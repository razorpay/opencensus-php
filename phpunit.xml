<?xml version="1.0" encoding="UTF-8"?>
<phpunit backupGlobals="false"
         backupStaticAttributes="false"
         bootstrap="bootstrap/autoload.php"
         colors="true"
         convertErrorsToExceptions="true"
         convertNoticesToExceptions="true"
         convertWarningsToExceptions="true"
         processIsolation="false"
         stopOnFailure="false"
         syntaxCheck="false">
  <testsuites>
      <testsuite name="Application Test Suite">
          <directory>./tests/</directory>
          <!-- Following two test files will be included once new attributes of
          entities are exposed publicly soon. -->
          <exclude>./tests/Functional/Invoice/InvoiceTaxesTest.php</exclude>
          <exclude>./tests/Unit/LineItem/Tax/CalculatorTest.php</exclude>
      </testsuite>
  </testsuites>
  <filter>
    <whitelist>
      <directory suffix=".php">./app/</directory>
      <exclude>
        <file>./app/config/database.php</file>
        <file>./app/config/testing/database.php</file>
        <file>./app/gateway/hdfc/HdfcGatewayConfig.php</file>
        <directory suffix=".php">./app/database/seeds</directory>
      </exclude>
    </whitelist>
  </filter>
  <php>
    <ini name="memory_limit" value="3072M"/>
    <const name="MCRYPT_RIJNDAEL_128" value="MCRYPT_RIJNDAEL_128"/>
  </php>
</phpunit>
