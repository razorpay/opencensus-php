{
  "name": "dashboard",
  "version": "0.0.0",
  "author": "Team Razorpay",
  "private": true,
  "license": "ISC",
  "engines": {
    "node": "^18.0.0",
    "npm": ">=8.1.2",
    "pnpm": "~9.0.0"
  },
  "scripts": {
    "prepare:commitmessage": "if [ \"$CI\" = \"true\" ]; then echo 'Running in CI environment'; else exec < /dev/tty && git cz --hook || true; fi",
    "postinstall": "pnpm exec husky install",
    "start": "pnpm nx run web:dev:build-merchant",
    "start-self-serve": "pnpm nx run self-serve:start",
    "start-digital-bills": "pnpm nx run digital-bills:start",
    "start-pos": "pnpm nx run pos:start",
    "start-newAuth": "pnpm nx run web:dev:build-newAuth",
    "start-pokedex": "pnpm nx run web:dev:build-pokedex",
    "start-merchantLA": "pnpm nx run web:dev:build-merchantLA",
    "tsc": "pnpm nx run web:tsc",
    "build": "pnpm nx run web:production:build",
    "serve": "REDIRECTOR=true pnpm start",
    "serve-newAuth": "REDIRECTOR=true pnpm start-newAuth",
    "serve-pokedex": "REDIRECTOR=true pnpm start-pokedex",
    "serve-merchantLA": "REDIRECTOR=true pnpm start-merchantLA",
    "test": "pnpm nx run web:test",
    "test:jest": "pnpm nx run web:test:jest",
    "test:jest-pos": "pnpm nx run pos:test:jest",
    "test:jest:ci": "pnpm nx run web:test:jest:ci",
    "test:jest-watch-changed": "pnpm nx run web:test:jest-watch-changed",
    "test:jest-watch": "pnpm nx run web:test:jest-watch",
    "devstack-deploy": "pnpm nx run web:devstack-deploy",
    "lint": "pnpm nx run web:lint",
    "lint:stylelint": "pnpm nx run web:stylelint",
    "nx": "nx",
    "validate-lint": "bash validate-eslint.sh $base",
    "lint:css": "pnpm nx run web:lint:css",
    "fix:css": "pnpm nx run web:fix:css",
    "sizelimit:local": "npx danger local --dangerfile dangerfile-bundlelimit.js",
    "test:setup": "pnpm nx run web:test:setup",
    "test:e2e": "pnpm nx run web:test:e2e",
    "test:e2e:auth": "pnpm exec playwright test",
    "test:e2e:payments-automation": "pnpm nx run web:test:e2e:payments-automation",
    "test:e2e:flow": "bash run-e2e.sh",
    "test:e2e-infra": "node ./playwright/runInfraE2E.js",
    "add-prod-commits": "node ./playwright/utils/addProdCommits.js",
    "test:e2e:show-report": "pnpm exec universe web-e2e show-report",
    "generate-changeset": "bash ./scripts/nx-releases/release.sh",
    "changeset-version": "changeset version",
    "version-update": "run-s changeset-version",
    "updateE2EDependencies": "node ./playwright/utils/copyDependecy.js",
    "removeNpmrc": "node ./playwright/utils/removeNpmrc.js"
  },
  "dependencies": {
    "@changesets/changelog-github": "^0.5.0",
    "@changesets/cli": "^2.27.1",
    "@razorpay/universe-cli": "18.5.1",
    "@razorpay/universe-doctor": "6.3.7",
    "@typeform/embed": "1.10.0",
    "croppie": "^2.6.4",
    "glob": "^7.1.2",
    "jspdf": "^2.5.1",
    "papaparse": "^5.4.1",
    "query-string": "^6.8.3",
    "secretlint": "4.1.3",
    "tslib": "^2.3.0",
    "wkhtmltopdf": "^0.4.0"
  },
  "devDependencies": {
    "@actions/core": "1.2.6",
    "@babel/eslint-parser": "^7.15.4",
    "@babel/plugin-proposal-private-methods": "7.16.11",
    "@babel/runtime-corejs3": "7.17.8",
    "@nx/js": "17.0.3",
    "@nx/react": "^17.0.3",
    "@nx/rollup": "17.0.3",
    "@playwright/test": "1.45.3",
    "@reportportal/agent-js-playwright": "5.1.9",
    "@rollup/plugin-url": "^7.0.0",
    "@size-limit/file": "^8.1.0",
    "@svgr/rollup": "^8.0.1",
    "@types/jest": "^29.4.1",
    "ansi-colors": "^4.1.3",
    "babel-jest": "29.2.0",
    "chalk": "4.1.0",
    "commitizen": "^4.2.4",
    "cz-conventional-changelog": "^3.2.0",
    "dotenv": "8.2.0",
    "eslint-import-resolver-jest": "^3.0.2",
    "eslint-import-resolver-typescript": "3.6.1",
    "eslint-plugin-i18n-rules": "file:./plugins/i18n-rules",
    "eslint-plugin-no-dist-assets": "file:./plugins/no-dist-assets",
    "http-server": "^0.12.3",
    "human-id": "^4.1.1",
    "husky": "^7.0.0",
    "jest": "^29.4.1",
    "jest-environment-jsdom": "^29.4.1",
    "jest-environment-node": "^29.4.1",
    "jest-location-mock": "^1.0.9",
    "jest-silent-reporter": "0.5.0",
    "jest-sonar": "0.2.12",
    "jshint": "^2.13.0",
    "lint-staged": "^10.2.11",
    "micromatch": "^4.0.5",
    "nodemon": "^2.0.7",
    "npm-run-all": "4.1.5",
    "nx": "17.0.3",
    "ora": "^8.0.1",
    "size-limit": "^8.1.0",
    "typescript": "4.9.3",
    "verdaccio": "^5.0.4",
    "danger": "11.2.2"
  },
  "resolutions": {
    "@typescript-eslint/eslint-plugin": "5.59.0",
    "@typescript-eslint/parser": "5.59.0"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog",
      "disableScopeLowerCase": true
    }
  },
  "universe": {
    "isInsideMonorepo": false
  },
  "nx": {
    "includedScripts": []
  }
}
