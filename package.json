{
  "name": "dashboard",
  "version": "0.0.0",
  "author": "Team Razorpay",
  "private": true,
  "license": "ISC",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.1.2",
    "yarn": "~1.22.10"
  },
  "workspaces": {
    "packages": [
      "web",
      "apps/self-serve",
      "libs/shared-ui",
      "libs/shared-utils"
    ],
    "nohoist": [
      "web/**",
      "**/web/**",
      "apps/self-serve/**",
      "**/apps/self-serve/**"
    ]
  },
  "scripts": {
    "prepare:commitmessage": "exec < /dev/tty && git cz --hook || true",
    "postinstall": "husky install",
    "start": "REDIRECTOR=true lerna run --scope=web dev:build-merchant",
    "start-self-serve": "lerna run --scope=self-serve start",
    "start-newAuth": "lerna run --scope=web dev:build-newAuth",
    "start-pokedex": "lerna run --scope=web dev:build-pokedex",
    "tsc": "lerna run --scope=web tsc",
    "build": "lerna run --scope=web production:build",
    "serve": "REDIRECTOR=true yarn start",
    "serve-newAuth": "REDIRECTOR=true yarn start-newAuth",
    "serve-pokedex": "REDIRECTOR=true yarn start-pokedex",
    "test": "lerna run --scope=web test",
    "test:jest": "lerna run --scope=web test:jest",
    "test:jest:ci": "lerna run --scope=web test:jest:ci",
    "test:jest-watch-changed": "lerna run --scope=web test:jest-watch-changed",
    "test:jest-watch": "lerna run --scope=web test:jest-watch",
    "devstack-deploy": "lerna run --scope=web devstack-deploy",
    "lint": "lerna run --scope=web lint",
    "nx": "nx",
    "lerna": "lerna",
    "validate-lint": "bash validate-eslint.sh $base",
    "lint:css": "lerna run --scope=web lint:css",
    "fix:css": "lerna run --scope=web fix:css",
    "sizelimit:local": "npx danger local --dangerfile dangerfile-bundlelimit.js",
    "test:setup": "lerna run --scope=web test:setup",
    "test:e2e": "lerna run --scope=web test:e2e",
    "test:e2e:auth": "universe-test web-e2e test",
    "test:e2e:payments-automation": "lerna run --scope=web test:e2e:payments-automation",
    "test:e2e:flow": "bash run-e2e.sh",
    "test:e2e-infra": "node ./playwright/runInfraE2E.js",
    "add-prod-commits": "node ./playwright/utils/addProdCommits.js",
    "test:e2e:show-report": "universe-test web-e2e show-report"
  },
  "dependencies": {
    "@typeform/embed": "1.10.0",
    "croppie": "^2.6.4",
    "glob": "^7.1.2",
    "query-string": "^6.8.3",
    "tslib": "^2.3.0",
    "@razorpay/universe-cli": "17.2.0"
  },
  "devDependencies": {
    "@actions/core": "1.2.6",
    "@babel/eslint-parser": "^7.15.4",
    "@nx/js": "17.0.3",
    "@nx/react": "^17.0.3",
    "@nx/rollup": "17.0.3",
    "@razorpay/universe-cli": "17.2.0",
    "@rollup/plugin-url": "^7.0.0",
    "@size-limit/file": "^8.1.0",
    "@svgr/rollup": "^8.0.1",
    "@testing-library/user-event": "14.4.3",
    "@types/jest": "29.2.0",
    "ansi-colors": "^4.1.3",
    "babel-jest": "29.2.0",
    "commitizen": "^4.2.4",
    "cz-conventional-changelog": "^3.2.0",
    "eslint-config-prettier": "8.5.0",
    "eslint-import-resolver-jest": "^3.0.2",
    "http-server": "^0.12.3",
    "husky": "^7.0.0",
    "jest": "^29.4.1",
    "jest-environment-jsdom": "^29.4.1",
    "jest-environment-node": "^29.4.1",
    "jest-location-mock": "^1.0.9",
    "jest-silent-reporter": "0.5.0",
    "jest-sonar": "0.2.12",
    "jshint": "^2.13.0",
    "lerna": "7.3.0",
    "lint-staged": "^10.2.11",
    "micromatch": "^4.0.5",
    "nodemon": "^2.0.7",
    "nx": "17.0.3",
    "size-limit": "^8.1.0",
    "typescript": "4.9.3",
    "verdaccio": "^5.0.4",
    "eslint-import-resolver-typescript": "3.6.1"
  },
  "resolutions": {
    "webpack": "5.76.0",
    "@types/react": "17.0.39",
    "@playwright/test": "1.31.1",
    "@reportportal/agent-js-playwright": "5.0.11"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog",
      "disableScopeLowerCase": true
    }
  },
  "universe": {
    "isInsideMonorepo": false
  },
  "nx": {
    "includedScripts": []
  }
}
