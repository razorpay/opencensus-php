{
  "name": "dashboard",
  "author": "Team Razorpay",
  "private": true,
  "license": "ISC",
  "engines": {
    "node": ">=16.13.1",
    "npm": ">=8.1.2",
    "yarn": ">=1.22.10"
  },
  "dependencies": {
    "@typeform/embed": "1.10.0",
    "croppie": "^2.6.4",
    "glob": "^7.1.2",
    "query-string": "^6.8.3"
  },
  "scripts": {
    "prepare:commitmessage": "exec < /dev/tty && git cz --hook || true",
    "postinstall": "husky install && cd web && yarn --frozen-lockfile",
    "start": "cd web && yarn dev:build-merchant",
    "start-newAuth": "cd web && yarn dev:build-newAuth",
    "start-pokedex": "cd web && yarn dev:build-pokedex",
    "build": "cd web && yarn prod-build-all",
    "serve": "REDIRECTOR=true yarn start",
    "serve-newAuth": "REDIRECTOR=true yarn start-newAuth",
    "serve-pokedex": "REDIRECTOR=true yarn start-pokedex",
    "test": "cd web && yarn test",
    "test:jest": "cd web && yarn test:jest",
    "test:jest:ci": "cd web && yarn test:jest",
    "test:jest-watch-changed": "cd web && yarn test:jest-watch-changed",
    "test:jest-watch": "cd web && yarn test:jest-watch",
    "lint": "bash lint.sh",
    "devstack-deploy": "cd web && yarn devstack-deploy",
    "validate-lint": "bash validate-eslint.sh $base",
    "lint:css": "stylelint --config .stylelintrc-stylus.js",
    "fix:css": "stylelint --config .stylelintrc-stylus.js --fix",
    "sizelimit:local": "npx danger local --dangerfile dangerfile-bundlelimit.js",
    "test:setup": "cd web && yarn test:setup",
    "test:e2e": "cd web && yarn test:e2e",
    "test:e2e:auth": "cd web && yarn test:e2e:auth",
    "test:e2e:payments-automation": "cd web && yarn test:e2e:payments-automation",
    "test:e2e:flow": "bash run-e2e.sh",
    "test:e2e-infra": "cd web && yarn test:e2e-infra"
  },
  "devDependencies": {
    "@actions/core": "1.2.6",
    "@babel/eslint-parser": "^7.15.4",
    "@razorpay/universe-doctor": "^2.0.0",
    "@razorpay/universe-utils": "6.0.2",
    "@size-limit/file": "^8.1.0",
    "@testing-library/user-event": "14.4.3",
    "@typescript-eslint/eslint-plugin": "^3.9.1",
    "@typescript-eslint/parser": "^3.9.1",
    "ansi-colors": "^4.1.3",
    "commitizen": "^4.2.4",
    "cz-conventional-changelog": "^3.2.0",
    "eslint": "^7.26.0",
    "eslint-config-kentcdodds": "^14.7.0",
    "eslint-config-prettier": "^6.15.0",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-import-resolver-jest": "^3.0.2",
    "eslint-plugin-import": "^2.28.0",
    "eslint-plugin-json": "^2.1.2",
    "eslint-plugin-jsx-a11y": "^6.4.1",
    "eslint-plugin-no-relative-import-paths": "^1.4.0",
    "eslint-plugin-prettier": "^3.4.1",
    "eslint-plugin-react": "^7.25.1",
    "eslint-plugin-yml": "^0.9.0",
    "http-server": "^0.12.3",
    "husky": "^7.0.0",
    "jest-location-mock": "^1.0.9",
    "jshint": "^2.13.0",
    "lint-staged": "^10.2.11",
    "micromatch": "^4.0.5",
    "nodemon": "^2.0.7",
    "prettier": "^2.0.5",
    "size-limit": "^8.1.0",
    "stylelint": "14.0.0",
    "stylelint-config-standard": "24.0.0",
    "stylelint-stylus": "0.16.1",
    "typescript": "3.9.5"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog",
      "disableScopeLowerCase": true
    }
  },
  "universe": {
    "isInsideMonorepo": false
  }
}
