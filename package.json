{
  "name": "dashboard",
  "author": "Team Razorpay",
  "private": true,
  "dependencies": {
    "@typeform/embed": "^0.16.0",
    "aws-sdk": "2.181.0",
    "croppie": "^2.6.4",
    "ecstatic": "^3.3.2",
    "glob": "^7.1.2",
    "jshint": "^2.10.2",
    "multi-glob": "^1.0.2",
    "puppeteer": "^1.20.0",
    "query-string": "^6.8.3"
  },
  "scripts": {
    "postinstall": "cd web && npm i",
    "start": "node signup.js; cd web && npm start",
    "build": "node signup.js; cd web && npm run production:build",
    "test": "node test.js; cd web && npm run test"
  },
  "devDependencies": {
    "@universe/configs": "^1.0.30",
    "commitizen": "^4.1.2",
    "cz-conventional-changelog": "^3.2.0",
    "husky": "^4.2.5",
    "lint-staged": "^10.2.11",
    "prettier": "^1.10.2"
  },
  "husky": {
    "hooks": {
      "prepare-commit-msg": "exec < /dev/tty && git cz --hook || true",
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "/web/js/dashboard_v2/**/*.(js|jsx|ts|tsx)": ["eslint", "stylelint"],
    "*.(js|json|jsx|ts|tsx)": ["prettier --write --single-quote --trailing-comma es5"]
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog",
      "disableScopeLowerCase": true
    }
  }
}
