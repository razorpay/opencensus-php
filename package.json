  "resolutions": {
    "react": "17.0.2",
    "react-dom": "17.0.2",
    "@typescript-eslint/eslint-plugin": "5.59.0",
    "@typescript-eslint/parser": "5.59.0",
    "source-map": "^0.8.0-beta.0",
    "framer-motion": "6.5.1"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog",
      "disableScopeLowerCase": true
    }
  },
  "universe": {
    "isInsideMonorepo": false
  },
  "nx": {
    "targets": {
      "test:e2e:auth": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "newauth-dashboard:test:e2e:auth"
        ],
        "options": {
          "command": "echo Authenticated States Saved!"
        }
      },
      "test:e2e:infra": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "@libs/shared-core:build"
        ],
        "options": {
          "command": "pnpm node ./node_modules/@libs/shared-core/dist/initializeE2EInfra.playwright.cjs"
        }
      },
      "test:e2e:add-prod-commits": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "@libs/shared-core:build"
        ],
        "options": {
          "command": "pnpm node ./node_modules/@libs/shared-core/dist/addProdCommit.playwright.cjs"
        }
      },
      "init:dev": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "@libs/shared-core:build"
        ],
        "options": {
          "cwd": ".",
          "command": "pnpm node ./node_modules/@libs/shared-core/dist/dashboard-cli.cjs"
        }
      },
      "init:scaffold": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "@libs/shared-core:build"
        ],
        "options": {
          "cwd": ".",
          "command": "pnpm node ./node_modules/@libs/shared-core/dist/scaffold-app.cjs"
        }
      },
      "local-registry": {
        "executor": "@nx/js:verdaccio",
        "options": {
          "port": 4873,
          "config": ".verdaccio/config.yml",
          "storage": "tmp/local-registry/storage"
        }
      }
    },
    "includedScripts": []
  }
}