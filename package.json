  "scripts": {
    "prepare:commitmessage": "if [ \"$CI\" = \"true\" ]; then echo 'Running in CI environment'; else exec < /dev/tty && git cz --hook || true; fi",
    "postinstall": "pnpm exec husky install",
    "tsc": "pnpm nx run web-nexus:tsc",
    "lint": "pnpm nx run web-nexus:lint",
    "lint:stylelint": "pnpm nx run web-nexus:stylelint",
    "nx": "nx",
    "validate-lint": "bash validate-eslint.sh $base",
    "lint:css": "pnpm nx run web-nexus:lint:css",
    "fix:css": "pnpm nx run web-nexus:fix:css",
    "sizelimit:local": "npx danger local --dangerfile dangerfile-bundlelimit.js",
    "generate-changeset": "bash ./scripts/nx-releases/release.sh",
    "changeset-version": "changeset version",
    "version-update": "run-s changeset-version",
    "clean:nodemodules": "find . -name 'node_modules' -type d -prune -exec rm -rf '{}' +",
    "test:e2e:install-browsers": "npx playwright install --with-deps chromium"
  },
