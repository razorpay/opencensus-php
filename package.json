{
  "name": "dashboard",
  "author": "Team Razorpay",
  "private": true,
  "dependencies": {
    "@typeform/embed": "1.10.0",
    "croppie": "^2.6.4",
    "glob": "^7.1.2",
    "query-string": "^6.8.3"
  },
  "scripts": {
    "prepare:commitmessage": "exec < /dev/tty && git cz --hook || true",
    "postinstall": "husky install && cd web && npm ci",
    "start": "node signup.js; cd web && npm start",
    "start:all": "node signup.js; cd web && npm run start:all",
    "serve": "REDIRECTOR=true npm run start",
    "serve:signup": "nodemon signup.js --watch public/js/merchant/",
    "build": "node signup.js; cd web && npm run production:build",
    "test": "cd web && npm run test",
    "test:jest": "cd web && npm run test:jest",
    "test:jest-watch-changed": "cd web && npm run test:jest-watch-changed",
    "test:jest-watch": "cd web && npm run test:jest-watch",
    "build:e2e": "cd web && npm run e2e:build",
    "test:e2e": "cd web && npm run test:e2e",
    "lint": "bash lint.sh",
    "validate-lint": "bash validate-eslint.sh $base"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.15.4",
    "@typescript-eslint/eslint-plugin": "^3.9.1",
    "@typescript-eslint/parser": "^3.9.1",
    "@universe/configs": "^1.0.36",
    "@razorpay/universe-doctor": "^2.0.0",
    "commitizen": "^4.2.4",
    "cz-conventional-changelog": "^3.2.0",
    "eslint": "^7.26.0",
    "eslint-config-kentcdodds": "^14.7.0",
    "eslint-config-prettier": "^6.15.0",
    "eslint-import-resolver-jest": "^3.0.0",
    "eslint-plugin-json": "^2.1.2",
    "eslint-plugin-jsx-a11y": "^6.4.1",
    "eslint-plugin-prettier": "^3.4.1",
    "eslint-plugin-react": "^7.25.1",
    "eslint-plugin-yml": "^0.9.0",
    "http-server": "^0.12.3",
    "husky": "^7.0.0",
    "jshint": "^2.13.0",
    "lint-staged": "^10.2.11",
    "nodemon": "^2.0.7",
    "prettier": "^2.0.5",
    "typescript": "3.9.5"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog",
      "disableScopeLowerCase": true
    }
  },
  "universe": {
    "isInsideMonorepo": false
  }
}
