{
  "name": "dashboard",
  "author": "Team Razorpay",
  "private": true,
  "dependencies": {
    "aws-sdk": "2.181.0",
    "ecstatic": "^3.1.1",
    "glob": "^7.1.2",
    "multi-glob": "^1.0.1",
    "puppeteer": "^1.0.0"
  },
  "scripts": {
    "precommit": "lint-staged",
    "prettier": "prettier",
    "postinstall": "cd web && npm i",
    "start": "node signup; cd web && npm start",
    "build": "node signup; cd web && npm run build",
    "test": "node test.js"
  },
  "lint-staged": {
    "*.js": [
      "prettier --write --single-quote --trailing-comma es5",
      "git add"
    ]
  },
  "devDependencies": {
    "husky": "^0.14.3",
    "lint-staged": "^6.0.0",
    "prettier": "^1.10.2"
  }
}
