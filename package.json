  "devDependencies": {
    "husky": "^0.14.3",
    "lint-staged": "^4.3.0",
    "prettier": "^1.8.0"
  },
  "dependencies": {
    "axios": "^0.17.0",
    "babel-core": "^6.26.0",
    "babel-loader": "^7.1.2",
    "babel-plugin-react-html-attrs": "^2.0.0",
    "babel-plugin-transform-decorators-legacy": "^1.3.4",
    "babel-preset-env": "^1.6.1",
    "babel-preset-es2015": "^6.24.1",
    "babel-preset-react": "^6.24.1",
    "babel-preset-stage-0": "^6.24.1",
    "butternut": "^0.4.6",
    "chart.js": "^2.7.1",
    "deep-equal": "^1.0.1",
    "glob": "^7.1.2",
    "gulp": "^3.9.1",
    "gulp-stylus": "^2.6.0",
    "icon-font-generator": "^1.1.1",
    "mobx": "^3.3.1",
    "mobx-react": "^4.3.4",
    "moment": "^2.19.1",
    "promise-polyfill": "^6.0.2",
    "react": "^16.0.0",
    "react-async-button": "^0.2.0",
    "react-dom": "^16.0.0",
    "react-router-dom": "^4.2.2",
    "react-transition-group": "^2.2.1",
    "webpack": "^3.8.1"
  },
  "scripts": {
    "start": "externals=`./web/scripts/vendor.sh` webpack -w & gulp watch; kill -9 $!",
    "build": "gulp; externals=`./web/scripts/vendor.sh` webpack; ./web/scripts/build.sh",
    "squash": "for i in public/dist/*/*.js; do squash $i > $i.min; rm $i; mv $i.min $i; done",
    "precommit": "lint-staged",
    "prettier": "prettier"
  },
  "lint-staged": {
    "*.js": [
      "prettier --write --single-quote --trailing-comma es5",
      "git add"
    ]
  }
}
