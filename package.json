{
  "name": "dashboard",
  "author": "Team Razorpay",
  "private": true,
  "dependencies": {
    "@typeform/embed": "^0.16.0",
    "aws-sdk": "2.181.0",
    "croppie": "^2.6.4",
    "glob": "^7.1.2",
    "jshint": "^2.10.2",
    "multi-glob": "^1.0.2",
    "puppeteer": "^1.20.0",
    "query-string": "^6.8.3"
  },
  "scripts": {
    "postinstall": "cd web && npm ci",
    "start": "node signup.js; cd web && npm start",
    "serve": "REDIRECTOR=true npm run start",
    "serve:signup": "nodemon signup.js --watch public/js/merchant/",
    "build": "node signup.js; cd web && npm run production:build",
    "test": "node test.js; cd web && npm run test",
    "test:jest": "cd web && npm run test:jest",
    "build:e2e": "cd web && npm run e2e:build",
    "test:e2e": "cd web && npm run test:e2e"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^3.9.1",
    "@typescript-eslint/parser": "^3.9.1",
    "@universe/configs": "^1.0.35",
    "commitizen": "^4.1.2",
    "cz-conventional-changelog": "^3.2.0",
    "eslint-import-resolver-jest": "^3.0.0",
    "http-server": "^0.12.3",
    "husky": "^4.2.5",
    "lint-staged": "^10.2.11",
    "nodemon": "^2.0.7",
    "prettier": "^2.0.5",
    "typescript": "3.9.5"
  },
  "husky": {
    "hooks": {
      "prepare-commit-msg": "exec < /dev/tty && git cz --hook || true",
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "web/v2/**/*.(js|jsx|ts|tsx)": [
      "eslint",
      "stylelint"
    ],
    "*.(js|json|jsx|ts|tsx)": [
      "prettier --write"
    ]
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog",
      "disableScopeLowerCase": true
    }
  }
}
