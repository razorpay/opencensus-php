::-webkit-scrollbar-track
{
  -webkit-box-shadow: inset 0 0 6px rgba(0,0,0,0.2);
  border-radius: 8px;
  background-color: #F5F5F5;
}

::-webkit-scrollbar
{
  width: 10px;
  background-color: #F5F5F5;
}

::-webkit-scrollbar-thumb
{
  border-radius: 8px;
  background-color: #666;
}

.sk-input-wrap{
    margin: 8px 10px 0!important;
}
.sk-intro input {
  color: #555;
  width: 100%;
  margin: 0 0 0 -10px;
  border: 1px solid #ddd;
  padding: 0 10px;
  line-height: 34px;
  border-radius: 2px;
  outline: none;

  &:invalid {
    border-color: #e74c3c;
  }
}
.list-group-item pre {
	font-family: Menlo, Monaco, "Ubuntu Mono", Consolas, "Courier New", monospace;
	letter-spacing: 0.0625em;
	word-spacing: 5px;
}

.panel code {
	color: inherit;
	background-color: inherit;
}
a code {
	color: #58666e;
	font-size: inherit;
}
.legend .legendLabel{
  color: #333;
}
.input-date{
  width: 180px;
  float: left;

  &+div{
    margin-left: 12px;
  }

  .input-group-addon{
    border-radius: 2px;
    cursor: pointer;
  }

  @media(max-width: 840px){
    width: 140px;

    .input-group-addon{
      display: none;
    }
  }
}
.date-filter{
  @media(max-width: 540px){
    display: none;
  }
}

.intro-tour-overlay {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1000;
  background-color: rgba(0, 0, 0, 0.5);
}
