}

// tourbus container is available after login. we only show it to logged in users
.tourbus-container ~ #sk-holder .sk-intro-section .intro-text:after {
  content: $supportkit-text;
}

.dynamic-tooltip {
  padding: 5px 10px;
  position: absolute;
  border-radius: 4px;
  color: #fff;
  background-color: #000;
  z-index: 200;
  animation: fadeIn 0.5s;

  &::after {
    content: '';
    position: absolute;
    left: -8px;
    width: 0;
    height: 0;
    transform: translate(0, 50%);
    border-top: 5px solid transparent;
    border-bottom: 5px solid transparent;
    border-right: 10px solid #000;
  }
}
@keyframes fadeIn {
  0% {
    opacity: 0;
  }

  100% {
    opacity: 1;
  }
}

