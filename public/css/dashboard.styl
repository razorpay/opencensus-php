// Invoices nav

#invoices-page {
  position relative;

  .invoicesNav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 20px;
    border-bottom: 1px solid #ddd;
    height: 67px;

    > .h3 {
      flex: 0.9;
    }

    > .nav.nav-pills {
      flex: 1;

      > li > a {
        background: transparent;
        padding: 22px;
        border-radius: 0;
        border-bottom: 2px solid transparent;

        &.active {
          color: #7266ba;
          border-color: inherit;
        }
      }
    }

    > div {
      flex: 1.2;
    }
  }

  .react-root > .btn-toolbar {
    position: absolute;
    right: 20px;
    top: 20px;
  }
}

.bg-dark .nav > li > a.active {
  color: #fff;
  background-color: #2e3344;
}

.bg-dark .nav > li:focus > a {
  color: #b4b6bd;
  background-color: transparent;
}

