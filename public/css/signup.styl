/* latin-ext */
@font-face {
  font-family: 'Lato';
  font-style: normal;
  font-weight: 400;
  src: local('Lato Regular'), local('Lato-Regular'), url(https://fonts.gstatic.com/s/lato/v11/UyBMtLsHKBKXelqf4x7VRQ.woff2) format('woff2');
  unicode-range: U+0100-024F, U+1E00-1EFF, U+20A0-20AB, U+20AD-20CF, U+2C60-2C7F, U+A720-A7FF;
}
/* latin */
@font-face {
  font-family: 'Lato';
  font-style: normal;
  font-weight: 400;
  src: local('Lato Regular'), local('Lato-Regular'), url(https://fonts.gstatic.com/s/lato/v11/1YwB1sO8YE1Lyjf12WNiUA.woff2) format('woff2');
  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02C6, U+02DA, U+02DC, U+2000-206F, U+2074, U+20AC, U+2212, U+2215, U+E0FF, U+EFFD, U+F000;
}

#auth-container {
  font-family: "Lato", "Source Sans Pro", "Helvetica Neue", Helvetica, Arial,
    sans-serif;
  background: linear-gradient(116deg, #1b2566, #a899d2);
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  right: 0;
  
  .logo {
    height 32px
  }
  
  ::-webkit-scrollbar { 
    display: none; 
  }
  
  &.no-transition {
    * {
      transition-duration 0s !important
    }
  }
}

.auth-header 
  margin-bottom 60px
  @media(max-width: 890px){
    padding 0 30px
  }
  .btn-layout-change
    color white
    border-radius 5px
    background-color rgba(255, 255, 255, 0.05)
    border solid 1px rgba(255, 255, 255, 0.5)
    font-weight bold
    width 72px

.auth-inner {
  margin 0 auto
  width 890px
  padding 30px
  @media(max-width: 890px){
    width auto
    max-width 480px
    padding 0
    margin 30px auto
  }
}
.auth-body {
  position relative
  margin-top 30px
}
.auth-messaging {
  width 100%
  height 480px
  position relative
  border-radius: 4px;
  padding: 40px;
  background-color: #eaeaea;
  box-shadow: 0 2px 2px 0 rgba(0, 0, 0, 0.2);
  &.signup {
    .signup-messaging {
      opacity 1;
    }
  }
  &.login {
    .login-messaging {
      opacity 1;
    }
  }
  @media(max-width: 890px){
    display none
  }
}

.messaging-heading
  font-size 16px
  font-weight bold

.messaging-text
  font-size 14px
  line-height 2
  margin-top 12px

.messaging-testimonial
  margin-top 40px
  
.messaging-image
  display inline-block
  vertical-align top
  img
    height 60px
    width 60px

.messaging-right
  display inline-block
  margin-left 20px
  
.messaging-name
  font-size 16px
  font-weight bold
  line-height 28px
  
.messaging-position
  font-size 14px
  line-height 28px
  
.messaging-support
  position: absolute;
  bottom: 0;
  height: 90px;
  
.line-segment
  width: 20px
  height 0px
  border 1px #58666e solid

.support-container 
  margin-top 24px

.support-icon
  display inline-block
  height 40px
  width 40px
  font-size 18px
  padding 7px 12px
  border-radius 4px
  border 1px #58666e solid
  vertical-align top
  
.support-info-container 
  display inline-block
  margin-left 18px
  
.support-text
  font-size 12px
  line-height 16px
  letter-spacing 1.4px

.support-number
  font-weight bold
  font-size 20px
  line-height 32px

.signup-messaging {
  position absolute
  top 40px
  right 40px
  bottom 40px
  left: 390px;
  opacity: 0
  transition opacity 0.25s cubic-bezier(0.175, 0.885, 0.260, 1.055)
}

.messaging-link
  letter-spacing 1px
  color: #6d5fba;
  margin-top: 12px;
  display: block;
  margin-bottom: 20px;

.login-messaging {
  position absolute
  top 40px
  right 390px
  bottom 40px
  left: 40px;
  opacity: 0
  transition opacity 0.25s cubic-bezier(0.175, 0.885, 0.260, 1.055)
}

.auth-main-container {
  height 540px
  width 320px
  border-radius: 4px;
  background-color: #fafafa;
  box-shadow: 0 5px 10px 0 rgba(0, 0, 0, 0.15), 0 0 2px 0 rgba(0, 0, 0, 0.2);
  top -30px
  left 30px
  padding 40px
  transition left .5s cubic-bezier(0.175, 0.885, 0.260, 1.055)
  &.right-align {
    .translate-container {
      transform: translateX(-240px)
    }
    .auth-signup-container {
      transition-delay 0s
      opacity 0
    }
    .auth-signin-container {
      transition-delay 0.25s
      opacity 1
    }
  }
  @media(min-width: 890px){
    position absolute
    &.right-align {
      left 480px
    }
  }
  @media(max-width: 890px){
    margin 0 auto
  }
}

.translate-container
  width 480px
  transition transform .5s cubic-bezier(0.175, 0.885, 0.260, 1.055)

.overflow-container
  overflow hidden

.auth-signup-container 
  width 240px
  height 460px
  float left
  transition opacity .25s cubic-bezier(0.175, 0.885, 0.260, 1.055)
  transition-delay 0.25s
  opacity 1

.auth-signin-container 
  width 240px
  height 460px
  float left
  transition opacity .25s cubic-bezier(0.175, 0.885, 0.260, 1.055)
  transition-delay 0s
  opacity 0
  
.signup-translate-container 
  width 960px
  transition transform .5s cubic-bezier(0.175, 0.885, 0.260, 1.055)

.login-translate-container
  width 480px
  transition transform .5s cubic-bezier(0.175, 0.885, 0.260, 1.055)

.auth-overflow-container 
  width: 100%;
  height: 100%;
  overflow: hidden;

.auth-step
  float: left;
  width: 240px;
  overflow-x hidden
  
.auth-form
  margin-top 24px
  margin-bottom 12px
  position relative
  
.spinner-container
  position: absolute;
  top: 0;
  bottom: 0;
  right: 0;
  left: 0;
  background-repeat: no-repeat;
  background-position: center;
  
.loading-animation
  position: absolute;
  top: 0;
  bottom: 0;
  right: 0;
  left: 0;
  background: rgba(250,250,250,0.4);
  opacity: 0
  pointer-events none
  &.active
    opacity 1
  
.auth-heading 
  font-size: 18px;
  font-weight: bold;
  line-height 28px
  
.auth-subheading
  font-size 14px
  font-weight bold
  line-height 24px
  
.auth-form-input
  margin-bottom 12px
  height 40px

.auth-text 
  font-size 14px
  line-height 24px
  
.highlight
  text-decoration underline 

.auth-subtext 
  font-size 12px
  line-height 18px
  margin-bottom 18px
  
.google-captcha
  width 240px
  height 78px
  transform: scale(0.79);
  transform-origin: top left;
  
.btn-step-2
  margin-top 96px

.steps-dots 
  margin-top 32px

.step-dot {
  float: left;
  width: 8px;
  height: 8px;
  border: 1px solid rgba(0, 0, 0, 0.26);
  margin-right: 4px;
  border-radius: 4px;
  transition: all 0.5s cubic-bezier(0.175, 0.885, 0.260, 1.055)
  &.active{
    width: 12px;
    background-color: #7266ba;
    border: none;
  }
}

.signup-details-translate-container 
  width 1200px
  transition transform .5s cubic-bezier(0.175, 0.885, 0.260, 1.055)
  
.login-details-translate-container 
  width 480px
  transition transform .5s cubic-bezier(0.175, 0.885, 0.260, 1.055)

.signup-details-overflow-container
  margin-top 12px
  height 360px
  width 240px
  position relative
  
.login-details-overflow-container
  height 360px
  width 240px  

.auth-substep
  width 240px
  height 356px
  float left
  overflow scroll
  
.signup-details-button
  margin-top 18px
  
.select-one {
  margin-top 12px
  
  .select-one-option {
    display: block;
    width: 100%;
    margin: 0;
    border: 1px solid #eaeaea;
    margin-top: -1px;
    overflow: hidden;

    &:first-child {
      border-radius: 4px 4px 0 0;
    }
    &:last-child {
      border-radius: 0 0 4px 4px;
    }
  }

  label {
    background: #ffffff;
    width: 100%;
    display: block;
    padding: 9px 16px;
    margin: 0;
    cursor: pointer;
    transition: 0.3s;

    &:hover {
      background: #fafafa;
    }
  }

  .fa-check {
    color: #f1f1f1;
    line-height: 22px;
    transition: 0.3s;
  }
  .fa-ellipsis-h {
    line-height: 22px;
  }

  input[type=radio] {
    display: none;

    &:checked + label {
      background: #fffaea;
      .fa-check{
        color: #00bb55;
      }
    }
  }

  input[type=checkbox] {
    display: none;
  }
}

.highlight-clickable-text {
  cursor pointer
  color #7266ba
  text-decoration underline
  margin-top 24px
}

.login-btn {
  margin-top 24px
}

