/* latin-ext */
@font-face {
  font-family: 'Lato';
  font-style: normal;
  font-weight: 400;
  src: local('Lato Regular'), local('Lato-Regular'), url(https://fonts.gstatic.com/s/lato/v11/UyBMtLsHKBKXelqf4x7VRQ.woff2) format('woff2');
  unicode-range: U+0100-024F, U+1E00-1EFF, U+20A0-20AB, U+20AD-20CF, U+2C60-2C7F, U+A720-A7FF;
}
/* latin */
@font-face {
  font-family: 'Lato';
  font-style: normal;
  font-weight: 400;
  src: local('Lato Regular'), local('Lato-Regular'), url(https://fonts.gstatic.com/s/lato/v11/1YwB1sO8YE1Lyjf12WNiUA.woff2) format('woff2');
  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02C6, U+02DA, U+02DC, U+2000-206F, U+2074, U+20AC, U+2212, U+2215, U+E0FF, U+EFFD, U+F000;
}

#auth-container {
  font-family: "Lato", "Helvetica Neue", Helvetica, Arial,sans-serif;
  background: linear-gradient(116deg, #1b2566, #a899d2);
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  right: 0;
  min-height: 660px;
  .logo {
    height: 32px;
  }

  ::-webkit-scrollbar {
    display: none;
  }

  .no-transition {
    // * {
    transition-duration: 0s !important;
    // }
  }
  .ng-invalid.ng-dirty {
    border-color: #da4444;
  }
  .form-control:focus {
    border-color: #7266ba;
  }
}

.signup-org-loading{
  position: relative;
  height: 100%;
}

.auth-background-img {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  right: 0;
  opacity: 0.2;
  filter: blur(10px)
  background-size cover
}

.auth-header {
  margin-bottom: 60px;
  position: relative;
  @media(max-width: 890px){
    padding: 0 30px;
    .auth-header-text {
      display: none;
    }
  }
  .btn-layout-change {
    color: white;
    border-radius: 5px;
    background-color: rgba(255, 255, 255, 0.05);
    border: solid 1px rgba(255, 255, 255, 0.5);
    font-weight: bold;
    width: 72px;
    margin-left: 12px;
  }
}

.auth-header-text {
  color: white;
}


.auth-inner {
  margin: 0 auto;
  width: 890px;
  padding: 30px;
  @media(max-width: 890px){
    width: auto;
    max-width: 480px;
    padding: 0;
    margin: 30px auto;
  }
}

.auth-body {
  position: relative;
  margin-top: 30px;
}

.auth-messaging {
  width: 100%;
  height: 480px;
  position: relative;
  border-radius: 4px;
  padding: 40px;
  background-color: #eaeaea;
  box-shadow: 0 2px 2px 0 rgba(0, 0, 0, 0.2);
  &.signup {
    .signup-messaging {
      opacity: 1;
      transition-delay: 0.4s;
    }
    .login-messaging {
      transition-delay: 0s;
    }
  }
  &.login {
    .login-messaging {
      opacity: 1;
      transition-delay: 0.4s;
    }
    .signup-messaging {
      transition-delay: 0s;
    }
  }
  @media(max-width: 890px){
    display: none;
  }
}

.messaging-heading{
  font-size: 16px;
  font-weight: bold;
}

.messaging-text{
  font-size: 14px;
  line-height: 1.8;
  margin-top: 8px;
}

.messaging-testimonial{
  margin-top: 40px;
}

.messaging-image{
  display: inline-block;
  vertical-align: top;
  img{
      height: 60px;
      width: 60px;
  }
}

.messaging-right{
  display: inline-block;
  margin-left: 20px;
}

.messaging-name{
  font-size: 16px;
  font-weight: bold;
  line-height: 28px;
}

.messaging-position{
  font-size: 14px;
  line-height: 28px;
}

.messaging-support{
  position: absolute;
  bottom: 0;
  height: 90px;
}

.line-segment{
  width: 20px;
  height: 0px;
  border: 1px #58666e solid;
}

.support-container {
  margin-top: 24px;
}

.support-icon{
  display: inline-block;
  height: 40px;
  width: 40px;
  font-size: 18px;
  padding: 7px 12px;
  border-radius: 4px;
  border: 1px #58666e solid;
  vertical-align: top;
}

.support-info-container {
  display: inline-block;
  margin-left: 18px;
}

.support-text{
  font-size: 12px;
  line-height: 16px;
  letter-spacing: 1.4px;
}

.support-number{
  font-weight: bold;
  font-size: 20px;
  line-height: 30px;
}

.signup-messaging {
  position: absolute;
  top: 40px;
  right: 40px;
  bottom: 40px;
  left: 390px;
  opacity: 0;
  transition: opacity 0.2s ease-in-out;
}

.messaging-link{
  letter-spacing: 1px;
  color: #6d5fba;
  margin-top: 8px;
  display: inline-block;
  margin-bottom: 20px;
}

.login-messaging {
  position: absolute;
  top: 40px;
  right: 390px;
  bottom: 40px;
  left: 40px;
  opacity: 0;
  transition: opacity 0.2s ease-in-out;
}

.auth-main-container {
  height: 540px;
  width: 320px;
  border-radius: 4px;
  background-color: #fafafa;
  box-shadow: 0 5px 10px 0 rgba(0, 0, 0, 0.15), 0 0 2px 0 rgba(0, 0, 0, 0.2);
  top: -30px;
  left: 30px;
  padding: 32px 40px;
  transition: left 0.8s cubic-bezier(0.175, 0.885, 0.260, 1.055);
  &.right-align {
    .translate-container {
      transform: translateX(-240px);
    }
    .auth-signup-container {
      transition-delay: 0s;
      opacity: 0;
    }
    .auth-signin-container {
      transition-delay: 0.6s;
      opacity: 1;
    }
  }
  @media(min-width: 890px){
    position: absolute;
    &.right-align {
      left: 480px;
    }
  }
  @media(max-width: 890px){
    margin: 0 auto;
  }
}

.translate-container{
  width: 480px;
  transition: transform 0.2s ease-out;
  transition-delay: 0.4s;
}

.overflow-container{
  overflow: hidden;
}

.auth-signup-container {
  width: 240px;
  height: 476px;
  float: left;
  transition: opacity 0.4s cubic-bezier(0.175, 0.885, 0.260, 1.055);
  transition-delay: 0.6s;
  opacity: 1;
}

.auth-signin-container {
  width: 240px;
  height: 476px;
  float: left;
  transition: opacity 0.4s cubic-bezier(0.175, 0.885, 0.260, 1.055);
  transition-delay: 0s;
  opacity: 0;
}

.signup-translate-container {
  width: 960px;
  transition: transform 0.3s ease-out;
}

.login-translate-container{
  width: 960px;
  transition: transform 0.3s ease-out;
}

.auth-overflow-container {
  width: 100%;
  height: 100%;
  overflow: hidden;
  position: relative;
  &:after {
    // uncomment for grey gradient at the bottom
    // content: ' ';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 8px;
    pointer-events: none;
    background: linear-gradient(0deg, #fafafa, rgba(250,250,250,0.01));
  }
}

.auth-step{
  float: left;
  width: 240px;
  height: 476px;
  overflow: hidden;
}

.signup-form-step {
  height: 100%;
  overflow: scroll;
}

.auth-form{
  margin-top: 16px;
  margin-bottom: 12px;
  position: relative;
}

.spinner-container{
  position: absolute;
  top: 0;
  bottom: 0;
  right: 0;
  left: 0;
  background-repeat: no-repeat;
  background-position: center;
}

.loading-animation{
  position: absolute;
  top: 0;
  height: 0;
  right: 0;
  left: 0;
  background: rgba(250,250,250,0.4);
  opacity: 0;
  &.active{
    bottom: 0;
    height: auto;
    opacity: 1;
  }
}

.auth-heading {
  font-size: 18px;
  font-weight: bold;
  line-height: 28px;
  margin-bottom: 8px;
}

.auth-subheading{
  font-size: 14px;
  font-weight: bold;
  line-height: 24px;
}

.auth-form-input{
  margin-bottom: 12px;
  height: 40px;
  font-size: 14px;
}

.auth-text {
  font-size: 14px;
  line-height: 24px;
}

.highlight{
  text-decoration: underline;
}

.auth-subtext {
  font-size: 12px;
  line-height: 18px;
  margin-bottom: 18px;
}

.google-captcha{
  width: 240px;
  height: 78px;
  transform: scale(0.79);
  transform-origin: top left;
}

.btn-step-2{
  margin-top: 16px;
}

.steps-dots {
  margin-top: 32px;
}

.step-dot {
  float: left;
  width: 8px;
  height: 8px;
  border: 1px solid rgba(0, 0, 0, 0.26);
  margin-right: 4px;
  border-radius: 4px;
  transition: all 0.5s ease-out;
  &.active{
    width: 12px;
    background-color: #7266ba;
    border: none;
  }
}

.question-back-arrow {
  cursor: pointer;
  color: #7266ba;
  margin-right: 4px;
  font-size: 18px;
  vertical-align: middle;
}

.signup-detail-header {
  height: 64px;
}

.signup-details-translate-container {
  width: 1200px;
  transition: transform .3s ease-out;
}

.login-details-translate-container {
  width: 480px;
  transition: transform .3s ease-out;
}

.signup-details-overflow-container{
  margin-top: 12px;
  height: 344px;
  width: 240px;
  position: relative;
}

.login-details-overflow-container{
  height: 360px;
  width: 240px;
}

.auth-substep{
  width: 240px;
  float: left;
  padding-bottom: 14px;
  position: relative;
  overflow: auto;
  &::-webkit-scrollbar {
      display: initial !important;
  }
}

.business-type-substep, .name-substep {
  height: 360px;
  // padding-bottom: 24px;
  .select-one {
    height: 235px;
  }
}

.business-type-show-more {
  .select-one {
    height: 430px;
  }
}

.signup-details-button{
  margin-top: 18px;
}

.select-one {
  margin-top: 12px;
  transition: height 0.6s ease-out;

  .select-one-option {
    display: block;
    width: 100%;
    margin: 0;
    border: 1px solid #eaeaea;
    margin-top: -1px;
    overflow: hidden;

    &:first-child {
      border-radius: 4px 4px 0 0;
    }
    &:last-child {
      border-radius: 0 0 4px 4px;
    }
  }

  label {
    background: #ffffff;
    width: 100%;
    display: block;
    padding: 9px 16px;
    margin: 0;
    cursor: pointer;
    transition: 0.2s;

    &:hover {
      background: #fafafa;
    }
  }

  .fa-check {
    color: #f1f1f1;
    line-height: 22px;
    transition: 0.3s;
  }
  .fa-ellipsis-h {
    line-height: 22px;
  }

  input[type=radio] {
    display: none;

    &:checked + label {
      background: #fffaea;
      .fa-check{
        color: #00bb55;
      }
    }
  }

  input[type=checkbox] {
    display: none;
  }
}

.details-label {
  font-size: 14px;
  font-weight: bold;
}

.highlight-clickable-text {
  cursor: pointer;
  color: #7266ba;
  text-decoration: underline;
}

.forgot-password-text{
  margin-bottom: 12px;
  font-size: 12px;
}

.verification-image, .signup-success-image{
  width: 180px;
  height: 149px;
  margin: 40px auto;
  background-size: cover;
}

.verify-container, .signup-success-container{
  text-align: center;
}
