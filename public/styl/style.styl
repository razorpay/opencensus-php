/* Colours */

rzp-blue = #29B7D5
rzp-red = #E74C3C
rzp-green = #27AE60
rzp-light-gray = #EFEFEF
rzp-gray = #444444

/* Mixins */

transition(n)
	transition all n ease-in 0s
	-o-transition all n ease-in 0s
	-moz-transition all n ease-in 0s
	-webkit-transition all n ease-in 0s

border-radius-left(n)
	-webkit-border-top-left-radius n
	-webkit-border-bottom-left-radius n
	-moz-border-radius-topleft n
	-moz-border-radius-bottomleft n
	border-top-left-radius n
	border-bottom-left-radius n

border-radius-right(n)
	-webkit-border-top-right-radius n
	-webkit-border-bottom-right-radius n
	-moz-border-radius-topright n
	-moz-border-radius-bottomright n
	border-top-right-radius n
	border-bottom-right-radius n

include-box-shadow(horizontal, vertical, blur, spread, color)
	vendor('box-shadow', horizontal vertical blur spread color)

include-border-radius(radius)
	vendor('border-radius', radius)

vendor(prop, args)
	-webkit-{prop} args
	-moz-{prop} args
	-o-{prop} args
	-ms-{prop} args
	{prop} args

/* Styles */

html
	height 100%

body
	font-family 'Lato',sans-serif
	font-size 14px
	font-weight 400
	color rzp-gray

/* Header */

header
	position fixed
	// background rzp-blue
	background white
	border-bottom 1px solid rzp-gray
	color rzp-gray
	height 48px
	width 100%
	font-size 1.2em
	z-index 1000
	top 0
	include-box-shadow 0px 1px 2px 0px rgba(0, 0, 0, 0.1)
	#nav
		height 48px
		width 100%
		padding 5px 0 0 20px
		#logo img
			float left
			height 32px
		#centernav, #rightnav
			display inline
			list-style-type none
			li
				display inline
				list-style-type none
				padding 0 5px 0 5px
				position relative
		#centernav
			text-align center
		#rightnav
			text-align right
			li.button
				border solid 1px rzp-blue
				include-border-radius 4px
				padding 2px 0px 5px 0px
				a
					padding 8px
		ul a
			display inline-block
			text-decoration none
			color rzp-gray
			padding 8px 4px
			transition(0.1s)
			&:hover
				color black
				transition(0.1s)

/* Main */

#main
	margin-top 70px

.spaced-right-box
	padding-right 50px

.spaced-bottom-box
	margin-bottom 30px

.boxed
	border 1px solid rzp-gray

.hidden
	display none

.centered
	margin 0 auto

/* Live mode toggle */

#livemode
	min-height 70px
	text-align center
	padding 20px 0
	.active
		color rzp-blue
	.button-desc
		font-size 1.3em
		height 26px
		display inline-block
		margin 0 20px
		padding-top 3px
	.button-wrap
		width 45px
		cursor pointer
		display inline-block
		vertical-align top
	.button-bg
		width 100%
		height 26px
		background-color #FFF
		border-radius(40px)
		border 1px solid rzp-gray
		color #fff
		transition all 0.2s ease
	.button-switch
		transition all 0.2s ease
		position relative
		left 0px
		width 12px
		height 12px
		border solid 12px rzp-blue
		border-radius(12px)
		transition(0.2s)
	.button-active .button-switch
		left 19px


/* Sidebar */

#sidebar
	padding 10px 0 30px 0
	min-height 300px
	h3
		border-bottom 1px solid rzp-gray
		font-weight 300
		.title
			display inline-block
			position relative
			top 9px
			background #fff
			padding 0 5px
			margin-left 15px
	ul
		margin 10px 0
		li
			margin 5px 0
			font-size 1.2em
			color rzp-blue
			border-bottom 2px solid transparent
			a
				margin-left 30px
				padding 0 5px
				position relative
				top 9px
				text-decoration none
				color inherit
		li:hover
			border-bottom 1px solid rzp-blue
			padding-bottom 1px
			a
				background #FFF
		.active
			font-weight 400
			border-bottom 2px solid rzp-blue
			&:hover
				padding-bottom 0px
				border-bottom 2px solid rzp-blue
			a
				background #fff

/* Dashboard */

#dashboard-wrapper
	min-height 700px
	border 1px solid rzp-blue

#transactions-line-chart-wrapper
	padding 20px 30px
	#transactions-line-chart
		margin-top 50px
		min-height 250px

#count-line-chart-wrapper
	padding 20px 30px
	margin-bottom 30px
	min-height 250px

#controls-wrapper
	h2,div
		display inline-block
	h2
		font-size 1.7em
	#datepicker-group
		text-align right
	.datepicker
		height 25px
		width 80px
		margin 0 10px
		text-align center
		color rzp-gray
		font-family 'Lato',sans-serif
	.datepicker:focus
		border 1px solid rzp-blue
		outline 0
	.btn-group
		margin 5px 0 0 0
		.btn
			border 1px solid rzp-gray
			padding 5px 10px
			cursor pointer
			margin 0 -3px 0 0
			border-right 0
		#interval-day
			border-radius-left(3px)
		#interval-year
			border-right 1px solid rzp-gray
			border-radius-right(3px)
			-webkit-border-top-right-radius 3px
			-webkit-border-bottom-right-radius 3px
		.btn.active
			background-color rzp-gray
			color white

.horizontal-data-wrapper
	min-height 120px
	border-bottom 1px solid rzp-blue
	background-color rzp-blue
	color white
	.data-item
		display inline-block
		text-align center
		margin 30px 0
		.data-item-value
			font-size 2em
			line-height 1.5
		.data-item-desc
			font-size 1.3em

/* Transactions */

.list-wrapper
	padding 0 40px 0 30px
	h2
		font-weight 300

#refunds .list-wrapper, #settlements .list-wrapper
	padding-top 30px

.transaction-list
	margin-top 20px
	li
		padding 0 10px
		font-size 1.3em
		a
			span
				margin 7px 0
			color rzp-gray
			text-decoration none
			.amount
				font-weight 400
			.status
				text-align right
			.date
				text-align right
		a:hover
			text-decoration none
	li:hover
		background-color rzp-light-gray

#transaction-one
	margin 30px;
	h2
		font-size 2.2em
		font-weight 300
	.details
		margin-top 30px
		.key
			font-weight 400
		div
			font-size 1.3em
			padding 3px 0

/* Account */

.account-details
	padding 30px
	font-size 1.3em
	div
		padding 5px 0

/* Keys */

.keys-heading
	padding 30px
	text-transform: capitalize

.key-wrapper
	padding 30px
	font-size 1.3em
	li
		margin 5px
	.field
		text-align left
		width 150px
	.field, .value
		display inline-block
	a
		cursor pointer
	.roll-icon
		height 20px
		margin-left 20px
		opacity 0.7
		&:hover
			opacity 1

.roll-key-form-wrapper
	background-color rzp-blue
	padding 20px 30px
	font-weight 400
	color rzp-light-gray
	.close-button
		float right
		img
			cursor pointer
			height 20px
	div
		margin-bottom 10px
	span
		margin 0 10px
	.roll-key-button
		margin-top 15px
		width 10%
		background-color white
		outline none
		border 0
		color rzp-blue
		font-family 'Lato',sans-serif
		padding 5px 0
		cursor pointer
	.roll-key-form-loader
		margin-left 10px
	a
		color white


/* Loader */

.spinner
	margin 100px auto
	width 50px
	height 30px
	text-align center
	font-size 10px

.spinner > div
	background-color rzp-blue
	height 100%
	width 6px
	display inline-block
	-webkit-animation stretchdelay 1.2s infinite ease-in-out
	animation stretchdelay 1.2s infinite ease-in-out

.spinner .rect2
	-webkit-animation-delay -1.1s
	animation-delay -1.1s

.spinner .rect3
	-webkit-animation-delay -1.0s
	animation-delay -1.0s

.spinner .rect4
	-webkit-animation-delay -0.9s
	animation-delay -0.9s

.spinner .rect5
	-webkit-animation-delay -0.8s
	animation-delay -0.8s

@-webkit-keyframes stretchdelay
	0%, 40%, 100%
		-webkit-transform scaleY(0.4)
	20%
		-webkit-transform scaleY(1.0)

@keyframes stretchdelay
	0%, 40%, 100% 
		transform scaleY(0.4)
		-webkit-transform scaleY(0.4)
	20%
		transform scaleY(1.0)
		-webkit-transform scaleY(1.0)

/* Login */

.form-wrapper
	margin-top 100px
	width 500px
	min-height 340px
	border-radius(5px)
	.error-message
		color rzp-red
	.success-message
		color rzp-green
	.error-message, .success-message
		font-size 1.3em
		text-align center
	p.message
		margin 20px 0
		font-size 1.3em
		text-align center
		a
			text-decoration none
			color rzp-blue
	.credentials
		padding 10px
		font-family 'Courier'
		font-size 1em
		div
			display inline-block
			margin 5px 0
		.key
			width 30px
			text-align right
			margin-right 20px
	h2
		color black
		text-align center
		font-size 2.2em
		font-weight 300
		padding 12px 0
	form
		padding 7px 0 20px
		.text
			input
				width 70%
				display block
				outline none
				border 0
				border-bottom 1px solid rzp-gray
				color rzp-blue
				padding 5px 0
				line-height 1.1em
				margin 10px auto
		a, .text>input
			font-size 1.3em
			font-family 'Lato',sans-serif
		a
			margin 5px auto
			text-decoration none
			color rzp-gray
			&:hover
				text-decoration none
			&:focus
				outline none
			&:focus, &:hover
				color black
		.row
			width 70%
			height 20px
			margin 30px auto
		.remember
			label
				font-size 1.3em
				font-family 'Lato', sans-serif
				color rzp-blue
			input[type="checkbox"]
				background-color rzp-blue
				outline none
				border 0
				margin-right 5px
		.forgot-wrap
			text-align right
		#form-button
			display block
			margin 30px auto 5px
			width 70%
			background-color rzp-blue
			border-radius(3px)
			outline none
			border 0
			color white
			font-family 'Lato',sans-serif
			font-size 1.3em
			height 35px
			padding 5px 0
			cursor pointer
	.form-footer
		padding 15px
		text-align center
		.footer-text
			margin 0 auto
			font-size 1.3em
			a
				text-decoration none
				color rzp-blue

/* Activation */

.activation-form-wrapper
	margin-top 30px
	width 700px
	min-height 340px
	border-radius(5px)
	#activation-form
		padding 7px 0 20px
		a, .text>input
			font-family 'Lato',sans-serif
		a
			margin 5px auto
			text-decoration none
			color rzp-gray
			&:hover
				text-decoration none
			&:focus
				outline none
			&:focus, &:hover
				color black
		.prev-next
			display block
			outline none
			border 0
			color rzp-blue
			padding 5px 0
			line-height 1.3em
			text-align center
			margin 40px auto 50px auto
			.prev
				float left
			.next
				float right
	.form-footer
		padding 15px
		text-align center
		.footer-text
			margin 0 auto
			font-size 1.6em
			a
				text-decoration none
				color rzp-blue

/*progressbar*/

ol.steplist
	margin 0
	padding 0
	list-style-type none
	font-size 12px
	li
		display inline-block
		text-align center
		line-height 3em
		width 16.6% 
	li:before
		content "\00a0\00a0"
	li:after
		position relative
		bottom -2.5em
		float left
		left 50%
		line-height 1em

ol.progtrckr
	margin 0
	padding 0
	list-style-type none
	font-size 12px
	li
		display inline-block
		text-align center
		line-height 3em
		width 16.66% 
	li:before
		content "\00a0\00a0"
	li:after
		position relative
		bottom -2.5em
		float left
		left 50%
		line-height 1em
	li.progtrckr-done
		color black
		border-bottom 4px solid yellowgreen
	li.progtrckr-done:after
		content "\2713"
		color white
		background-color yellowgreen
		height 1.2em
		width 1.2em
		line-height 1.2em
		border none
		border-radius 1.2em
	li.progtrckr-todo
		color silver 
		border-bottom 4px solid silver
	li.progtrckr-todo:after
		content "\039F"
		color silver
		background-color white
		font-size 1.5em
		bottom -1.6em
	li.progtrckr-current
		color black 
		border-bottom 4px solid rzp-blue
	li.progtrckr-current:after
		content "\2600"
		color white
		background-color rzp-blue
		height 1.2em
		width 1.2em
		line-height 1.2em
		border none
		border-radius 1.2em
	li.progtrckr-error
		color black 
		border-bottom 4px solid red
	li.progtrckr-error:after
		content "\274C"
		color white
		background-color red
		height 1.2em
		width 1.2em
		line-height 1.2em
		border none
		border-radius 1.2em	
