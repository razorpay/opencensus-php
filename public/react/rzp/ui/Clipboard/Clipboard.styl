.Clipboard {
  .form-control {
    background-color: #fff;
  }

  .input-group-addon {
    cursor: pointer;
    background-color: #fff;
    font-weight: bold;
    color: #7266ba;
    border-left-color: transparent;
  }
}

.Clipboard--unsupported {
  width: 100%;
}

.Clipboard__CustomInput {
  width: 0px;
  height: 0px;
  position: absolute;
  left: -9999px
}
