$borderColor = #EAEFF0;

.rzp-legend-item {

  display: block;
  position: relative;

  .rzp-legend-item-inner {

    width: 100%;
    display: block;
    position: relative;
    border: 1px solid $borderColor;

    > div {

      display: inline-block;
      vertical-align: middle;

      &.rzp-legend-label {

        padding: 3px 5px;
        margin: -1px;
        color: white;
      }

      &.rzp-legend-title, &.rzp-legend-content {

        padding-left: 10px;
        padding-right: 10px;
      }

      &.rzp-legend-title {

        border-right: 1px solid $borderColor;
      }
    }
  }
}
