.LoaderDots span {
  font-size: 48px;
  color: #999;
  animation-fill-mode: both;
  animation: fadeOut 1s infinite ease-in-out;
}

.LoaderDots span:nth-child(2) {
  animation-delay: .2s;
}

.LoaderDots span:nth-child(3) {
  animation-delay: .4s;
}

@keyframes fadeOut {
  0% { opacity: .2; }
  20% { opacity: 1; }
  100% { opacity: .2; }
}
