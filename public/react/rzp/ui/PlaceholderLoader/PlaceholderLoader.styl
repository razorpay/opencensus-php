.PlaceholderLoader {
  position: relative;
  background: #f6f7f8 no-repeat 800px 104px;
  background-image: linear-gradient(to left, #f6f7f8 0%, #edeef1 20%, #f6f7f8 40%, #f6f7f8 100%);
  height: 14px;
  margin-bottom: 6px;
  animation: phLoader 1.5s forwards infinite linear;
}

@keyframes phLoader {
  0% {
    background-position:-300px 0;
  }
  100%{
    background-position:300px 0;
  }
}
