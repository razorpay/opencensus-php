@import '../../../../styles/rzp/vars.styl'

.RadioButton{
  margin: 16px 0;

  label {
    padding-left: 0;
    font-weight: normal;
    display: block;
  }

  input {
    display: none;

    &:checked + div {
      .RadioButton__button {
        &:before {
          opacity: 1;
          transform: rotate(42deg) translate(8px, -3px) scale(1);
        }
      }
    }
  }

  &__button {
    width: 24px;
    height: @width;
    background: #f5f5f5;
    border: 1px solid #E0E0E0;
    border-radius: 4px;
    float: left;

    &:before {
      content: '';
      position: absolute;
      width: 6px;
      height: 14px;
      border: 2px solid $primary-color;
      border-top: 0;
      border-left: 0;
      opacity: 0;
      transition: 0.2s;
      transform: rotate(42deg) translate(8px, -3px) scale(0.4);
    }
  }

  &__label {
    padding-left: 32px;
    line-height: 24px;
  }
}
