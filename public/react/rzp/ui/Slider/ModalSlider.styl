$slider-width = 500px

.close-secondary {
  display: none;
}

.ModalSlider__Overlay.ReactModal__Overlay {
  width: $slider-width;
  position: fixed;
  top: 51px;
  left: 100%;
  margin-left: - $slider-width;
  bottom: 0;
  box-shadow: 0 0 10px 0 rgba(0,0,0,0.1);
  transform: translateX(90%);
  transition: .3s, .24s opacity;
  z-index: 2;
  padding-bottom: 45px;

  @media (max-width: 650px) {
    max-width: 92%;
    width: 100%;
  }

  &.ReactModal__Overlay--after-open {
    transform: none;
  }

  &.expanded {
    transform: translateX(-100%);
    .content-wrapper {
      &:first-child {
        .panel, .panel-heading {
          background-color: #FAFAFA;
        }
      }
    }
  }
  .close-secondary {
    left: 200%;
    display: block;
  }

  &.ReactModal__Overlay--before-close {
    opacity: 0;
    transform: translateX(100%);
  }
}

.ModalSlider__Content {
  min-height: 100%;
  transform: none;

  button.close {
    padding: 10px;
    position: absolute;
    top: 16px;
    margin-left: -53px;
    left: 100%;
    z-index: 2;
  }

  .content-wrapper {
    max-width: none
    margin: 0
    min-height: 0;
    padding: 0
    position: absolute
    top: 0
    bottom: 0
    background: #fff
    width: $slider-width
    &+.content-wrapper {
      left: 100%;
    }
  }

  .SliderPanel__Body {
    > .panel-body {
      padding-bottom: 80px;
    }
  }
}

.SliderPanel__Body {
  .empty-table-message {
    padding: 30px 50px;
  }
}

.ReactModal__Content--after-open {
  .SliderPanel .panel-heading > .btn-toolbar {
    padding-right: 35px;
  }
}
