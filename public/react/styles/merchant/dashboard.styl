.Dashboard {
  .h1, h4 {
    margin: 0;
    font-weight: 300;
  }

  .panel {
    box-shadow: 0 1px 1px rgba(0,0,0,.05);
  }
}

.InfoCard {
  padding-top: 15px;
  padding-bottom: 15px;

  .LoaderDots span {
    font-size: 28px;
  }
}

.InfoCard__value {
  height: 36px;
  line-height: 36px;
}

.InfoCard__label {
  font-size: 12px;
  color: rgb(214, 211, 230);
}

.WidgetContainer {
  height: 304px;
  margin-bottom: 20px;

  h4 {
    margin-bottom: 10px;
  }

  .panel,
  .panel-body {
    height: 100%;
    position: relative;
  }

  &.Transaction__Vol {
    margin-right: 30%;
    @media (max-width $screen-sm-min) {
      margin-right: 0;
    }
  }

  &.Transaction__Types {
    display: inline-block;
    float: right;
    width: 30%;
    color: #58666e;
    @media (max-width $screen-sm-min) {
      width: 100%;
      float: none;
    }

    .panel-body {
      background-color: #e4eaec;
    }
  }
}

.RecentTxns .WidgetContainer {
  height: auto;

  .panel-body {
    min-height: 175px;
  }
}

.EntityTable {
  code {
    padding: 0;
  }
}

.upload-container {
  .row {
    margin: 32px 0;

    [class^='col-'] {
      text-align: center;
    }

    label {
      cursor: pointer;

      input[type=checkbox] {
        margin-left: 16px;
      }
    }
  }
}


// Onboarding Card

.onboarding-card.media {
  background-color: #fff;
  margin-bottom: 20px;
  box-shadow: 0 0 8px 0 rgba(0,0,0,0.16);
  border-radius: 2px;
  position: relative;
  min-height: 200px;

  .close {
    position: absolute;
    top: 16px;
    right: 16px;
    font-size: 18px;
  }

  > .media-left {
    vertical-align: middle;

    .media-object {
      width: 320px;
      min-height: 200px;
      max-height: 220px;
    }
  }

  > .media-body {
    padding: 24px 12px;
    max-width: 800px;
    min-height: 200px;

    p {
      margin-bottom: 16px;
    }

    ul.row {
      margin-bottom: 8px;
      padding-left: 30px;

      > li {
        padding-left: 0;
        margin-bottom: 8px;
      }
    }

    .btn-lg {
      padding-left: 12px;
      font-size: 14px;
      border-radius: 2px;

      > span {
        margin-right: 48px;
      }
    }
  }

  .media-heading {
    font-size: 15px;
    font-weight: bold;
  }

  .Onboarding__Step {
    display: block;
    color: #58666e;
    box-shadow: 0 1px 1px 0 rgba(0,0,0,0.05);
    border-radius: 2px;
    background-color: #FAFAFA;
    padding: 14px;
    border: 1px solid #D8E1E3;

    a {
      text-decoration: underline;
      color: inherit;
    }

    .icon-external-link {
      font-size: 100%;
    }

    .media-heading {
      margin-bottom: 2px;
    }

    .media-body {
      font-size: 13px;
    }

    .media-object {
      width: 53px;
      height: 42px;
    }

    .activation-progress {
      width: 75px;
      display: inline-block;
      margin-left: 12px;

      .progress {
        height: 8px;
        border-radius: 2px;
        background-color: #e4e9ea;
        margin-bottom: 0;
      }
    }
  }
}
