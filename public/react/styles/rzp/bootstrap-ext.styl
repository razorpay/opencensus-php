.form-control,
.form-control:focus {
  box-shadow: none;
}

.table > thead > tr > th {
  background-color: #eaeff0;
  border-bottom: 1px solid #ddd;
}

.table > thead:first-child > tr:first-child > th {
  border-top: 1px solid #ddd;
}

a:hover,
a:focus,
a.active {
  text-decoration: none;
}

code {
  color: inherit;
  background-color: inherit;
}

.text-danger {
  color: $textDangerColor;
}

.text-success {
  color: $brand-success;
}

.bg-light {
  color: #58666e;
  background-color: #edf1f2;
}


.modal-header .close {
  margin: 3px;
}

.form-control[type='number'] {
  padding-right: 0;
}

.label-muted {
  background-color: #999;
}

.checkbox label.i-switch {
  padding-left: 0;
}

.nav-tabs > li.active,
.nav-tabs > li {
  > a.text-success {
    color: #23ad44;
  }

  > a.text-danger {
    color: $textDangerColor;
  }
}

.dropdown-menu {
  margin-top: 0;
  border-radius: 0;
}
