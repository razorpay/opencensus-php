// Only page layout styles should reside in this file.
// This will be moved under `rzp` later

html, body {
  background-color: #f0f3f4;
}

body {
  -webkit-font-smoothing: antialiased;
}

*:focus {
  outline: 0 !important;
}

.btn {
  .fa + span {
    margin-left: 5px;
  }
}

.main-content {
  margin-left: 200px;
  margin-top: 51px;
}

.sidebar {
  position: fixed;
  top: 0;
  bottom: 0;
  background-color: #3a3f51;
  width: 200px;

  .brand-logo {
    > a {
      display: block;
      line-height: 50px;
      text-align: center;

      > img {
        max-width: 145px;
        max-height: 40px;
        display: inline-block;
      }
    }
  }

  .nav > a {
    border-left: 4px solid transparent;
    color: #b4b6bd;
    display: block;
    line-height: 40px;
    padding: 0 20px;

    &:hover, &:focus {
      background-color: #32374a;
    }

    &.active {
      border-color: #586DD1;
      color: #fff;
      background-color: #2e3344;
    }
  }
}

.navbar-fixed-top {
  margin-left: 200px;
  margin-bottom: 0;
  border-bottom: 0;
  background-color: #fff;
  box-shadow: 0 2px 2px rgba(0, 0, 0, 0.05), 0 1px 0 rgba(0, 0, 0, 0.05);
}

.navbar-default .navbar-nav {
  .dropdown > a.dropdown__trigger {
    display: inline-block;
    color: #777;
    cursor: pointer;
    padding: 15px;

    &:hover {
      text-decoration: none;
    }
  }
}

.dropdown--active > .dropdown__content > .dropdown-menu {
  display: block;
}

.react-root {
  ::-webkit-input-placeholder { /* WebKit, Blink, Edge */
    color: #aaa;
  }
  :-moz-placeholder { /* Mozilla Firefox 4 to 18 */
   color: #aaa;
  }
  ::-moz-placeholder { /* Mozilla Firefox 19+ */
   color: #aaa;
  }
  :-ms-input-placeholder { /* Internet Explorer 10-11 */
    color: #aaa;
  }

  h3, h2 {
    margin: 0;
  }

  h3 {
    font-weight: bold;
    font-size: 20px;
  }

  .alert {
    > ul > li {
      line-height: 2;
    }
  }

  input[type='color'] {
    padding: 0 3px;
  }
}

.content-wrapper {
  padding: 30px 20px;
}

.content-sm {
  max-width: 800px
}

// React Modal Style Overrides

body.ReactModal__Body--open {
  overflow: hidden;
}

.ReactModal__Content h4 {
  margin: 0;
}


.ReactModal__Content {
  transition: transform 300ms ease-in-out;
  transform: translateY(-15%);

  &--after-open {
    transform: translateY(0);
  }
  &--before-close {
    transform: translateY(-15%);
  }
}

.ModalSlider__Overlay.ReactModal__Overlay {
  width: 600px;
  position: fixed;
  top: 51px;
  right: 0;
  bottom: 0;
  left: auto;
  box-shadow: 3px 11px 22px -1px #3a3f51;
  transform: translateX(90%);
  transition: transform 300ms linear;
  z-index: 9998;
  background-color: #fff;
  overflow: auto;
  padding-bottom: 45px;

  &.ReactModal__Overlay--after-open {
    transform: translateX(1%);
  }

  &.ReactModal__Overlay--before-close {
    opacity: 1;
    transform: translateX(90%);
  }
}

.ModalSlider__Content {
  padding: 20px 10px;
  min-height: 100%;
  transform: none;
}

.ReactModalPortal > * {
  // When the modal is closed, overlay div has no css class
  // This selector should be overridden by the `&--after-open` class below
  opacity: 0;
}

.ReactModal__Overlay {
  transition: opacity 250ms ease-in-out;
  opacity: 0;

  &--after-open {
    opacity: 1;
  }
  &--before-close {
    opacity: 0;
  }
}

.Modal .modal-body > .alert-dismissable {
  margin-left: -24px;
  margin-right: -24px;
}

.Modal {
  .form-group > label {
    font-weight: bold;
  }
}


// react-dates style overrides

.SingleDatePicker {
  display: block;
}

.SingleDatePickerInput {
  border-color: #cfdadd;
}

.SingleDatePicker__tether--show {
  top: -11px !important;
}

.SingleDatePicker__picker {
  top: 45px;
}

.DateInput__input {
  cursor: pointer;
}

.DateInput {
  font-weight: inherit;
  font-size: 14px;
  padding: 0;
  width: 100%;
}

.DateInput--disabled {
  background-color: #eee;
}

.DateInput__display-text {
  color: #aaa;
  font-size: 12px;
}

.DateInput__display-text--disabled {
  font-style: normal;
}

.DateInput__display-text--focused {
  background-color: #fff;
  border-color: inherit;
  color: inherit;
}

.DateInput__display-text--has-input {
  color: #555;
}

.DateInput--with-caret::before {
  top: 34px;
}

.DateInput--with-caret::after {
  top: 35px;
}

.DateRangePicker__picker--valid-date-hovered .CalendarMonth__day--selected-start,
.DateRangePicker__picker--valid-date-hovered .CalendarMonth__day--selected-end,
.CalendarMonth__day--selected-start,
.CalendarMonth__day--selected-end,
.CalendarMonth__day--selected {
  background-color: #23b7e5;
  border-color: #23b7e5;
}

// End of third party style overrides

.page-spinner-container {
  display: flex;
  height: 350px;

  .spinner {
    margin: auto;
  }
}

.modal-body .page-spinner-container {
  height: 150px;
}

.quick-create {
  padding: 2px 5px;
  background-color: rgba(195, 195, 195, 0.23);
  color: #337ab7;
  cursor: pointer;
  font-size: 12px;
}

.row-action > .btn-group {
  visibility: hidden;
}

tr:hover .row-action > .btn-group {
  visibility: visible;
}

.panel-detail-container {
  .text-warning {
    color: #d8b617;
  }
}

.details-row-container {
  .list-group-item {
    .table > tbody > tr > td.empty-table {
      padding: 20px;
      border-top: 0;
    }

    &:not(.no-flex) {
      display: flex;
      justify-content: space-between;
    }
  }
}

.form-horizontal .control-label.label-required::after {
  right: 7px;
  top: 7px;
}

.btn-group > .tooltip-wrapper {
  display: inline-block;
}
