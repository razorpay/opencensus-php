// i-switch checkbox

.i-switch {
  position: relative;
  display: inline-block;
  width: 35px;
  height: 20px;
  margin: 0;
  cursor: pointer;
  background-color: #27c24c;
  border-radius: 30px;
}

.i-switch input {
  position: absolute;
  opacity: 0;
}

.i-switch input:checked + i:before {
  top: 50%;
  right: 5px;
  bottom: 50%;
  left: 50%;
  border-width: 0;
  border-radius: 5px;
}

.i-switch input:checked + i:after {
  margin-left: 16px;
}

.i-switch i:before {
  position: absolute;
  top: -1px;
  right: -1px;
  bottom: -1px;
  left: -1px;
  background-color: #fff;
  border: 1px solid #f0f0f0;
  border-radius: 30px;
  content: "";
  -webkit-transition: all 0.2s;
          transition: all 0.2s;
}

.i-switch i:after {
  position: absolute;
  top: 1px;
  bottom: 1px;
  width: 18px;
  background-color: #fff;
  border-radius: 50%;
  content: "";
  -webkit-box-shadow: 1px 1px 3px rgba(0, 0, 0, 0.25);
          box-shadow: 1px 1px 3px rgba(0, 0, 0, 0.25);
  -webkit-transition: margin-left 0.3s;
          transition: margin-left 0.3s;
}

// Tooltip

[data-tip] {
  position: relative;
  &[data-place=bottom] {
    &:before, &:after {
      bottom: auto;
      top: 100%;
      transform: translateX(-50%) translateY(-6px) scale(.92);
      border-bottom-color: #222;
      border-top-color: transparent;
    }
  }

  &[data-place=right] {
    &:after {
      left: auto;
      right: 0;
      transform: translateY(6px) scale(0.92);
    }
  }

  &[data-place=left] {
    &:after {
      left: 0;
      transform: translateY(6px) scale(0.92);
    }
  }

  &:before, &:after {
    opacity: 0;
    transform: translateX(-50%) translateY(6px) scale(.92);
    left: 50%;
    bottom: 100%;
    position: absolute;
    pointer-events: none;
    z-index: 1000;
    transition: .17s, .3s transform;
  }
  &:before {
    content: '';
    border: 7px solid transparent;
    border-top-color: #222;
    margin: -7px 0 -7px;
  }
  &:after {
    margin: 6px 0 6px;
    content: attr(data-tip);
    padding: 4px 12px;
    background: #222;
    border-radius: 3px;
    color: #fff;
    font-weight: normal;
    font-size: 14px;
    line-height: 20px;
    white-space: nowrap;
  }
  &:not([data-event]):hover,
  &[data-event=active]:active
  {
    &:before, &:after {
      opacity: 1;
      transform: translateX(-50%);
    }

    &[data-place=right], &[data-place=left]{
      &:after {
        transform: none;
      }
    }
  }
  &[data-event=active] {
    &:active {
      &:after, &:before {
        transition: 0s;
      }
    }
    &:after, &:before {
      transition-delay: 2s;
    }
  }
}

// Small Alert
.alert-sm {
  padding: 6px 8px;
  font-size: 12px;
}

// Required indicator in form labels
.label-required {
  position: relative;

  &::after {
    content: '*';
    position: absolute;
    top: 0;
    right: -10px;
    color: #e68686;
  }
}


// List Filter Container for search
.list-filter-container {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-start;
  margin: 0 -25px 15px -25px;
}

.list-filter-item {
  flex: 1;
  flex-basis: 185px;
  flex-grow: 0;
  margin-left: 25px;

  &.count {
    flex-basis: 70px;
  }

  &.btn-toolbar {
    margin-top: 25px;
    flex-basis: initial;

    > .btn:first-child {
      margin-left: 0;
    }
  }
}

// Status label for transactions
.status-label {
  display: inline-block;
  min-width: 78 px;
  font-size: 12px;
  padding-top: 5px;
  padding-bottom: 5px;
  border-radius: 20px;
}


.label-draft {
  background-color: #ccc;
  color: #fff;
}

.breadcrumb__backNav {
  padding: 0;
  background-color: transparent;
  margin-bottom: 16px;
}

.breadcrumb__backNav--heading {
  display: inline-block;
}

a.breadcrumb__backNav--link {
  color: #7266ba;
}

.breadcrumb > li + li {
  padding-left: 16px;
  position: relative;
  line-height: 24px;

  &:before {
    content: '';
    display: block;
    height: 24px;
    border-left: 1px solid rgba(0, 0, 0, 0.54);
    position: absolute;
    left: 0;
    bottom: -2px;
    transform: rotate(24deg)
  }
}

.rzpCheckbox {
  margin-bottom: 8px;

  [type='checkbox']:not(:checked), [type='checkbox']:checked {
    position: absolute;
    left: -9999px;

    + label {
      position: relative;
      padding-left: 25px;
      cursor: pointer;

      &::before {
        content: '';
        width: 20px;
        height: 20px;
        border: 1px solid #e0e0e0;
        border-radius: 2px;
        background-color: #fff;
        display: inline-block;
        position: absolute;
        left: 0;
      }

      &::after {
        content: "\E009";
        color: #7266ba;
        position: absolute;
        line-height: 1.3;
        top: 1px;
        left: 3px;
        transition: opacity 0.2s ease-out;
        font-weight: 600;
        font-family: "icons";
      }
    }
  }

  // Customer css for submit-form as label can have text as well
  &.submit-form {
    [type='checkbox']:not(:checked), [type='checkbox']:checked {
      + label {
        padding-left: 30px;
        user-select: none;

        &::before {
          top: 3px;
        }

        &::after {
          top: 4px;
        }

      }
    }
  }

  [type='checkbox']:not(:checked) + label::after {
    opacity: 0
  }

  [type='checkbox']:checked + label::after {
    opacity: 1
  }

  [type='checkbox']:disabled + label {
    cursor: not-allowed;
  }
}

@keyframes luminate {
  0% {
    background-color: rgba(251, 251, 157, 0.75)
  }

  75% {
    background-color: rgba(251, 251, 157, 0.5)
  }

  100% {
    background-color: transparent
  }
}

.table > tbody > tr.luminate > td {
  animation: luminate 4s linear;
}


// Dot near the mode in header nav
.ModeIndicator {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  display: inline-block;
  margin-right: 4px;
}

.ModeIndicator--test {
  background-color: #FFBB00;
}

.ModeIndicator--live {
  background-color: #27c24c;
}

.centered {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%)
}

.block-radio-group {
  .list-group-item {
    padding: 0;

    input[type="radio"] {
      display: none;
    }

    input[type="radio"]:checked + label {
      background-color: #fffaea;

      .fa-check {
        color: #0b5;
      }
    }

    input[type="radio"]:disabled + label {
      background: #F7F8FA;
      color: #CCC;
      cursor: not-allowed;
    }

    > label {
      display: block;
      margin: 0;
      padding: 9px 16px;
      cursor: pointer;
      transition: background-color 0.2s;
    }

    .fa-check {
      color: #f1f1f1;
      line-height: 22px;
      tranistion: 0.3s;
    }
  }
}

