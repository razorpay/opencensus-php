.keymetrics.react-tabs {

  > .nav.nav-tabs {

    li {

      padding-bottom: 0;
      display: inline-block;

      &.active > a , &:hover > a {

        background-color: transparent;
        border: none;
      }

      &.active > a > div {

        background-color: #ffffff;
        border: 1px solid #ffffff;
        color: #4C58C7;

        > h1 {

          color: #2D3042;
        }

        > span .PlaceholderLoader {

          /* blue gradient for active tab*/
          background: #c5c9ed;
          background: linear-gradient(to right, #c5c9ed 0%, #9ea5e0 10%,  20%);
        }
      }

      > a {

        border: none;
        padding: 0;
        text-align: left;
        color: #686D87;
        &:hover {

          padding-left: 0;
        }

        > div {

          padding: 21px 24px;
          box-shadow: 0 0 3px rgba(0, 0, 0, 0.1);

          > h1 {

            font-weight: 300;
            color: #2D3042;
            margin-top: 0;
            margin-bottom: 8px;
            line-height: 1;

            > .PlaceholderLoader {

              width: 20%;
            }
          }
        }

        .PlaceholderLoader {

          height: 1em;
        }
      }
    }
  }

  div.panel-body {

    display: table;
    width: 100%;
    height: 250px;

    div.panel-body-content {

      display: table-cell;
      vertical-align: bottom;
    }
  }

  div.chart-container {

    margin-top: 23px;
    height: 165px;
  }

  .rzp-legend {

    padding-top: 8px;
  }
}

#chartjs-tooltip {

  position: fixed;
  width: 248px;
  z-index: 999;
  padding-bottom: 10px;
  transition: left 0.25s ease, top 0.25s ease;
  margin-left: -124px;

  .custom-tooltip-inner {

    position: relative;
    width: 100%;
    background-color: #FFF;
    box-shadow: 0 0 50px #CCC;
    padding: 14px;

    .sec-text {

      color: #8991AE;
    }

    .tooltip-title {

      line-height: 20px;
      margin-bottom: 16px;

      .tooltip-amount {

        font-weight: bold;
      }

      .tooltip-date {

        font-size: 10px;
        line-height: 1.3;
      }

      .ex-link {

        color: #4c58c7;

        > svg {

          display: block;
          width: 13px;
          height: 13px;

          > path {

            fill: currentColor;
          }
        }
      }
    }

    .tooltip-body {
      text-align: left;
      font-size: 12px;

      .tooltip-row {

        margin-top: 10px;

        &:first-child {

          margin-top: 0;
        }
      }

      .label-icon {

        display: block;
        width: 1em;
        height: 1em;
        float: left;
      }

      .label {

        margin-left: 10px;
        display: block;
        padding: 0;
        font-size: 100%;
        float: left;
        line-height: 1;
        font-weight: normal;
      }

      .label-value {

        float: right;
        line-height: 1;
      }
    }

    .caret {
      width: 0;
      height: 0;
      border-left: 10px solid transparent;
      border-right: 10px solid transparent;

      border-top: 10px solid #FFF;
      position: absolute;
      left: 50%;
      top: 100%;
      z-index: 2;
    }

    .cross-hair {

      width: 2px;
      position: absolute;
      left: 50%;
      top: 100%;
      margin-left: -1px;
      background-color: rgb(255, 255, 255);
      z-index: 1;
      display: none;
    }
  }
}
