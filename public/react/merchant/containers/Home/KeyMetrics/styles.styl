.keymetrics.react-tabs {

  > .nav.nav-tabs {

    li {

      padding-bottom: 0;
      display: inline-block;

      &.active > a , &:hover > a {

        background-color: transparent;
        border: none;
      }

      &.active > a > div {

        background-color: #ffffff;
        border: 1px solid #ffffff;
        color: #4C58C7;

        > h1 {

          color: #2D3042;
        }

        .PlaceholderLoader {

          /* blue gradient for active tab*/
          background: #c5c9ed;
          background: linear-gradient(to right, #c5c9ed 0%, #9ea5e0 10%,  20%);
        }
      }

      > a {

        border: none;
        padding: 0;
        text-align: left;
        color: #686D87;
        &:hover {

          padding-left: 0;
        }

        > div {

          padding: 21px 24px;
          box-shadow: 0 0 3px rgba(0, 0, 0, 0.1);

          > h1 {

            font-weight: 300;
            color: #2D3042;
            margin-top: 0;
            margin-bottom: 8px;
            line-height: 1;

            > .PlaceholderLoader {

              width: 20%;
            }
          }
        }

        .PlaceholderLoader {

          height: 1em;
        }
      }
    }
  }

  div.chart-container {

    margin-top: 50px - 21px;
    height: 165px;
  }
}

#chartjs-tooltip {

  position: fixed;
  width: 218px;
  z-index: 10000;
  padding-bottom: 10px;
  transition: left 0.25s ease, top 0.25s ease;
  margin-left: -109px;

  .custom-tooltip-inner {

    position: relative;
    width: 100%;
    background-color: #FFF;
    box-shadow: 0 0 50px #CCC;
    padding: 6px;

    .tooltip-body {
      text-align: left;

      .title {

        color: #252939;
      }

      .label-icon {

        padding: 1px 8px;
      }

      .label {

        color: #8991AE;
      }

      .label-value {

        color: #252939;
        float: right;
      }
    }

    .caret {
      width: 0;
      height: 0;
      border-left: 10px solid transparent;
      border-right: 10px solid transparent;

      border-top: 10px solid #FFF;
      position: absolute;
      left: 50%;
      top: 100%;
      z-index: 2;
    }

    .cross-hair {

      width: 2px;
      position: absolute;
      left: 50%;
      top: 100%;
      margin-left: -1px;
      background-color: rgb(255, 255, 255);
      z-index: 1;
    }
  }
}
