.rzp-traffic {

  display: table;
  padding-top: 35px;
  width: 100%;

  .panel-actions {

    position: absolute;
    top: 10px;
    left: 0;
    padding-right: 10px;
    width: 100%;
  }

  > div.row {

    display: table-cell;
    height: 100%;
    vertical-align: middle;

    .column {
      height: 100%;
    }
  }

  .chart-container  > .chart-content {

    display: table;

    .chart , .rzp-legend {

      display: table-cell;
      vertical-align: middle;
    }

    .chart {

      width: 60%;
    }

    .rzp-legend {

      width: 40%;
    }
  }
}
