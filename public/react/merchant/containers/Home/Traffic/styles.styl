$gutter = 21px;

.panel.rzp-traffic {

  display: table;
  padding-top: $gutter + 35px;
  width: 100%;

  div.panel-topbar {

    position: absolute;
    top: $gutter;
    left: 0;
    padding-right: $gutter;
    width: 100%;
  }

  div.panel-body {

    height: 252px; /* aligns with 6 recent items */

    > div.row {

      width: 100%;
      height: 100%;
      display: table;
      margin: 0;

      .column {
        display: table-cell;
        height: 100%;
        vertical-align: middle;
      }
    }

    .chart-container  > .chart-content {

      display: table;

      .chart , .rzp-legend {

        display: table-cell;
        vertical-align: middle;
      }

      .chart {

        width: 60%;
      }

      .rzp-legend {

        width: 40%;
      }
    }
  }
}
