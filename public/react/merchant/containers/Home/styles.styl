.dashboard-ctrl-bar {

  background-color: white;
  padding: 10px 20px;

  .breakdown-container {

    margin-left: -20px;

    > div {

      display: inline-block;
      margin-left: 20px;
    }
  }

  .RadioButton {

    margin-top: 0;
    margin-bottom: 0;
    padding: 6px 0;
  }
}

.header, .dashboard {

  background-color: #FAFBFC;
}

.dashboard {

  padding: 20px;

  .panel {

    position: relative;
    box-shadow: 0 2px 7px 0 rgba(0,0,0,0.1);
    padding-bottom: 45px;
    min-height: 300px;
   
    .panel-footer {

      position: absolute;
      top: 100%;
      left: 0;
      margin-top: -45px;
      width: 100%;
      background-color: #FBFCFD;
      padding-top: 0;
      padding-bottom: 0;
      color: #686D87;
      line-height: 44px;
      border-top: 1px solid #F0F1F6;
    }

    select.form-control {
      border-radius: 1px;
    }

    .panel-body {

      padding: 0;
      width: 100%;
      height: 100%;
    }
  }

  .react-tabs > .nav.nav-tabs {

    li {

      padding-bottom: 0;

      &.active > a , &:hover > a {

        background-color: transparent;
        border: none;
      }

      &.active > a > div {

        background-color: #ffffff;
        border: 1px solid #ffffff;
        color: #4C58C7;

        > h1 {

          color: #2D3042;
        }
      }

      > a {

        border: none;
        padding-left: 0;
        padding-bottom: 0;
        padding-right: 0;
        text-align: left;
        color: #686D87;
        &:hover {

          padding-left: 0;
        }

        > div {

          padding-right: 10px;
          padding-left: 24px;
          padding-top: 24px;
          padding-bottom: 15px;
          box-shadow: 0 0 3px rgba(0, 0, 0, 0.1);

          > h1 {

            font-weight: 300;
            color: #2D3042;
            margin-top: 0;
            margin-bottom: 8px;
          }
        }
      }
    }
  }

  div.panel-actions {

    .panel-action-item {

       display: inline-block;
       margin-left: 10px;

       &:first {

         margin-left: 0;
       }

       &.btn-group {

         .btn-default {

           border-radius: 1px;
           background-color: #FFF;
           border-color: #CFDADD;
         }

         .active {

           background-color: #FAFBFC;
           z-index: auto;
           color: #4C58C7;
           box-shadow: none;

         }
       }

       .more-options-button {

         div.option {

           padding: 0;

           > a {

             padding: 10px 15px;
             display: block;
             color: inherit;
           }
         }
       }
     }
  }

  div.key-metrics-container {

    .PlaceholderLoader {

      height: 1em;
    }

    div.chart-container {

      margin-top: 50px;
      height: 125px;
    }

    div.panel-topbar {

      padding: 14px;
    }

    &.panel {

      height: 384px;
    }
  }

  div.traffic-activity-row {

    display: flex;
    flex-flow: row wrap;
    align-items: stretch;

    &> div {

      width: 50%;
      display: block;
      position: relative;

      p.content-title {

        margin-bottom: 0;
        padding-bottom: 10px;
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
      }

      div.content {

        position: relative;
        width: 100%;
        height: 100%;
        padding-top: 30px;

        div.panel {

          height: 100%;

          &.rzp-traffic {

            display: table;
            padding-top: 35px;
            width: 100%;

            .panel-actions {

              position: absolute;
              top: 10px;
              left: 0;
              padding-right: 10px;
              width: 100%;
            }

            > div.row {

              display: table-cell;
              height: 100%;
              vertical-align: middle;

              .column {
                height: 100%;
              }
            }
          }
        }
      }

      &.traffic-container {

        padding-right: 10px;
      }

      &.activity-container {

        padding-left: 10px;
      }

      div.panel {

        margin-bottom: 0;
      }
    }
  }

  .rzp-overlay {

    background-color: rgba(255, 255, 255, 0.5);
  }
}

#chartjs-tooltip {

  position: fixed;
  width: 218px;
  z-index: 10000;
  padding-bottom: 10px;
  transition: left 0.25s ease, top 0.25s ease;
  margin-left: -109px;

  .custom-tooltip-inner {

    position: relative;
    width: 100%;
    background-color: #FFF;
    box-shadow: 0 0 50px #CCC;
    padding: 6px;

    .tooltip-body {
      text-align: left;

      .title {

        color: #252939;
      }

      .label-icon {

        padding: 1px 8px;
      }

      .label {

        color: #8991AE;
      }

      .label-value {

        color: #252939;
        float: right;
      }
    }

    .caret {
      width: 0;
      height: 0;
      border-left: 10px solid transparent;
      border-right: 10px solid transparent;

      border-top: 10px solid #FFF;
      position: absolute;
      left: 50%;
      top: 100%;
      z-index: 2;
    }

    .cross-hair {

      width: 2px;
      position: absolute;
      left: 50%;
      top: 100%;
      margin-left: -1px;
      background-color: rgba(255, 255, 255, 0.5);
      z-index: 1;
    }
  }
}
