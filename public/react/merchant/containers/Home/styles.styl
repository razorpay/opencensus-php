/* TODO: restructure this file */
$background-color = #FAFBFC;

.dashboard-home {

  > .rzp-sticky > .sticky-content {

    z-index: 2;
  }

  .header {

    background-color: $background-color;
  }
}

.dashboard {

  padding: 20px;
  background-color: $background-color;

  div.traffic-activity-row {

    display: flex;
    flex-flow: row wrap;
    align-items: stretch;

    &> div {

      width: 50%;
      display: block;
      position: relative;

      p.content-title {

        margin-bottom: 0;
        padding-bottom: 10px;
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
      }

      div.content {

        position: relative;
        width: 100%;
        height: 100%;
        padding-top: 30px;

        div.panel {

          height: 100%;

          div.panel-body {

            min-height: auto;
          }
        }
      }

      &.traffic-container {

        padding-right: 10px;
      }

      &.activity-container {

        padding-left: 10px;
      }

      div.panel {

        margin-bottom: 0;
      }
    }
  }
}
