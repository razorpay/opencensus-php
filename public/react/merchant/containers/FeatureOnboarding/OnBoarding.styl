.page-container {
  @media (max-width: 991px) {
    margin: 0 15px;
  }

  @media (min-width: 992px) {
    margin: 0 30px;
  }
}

.onboarding-container {
  position: relative;
  top: 36px;
  max-width: 1024px;
  margin: 0 auto 60px;
  border-radius: 4px;

  // Common for onboarding overview and form containers
  .onboarding-overview, .onboarding-form {
  //display: inline-block;
    vertical-align: top;
    padding: 36px;

  }
}

.onboarding-container.fullForm {
  box-shadow: 0 0 8px 0 rgba(0,0,0,0.1);
  background-color: #fff;
}

.onboarding-container.halfForm {
  .onboarding-overview {
    box-shadow: 0 0 8px 0 rgba(0,0,0,0.1);

    margin-left: 50%;
    transform: translateX(-50%);
  }
}


// overview container
.onboarding-overview {
  //width: 55%;
  border-right: 1px solid #dee5e7;
  background-color: #FAFAFA;
  z-index: 2;

  h2 {
    margin-bottom: 20px;
    font-size: 24px;
    font-weight: 800;
  }

  p {
    line-height: 24px;
  }

  .dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    margin: 0 4px;
    vertical-align: middle;
    border-radius: 50%;
    background-color: #bbc2c3;
  }

  .action-container {
    margin-top: 10px;

    button {
      margin-right: 20px;
      margin-top: 8px;
      margin-bottom: 8px;
    }

    .action-links {
      display: inline-block;
      margin-top: 10px;
    }

    a {
      vertical-align: middle;
    }
  }
}

// onboarding form container
.onboarding-form {
  //width: 45%;
  z-index: 1;

  h3 {
    margin-bottom: 20px;
    font-size: 18px;
    line-height: 26px;
  }

  p {
    line-height: 24px;
  }
}


.banner-figure {
  position: relative;
  margin: 60px auto 24px;

  &:before {
    content: '';
    width: 53%;
    padding-top: 55%;
    left: 14px;
    top: 0;
    position: relative;
    border-radius: 3px;

    z-index: 1;

    background-color: #feffff;
    border-left: 1px solid #dcf3ec;
    color: #dcf3ec;

    transform: rotateZ(45deg) skewX(-15deg) skewY(-16deg) translateX(23%) translateY(-18%) scale(0.96);
    box-shadow: 1px 1px 0, 2px 2px 0, 3px 3px 0, 4px 4px 0, 5px 5px 0, 6px 6px 0, 7px 7px 0, 8px 8px 0;
  }

  @media (max-width: 991px) {
    &.halfForm {
      display: none;
    }
  }
}
.feature-image {
  display: block;
  position: absolute;
  width: 74%;
  left: 21px;
  top: -20px;
  margin: 0 auto;
  z-index: 2;

  transition: 1.2s all ease;
  opacity: 0;

  &.fadein {
    opacity: 1;
  }
}
