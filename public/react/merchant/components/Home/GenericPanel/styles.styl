.panel.dasboard-home-panel {

  position: relative;
  box-shadow: 0 2px 7px 0 rgba(0,0,0,0.1);
  padding-bottom: 45px;
  min-height: 300px;
 
  .panel-footer {

    position: absolute;
    top: 100%;
    left: 0;
    margin-top: -45px;
    width: 100%;
    background-color: #FBFCFD;
    padding-top: 0;
    padding-bottom: 0;
    color: #686D87;
    line-height: 44px;
    border-top: 1px solid #F0F1F6;
  }

  .panel-body {

    padding: 0;
    width: 100%;
    height: 100%;
    position: relative;

    .rzp-overlay {

      background-color: rgba(255, 255, 255, 0.5);
    }
  }

  div.panel-actions {

    .panel-action-item {

      display: inline-block;
      margin-left: 10px;

      &:first {

        margin-left: 0;
      }

      &.btn-group {

        .btn-default {

          border-radius: 1px;
          background-color: #FFF;
          border-color: #CFDADD;
        }

        .active {

          background-color: #FAFBFC;
          z-index: auto;
          color: #4C58C7;
          box-shadow: none;

        }
      }

      .more-options-button {

        div.option {

          padding: 0;

          > a {

            padding: 10px 15px;
            display: block;
            color: inherit;
          }
        }
      }
    }
  }
}
