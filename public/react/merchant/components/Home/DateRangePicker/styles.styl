.rzp-daterange-picker {

  display: block;
  border: 1px solid rgba(0, 0, 0, 0.1);

  > div {

    display: inline-block;

    &.icon-container {

      line-height: 1;
      padding: 9px;
      font-size: 20px;
    }

    > select {

      height: 40px;
      border-radius: 0;
      outline: none;
      border: 0;
    }
  }
}
