.creation-container {
  max-width: 1100px;

  .form-group {
    margin-bottom: 30px;

    > label {
      font-size: 17px;
      font-weight: bold;
    }
  }

  .invoice-lineitem {
    margin: 30px -20px;

    .table > thead > tr > th {
      padding: 12px 20px;
    }

    .table > tbody > tr > td {
      padding: 15px 20px;
    }
  }
}
