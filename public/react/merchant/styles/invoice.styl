.invoice-creation-container {
  max-width: 900px;
  margin: auto;

  .panel-body {
    padding: 40px;
  }

  .form-group {
    margin-bottom: 30px;

    > label {
      font-size: 17px;
      font-weight: bold;
    }
  }

  .invoice-lineitem {
    margin: 30px -40px;

    .power-select {
      max-width: 80%;
    }

    .table > tbody > tr > td {
      border-bottom: 1px solid #eaeff0;
      &:first-child {
        position: relative;

        &:before {
          $width = 50px;
          content: '';
          width: $width;
          position: absolute;
          top: 0;
          bottom: 0;
          left: - $width;
        }
      }
    }

    .remove-row-action {
      position: absolute;
      top: 0;
      left: -32px;
      padding: 16px 10px;
      cursor: pointer;
      visibility: hidden;
    }

    .table > tbody > tr:hover .remove-row-action, .remove-row-action:hover {
      visibility: visible;
    }
  }
}

.invoice-lineitem {
  .table > thead > tr > th {
    background-color: #E3F4FE;
  }

  .table > thead > tr > th,
  .table > tbody > tr > td {
    padding: 12px 25px;
  }

  .table > thead > tr > th:first-child,
  .table > tbody > tr > td:first-child {
    padding-left: 40px;
  }

  .table > thead > tr > th:last-child,
  .table > tbody > tr > td:last-child {
    padding-right: 40px;
  }
}

.invoice-total {
  font-size: 17px;

  .dl-horizontal {
    padding-top: 15px;
    border-top: 1px solid #aaa;
    padding-right: 40px;

    dt, dd {
      margin-bottom: 8px;
    }
  }
}

.add-line-item {
  line-height: 0.9;
  padding: 4px 10px;
}

.payment-link-form {
  .or-separator::before {
    content: '(or)';
    position: absolute;
    left: -8px;
    top: 10px;
    color: #999;
    font-size: 11px;
  }
}

.help-label {
  padding-top: 2px;
  line-height: 1.1;

  small {
    font-size: 11px;
    color: #999;
  }
}

.invoice-details {
  .invoice-header {
    padding: 20px 0;

    > h3 {
      margin: 0;
    }
  }

  .panel {
    margin-bottom: 25px;
  }

  .panel-heading {
    font-size: 16px;
    padding-top: 10px;
    padding-bottom: 10px;
  }

  .dl-horizontal {
    margin-left: 25px;
    margin-bottom: 0;

    dt, dd {
      line-height: 2.5;
    }

    dt {
      text-align: left;
      text-transform: uppercase;
    }
  }

  .invoice-lineitem {
    margin-left: -15px;
    margin-right: -15px;
  }
}

.item-ac-container {
  .powerselect {
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
  }

  textarea.form-control {
    border: 1px dashed #ccc;
    border-top: 0;
    resize: none;
  }
}
