.creation-container {
  max-width: 1100px;

  .form-group {
    margin-bottom: 30px;

    > label {
      font-size: 17px;
      font-weight: bold;
    }
  }

  .invoice-lineitem {
    margin: 30px -20px;

    .table > thead > tr > th {
      padding: 12px 20px;
    }

    .table > tbody > tr > td {
      padding: 15px 20px;

      &:last-child {
        position: relative
      }
    }

    .remove-row-action {
      position: absolute;
      top: 0;
      bottom: 0;
      right: -32px;
      padding: 16px 10px;
      cursor: pointer;
      visibility: hidden;
    }

    .table > tbody > tr:hover .remove-row-action {
      visibility: visible;
    }
  }
}

.invoice-total {
  padding-right: 20px;
  font-size: 17px;

  dt {
    margin-bottom: 15px;
  }
}
