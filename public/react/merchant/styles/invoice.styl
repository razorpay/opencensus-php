$semiMuted = rgba(0, 0, 0, 0.54)
$muted = rgba(0, 0, 0, 0.27)

.invoice-creation-container {
  max-width: 1110px;
  margin: auto;

  .breadcrumb__backNav--heading {
    margin-right: 5px;
  }

  .invoice-container {
    max-width: 665px;
  }

  .invoice {
    background-color: #fff;
    padding: 40px;
    border-radius: 4px;
    box-shadow: 0 0 8px 0 rgba(0,0,0,0.1);
    min-height: 761px;

    > .row {
      margin-bottom: 40px;
    }

    label {
      font-size: 12px;
      font-weight: bold;
      color: $semiMuted;
    }
  }

  .inv__titlesection {
    margin-bottom: 5px;

    h3 {
      display: inline-block;
    }

    .inlineField {
      display: inline-block;
      margin-left: 7px;
      vertical-align: bottom;
    }
  }

  .inv__amountdue {
    position: relative;

    &::after {
      content: ''
      width: 20px
      border: 1px solid #999
      position: absolute
      bottom: -5px
      right: 0
    }
  }

  .inv__cta {
    margin-top: 48px;

    .btn {
      padding-top: 0;
      padding-bottom: 0;
      font-size: 16px;
      transition: background-color 0.3s ease-out;

      &.btn-primary {
        line-height: 54px;
      }

      &.btn-default {
        line-height: 46px;
      }
    }
    .btn-group-vertical {
      margin-bottom: 8px;
      display: block;
    }
  }

  .inv__cta, .inv__info {
    max-width: 280px;
    margin-bottom: 16px;
  }

  .inv__info {
    background-color: #fafafa;
    padding: 24px;
    border: 1px solid rgba(0, 0, 0, 0.12);
    border-radius: 2px;

    h4 {
      margin: 0;
      font-weight: bold;
    }

    > dl {
      margin: 0;
      dt {
        text-transform: uppercase;
        font-size: 12px;
        color: rgba(0,0,0,0.4);
        margin-top: 24px;
        margin-bottom: 4px;
      }
    }
  }

  .invoice-lineitem {
    .lineItem--empty {
      color: $muted;
    }

    .table > thead > tr > th {
      padding: 8px 16px;
      border-bottom: 1px solid #999;
      font-weight: bold;
      color: $semiMuted;
      font-size: 12px;
      font-weight: bold;
      background-color: #fff;
    }

    .table > tbody > tr > td {
      padding: 16px;
      border-bottom: 1px solid #f3f3f3;
      &.no-border {
        border-bottom-color: transparent;
      }
    }

    .table > thead > tr > th:first-child,
    .table > tbody > tr > td:first-child {
      padding-left: 0;
    }

    .table > thead > tr > th:last-child,
    .table > tbody > tr > td:last-child {
      padding-right: 0;
    }

    .table > tbody > tr {
      &.total td:not(:first-child) {
        border-bottom: 1px solid #999;
      }

      > td {
        &:first-child {
          position: relative;
          &:before {
            $width = 50px;
            content: '';
            width: $width;
            position: absolute;
            top: 0;
            bottom: 0;
            left: - $width;
          }
        }
      }
    }

    .remove-row-action {
      position: absolute;
      top: 0;
      left: -32px;
      padding: 16px 10px;
      cursor: pointer;
      visibility: hidden;
    }

    .table > tbody > tr:hover .remove-row-action,
    .remove-row-action:hover {
      visibility: visible;
    }

    .table > tbody > tr.lineItem--disabled .remove-row-action {
      visibility: hidden;
    }
  }
}

.add-line-item {
  line-height: 0.9;
  padding: 4px 10px;
}

.payment-link-form {
  .or-separator::before {
    content: '(or)';
    position: absolute;
    left: -8px;
    top: 10px;
    color: #999;
    font-size: 11px;
  }
}

.help-label {
  padding-top: 2px;
  line-height: 1.1;

  small {
    font-size: 11px;
    color: #999;
  }
}

.invoice-details {
  .invoice-header {
    padding: 20px 0;

    > h3 {
      margin: 0;
      font-weight: bold;
      font-size: 20px;
    }
  }

  .panel {
    margin-bottom: 25px;
  }

  .panel-heading {
    font-size: 16px;
    padding-top: 10px;
    padding-bottom: 10px;
  }

  .dl-horizontal {
    margin-left: 25px;
    margin-bottom: 0;

    dt, dd {
      line-height: 2.5;
    }

    dt {
      text-align: left;
      text-transform: uppercase;
      clear: auto;
    }
  }

  .invoice-lineitem {
    margin-left: -15px;
    margin-right: -15px;
  }
}
