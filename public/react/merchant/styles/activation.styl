.activation-wizard {
  small.help-block {
    font-size: 12px;
  }

  small.help-block,
  .nav-tabs > li > a {
    .fa + span {
      margin-left: 5px;
    }
  }

  .btn-toolbar {
    margin-top: 16px;
    margin-bottom: 16px;
  }

  .wizard-header {
    margin-top: 15px;
    margin-bottom: 30px;
    font-weight: bold;
    font-size: 20px;
  }

  .submit-form {
    .i-checks > i {
      float: left;
      margin-top: 5px;
      margin-right: 10px;
    }
  }
}
