.container {
  max-width: 100%;
}

.panel > .panel-heading, .panel > .panel-footer {
  padding: 15px 20px;
}

.modal-header .close {
  margin: 3px;
}

.btn {
  .fa + span {
    margin-left: 5px;
  }
}

.table > thead > tr > th {
  background-color: #eaeff0;
}

.form-control[type='number'] {
  padding-right: 0;
}

.label {
  font-size: 14px;
}

.label-muted {
  background-color: #999;
}

.btn-default {
  background-color: #fafafa;
}

.checkbox label.i-switch {
  padding-left: 0;
}
