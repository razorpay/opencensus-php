{
  "compilerOptions": {
    "outDir": "dist",
    "jsx": "react",
    "lib": ["es6", "dom"],
    "noImplicitAny": false,
    "noImplicitThis": true,
    "composite": true,
    "declaration": true,
    "typeRoots": ["node_modules/@types"],
    "preserveSymlinks": true
  },
  "extends": "../../tsconfig.base.json",
  "include": [
    "src",
    "src/**/*.json",
    "custom.d.ts",
    "e2e",
