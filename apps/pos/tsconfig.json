  "exclude": ["node_modules", "**/*.stories.ts", "**/*.stories.tsx", "**/*.stories.jsx", "out"],
  "references": [
    { "path": "../../web" },
    { "path": "../../libs/shared-ui/tsconfig.lib.json" },
    { "path": "../../libs/shared-utils/tsconfig.lib.json" }
  ],
  "types": ["resize-observer-browser", "jest", "jest-dom"]
