{
  "name": "pos",
  "description": "dashboard pos apps",
  "repository": "https://github.com/razorpay/dashboard/",
  "version": "1.0.0",
  "author": "razorpay",
  "license": "UNLICENSED",
  "engines": {
    "node": "^18.0.0",
    "npm": ">=8.1.2",
    "pnpm": "^9.0.0"
  },
  "scripts": {
    "start": "STAGE=development REDIRECTOR=false universe dev",
    "start:redirector": "STAGE=development REDIRECTOR=true universe dev",
    "beta:build": "rm -rf ./build && STAGE=beta universe build",
    "beta:serve": "STAGE=beta universe serve",
    "production:build": "STAGE=production universe build",
    "production:serve": "STAGE=production universe serve",
    "automation:build": "STAGE=automation universe build",
    "automation:serve": "STAGE=automation universe serve",
    "devstack:build": "STAGE=devstack universe build",
    "devstack:serve": "STAGE=devstack universe serve",
    "tsc": "tsc --allowJs false",
    "lint": "run-p lint:*",
    "lint:eslint": "universe eslint . -- --quiet --fix",
    "lint:secretlint": "universe secretlint \"**/*\"",
    "prettier": "universe prettier -- --write .",
    "test:jest": "jest --config=./jest.config.js",
    "test:jest:ci": "pnpm test:jest --silent --ci --json --coverage --testLocationInResults --outputFile=report.json",
    "test:jest-watch-changed": "jest --watch",
    "test:jest-watch": "jest --watchAll --silent=false",
    "test:setup": "pnpm exec universe web-e2e install",
    "test:e2e": "pnpm exec playwright test",
    "test:e2e:show-report": "pnpm exec universe web-e2e show-report",
    "devstack-deploy": "pnpm exec universe infra-e2e devstack-deploy",
    "devstack-revert": "pnpm exec universe infra-e2e devstack-revert",
    "test:e2e-infra": "pnpm exec universe infra-e2e e2e-run"
  },
  "dependencies": {
    "@razorpay/blade": "11.28.0",
    "@razorpay/i18nify-js": "^1.8.1",
    "@razorpay/universe-cli": "18.5.1",
    "@tanstack/react-query": "4.33.0",
    "@types/jest": "^29.4.1",
    "@types/jsdom": "16.2.15",
    "@types/node": "17.0.41",
    "moment": "2.29.1",
    "prop-types": "15.7.2",
    "qrcode": "^1.5.3",
    "react": "17.0.2",
    "react-dom": "17.0.2",
    "react-hook-form": "^7.52.1",
    "react-router-dom": "6.14.2",
    "styled-components": "5.1.1",
    "zustand": "3.1.2",
    "regenerator-runtime": "0.13.7",
    "graphql-tag": "2.12.6"
  },
  "devDependencies": {
    "@babel/plugin-proposal-function-bind": "7.8.3",
    "@tanstack/query-core": "4.33.0",
    "@tanstack/react-query-devtools": "4.33.0",
    "@testing-library/dom": "8.20.0",
    "@testing-library/jest-dom": "5.11.4",
    "@testing-library/react": "10.4.8",
    "@testing-library/react-hooks": "3.2.1",
    "@testing-library/user-event": "14.4.3",
    "@types/react": "17.0.39",
    "@types/react-dom": "17.0.11",
    "@types/react-motion": "0.0.29",
    "@types/resize-observer-browser": "0.1.7",
    "@types/styled-components": "5.1.28",
    "@types/testing-library__jest-dom": "5.14.9",
    "babel-plugin-react-require": "^3.1.3",
    "copy-webpack-plugin": "6.4.1",
    "history": "4.10.1",
    "lodash": "^4.17.21",
    "msw-old": "npm:msw@^0.21.2",
    "msw": "npm:msw@^2.4.1",
    "playwright-msw": "^3.0.1",
    "node-polyfill-webpack-plugin": "2.0.1",
    "npm-run-all": "4.1.5",
    "whatwg-fetch": "3.6.2",
    "@playwright/test": "1.45.3"
  },
  "watch": {
    "beta:build": {
      "patterns": [
        "src"
      ],
      "extensions": [
        "ts",
        "tsx",
        "json",
        "html"
      ],
      "delay": 250,
      "runOnChangeOnly": true
    }
  },
  "universe": {
    "appType": "react-typescript-app",
    "isInsideMonorepo": true
  }
}
