{
  "name": "digital-bills",
  "description": "Dashboard for Digital Bills",
  "repository": "https://github.com/razorpay/dashboard/",
  "version": "1.0.0",
  "author": "razorpay",
  "license": "UNLICENSED",
  "scripts": {
    "start": "STAGE=development universe dev",
    "test:jest": "jest --config=./jest.config.js",
    "beta:build": "rm -rf ./build && STAGE=beta universe build",
    "beta:serve": "STAGE=beta universe serve",
    "production:build": "STAGE=production universe build",
    "production:serve": "STAGE=production universe serve",
    "devstack:build": "STAGE=devstack universe build",
    "devstack:serve": "STAGE=devstack universe serve",
    "tsc": "universe tsc --",
    "lint": "run-p lint:*",
    "lint:eslint": "universe eslint . -- --quiet --fix",
    "lint:secretlint": "universe secretlint \"**/*\"",
    "prettier": "universe prettier -- --write .",
    "devstack-deploy": "pnpm exec universe infra-e2e devstack-deploy",
    "devstack-revert": "pnpm exec universe infra-e2e devstack-revert",
    "test:e2e-infra": "pnpm exec universe infra-e2e e2e-run"
  },
  "dependencies": {
    "@dnd-kit/core": "6.1.0",
    "@dnd-kit/sortable": "8.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@razorpay/blade": "12.8.2",
    "@razorpay/i18nify-js": "1.12.3",
    "@razorpay/universe-cli": "18.5.1",
    "@tanstack/react-query": "4.33.0",
    "@types/jest": "^29.4.1",
    "@types/jsdom": "16.2.15",
    "@types/node": "17.0.41",
    "graphql-tag": "2.12.6",
    "moment": "2.29.4",
    "prop-types": "15.7.2",
    "react": "17.0.2",
    "react-chartjs-2": "2.11.1",
    "react-dom": "17.0.2",
    "react-router-dom": "6.14.2",
    "styled-components": "5.1.1",
    "ua-parser-js": "^1.0.35",
    "zustand": "3.1.2"
  },
  "devDependencies": {
    "@tanstack/query-core": "4.33.0",
    "@tanstack/react-query-devtools": "4.33.0",
    "@testing-library/dom": "8.20.0",
    "@testing-library/jest-dom": "5.11.4",
    "@testing-library/react": "10.4.8",
    "@testing-library/react-hooks": "3.2.1",
    "@testing-library/user-event": "14.4.3",
    "@types/react": "17.0.39",
    "@types/react-dom": "17.0.11",
    "@types/styled-components": "5.1.28",
    "@types/testing-library__jest-dom": "5.14.9",
    "babel-plugin-graphql-tag": "3.1.0",
    "copy-webpack-plugin": "6.4.1",
    "history": "4.10.1",
    "msw": "0.21.2",
    "node-polyfill-webpack-plugin": "2.0.1"
  },
  "universe": {
    "appType": "react-typescript-app",
    "isInsideMonorepo": true
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.1.2",
    "pnpm": "^9.0.0"
  }
}
