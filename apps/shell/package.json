{
  "name": "shell",
  "description": "Shell application for Razorpay Dashboard",
  "repository": "https://github.com/razorpay/dashboard",
  "version": "1.0.0",
  "author": {
    "name": "Joel Jaimon (joel-jaimon)",
    "url": "https://github.com/joel-jaimon"
  },
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.15.0",
    "yarn": ">=1.22.0",
    "npm": ">=8.1.2",
    "pnpm": ">=10.10.0"
  },
  "scripts": {
    "start": "STAGE=development universe dev",
    "start:browser": "STAGE=development TARGET_BUILD=browser universe dev",
    "start:server": "STAGE=development TARGET_BUILD=server universe dev",
    "tsc": "universe tsc --",
    "lint": "run-p lint:*",
    "lint:eslint": "pnpm exec universe eslint . -- --cache",
    "lint:secretlint": "pnpm exec universe secretlint \"**/*\"",
    "prettier": "pnpm exec universe prettier -- --write --cache ."
  },
  "dependencies": {
    "browserslist-useragent": "3.0.2",
    "express-static-gzip": "2.2.0",
    "cors": "2.8.5",
    "@fontsource/lato": "4.5.9",
    "@loadable/component": "5.14.1",
    "@module-federation/enhanced": "0.8.9",
    "helmet": "3.21.2",
    "@loadable/server": "5.14.2",
    "@razorpay/blade": "12.17.1",
    "@razorpay/universe-cli": "20.2.13",
    "@tanstack/react-query": "4.33.0",
    "compression": "1.7.5",
    "connect-slashes": "1.4.0",
    "cookie-parser": "1.4.7",
    "core-js": "3.6.5",
    "express": "4.17.3",
    "graphql": "16.8.1",
    "graphql-request": "6.1.0",
    "graphql-tag": "2.12.6",
    "http-proxy-middleware": "3.0.3",
    "morgan": "1.10.0",
    "node-fetch": "3.3.2",
    "prom-client": "15.1.3",
    "react": "17.0.2",
    "react-dom": "17.0.2",
    "react-helmet-async": "2.0.5",
    "react-router-dom": "6.14.2",
    "regenerator-runtime": "0.13.7",
    "styled-components": "5.3.11",
    "whatwg-fetch": "3.6.2",
    "winston": "3.17.0",
    "zustand": "3.1.2",
    "uuid": "8.3.2",
    "axios": "0.21.1",
    "@libs/shared-core": "workspace:*"
  },
  "devDependencies": {
    "@types/helmet": "0.0.44",
    "@types/cors":"2.8.17",
    "@types/browserslist-useragent": "3.0.2",
    "@module-federation/node": "2.2.2",
    "@tanstack/react-query-devtools": "4.33.0",
    "@types/compression": "1.7.0",
    "@types/connect-slashes": "0.0.31",
    "@types/cookie-parser": "1.4.7",
    "@types/express": "4.17.3",
    "@types/express-serve-static-core": "4.17.3",
    "@types/http-proxy": "1.17.6",
    "@types/jest": "^29.4.1",
    "@types/loadable__component": "5.13.4",
    "@types/loadable__server": "5.12.6",
    "@types/morgan": "^1.9.9",
    "@types/react": "17.0.39",
    "@types/react-dom": "17.0.11",
    "@types/styled-components": "5.1.28",
    "@types/uuid": "8.3.0",
    "@types/webpack-env": "1.16.0"
  },
  "universe": {
    "appType": "react-typescript-node-app",
    "isInsideMonorepo": true
  },
  "nx": {
    "targets": {
      "devstack:build": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "apps/shell"
        }
      },
      "canary:build": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "apps/shell"
        }
      },
      "production:build": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "apps/shell"
        }
      }
    }
  }
}
