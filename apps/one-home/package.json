{
  "name": "one-home",
  "description": "One Home Dashboard",
  "repository": "https://github.com/razorpay/dashboard/",
  "version": "1.0.0",
  "author": "razorpay",
  "license": "UNLICENSED",
  "scripts": {
    "start": "STAGE=development universe dev",
    "production:serve": "STAGE=production universe serve",
    "devstack:serve": "STAGE=devstack universe serve",
    "tsc": "universe tsc --",
    "lint": "run-p lint:*",
    "lint:eslint": "universe eslint . -- --quiet --fix",
    "lint:secretlint": "universe secretlint \"**/*\"",
    "prettier": "universe prettier -- --write .",
    "devstack-deploy": "pnpm exec universe infra-e2e devstack-deploy",
    "devstack-revert": "pnpm exec universe infra-e2e devstack-revert",
    "test:e2e-infra": "pnpm exec universe infra-e2e e2e-run"
  },
  "dependencies": {
    "@razorpay/universe-cli": "20.2.13",
    "@razorpay/blade": "12.17.1",
    "@razorpay/i18nify-js": "1.12.5",
    "react-dom": "17.0.2",
    "react-query": "2.23.0",
    "react-router-dom": "6.14.2",
    "react": "17.0.2",
    "styled-components": "5.1.1",
    "graphql-tag": "2.12.6",
    "@types/jest": "^29.4.1",
    "@types/jsdom": "16.2.15",
    "@types/node": "17.0.41",
    "zustand": "3.1.2",
    "@tanstack/react-query": "4.33.0",
    "moment": "2.29.4",
    "react-chartjs-2": "2.11.1"
  },
  "devDependencies": {
    "@tanstack/query-core": "4.33.0",
    "@tanstack/react-query-devtools": "4.33.0",
    "@testing-library/dom": "8.20.0",
    "@testing-library/jest-dom": "5.11.4",
    "@testing-library/react": "10.4.8",
    "@testing-library/react-hooks": "3.2.1",
    "@testing-library/user-event": "14.4.3",
    "@types/react": "17.0.39",
    "@types/react-dom": "17.0.11",
    "@types/styled-components": "5.1.28",
    "@types/testing-library__jest-dom": "5.14.9",
    "history": "4.10.1",
    "msw": "0.21.2",
    "framer-motion": "6.5.1",
    "@libs/shared-core": "workspace:*"
  },
  "universe": {
    "appType": "react-typescript-app",
    "isInsideMonorepo": true
  },
  "engines": {
    "node": ">=22.15.0",
    "npm": ">=8.1.2",
    "pnpm": ">=10.10.0"
  },
  "nx": {
    "targets": {
      "test:jest": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "apps/one-home"
        }
      },
      "test:jest:ci": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "apps/one-home"
        }
      },
      "devstack:build": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "apps/one-home"
        }
      },
      "canary:build": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "apps/one-home"
        }
      },
      "production:build": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "apps/one-home"
        }
      }
    }
  }
}
