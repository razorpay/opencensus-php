{
  "name": "self-serve",
  "description": "dashboard self serve apps",
  "repository": "https://github.com/razorpay/dashboard/",
  "version": "1.0.0",
  "author": "razorpay",
  "license": "UNLICENSED",
  "scripts": {
    "start": "STAGE=development universe dev",
    "beta:build": "rm -rf ./build && STAGE=beta universe build",
    "beta:serve": "STAGE=beta universe serve",
    "production:build": "STAGE=production universe build",
    "production:serve": "STAGE=production universe serve",
    "automation:build": "STAGE=automation universe build",
    "automation:serve": "STAGE=automation universe serve",
    "devstack:build": "STAGE=devstack universe build",
    "devstack:serve": "STAGE=devstack universe serve",
    "tsc": "universe tsc -- --allowJs false",
    "lint": "run-p lint:*",
    "lint:eslint": "universe eslint . -- --quiet --fix",
    "lint:secretlint": "universe secretlint \"**/*\"",
    "prettier": "universe prettier -- --write .",
    "postinstall": "del-cli node_modules/.cache/webpack",
    "test:jest": "jest --config=./jest.config.js",
    "test:jest:ci": "yarn test:jest --silent --ci --json --coverage --testLocationInResults --outputFile=report.json",
    "test:jest-watch-changed": "jest --watch",
    "test:jest-watch": "jest --watchAll --silent=false",
    "test:e2e": "universe-test web-e2e test"
  },
  "dependencies": {
    "@razorpay/blade": "10.18.0",
    "@razorpay/universe-cli": "17.2.0",
    "prop-types": "15.7.2",
    "react-chartjs-2": "2.11.1",
    "react-dom": "17.0.2",
    "react-lottie": "1.2.3",
    "@tanstack/react-query": "4.33.0",
    "react-redux": "5.1.2",
    "react-router-dom": "6.14.2",
    "react": "17.0.2",
    "redux": "4.0.5",
    "styled-components": "5.1.1",
    "zustand": "3.1.2",
    "@razorpay/i18nify-js": "^1.8.1"
  },
  "devDependencies": {
    "@babel/plugin-proposal-function-bind": "7.8.3",
    "@testing-library/jest-dom": "5.11.4",
    "@testing-library/react-hooks": "3.2.1",
    "@testing-library/react": "10.4.8",
    "@testing-library/user-event": "14.4.3",
    "copy-webpack-plugin": "6.4.1",
    "history": "4.10.1",
    "msw": "0.21.2",
    "node-polyfill-webpack-plugin": "2.0.1",
    "babel-plugin-react-require": "^3.1.3",
    "@tanstack/react-query-devtools": "4.33.0"
  },
  "watch": {
    "beta:build": {
      "patterns": [
        "src"
      ],
      "extensions": [
        "ts",
        "tsx",
        "json",
        "html"
      ],
      "delay": 250,
      "runOnChangeOnly": true
    }
  },
  "universe": {
    "appType": "react-typescript-app",
    "isInsideMonorepo": true
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.1.2",
    "yarn": "~1.22.10"
  }
}
