{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "typeRoots": ["node_modules/@types"],
    "outDir": "./dist",
    "paths": {
      "@libs/shared-qsuite/playwright": ["libs/shared-qsuite/dist/playwright.cjs.js"],
      "@federated/apps/shell/*": ["apps/shell/src/client/exposed/*"],
      "@FTUX/*": ["apps/onboarding-experience/src/app/FTUX/*"],
      "@libs/shared-types": ["libs/shared-types/src/common/index.ts"],
      "@libs/shared-types/la": ["libs/shared-types/src/dashboards/la/index.ts"],
      "@libs/shared-types/payments": ["libs/shared-types/src/dashboards/payments/index.ts"],
      "@libs/shared-utils": ["libs/shared-utils/src/common/index.ts"],
      "@libs/shared-ui": ["libs/shared-ui/src/common/index.ts"]
    }
  },
  "include": ["../../libs/shared-types/global.d.ts", "*.json", "**/*.json", "src"],
  "exclude": ["node_modules", "build", ".playwright-analysis", ".jest-analysis"],
  "types": ["resize-observer-browser", "jest", "jest-dom"],
  "references": [
    { "path": "../../libs/shared-utils" },
    { "path": "../../libs/shared-ui" },
    { "path": "../../libs/shared-types" },
    { "path": "../../libs/shared-qsuite" },
    { "path": "../../web/js/common" },
    { "path": "../../web/js/merchant_common" },
    { "path": "../../apps/shell" },
    { "path": "../../web/js/merchant" }
  ]
}
