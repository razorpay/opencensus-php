{
    "name": "razorpay/api",
    "description": "The Razorpay API Backend",
    "keywords": [
        "api",
        "razorpay"
    ],
    "require": {
        "php": ">=7.1",
        "laravel/framework": "5.5.*",
        "razorpay/razorpay": "dev-master",
        "razorpay/spine": "0.1.3",
        "mailgun/mailgun-php": "~2.0",
        "aws/aws-sdk-php-laravel": "3.1.0",
        "symfony/event-dispatcher": "~2.2",
        "cebe/markdown": "~1.2.1",
        "elasticsearch/elasticsearch": "^5.2",
        "razorpay/ifsc": "~1.4",
        "propaganistas/laravel-phone": "^2.7",
        "giggsey/libphonenumber-for-php": "^8",
        "predis/predis": "^1.1",
        "php-http/guzzle6-adapter": "^1.1",
        "phpseclib/phpseclib": "^2.0",
        "jenssegers/agent": "^2.3",
        "minfraud/http": "^1.70",
        "razorpay/upi-clients": "dev-master",
        "robrichards/xmlseclibs": "^3.0.3",
        "bjeavons/zxcvbn-php": "^0.3.0",
        "doctrine/dbal": "^2.5",
        "guzzlehttp/promises": "1.2.0",
        "mikehaertl/phpwkhtmltopdf": "^2.2",
        "mustache/mustache": "^2.11",
        "php-http/laravel-httplug": "^0.1.0",
        "maxmind/minfraud": "^1.3",
        "php-http/discovery": "^1.7",
        "ext-gmp": "*",
        "box/spout": "^2.7",
        "schuppo/password-strength": "~1.5",
        "razorpay/slack-laravel": "1.3.10",
        "laravel/tinker": "1.0.2",
        "rtconner/laravel-tagging": "~2.2",
        "anlutro/l4-settings": "^0.5",
        "drewm/mailchimp-api": "^2.1",
        "razorpay/ufh-sdk-php": "dev-master",
        "bacon/bacon-qr-code": "1.0.3",
        "watson/rememberable": "^3",
        "razorpay/hodor": "dev-master",
        "razorpay/oauth": "0.1.5",
        "fideloper/proxy": "~3.0",
        "nojacko/email-validator": "^1.1",
        "symfony/dom-crawler": "3.*",
        "justinrainbow/json-schema": "^5.2",
        "phpoffice/phpspreadsheet": "^1.4",
        "mdanter/ecc": "^0.5.0",
        "razorpay/trace": "~2.4.6",
        "maclof/kubernetes-client": "^0.11.0",
        "rmccue/requests": "v1.7.0",
        "sentry/sentry-laravel": "0.11.0",
        "myclabs/deep-copy": "^1.6.1",
        "razorpay/lqext": "^1.0",
        "brozot/laravel-fcm": "^1.3",
        "razorpay/laravel-excel": "dev-master",
        "razorpay/edge-passport-php": "dev-master",
        "opencensus/opencensus":"0.7.5",
        "opencensus/opencensus-exporter-jaeger": "^0.1.1",
        "wyndow/fuzzywuzzy": "^0.6.0",
        "guzzlehttp/psr7": "^1.6",
        "http-interop/http-factory-guzzle": "^1.0",
        "kriswallsmith/buzz": "^1.1",
        "google/protobuf": "^3.12",
        "twirp/twirp": "^0.5.3",
        "halaxa/json-machine": "^0.4.1",
        "ext-zip": "*"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "git@github.com:razorpay/spine.git"
        },
        {
            "type": "vcs",
            "url": "git@github.com:razorpay/upi-clients.git"
        },
        {
            "type": "vcs",
            "url": "git@github.com:razorpay/trace.git"
        },
        {
            "type": "vcs",
            "url": "git@github.com:razorpay/oauth.git"
        },
        {
            "type": "vcs",
            "url": "git@github.com:razorpay/laravel-settings.git"
        },
        {
            "type": "vcs",
            "no-api": true,
            "url": "git@github.com:razorpay/ufh-sdk-php.git"
        },
        {
            "type": "vcs",
            "url": "git@github.com:razorpay/hodor.git"
        },
        {
            "type": "vcs",
            "url": "git@github.com:razorpay/metrics-php.git"
        },
        {
            "type": "vcs",
            "url": "git@github.com:razorpay/laravel-excel.git"
        },
        {
            "type": "vcs",
            "url": "git@github.com:razorpay/edge-passport-php.git"
        },
        {
            "type": "vcs",
            "url": "git@github.com:razorpay/opencensus-php.git"
        }
    ],
    "require-dev": {
        "kint-php/kint": "1.*",
        "laracasts/testdummy": "2.*",
        "mockery/mockery": "*",
        "codacy/coverage": "dev-master",
        "tijsverkoyen/css-to-inline-styles": "2.*",
        "php-http/mock-client": "^0.3.3",
        "phpunit/phpunit": "^6.2",
        "symfony/phpunit-bridge": "3.3.*@dev",
        "codedungeon/phpunit-result-printer": "^0.5.4",
        "orchestra/testbench": "^3.5",
        "barryvdh/laravel-debugbar": "^3.1"
    },
    "autoload": {
        "classmap": [
            "database",
            "tests",
            "app/Models/Customer"
        ],
        "psr-4": {
            "RZP\\": "app/",
            "": "generated/proto/"
        }
    },
    "scripts": {
        "post-root-package-install": [
            "php -r \"copy('environment/.env.sample', 'environment/.env');\""
        ],
        "post-create-project-cmd": [
            "php artisan key:generate"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "php artisan package:discover"
        ],
        "proto-gen": [
            "scripts/proto-gen.sh"
        ],
        "proto-clean": [
            "rm -rf generated/proto"
        ]
    },
    "config": {
        "preferred-install": "dist"
    },
    "minimum-stability": "stable"
}
