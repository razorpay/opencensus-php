{
    "name": "razorpay/api",
    "description": "The Razorpay API Backend",
    "keywords": ["api", "razorpay"],
    "require": {
        "rmccue/requests": ">=1.0",
        "laravel/framework": "4.2.*",
        "doctrine/dbal": "~2.5",
        "razorpay/razorpay": "dev-master",
        "razorpay/spine": "dev-master",
        "maatwebsite/excel": "1.*",
        "mailgun/mailgun-php": "~1.7.1",
        "aws/aws-sdk-php-laravel": "1.*"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "git@bitbucket.org:razorpay/spine.git"
        }
    ],
    "require-dev": {
        "raveren/kint": ">=0.9",
        "laracasts/testdummy": "1.*",
        "mockery/mockery": "*"
    },
    "autoload": {
        "classmap": [
            "app/commands",
            "app/constants",
            "app/controllers",
            "app/dashboard",
            "app/database",
            "app/ee",
            "app/gateway",
            "app/http",
            "app/lib",
            "app/models",
            "app/services",
            "app/tests",
            "app/trace"
        ]
    },
    "scripts": {
        "post-install-cmd": [
            "php artisan clear-compiled",
            "php artisan optimize"
        ],
        "post-update-cmd": [
            "php artisan clear-compiled",
            "php artisan optimize"
        ],
        "post-create-project-cmd": [
            "php artisan key:generate"
        ]
    },
    "config": {
        "preferred-install": "dist"
    },
    "minimum-stability": "stable"
}
