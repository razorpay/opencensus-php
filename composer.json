{
    "name": "razorpay/dashboard",
    "description": "Razorpay Merchant Dashbaord",
    "keywords": ["dashboard", "razorpay"],
    "require": {
        "laravel/framework": "4.2.*",
        "razorpay/razorpay": "1.2.*",
        "rmccue/requests": ">=1.0",
        "aws/aws-sdk-php-laravel": "1.*",
        "doctrine/cache": "1.*",
        "ollieread/multiauth": "dev-master",
        "barryvdh/laravel-debugbar": "1.*",
        "razorpay/spine": "dev-master",
        "maknz/slack": "1.*",
        "bogardo/mailgun": "3.1.*",
        "guzzlehttp/guzzle": "~4.0",
        "maatwebsite/excel": "1.*",
        "vipsoft/unzip": "^1.1",
        "schuppo/password-strength": "~0.7"
    },
    "require-dev": {
        "raveren/kint": ">=0.9",
        "zizaco/testcases-laravel": "dev-master",
        "laracasts/testdummy": "~2.0",
        "mockery/mockery": "dev-master@dev"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "git@github.com:razorpay/spine.git"
        }
    ],
    "autoload": {
        "classmap": [
            "app/commands",
            "app/controllers",
            "app/models",
            "app/database/migrations",
            "app/database/seeds",
            "app/http",
            "app/tests",
            "app/rzp",
            "app/exception",
            "app/trace"
        ]
    },
    "scripts": {
        "post-install-cmd": [
            "php artisan clear-compiled",
            "php artisan optimize"
        ],
        "post-update-cmd": [
            "php artisan clear-compiled",
            "php artisan optimize"
        ],
        "post-create-project-cmd": [
            "php artisan key:generate"
        ]
    },
    "config": {
        "preferred-install": "dist"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "license": "proprietary"
}
