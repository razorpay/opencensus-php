{
    "name": "razorpay/dashboard",
    "description": "Razorpay Merchant Dashbaord",
    "keywords": ["dashboard", "razorpay"],
    "require": {
        "laravel/framework": "4.2.*",
        "razorpay/razorpay": "dev-master",
        "rmccue/requests": ">=1.0",
        "aws/aws-sdk-php-laravel": "1.*",
        "doctrine/cache": "1.*",
        "ollieread/multiauth": "dev-master",
        "barryvdh/laravel-debugbar": "1.*",
        "razorpay/spine": "dev-master",
        "maknz/slack": "dev-queue",
        "bogardo/mailgun": "3.1.*",
        "guzzlehttp/guzzle": "~5.0",
        "maatwebsite/excel": "1.*",
        "vipsoft/unzip": "^1.1",
        "schuppo/password-strength": "~0.7",
        "league/csv": "7.1.2",
        "rtconner/laravel-tagging": "~0.5",
        "marlek/laravel-automigrate": "1.2",
        "ircmaxell/random-lib": "^1.1",
        "drewm/mailchimp-api": "^2.1",
        "nesbot/carbon": "1.*",
        "sunra/php-simple-html-dom-parser": "v1.5.0",
        "nitmedia/wkhtml2pdf": "^2.0",
        "razorpay/ifsc": "^0.1.1"
    },
    "require-dev": {
        "raveren/kint": ">=0.9",
        "zizaco/testcases-laravel": "dev-master",
        "laracasts/testdummy": "~2.0",
        "mockery/mockery": "dev-master@dev"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "git@github.com:razorpay/spine.git"
        },
        {
            "type": "vcs",
            "url": "git@github.com:razorpay/slack.git"
        }
    ],
    "autoload": {
        "classmap": [
            "app/commands",
            "app/controllers",
            "app/models",
            "app/database/migrations",
            "app/database/seeds",
            "app/http",
            "app/tests",
            "app/rzp",
            "app/exception",
            "app/trace"
        ],
        "psr-4":{
            "Razorpay\\":"Razorpay"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "php artisan clear-compiled",
            "php artisan optimize"
        ],
        "post-update-cmd": [
            "php artisan clear-compiled",
            "php artisan optimize"
        ],
        "post-create-project-cmd": [
            "php artisan key:generate"
        ]
    },
    "config": {
        "preferred-install": "dist"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "license": "proprietary"
}
