{
  "name": "razorpay/dashboard",
  "description": "Razorpay Merchant Dashboard",
  "keywords": [
    "dashboard",
    "razorpay"
  ],
  "require": {
    "php": "^8.1",
    "laravel/framework": "^9.0",
    "razorpay/razorpay": "v2.8.4",
    "aws/aws-sdk-php-laravel": "~3.0",
    "barryvdh/laravel-debugbar": "^3.7",
    "doctrine/cache": "1.*",
    "guzzlehttp/guzzle": "^7.7",
    "ircmaxell/random-lib": "^1.1",
    "league/csv": "7.1.2",
    "razorpay/trace": "4.0.0",
    "monolog/monolog": "2.6.0",
    "maatwebsite/excel": "3.*",
    "razorpay/slack-laravel": "dev-php-upgrade",
    "nesbot/carbon": "2.*",
    "razorpay/spine": "dev-php-upgrade",
    "rmccue/requests": ">=1.0",
    "schuppo/password-strength": "^2",
    "sunra/php-simple-html-dom-parser": "v1.5.0",
    "vipsoft/unzip": "^1.1",
    "razorpay/oauth-5-laravel": "dev-master",
    "ua-parser/uap-php": "^3.9",
    "predis/predis": "^1.1",
    "php-http/guzzle7-adapter": "1.0.0",
    "laravel/helpers": "^1.4",
    "nunomaduro/termwind": "^1.1",
    "opencensus/opencensus": "v0.7.6.7",
    "razorpay/metrics-php": "^3",
    "opencensus/opencensus-exporter-jaeger": "^0.1.2-alpha",
    "hisorange/browser-detect": "^4.4",
    "webonyx/graphql-php": "^14.9",
    "ackintosh/ganesha": "^1.3",
    "jakeasmith/http_build_url": "^1",
    "razorpay/edge-passport-php": "v5.0.2",
    "mailgun/mailgun-php": "^3.5",
    "onelogin/php-saml": "^4.2"
  },
  "require-dev": {
    "kint-php/kint": "^4",
    "mockery/mockery": "*",
    "phpunit/phpunit": "^9.5"
  },
  "repositories": [
    {
      "type": "vcs",
      "no-api": true,
      "url": "git@github.com:razorpay/spine.git"
    },
    {
      "type": "vcs",
      "no-api": true,
      "url": "git@github.com:razorpay/metrics-php.git"
    },
    {
      "type": "vcs",
      "url": "git@github.com:razorpay/trace.git"
    },
    {
      "type": "vcs",
      "no-api": true,
      "url": "git@github.com:razorpay/opencensus-php.git"
    },
    {
      "type": "vcs",
      "no-api": true,
      "url": "git@github.com:razorpay/opencensus-php-exporter-jaeger.git"
    },
    {
      "type": "vcs",
      "url": "git@github.com:razorpay/edge-passport-php.git"
    },
    {
      "type": "vcs",
      "no-api": true,
      "url": "git@github.com:razorpay/oauth-5-laravel.git"
    }
  ],
  "autoload": {
    "classmap": [
      "database"
    ],
    "psr-4": {
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "Tests/"
    }
  },
  "scripts": {
    "post-install-cmd": [
      "php artisan clear-compiled",
      "php artisan optimize"
    ],
    "post-update-cmd": [
      "php artisan clear-compiled",
      "php artisan optimize"
    ]
  },
  "config": {
    "platform": {
      "php": "8.1"
    },
    "preferred-install": "dist"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "license": "proprietary"
}
