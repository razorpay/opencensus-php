{
  "name": "razorpay/dashboard",
  "description": "Razorpay Merchant Dashbaord",
  "keywords": [
    "dashboard",
    "razorpay"
  ],
  "require": {
    "laravel/framework": "5.2.*",
    "razorpay/razorpay": "dev-master#98b03ae27a76d5c91eed10d75fe116ecfa914ab1",
    "aws/aws-sdk-php-laravel": "~3.0",
    "barryvdh/laravel-debugbar": "2.*",
    "bogardo/mailgun": "4.0.*",
    "doctrine/cache": "1.*",
    "guzzlehttp/guzzle": "~5.0",
    "ircmaxell/random-lib": "^1.1",
    "league/csv": "7.1.2",
    "maatwebsite/excel": "~2.0.0",
    "razorpay/slack-laravel": "^2.0.0",
    "nesbot/carbon": "1.*",
    "razorpay/spine": "dev-l52",
    "rmccue/requests": ">=1.0",
    "schuppo/password-strength": "~1.5",
    "sunra/php-simple-html-dom-parser": "v1.5.0",
    "vipsoft/unzip": "^1.1",
    "oriceon/oauth-5-laravel": "dev-master#3f6c663b48c9878cc1d8c56e16ad6c2c3d019dc8",
    "ua-parser/uap-php": "^3.9",
    "predis/predis": "^1.1",
    "php-http/guzzle5-adapter": "^1.0",
    "lcobucci/jwt": "^3.2",
    "razorpay/metrics-php": "^2.1",
    "opencensus/opencensus":"v0.7.6.7",
    "opencensus/opencensus-exporter-jaeger": "^0.1.2-alpha",
    "hisorange/browser-detect": "^4.4",
    "webonyx/graphql-php": "^14.9"
  },
  "require-dev": {
    "kint-php/kint": "1.*",
    "mockery/mockery": "dev-master@dev"
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "git@github.com:razorpay/spine.git"
    },
    {
      "type": "vcs",
      "url": "git@github.com:razorpay/metrics-php.git"
    },
    {
      "type": "vcs",
      "url": "git@github.com:razorpay/opencensus-php.git"
    },
    {
      "type": "vcs",
      "url": "git@github.com:razorpay/opencensus-php-exporter-jaeger.git"
    }
  ],
  "autoload": {
    "classmap": [
      "database"
    ],
    "psr-4": {
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "Tests/"
    }
  },
  "scripts": {
    "post-install-cmd": [
      "php artisan clear-compiled",
      "php artisan optimize"
    ],
    "post-update-cmd": [
      "php artisan clear-compiled",
      "php artisan optimize"
    ]
  },
  "config": {
    "preferred-install": "dist"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "license": "proprietary"
}
