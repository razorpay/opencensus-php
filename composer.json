{
    "name": "razorpay/dashboard",
    "description": "Razorpay Merchant Dashbaord",
    "keywords": ["dashboard", "razorpay"],
    "require": {
        "laravel/framework": "5.2.*",
        "razorpay/razorpay": "dev-master",
        "aws/aws-sdk-php-laravel": "~3.0",
        "barryvdh/laravel-debugbar": "2.*",
        "bogardo/mailgun": "4.0.*",
        "doctrine/cache": "1.*",
        "drewm/mailchimp-api": "^2.1",
        "facebook/webdriver": "^1.1",
        "guzzlehttp/guzzle": "~5.0",
        "ircmaxell/random-lib": "^1.1",
        "league/csv": "7.1.2",
        "maatwebsite/excel": "~2.0.0",
        "maknz/slack": "dev-queue",
        "nesbot/carbon": "1.*",
        "phpunit/phpunit-selenium": "^3.0",
        "razorpay/ifsc": "^0.1.1",
        "razorpay/spine": "dev-master",
        "rmccue/requests": ">=1.0",
        "rtconner/laravel-tagging": "~2.1",
        "schuppo/password-strength": "~1.5",
        "sunra/php-simple-html-dom-parser": "v1.5.0",
        "vipsoft/unzip": "^1.1"
    },
    "require-dev": {
        "symfony/dom-crawler": "~3.0",
        "symfony/css-selector": "~3.0",
        "raveren/kint": ">=0.9",
        "laracasts/testdummy": "~2.0",
        "mockery/mockery": "dev-master@dev"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "git@github.com:razorpay/spine.git"
        },
        {
            "type": "vcs",
            "url": "git@github.com:razorpay/slack.git"
        }
    ],
    "autoload": {
        "classmap": [
            "database"
        ],
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\" : "Tests/"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "php artisan clear-compiled",
            "php artisan optimize"
        ],
        "post-update-cmd": [
            "php artisan clear-compiled",
            "php artisan optimize"
        ]
    },
    "config": {
        "preferred-install": "dist"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "license": "proprietary"
}
