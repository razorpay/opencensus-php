{
    "name": "razorpay/api",
    "description": "The Razorpay API Backend",
    "keywords": ["api", "razorpay"],
    "require": {
        "rmccue/requests": ">=1.0",
        "laravel/framework": "5.2.*",
        "razorpay/razorpay": "dev-master",
        "razorpay/spine": "dev-master",
        "laravelcollective/bus": "^5.2",
        "maatwebsite/excel": "~2.1.0",
        "mailgun/mailgun-php": "~2.0",
        "aws/aws-sdk-php-laravel": "~3.0",
        "symfony/event-dispatcher": "~2.2",
        "maknz/slack": "dev-f/queue-with-retry",
        "cebe/markdown": "~1.0.1",
        "elasticsearch/elasticsearch": "^2.1",
        "razorpay/ifsc": "~0.1",
        "propaganistas/laravel-phone": "^2.7",
        "giggsey/libphonenumber-for-php": "^7.4",
        "predis/predis": "^1.1",
        "php-http/guzzle6-adapter": "^1.1",
        "phpseclib/phpseclib": "^2.0",
        "jenssegers/agent": "^2.3",
        "minfraud/http": "^1.70",
        "northox/stupid-password": "dev-master"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "git@github.com:razorpay/spine.git"
        },
        {
            "type": "vcs",
            "url": "git@github.com:razorpay/slack.git"
        }
    ],
    "require-dev": {
        "raveren/kint": "1.*",
        "phpunit/phpunit": "^5.4",
        "laracasts/testdummy": "2.*",
        "mockery/mockery": "*",
        "codacy/coverage": "dev-master",
        "tijsverkoyen/css-to-inline-styles": "^1.5",
        "orchestra/testbench": "3.2.*"
    },
    "autoload": {
        "classmap": [
            "database",
            "tests",
            "app/Models/Customer"
        ],
        "psr-4": {
            "RZP\\": "app/"
        }
    },
    "scripts": {
        "post-root-package-install": [
            "php -r \"copy('environment/.env.sample', 'environment/.env');\""
        ],
        "post-create-project-cmd": [
            "php artisan key:generate"
        ],
        "post-install-cmd": [
            "Illuminate\\Foundation\\ComposerScripts::postInstall",
            "php artisan optimize"
        ],
        "post-update-cmd": [
            "Illuminate\\Foundation\\ComposerScripts::postUpdate",
            "php artisan optimize"
        ]
    },
    "config": {
        "preferred-install": "dist"
    },
    "minimum-stability": "stable"
}
