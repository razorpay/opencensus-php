{
    "name": "razorpay/api",
    "description": "The Razorpay API Backend",
    "keywords": [
        "api",
        "razorpay"
    ],
    "require": {
        "php": ">=7.2",
        "laravel/framework": "^6.0",
        "razorpay/razorpay": "dev-master",
        "razorpay/spine": "1.0.1",
        "mailgun/mailgun-php": "~2.0",
        "aws/aws-sdk-php-laravel": "^3",
        "symfony/event-dispatcher": "^4.0",
        "cebe/markdown": "~1.2.1",
        "elasticsearch/elasticsearch": "^5.2",
        "razorpay/ifsc": "~2.0.3",
        "propaganistas/laravel-phone": "^4.2",
        "giggsey/libphonenumber-for-php": "^8",
        "predis/predis": "^1.1.6",
        "php-http/guzzle6-adapter": "^1.1",
        "phpseclib/phpseclib": "2.0.31",
        "jenssegers/agent": "^2.3",
        "minfraud/http": "^1.70",
        "razorpay/upi-clients": "dev-master",
        "robrichards/xmlseclibs": "^3.0.3",
        "bjeavons/zxcvbn-php": "^0.3.0",
        "doctrine/dbal": "^2.5",
        "guzzlehttp/promises": "1.2.0",
        "mikehaertl/phpwkhtmltopdf": "^2.2",
        "mustache/mustache": "^2.14",
        "maxmind/minfraud": "^1.3",
        "php-http/discovery": "^1.7",
        "ext-gmp": "*",
        "box/spout": "^2.7",
        "schuppo/password-strength": "~1.5",
        "razorpay/slack-laravel": "3.0.0",
        "laravel/tinker": "^2.5",
        "rtconner/laravel-tagging": "~2.2",
        "anlutro/l4-settings": "1.0.0",
        "drewm/mailchimp-api": "^2.1",
        "razorpay/ufh-sdk-php": "dev-master",
        "bacon/bacon-qr-code": "1.0.3",
        "watson/rememberable": "^3",
        "razorpay/hodor": "dev-master",
        "razorpay/oauth": "2.1.0.20",
        "fideloper/proxy": "^4.0",
        "nojacko/email-validator": "^1.1",
        "symfony/dom-crawler": "^4.0",
        "justinrainbow/json-schema": "^5.2",
        "mdanter/ecc": "^0.5.0",
        "razorpay/trace": "^3.2",
        "maclof/kubernetes-client": "^0.15.0",
        "rmccue/requests": "^v1.8.0",
        "sentry/sentry-laravel": "^1.2.0",
        "myclabs/deep-copy": "^1.6.1",
        "razorpay/lqext": "3.0.0",
        "brozot/laravel-fcm": "^1.3",
        "razorpay/edge-passport-php": "2.2.0",
        "opencensus/opencensus":"v0.7.6.7",
        "opencensus/opencensus-exporter-jaeger": "^0.1.2-alpha",
        "wyndow/fuzzywuzzy": "^0.6.0",
        "guzzlehttp/psr7": "^1.6",
        "http-interop/http-factory-guzzle": "^1.0",
        "kriswallsmith/buzz": "^1.1",
        "google/protobuf": "^3.12",
        "twirp/twirp": "^0.5.3",
        "halaxa/json-machine": "^0.4.1",
        "ext-zip": "*",
        "google/apiclient": "^2.7",
        "maatwebsite/excel": "3.1.25",
        "phpoffice/phpspreadsheet": "1.16.0",
        "razorpay/outbox-php": "v0.2.3",
        "laravel/helpers": "^1.4",
        "lcobucci/jwt": "3.3.*",
        "segmentio/analytics-php": "^1.8",
        "teakowa/cryptomute": "^1.4",
        "ext-json": "*",
        "clouding/presto-client-php": "^1.1",
        "google/cloud-pubsub": "0.11.3",
        "fntneves/laravel-transactional-events": "1.8.11",
        "ext-dom": "*",
        "ext-libxml": "*",
        "p3k/emoji-detector": "^0.3.1"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "git@github.com:razorpay/spine.git"
        },
        {
            "type": "vcs",
            "url": "git@github.com:razorpay/upi-clients.git"
        },
        {
            "type": "vcs",
            "url": "git@github.com:razorpay/trace.git"
        },
        {
            "type": "vcs",
            "url": "git@github.com:razorpay/oauth.git"
        },
        {
            "type": "vcs",
            "url": "git@github.com:razorpay/laravel-settings.git"
        },
        {
            "type": "vcs",
            "no-api": true,
            "url": "git@github.com:razorpay/ufh-sdk-php.git"
        },
        {
            "type": "vcs",
            "url": "git@github.com:razorpay/hodor.git"
        },
        {
            "type": "vcs",
            "url": "git@github.com:razorpay/metrics-php.git"
        },
        {
            "type": "vcs",
            "url": "git@github.com:razorpay/edge-passport-php.git"
        },
        {
            "type": "vcs",
            "url": "git@github.com:razorpay/opencensus-php.git"
        },
        {
            "type": "vcs",
            "url": "git@github.com:razorpay/opencensus-php-exporter-jaeger.git"
        },
        {
            "type": "vcs",
            "url": "git@github.com:razorpay/outbox-php.git"
        },
        {
            "type": "vcs",
            "url": "git@github.com:razorpay/slack-laravel.git"
        }
    ],
    "require-dev": {
        "kint-php/kint": "1.*",
        "laracasts/testdummy": "2.*",
        "mockery/mockery": "*",
        "codacy/coverage": "dev-master",
        "tijsverkoyen/css-to-inline-styles": "2.*",
        "php-http/mock-client": "^0.3.3",
        "phpunit/phpunit": "^8.0",
        "symfony/phpunit-bridge": "4.4.*",
        "codedungeon/phpunit-result-printer": "^0.26",
        "orchestra/testbench": "4.*",
        "barryvdh/laravel-debugbar": "^3.1",
        "dms/phpunit-arraysubset-asserts": "^0.1.1"
    },
    "autoload": {
        "classmap": [
            "database",
            "tests",
            "app/Models/Customer"
        ],
        "psr-4": {
            "RZP\\": "app/",
            "": "generated/proto/"
        }
    },
    "scripts": {
        "post-root-package-install": [
            "php -r \"copy('environment/.env.sample', 'environment/.env');\""
        ],
        "post-create-project-cmd": [
            "php artisan key:generate"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "php artisan package:discover"
        ],
        "proto-gen": [
            "scripts/proto-gen.sh"
        ],
        "proto-clean": [
            "rm -rf generated/proto"
        ]
    },
    "config": {
        "preferred-install": "dist"
    },
    "minimum-stability": "stable"
}
