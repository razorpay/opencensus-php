{
	"name": "razorpay/dashboard",
	"description": "Razorpay Merchant Dashbaord",
	"keywords": ["dashboard", "razorpay"],
	"require": {
		"laravel/framework": "4.1.*",
		"razorpay/razorpay-php": "dev-master",
		"rmccue/requests": ">=1.0"
	},
	"repositories": [{
		"type": "vcs",
		"url": "git@bitbucket.org:razorpay/rzp-php.git"
	}],
	"autoload": {
		"classmap": [
			"app/commands",
			"app/controllers",
			"app/models",
			"app/database/migrations",
			"app/database/seeds",
			"app/tests/TestCase.php"
		]
	},
	"scripts": {
		"post-install-cmd": [
			"php artisan clear-compiled",
			"php artisan optimize"
		],
		"post-update-cmd": [
			"php artisan clear-compiled",
			"php artisan optimize"
		],
		"post-create-project-cmd": [
			"php artisan key:generate"
		]
	},
	"config": {
		"preferred-install": "dist"
	},
	"minimum-stability": "stable"
}
