{
  "name": "razorpay/dashboard",
  "description": "Razorpay Merchant Dashboard",
  "keywords": [
    "dashboard",
    "razorpay"
  ],
  "require": {
    "php": "^8.2",
    "laravel/framework": "11.44.1",
    "razorpay/razorpay": "dev-master",
    "aws/aws-sdk-php-laravel": "^3",
    "barryvdh/laravel-debugbar": "^3.9.2",
    "doctrine/cache": "1.*",
    "guzzlehttp/guzzle": "7.8.2",
    "ircmaxell/random-lib": "^1.1",
    "league/csv": "7.1.2",
    "razorpay/trace": "upgrade-version-dev",
    "monolog/monolog": "^3.0",
    "maatwebsite/excel": "3.1.64",
    "razorpay/slack-laravel": "dev-upgrade-laravel-11-2025",
    "nesbot/carbon": "^2.73",
    "rmccue/requests": "^2.0",
    "sunra/php-simple-html-dom-parser": "v1.5.0",
    "vipsoft/unzip": "^1.1",
    "razorpay/oauth-5-laravel": "dev-master",
    "ua-parser/uap-php": "^3.9",
    "predis/predis": "^2.2.2",
    "php-http/guzzle7-adapter": "1.0.0",
    "laravel/helpers": "^1.6",
    "nunomaduro/termwind": "^2.0",
    "opencensus/opencensus": "^1.0.0",
    "razorpay/metrics-php": "dev-upgrade-version",
    "opencensus/opencensus-exporter-jaeger": "dev-laravel-upgrade-11",
    "hisorange/browser-detect": "^4.4",
    "webonyx/graphql-php": "^14.9",
    "ackintosh/ganesha": "^1.3",
    "jakeasmith/http_build_url": "^1",
    "razorpay/edge-passport-php": "dev-upgrade-laravel-11-2025",
    "mailgun/mailgun-php": "^3.5",
    "onelogin/php-saml": "^4.2",
    "apache/thrift": "dev-master as dev-initial-setup"
  },
  "require-dev": {
    "kint-php/kint": "^4",
    "mockery/mockery": "*",
    "phpunit/phpunit": "^9.5"
  },
  "repositories": [
    {
      "type": "vcs",
      "no-api": true,
      "url": "git@github.com:razorpay/spine.git"
    },
    {
      "type": "vcs",
      "no-api": true,
      "url": "git@github.com:razorpay/metrics-php.git"
    },
    {
      "type": "vcs",
      "url": "git@github.com:razorpay/trace.git"
    },
    {
      "type": "vcs",
      "no-api": true,
      "url": "git@github.com:razorpay/opencensus-php.git"
    },
    {
      "type": "vcs",
      "no-api": true,
      "url": "git@github.com:razorpay/opencensus-php-exporter-jaeger.git"
    },
    {
      "type": "vcs",
      "url": "git@github.com:razorpay/edge-passport-php.git"
    },
    {
      "type": "vcs",
      "no-api": true,
      "url": "git@github.com:razorpay/oauth-5-laravel.git"
    }
  ],
  "autoload": {
    "classmap": [
      "database"
    ],
    "psr-4": {
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "Tests/"
    }
  },
  "scripts": {
    "post-install-cmd": [
      "php artisan clear-compiled",
      "php artisan optimize"
    ],
    "post-update-cmd": [
      "php artisan clear-compiled",
      "php artisan optimize"
    ]
  },
  "config": {
    "platform": {
      "php": "8.2"
    },
    "preferred-install": "dist",
    "allow-plugins": {
      "php-http/discovery": true
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "license": "proprietary"
}
