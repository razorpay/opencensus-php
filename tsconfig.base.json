{
  "compileOnSave": false,
  "compilerOptions": {
    "allowJs": true,
    "sourceMap": true,
    "moduleResolution": "Node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "jsx": "react",
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "resolveJsonModule": true,
    "preserveSymlinks": true,
    "strict": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "allowSyntheticDefaultImports": true,
    "typeRoots": ["node_modules/@types"],
    "forceConsistentCasingInFileNames": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitOverride": false,
    "noImplicitReturns": true,
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@dashboards/la/*": ["web/js/merchantLA/*"],
      "@dashboards/payments/*": ["web/js/merchant/*"],
      "@dashboards/pokedex/*": ["web/js/pokedex/*"],
      "@dashboards/razorx/*": ["web/js/razorx/*"],
      "@dashboards/tnc/*": ["web/js/merchantTnc/*"],
      "@dashboards/newAuth/*": ["web/js/newAuth/*"],
      "@libs/web-nexus/common/*": ["web/js/common/*"],
      "@libs/web-nexus/merchant/*": ["web/js/merchant_common/*"],
      "@apps/*": ["apps/*"],
      "@federated/apps/digital-bills/*": ["apps/digital-bills/src/exposed/*"],
      "@federated/apps/pos/*": ["apps/pos/src/exposed/*"],
      "@federated/apps/self-serve/*": ["apps/self-serve/src/exposed/*"],
      "@federated/apps/one-home/*": ["apps/one-home/src/exposed/*"],
      "@federated/apps/shell/*": ["apps/shell/src/client/exposed/*"],
      "@federated/apps/onboarding-experience/*": ["apps/onboarding-experience/src/exposed/*"],
      "@federated/dashboards/la/*": ["web/js/merchantLA/exposed/*"],
      "@federated/dashboards/payments/*": ["web/js/merchant/exposed/*"],
      "@libs/shared-types": ["libs/shared-types/src/common/index.ts"],
      "@libs/shared-types/la": ["libs/shared-types/src/dashboards/la/index.ts"],
      "@libs/shared-types/payments": ["libs/shared-types/src/dashboards/payments/index.ts"],
      "@libs/shared-ui": ["libs/shared-ui/src/common/index.ts"],
      "@libs/shared-utils": ["libs/shared-utils/src/common/index.ts"],
      "@libs/shared-qsuite/playwright": ["libs/shared-qsuite/dist/playwright.cjs.js"],
      "@libs/shared-qsuite/jest": ["libs/shared-qsuite/dist/jest.cjs.js"],
      "common/*": ["web/js/common/*"],
      "merchant/*": ["web/js/merchant/*"],
      "merchantLA/*": ["web/js/merchantLA/*"],
      "merchantTnc/*": ["web/js/merchantTnc/*"],
      "merchant_common/*": ["web/js/merchant_common/*"],
      "newAuth/*": ["web/js/newAuth/*"],
      "pokedex/*": ["web/js/pokedex/*"],
      "razorx/*": ["web/js/razorx/*"],
      "test-utils": ["web/js/common/services/test/test-utils"]
    },
    "plugins": [
      {
        "name": "typescript-styled-plugin"
      }
    ]
  },
  "include": ["libs/**/*", "apps/**/*", "web/**/*", "dashboards/**/*", "e2e:fe"],
  "exclude": [
    "**/node_modules",
    "**/build",
    "**/e2e",
    "**/__tests__",
    "**/__test__",
    "**/*.stories.ts",
    "**/*.stories.tsx",
    "**/*.stories.jsx"
  ],
  "references": [
    {
      "path": "./web/js/merchant"
    },
    {
      "path": "./web/js/common"
    },
    {
      "path": "./web/js/merchant_common"
    },
    {
      "path": "./web/js/merchantLA"
    },
    {
      "path": "./web/js/merchantTnc"
    },
    {
      "path": "./web/js/newAuth"
    },
    {
      "path": "./web/js/pokedex"
    },
    {
      "path": "./web/js/razorx"
    },
    {
      "path": "./apps/digital-bills"
    },
    {
      "path": "./apps/pos"
    },
    {
      "path": "./apps/self-serve"
    },
    {
      "path": "./apps/shell"
    },
    { "path": "./apps/one-home" },
    {
      "path": "./libs/shared-utils"
    },
    {
      "path": "./libs/shared-ui"
    },
    {
      "path": "./libs/shared-types"
    },
    {
      "path": "./apps/onboarding-experience"
    }
  ]
}
