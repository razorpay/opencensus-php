ARG ONGGI_IMAGE=c.rzp.io/razorpay/onggi:php-8.1-api-worker
ARG ARMORY_IMAGE=razorpay/armory:wkhtmltopdf-v182

FROM $ARMORY_IMAGE as wkhtmltopdf

FROM $ONGGI_IMAGE

ARG GIT_COMMIT_HASH
ARG GIT_TOKEN
ARG GIT_USERNAME
ARG CACHEBUST

WORKDIR /app

COPY --from=wkhtmltopdf /bin/wkhtmltopdf /usr/bin/wkhtmltopdf

COPY composer.json composer.lock /app/

RUN set -eu && \
    composer --version && \
    git config --global user.name ${GIT_USERNAME} && \
    composer config -g "github-oauth.github.com" ${GIT_TOKEN} && \
    composer config -g repos.packagist composer "https://packagist.rzp.io" && \
    composer install --no-dev --no-interaction --no-autoloader --no-scripts && \
    rm -rf /root/.composer && \
    composer clear-cache && \
    pear81 config-set php_ini /etc/php81/php.ini && \
    mkdir -p public && echo "${GIT_COMMIT_HASH}" > public/commit.txt

COPY . /app/

RUN composer dump-autoload -o

RUN apk add make git
ADD Makefile /app
ADD error_modules /app
RUN echo ${CACHEBUST}
RUN make error-module-clean
RUN make error-module-fetch

ENTRYPOINT [ "/usr/bin/dumb-init", "--single-child", "/app/dockerconf/entrypoint.worker.sh"]
