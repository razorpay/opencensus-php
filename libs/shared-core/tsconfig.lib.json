{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "incremental": true,
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "emitDeclarationOnly": false,
    "composite": true
  },
  "include": ["src/**/*.ts", "@types/**/*"],
  "exclude": ["src/**/*.spec.ts", "src/**/*.test.ts"],
}
