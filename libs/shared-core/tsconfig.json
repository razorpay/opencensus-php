{
  "compilerOptions": {
    "baseUrl": ".",
    "module": "esnext",
    "declaration": true,
    "target": "ESNext",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "typeRoots": ["./node_modules/@types"],
    "types": ["webpack"],
    "paths": {
      "@src/*": ["src/*"],
    }
  },
  "include": ["src/**/*", "@types/**/*"],
  "exclude": ["**/node_modules", "dist"]
}
