{
  "name": "shared-utils",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/shared-utils/src",
  "projectType": "library",
  "targets": {
    "production:build": {
      "command": "echo \"Building shared-utils for production...\""
    },
    "devstack:build": {
      "command": "echo \"Building shared-utils for devstack...\""
    },
    "publish": {
      "command": "node tools/scripts/publish.mjs shared-utils {args.ver} {args.tag}",
      "dependsOn": ["build"]
    },
    "tsc": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "libs/shared-utils",
        "commands": ["tsc -p tsconfig.typecheck.json --allowJs false"],
        "forwardAllArgs": false,
        "description": "Type check with tsc"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "libs/shared-utils",
        "commands": ["universe eslint . --fix", "universe secretlint \"**/*\""],
        "parallel": true,
        "forwardAllArgs": false,
        "description": "Lint"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/shared-utils/jest.config.ts",
        "passWithNoTests": true
      },
      "configurations": {
        "ci": {
          "ci": true,
          "codeCoverage": true
        }
      }
    }
  },
  "tags": []
}
