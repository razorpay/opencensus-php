{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "rootDir": "src",
    "composite": true,
    "typeRoots": ["node_modules/@types"],
    "types": ["react"],
    "skipLibCheck":true,
    "paths": {
      "@libs/shared-types":["../shared-types/src/common/index.ts"] // Only access to this path for this lib
    }
  },
  "include": ["../shared-types/global.d.ts", "src/**/*", "../shared-types/global.d.ts"],
  "exclude": ["**/node_modules"],
  "references": [
    { "path": "../shared-types" }
  ]
}
