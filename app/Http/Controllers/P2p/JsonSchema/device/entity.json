{
    "definitions": {},
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://api.razorpay.com/v1/p2p/json_schema/api/root.json",
    "type": "object",
    "required": [
        "id",
        "imei",
        "os",
        "os_version",
        "app_name",
        "handle",
        "cl.token",
        "cl.payload",
        "created_at"
    ],
    "properties": {
        "id": {
            "$id": "#/properties/id",
            "type": "string",
            "pattern": "^(.*)$"
        },
        "imei": {
            "$id": "#/properties/imei",
            "type": "string",
            "pattern": "^(.*)$"
        },
        "os": {
            "$id": "#/properties/os",
            "type": "string",
            "pattern": "^(.*)$"
        },
        "os_version": {
            "$id": "#/properties/os_version",
            "type": "string",
            "pattern": "^(.*)$"
        },
        "app_name": {
            "$id": "#/properties/app_name",
            "type": "string",
            "pattern": "^(.*)$"
        },
        "handle": {
            "$id": "#/properties/handle",
            "type": "string",
            "pattern": "^(.*)$"
        },
        "cl.token": {
            "$id": "#/properties/cl.token",
            "type": ["string", "null"]
        },
        "cl.payload": {
            "$id": "#/properties/cl.payload",
            "type": ["string", "null"]
        },
        "created_at": {
            "$id": "#/properties/created_at",
            "type": "integer"
        }
    },
    "actions" : [
        "create",
        "fetch",
        "refreshClToken",
        "delete"
    ]
}
