{
    "definitions": {},
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://api.razorpay.com/v1/p2p/json_schema/api/root.json",
    "type": "object",
    "required": [
        "id",
        "imei",
        "os",
        "os_version",
        "app_name",
        "handle",
        "cl",
        "created_at"
    ],
    "properties": {
        "id": {
            "$id": "#/properties/id",
            "type": "string",
            "pattern": "^(.*)$"
        },
        "imei": {
            "$id": "#/properties/imei",
            "type": "string",
            "pattern": "^(.*)$"
        },
        "os": {
            "$id": "#/properties/os",
            "type": "string",
            "pattern": "^(.*)$"
        },
        "os_version": {
            "$id": "#/properties/os_version",
            "type": "string",
            "pattern": "^(.*)$"
        },
        "app_name": {
            "$id": "#/properties/app_name",
            "type": "string",
            "pattern": "^(.*)$"
        },
        "handle": {
            "$id": "#/properties/handle",
            "type": "string",
            "pattern": "^(.*)$"
        },
        "cl": {
            "$id": "#/properties/cl",
            "type": "object"
            "required": [
                "token",
                "payload"
            ],
            "properties": {
                "token": {
                    "type": ["null", "string"]
                },
                "payload": {
                    "type": ["null", "string"]
                }
            }
        },
        "created_at": {
            "$id": "#/properties/created_at",
            "type": "integer"
        }
    },
    "actions" : [
        "create",
        "fetch",
        "refreshClToken",
        "delete"
    ]
}
