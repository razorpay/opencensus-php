{
    "definitions": {},
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "additionalProperties": false,
    "title": "The Root Schema",
    "required": [
        "status",
        "auth_token"
    ],
    "properties": {
        "status": {
            "type": "string",
            "enum": [
                "pending",
                "completed"
            ],
            "title": "The Status Schema"
        },
        "auth_token" : {
            "type" : ["string", "null"]
        },
        "status_url": {
            "type": "string",
            "format": "uri"
        },
        "expire_at": {
            "type": "integer"
        }
    }
}
