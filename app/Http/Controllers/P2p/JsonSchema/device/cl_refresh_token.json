{
    "definitions": {},
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "http://example.com/root.json",
    "type": "object",
    "required": [
        "contact",
        "handle",
        "cl.token",
        "cl.payload",
        "refreshed_at"
    ],
    "properties": {
        "contact": {
            "type": "string",
            "pattern": "^\\+91(\\d*){10}$"
        },
        "handle": {
            "type": "string"
        },
        "cl.token": {
            "type": ["string", "null"]
        },
        "cl.payload": {
            "type": ["string", "null"]
        },
        "refreshed_at": {
            "type": "integer"
        }
    }
}
