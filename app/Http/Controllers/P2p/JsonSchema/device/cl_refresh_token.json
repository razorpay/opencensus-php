{
    "definitions": {},
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "http://example.com/root.json",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "contact",
        "handle",
        "cl",
        "refreshed_at"
    ],
    "properties": {
        "contact": {
            "type": "string",
            "pattern": "^\\+91(\\d*){10}$"
        },
        "handle": {
            "type": "string"
        },
        "cl": {
            "type": "object",
            "required": [
                "token",
                "payload"
            ],
            "properties": {
                "token": {
                    "type": ["null", "string"]
                },
                "payload": {
                    "type": ["null", "string"]
                }
            }
        },
        "refreshed_at": {
            "type": "integer"
        }
    }
}
