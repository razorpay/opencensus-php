{
    "definitions": {},
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "http://example.com/root.json",
    "type": "object",
    "required": [
        "id",
        "contact",
        "handle",
        "ip",
        "os",
        "os_version",
        "sim_id",
        "uuid",
        "type",
        "geo_code",
        "app_name",
        "cl.token",
        "cl.payload",
        "created_at"
    ],
    "properties": {
        "id": {
            "type": "string",
            "pattern": "^device_\\w{14}$"
        },
        "contact": {
            "type": "string",
            "pattern": "^\\+91(\\d*){10}$"
        },
        "handle": {
            "type": "string"
        },
        "ip": {
            "type": "string"
        },
        "os": {
            "type": "string"
        },
        "os_version": {
            "type": "string"
        },
        "sim_id": {
            "type": "string"
        },
        "uuid": {
            "type": "string"
        },
        "type": {
            "type": "string"
        },
        "geo_code": {
            "type": "string"
        },
        "app_name": {
            "type": "string"
        },
        "cl.token": {
            "type": ["string", "null"]
        },
        "cl.payload": {
            "type": ["string", "null"]
        },
        "created_at": {
            "type": "integer"
        }
    }
}
