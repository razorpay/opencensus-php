{
    "definitions": {},
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://api.razorpay.com/v1/p2p/json_schema/api/root.json",
    "type": "object",
    "required": [
        "id",
        "contact",
        "email",
        "active",
        "notes",
        "created_at"
    ],
    "properties": {
        "id": {
            "$id": "#/properties/id",
            "type": "string",
            "pattern": "^cust_\\w{14}$"
        },
        "contact": {
            "$id": "#/properties/contact",
            "type": "string",
            "pattern": "^\\+91(\\d*){10}$"
        },
        "email": {
            "$id": "#/properties/email",
            "type": "string",
            "format": "email"
        },
        "active": {
            "$id": "#/properties/active",
            "type": "boolean"
        },
        "notes": {
            "$id": "#/properties/notes",
            "type": "object"
        },
        "created_at": {
            "$id": "#/properties/created_at",
            "type": "integer"
        }
    },
    "actions" : [
        "startVerification",
        "getVerificationStatus",
        "create",
        "delete"
    ]
}
