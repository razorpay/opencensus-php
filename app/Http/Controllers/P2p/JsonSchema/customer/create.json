{
  "definitions": {},
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "The Root Schema",
  "required": [
    "id",
    "contact",
    "email",
    "active",
    "notes"
  ],
  "properties": {
    "id": {
      "type": "string",
      "title": "The Id Schema",
      "pattern": "^cust_\\w{14}$"
    },
    "contact": {
      "type": "string",
      "title": "The Contact Schema",
      "pattern": "^\\+91(\\d*){10}$"
    },
    "email": {
      "type": [
        "string",
        "null"
      ],
      "title": "The Email Schema",
      "format": "email"
    },
    "active": {
      "type": "boolean",
      "title": "The Active Schema"
    },
    "notes": {
      "type": [
        "object",
        "array"
      ],
      "title": "The Notes Schema"
    }
  }
}
