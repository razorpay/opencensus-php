{
    "definitions": {},
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "http://example.com/root.json",
    "type": "object",
    "required": [
        "id",
        "entity",
        "ifsc",
        "bank_name",
        "beneficiary_name",
        "masked_account_number",
        "creds",
        "cl.registration_format",
        "refreshed_at",
        "created_at"
    ],
    "properties": {
        "id": {
            "type": "string",
            "pattern": "^(.*)$"
        },
        "entity": {
            "type": "string",
            "pattern": "^(.*)$"
        },
        "ifsc": {
            "type": "string",
            "pattern": "^(.*)$"
        },
        "bank_name": {
            "type": "string",
            "pattern": "^(.*)$"
        },
        "beneficiary_name": {
            "type": "string",
            "pattern": "^(.*)$"
        },
        "masked_account_number": {
            "type": "string",
            "pattern": "^(.*)$"
        },
        "creds": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "type",
                    "length",
                    "format",
                    "cl.format"
                ],
                "properties": {
                    "type": {
                        "type": "string",
                        "pattern": "^(.*)$"
                    },
                    "set": {
                        "type": "boolean"
                    },
                    "length": {
                        "type": "integer"
                    },
                    "format": {
                        "type": "string",
                        "pattern": "^(.*)$"
                    },
                    "cl.format": {
                        "type": "string"
                    }
                }
            }
        },
        "cl.registration_format": {
            "type": "string",
            "enum": [
                "FORMAT1",
                "FORMAT2"
            ]
        },
        "refreshed_at": {
            "type": "integer"
        },
        "created_at": {
            "type": "integer"
        }
    }
}
