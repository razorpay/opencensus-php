{
    "definitions": {},
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://api.razorpay.com/v1/p2p/json_schema/api/root.json",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "entity",
        "count",
        "items"
    ],
    "properties": {
        "entity": {
            "type": "string",
            "enum": [
                "collection"
            ],
            "default": null,
            "pattern": "^(.*)$"
        },
        "count": {
            "type": "integer"
        },
        "items": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "entity",
                    "ifsc",
                    "name",
                    "upi",
                    "active"
                ],
                "properties": {
                    "entity": {
                        "type": "string",
                        "enum": [
                            "bank"
                        ]
                    },
                    "ifsc": {
                        "type": "string",
                        "pattern": "^(.*)$"
                    },
                    "name": {
                        "type": "string",
                        "pattern": "^(.*)$"
                    },
                    "upi": {
                        "type": "boolean"
                    },
                    "active": {
                        "type": "boolean"
                    }
                }
            }
        }
    }
}
