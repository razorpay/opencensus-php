{
    "definitions": {},
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "http://example.com/root.json",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "entity",
        "count",
        "items"
    ],
    "properties": {
        "entity": {
            "type": "string",
            "pattern": "^(.*)$"
        },
        "count": {
            "type": "integer"
        },
        "items": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "id",
                    "entity",
                    "ifsc",
                    "bank_name",
                    "beneficiary_name",
                    "masked_account_number",
                    "creds",
                    "sdk",
                    "refreshed_at",
                    "created_at"
                ],
                "properties": {
                    "id": {
                        "type": "string",
                        "default": null,
                        "pattern": "^ba_(.*){14}$"
                    },
                    "entity": {
                        "type": "string",
                        "pattern": "^(.*)$"
                    },
                    "ifsc": {
                        "type": "string",
                        "default": null,
                        "pattern": "^(.*){11}$"
                    },
                    "bank_name": {
                        "type": "string",
                        "pattern": "^(.*)$"
                    },
                    "beneficiary_name": {
                        "type": "string",
                        "pattern": "^(.*)$"
                    },
                    "masked_account_number": {
                        "type": "string",
                        "pattern": "^(.*)$"
                    },
                    "creds": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "required": [
                                "type",
                                "sub_type",
                                "length",
                                "format",
                                "cl"
                            ],
                            "properties": {
                                "type": {
                                    "type": "string",
                                    "enum": [
                                        "pin",
                                        "otp",
                                        "sms"
                                    ],
                                    "pattern": "^(.*)$"
                                },
                                "sub_type": {
                                    "type": "string",
                                    "enum": [
                                        "upipin",
                                        "atmpin",
                                        "otp",
                                        "sms"
                                    ],
                                    "pattern": "^(.*)$"
                                },
                                "set": {
                                    "type": "boolean"
                                },
                                "length": {
                                    "type": "integer"
                                },
                                "format": {
                                    "type": "string",
                                    "pattern": "^(.*)$"
                                },
                                "cl": {
                                    "type": "object",
                                    "required": [
                                        "format"
                                    ],
                                    "properties": {
                                        "format": {
                                            "type": "string",
                                            "pattern": "^(.*)$"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "sdk": {
                        "type": "object",
                        "required": [
                            "registration_format"
                        ],
                        "properties": {
                            "registration_format": {
                                "type": "string",
                                "enum": [
                                    "FORMAT1",
                                    "FORMAT2",
                                    "FORMAT3"
                                ],
                                "default": null,
                                "pattern": "^(.*)$"
                            }
                        }
                    },
                    "refreshed_at": {
                        "type": "integer"
                    },
                    "created_at": {
                        "type": "integer"
                    }
                }
            }
        }
    }
}
