{
    "definitions": {},
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "http://example.com/root.json",
    "type": "object",
    "required": [
        "id",
        "entity",
        "address",
        "username",
        "handle",
        "bank_account_id",
        "created_at"
    ],
    "properties": {
        "id": {
            "$id": "#/properties/id",
            "type": "string",
            "default": null,
            "pattern": "^vpa_[\\w]{14}$"
        },
        "entity": {
            "$id": "#/properties/entity",
            "type": "string",
            "enum": [
                "vpa"
            ],
            "default": null,
            "pattern": "^(.*)$"
        },
        "address": {
            "$id": "#/properties/address",
            "type": "string",
            "default": null,
            "pattern": "^(.*)@(.*)$"
        },
        "username": {
            "$id": "#/properties/username",
            "type": "string",
            "pattern": "^(.*)$"
        },
        "handle": {
            "$id": "#/properties/handle",
            "type": "string",
            "pattern": "^(.*)$"
        },
        "bank_account_id": {
            "$id": "#/properties/bank_account_id",
            "type": "string",
            "default": null,
            "pattern": "^ba_[\\w]{14}$"
        },
        "created_at": {
            "$id": "#/properties/created_at",
            "type": "integer"
        }
    },
    "actions": [
        "fetchHandles",
        "create",
        "fetchAll",
        "fetch",
        "assignBankAccount",
        "checkAvailability",
        "delete"
    ]
}
