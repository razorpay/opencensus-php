{
    "definitions": {},
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "http://example.com/root.json",
    "type": "object",
    "required": [
        "id",
        "entity",
        "beneficiary_name",
        "created_at"
    ],
    "properties": {
        "id": {
            "$id": "#/properties/id",
            "type": "string",
            "pattern": "^(.*)$"
        },
        "entity": {
            "$id": "#/properties/entity",
            "type": "string",
            "enum": ["vpa", "bank_account"]
        },
        "beneficiary_name": {
            "$id": "#/properties/beneficiary_name",
            "type": "string"
        },
        "address": {
            "$id": "#/properties/address",
            "type": "string"
        },
        "username": {
            "$id": "#/properties/username",
            "type": "string"
        },
        "handle": {
            "$id": "#/properties/handle",
            "type": "string"
        },
        "masked_account_number": {
            "$id": "#/properties/masked_account_number",
            "type": "string"
        },
        "ifsc_code": {
            "$id": "#/properties/ifsc_code",
            "type": "string"
        },
        "bank_name": {
            "$id": "#/properties/bank_name",
            "type": "string"
        },
        "created_at": {
            "$id": "#/properties/created_at",
            "type": "integer"
        }
    },
    "actions" : [
        "create",
        "validate",
        "fetchAll"
    ]
}
