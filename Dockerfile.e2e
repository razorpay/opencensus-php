FROM mcr.microsoft.com/playwright:v1.31.1-focal

ARG INCLUDE_GROUPS
ARG EXCLUDE_GROUPS
ARG AFFFECTED_PROJECTS

ENV INCLUDE_GROUPS=$INCLUDE_GROUPS
ENV EXCLUDE_GROUPS=$EXCLUDE_GROUPS
ENV AFFFECTED_PROJECTS=$AFFFECTED_PROJECTS

WORKDIR /app

COPY . .

RUN --mount=type=secret,id=github_access_token set -eux && \
  echo "$(cat /run/secrets/github_access_token)" >> ~/.GITHUB_ACCESS_TOKEN

RUN npm install -g pnpm@~9.0

RUN export GITHUB_ACCESS_TOKEN="$(cat ~/.GITHUB_ACCESS_TOKEN)" && \
  pnpm config set unsafe-perm true && \
  pnpm install --frozen-lockfile --ignore-scripts

RUN rm -f ~/.GITHUB_ACCESS_TOKEN

RUN npx playwright install --with-deps

RUN rm -f .npmrc && \
    rm -f ./web/.npmrc && \
    rm -f ./apps/self-serve/.npmrc && \ 
    rm -f ./apps/pos/.npmrc && \
    rm -f ./apps/digital-bills/.npmrc

CMD pnpm test:e2e:auth && \
  INCLUDE_GROUPS=$INCLUDE_GROUPS \
  EXCLUDE_GROUPS=$EXCLUDE_GROUPS \
  npx nx run-many --target=test:e2e --projects=$AFFFECTED_PROJECTS --parallel=1
