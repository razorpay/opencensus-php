lua_package_path "/home/vagrant/code/src/github.com/razorpay/api/etc/nginx/?.lua;;";

server {
    listen 80;
    server_name openresty.api.razorpay.test;

    location / {
        access_by_lua_block {
            local lib = require 'rate_limit'
            lib.rate_limit_ngx(ngx)
        }
        proxy_pass http://api.razorpay.test;
    }

    access_log /var/log/nginx/openresty.api.razorpay.test-access.log;
    error_log  /var/log/nginx/openresty.api.razorpay.test-error.log warn;
}
