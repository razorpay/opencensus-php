lua_package_path "/usr/local/openresty/nginx/lua/?.lua;/usr/local/openresty/lualib/?.lua;/usr/local/openresty/luajit/share/lua/5.1/?.lua;/lua/src/?.lua";
lua_package_cpath "/usr/local/openresty/lualib/?.so;/usr/local/openresty/luajit/lib/lua/5.1/?.so;";

lua_shared_dict redis_cluster_slot_locks 100k;


log_format openresty-api escape=json
  '{'
    '"time_local":"$time_local",'
    '"remote_addr":"$remote_addr",'
    '"remote_user":"$remote_user",'
    '"request":"$request",'
    '"status": "$status",'
    '"body_bytes_sent":"$body_bytes_sent",'
    '"request_time":"$request_time",'
    '"http_referrer":"$http_referer",'
    '"http_user_agent":"$http_user_agent",'
    '"request_uri":"$request_uri",'
    '"upstream_response_time":"$upstream_response_time",'
    '"upstream_connect_time":"$upstream_connect_time",'
    '"ssl_protocol":"$ssl_protocol"'
  '}';

server {
    listen 8080;

    {% set qa = ['perf', perf1,'perf2', 'func','automation','bvt'] %}
    {% if env in qa  %}
        server_name {{ env }}-api.stage.razorpay.in {{ env }}-invoices.stage.razorpay.in;
    {% elif env == 'echo' %}
        server_name {{ env }}-api.stage.razorpay.in {{ env }}-invoices.stage.razorpay.in;
    {% elif env != 'prod' %}
        server_name {{ env }}-api.razorpay.com {{ env }}-invoices.razorpay.com;
    {% elif env == 'prod' %}
        server_name api.razorpay.com invoices.razorpay.com;
    {% endif %}

    location /server-status {
       return 404;
    }

    location /stub_status {
        stub_status;
        allow 127.0.0.1;
        deny all;
    }

    location / {
        access_by_lua_block {
            local lib = require 'rate_limit_router'
            lib.rate_limit_ngx(ngx)
        }

        proxy_pass http://localhost:80;
    }

    location /status {
       access_by_lua_block {
           local lib = require 'rate_limit_router'
           lib.check_redis_connection(ngx)
       }
    }

    access_log /dev/stdout openresty-api;
    error_log  /dev/stderr debug;
}
