<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Strict//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width"/>
  </head>
  <body><table>
  <!-- header -->
  <thead>
    <tr>
      <td class="left"></td>
      <td class="middle header">
        <h4>Subscription Started at {{$merchant['billing_label']}}</h4>
        <p>Subcription ID: {{$subscription['public_id']}}</p>
      </td>
      <td class="right"></td>
    </tr>
    <tr>
      <td class="left"></td>
      <td class="middle">
        A charge attempt towards your subscription has failed. You have {{$subscription['auth_attempts']}} attempt(s) remaining. Another charge will be attempted on {{$subscription['charge_at']}}. You may choose to <a href="#">use another card</a> or fix issues with the saved card and <a href="#">try again</a>.
      </td>
      <td class="right"></td>
    </tr>
    <tr>
      <td class="left demarcated"></td>
      <td class="middle demarcated">
        <table>
          <tr>
            <td class="full-button"><a href="#">UPDATE CARD</a></td>
            <td class="full-button"><a href="#">TRY AGAIN</a></td>
          </tr>
        </table>
      </td>
      <td class="right demarcated"></td>
    </tr>
  </thead>

  <!-- body -->

  <tbody>
    <tr>
      <td class="left"></td>
      <td class="middle"></td>
      <td class="right"></td>
    </tr>
    <!-- Plan -->
    <tr>
      <td class="left"></td>
      <td class="middle">
        <h6>Subscription Plan</h6>
        <p class="title">{{$plan_item['name']}}</p>
        <p class="sub-title">{{$plan_item['description']}}</p>
        <p class="sub-title">Next due on {{$subscription['charge_at']}}</p>
      </td>
      <td class="right"></td>
    </tr>
    <!-- Billing Period -->
    <tr>
      <td class="left"></td>
      <td class="middle">
        <h6>Billing Period</h6>
        <p class="sub-title">Start: {{$invoice['billing_start']}}</p>
        <p class="sub-title">End: {{$invoice['billing_end']}} </p>
      </td>
      <td class="right"></td>
    </tr>
    <!-- Card -->
    <tr>
      <td class="left"></td>
      <td class="middle">
        <h6>Payment Method</h6>
        <p class="title">{{$card['network']}} Card {{$card['number']}}</p>
        <p class="title"><a href="#">Update Card</a></p>
      </td>
      <td class="right"></td>
    </tr>
<!--     <tr>
      <td class="left"></td>
      <td class="middle">
        <p class="title">Please find all details of the payment in the attached invoice</p>
      </td>
      <td class="right"></td>
    </tr> -->
    <tr class="b-demarcate">
      <td class="left"></td>
      <td class="middle">
        <p class="sub-title">You may contact <a href="mailto:support@razorpay.com">Razorpay</a> for any query related to this subscription with the subscription ID as {{$subscription['public_id']}}</p>
      </td>
      <td class="right"></td>
    </tr>
  </tbody>

  <tfoot>
    <tr class="b-demarcate">
      <td class="left"></td>
      <td class="middle">
        <p class="title"><strong>{{$merchant['billing_label']}}</strong></p>
        <p class="sub-title">{{$merchant['website']}}</p>
      </td>
      <td class="right"></td>
    </tr>
    <tr>
      <td class="left"></td>
      <td class="middle">
        <p class="title">Powered by <img src="http://site.pronav.in/assets/razorpay-logo.svg" alt="Razorpay" /></p>
      </td>
      <td class="right"></td>
    </tr>
  </tfoot>

</table></body>
</html>
