                      </td>
                      <td>Rs. '. $amount . '</td>
                      <td>'. $dispute['gateway_dispute_id'] . '</td>
                      <td>'. $dispute['contact'] . '</td>
                      <td>'. date("d F Y", $dispute['respond_by']) . '</td>
                    </tr>';
