{
  "title": "Schindler Payment",
  "type": "object",
  "required": [
    "customer_id",
    "customer_name",
    "invoice_number",
    "job_number",
    "amount",
    "service_type",
    "location"
  ],
  "properties": {
    "customer_id": {
      "type": "number",
      "title": "Customer Code/ID",
      "minLength": 7,
      "maxLength": 9
    },
    "invoice_number": {
      "type": "string",
      "title": "Invoice Number",
      "length": 100,
      "default": ""
    },
    "customer_name": {
      "type": "string",
      "title": "Customer Name",
      "length": 100,
      "default": ""
    },
    "job_number": {
      "type": "integer",
      "title": "Job/Quotation number",
      "default": ""
    },
    "amount": {
      "type": "integer",
      "title": "Amount",
      "minimum": 0
    },
    "service_type": {
      "type": "string",
      "title": "Type Of Service",
      "enum": [
        "Repair",
        "Installation",
        "Maintenance"
      ]
    },
    "location": {
      "type": "string",
      "title": "Location",
      "enum": [
        "Bangalore",
        "Mumbai",
        "New delhi"
      ]
    }
  }
}
