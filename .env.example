APP_ENV=dev
APP_DEBUG=true
APP_KEY=SomeRandomString

DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=dashboard
DB_USERNAME=root
DB_PASSWORD=secret

CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_DRIVER=sync

MAIL_DRIVER=smtp
MAIL_HOST=mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null

API_URL=http://api.razorpay.dev/v1/
API_AUTH_PASS=secret
API_MOCK=false

QUEUE_DRIVER=sync
AWS_QUEUE_URL=

# AWS Bucket for storing activation documents uploaded
AWS_ACTIVATION_BUCKE=activation_test
#Your AWS Access Key ID
AWS_KEY_ID=''
# Your AWS Secret Access Key
AWS_KEY_SECRET=''
AWS_REGION=us-east-1
S3_MOCK=true

# Should mail be faked, set true in testing/development See mail.php for details
MAIL_PRETEND=true

# Should contact form submit details be sent to slack
# Set false in testing/development
# This is also used for Sorting Hat integration
# Slack Key is not used for Sorting Hat
SLACK_ENABLE=false
SLACK_KEY=''

NOCAPTCHA_SECRET=''
CONTEXT='dev'

# Creevey is the creenshot service
CREEVEY_TOKEN='token_for_creevey'
CREEVEY_MOCK=true

MAILCHIMP_LIST_I=list_id
MAILCHIMP_API_TOKE=xxxx-yyyy-zzzz
MAILCHIMP_MOCK=true

ZAPIER_MOCK=true
CRON_PASS='RANDOM_CRON_PASS'
