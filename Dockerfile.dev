FROM harbor.razorpay.com/razorpay/rzp-docker-image-inventory-multi-arch:rzp-legacy-image-api-curl-v4 as curl-cli
FROM harbor.razorpay.com/razorpay/rzp-docker-image-inventory-multi-arch:rzp-legacy-image-php-8.2-opencensus as opencensus-ext

FROM harbor.razorpay.com/razorpay/rzp-docker-image-inventory-multi-arch:rzp-legacy-image-php-8.2-api-web-v4

# RUN apk add --no-cache php82-pear php82-dev

# COPY --from=curl-cli /usr/bin/curl /usr/bin/

# RUN pear82 config-set php_ini /etc/php82/php.ini
RUN pecl82 install opencensus-alpha

RUN apk add font-noto font-noto-thai font-noto-tibetan font-ipa font-sony-misc font-jis-misc && \
    fc-cache -f

COPY --from=opencensus-ext /usr/lib/php82/modules/opencensus.so /usr/lib/php82/modules

VOLUME ['/app']

WORKDIR /app

ARG GIT_TOKEN
ENV GIT_TOKEN $GIT_TOKEN
ARG CACHEBUST

ADD Makefile /app
ADD error_modules /app
RUN echo ${CACHEBUST}
RUN make error-module-clean
RUN make error-module-fetch

EXPOSE 80

ENTRYPOINT ["/usr/bin/dumb-init", "--single-child", "/app/dockerconf/entrypoint.dev.sh"]
