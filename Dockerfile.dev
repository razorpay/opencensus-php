ARG ONGGI_IMAGE=c.rzp.io/razorpay/onggi:php-7.3-nginx

FROM $ONGGI_IMAGE as opencensus-ext

WORKDIR /
ARG OPENCENSUS_VERSION_TAG=v0.7.6.4
RUN set -eux && \
    wget -O - https://github.com/razorpay/opencensus-php/tarball/"${OPENCENSUS_VERSION_TAG}" | tar zx --strip=1
RUN cd /ext && phpize && ./configure --enable-opencensus && make install

FROM $ONGGI_IMAGE

ARG GIT_COMMIT_HASH
ARG GIT_TOKEN
ARG GIT_USERNAME

COPY composer.json composer.lock /app/

WORKDIR /app

RUN set -eu && \
    composer --version && \
    git config --global user.name ${GIT_USERNAME} && \
    composer config -g "github-oauth.github.com" ${GIT_TOKEN} && \
    composer config -g repos.packagist composer "https://packagist.rzp.io" && \
    composer install --no-dev --no-interaction --no-autoloader --no-scripts && \
    rm -rf /root/.composer && \
    composer clear-cache && \
    pear config-set php_ini /etc/php7/php.ini && \
    pecl install opencensus-alpha

RUN mkdir -p public && \
    echo ${GIT_COMMIT_HASH} > public/commit.txt

COPY --from=opencensus-ext /usr/lib/php7/modules/opencensus.so /usr/lib/php7/modules

COPY --chown=nginx:nginx . /app/

# This step can't run without some classes from above step
RUN composer dump-autoload -o

RUN cd /app/ && php artisan optimize

EXPOSE 80

STOPSIGNAL SIGQUIT

ENTRYPOINT ["/entrypoint.sh"]
