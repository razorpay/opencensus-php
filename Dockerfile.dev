FROM c.rzp.io/razorpay/armory:wkhtmltopdf-v182 as wkhtmltopdf

FROM c.rzp.io/razorpay/onggi:php-7.2-api-web as opencensus-ext
WORKDIR /
ARG OPENCENSUS_VERSION_TAG=v0.7.6.4
RUN set -eux && \
    wget -O - https://github.com/razorpay/opencensus-php/tarball/"${OPENCENSUS_VERSION_TAG}" | tar xz --strip=1
RUN cd /ext && phpize && ./configure --enable-opencensus && make install

FROM c.rzp.io/razorpay/onggi:php-7.2-api-web

COPY --from=wkhtmltopdf /bin/wkhtmltopdf /usr/bin/wkhtmltopdf

RUN pear config-set php_ini /etc/php7/php.ini
RUN pecl install opencensus-alpha

COPY --from=opencensus-ext /usr/lib/php7/modules/opencensus.so /usr/lib/php7/modules

VOLUME ['/app']

WORKDIR /app

ARG GIT_TOKEN

RUN apk add make git
ADD Makefile /app
ADD error_modules /app
ADD "https://www.random.org/cgi-bin/randbyte?nbytes=10&format=h" skipcache
RUN make error-module-clean
RUN make error-module-fetch

EXPOSE 80

ENTRYPOINT ["/usr/bin/dumb-init", "--single-child", "/app/dockerconf/entrypoint.dev.sh"]
