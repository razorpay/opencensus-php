FROM harbor.razorpay.com/razorpay/onggi-multi-arch:curl-7.82 as curl-cli
FROM harbor.razorpay.com/razorpay/onggi-multi-arch:php-8.1-opencensus as opencensus-ext

FROM harbor.razorpay.com/razorpay/onggi-multi-arch:php-8.1-api-web-v2

COPY --from=curl-cli /usr/bin/curl /usr/bin/

RUN pear81 config-set php_ini /etc/php81/php.ini
RUN pecl81 install opencensus-alpha

COPY --from=opencensus-ext /usr/lib/php81/modules/opencensus.so /usr/lib/php81/modules

VOLUME ['/app']

WORKDIR /app

ARG GIT_TOKEN
ENV GIT_TOKEN $GIT_TOKEN
ARG CACHEBUST

ADD Makefile /app
ADD error_modules /app
RUN echo ${CACHEBUST}
RUN make error-module-clean
RUN make error-module-fetch

EXPOSE 80

ENTRYPOINT ["/usr/bin/dumb-init", "--single-child", "/app/dockerconf/entrypoint.dev.sh"]
