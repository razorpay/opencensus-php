FROM razorpay/pithos:rzp-php7.0-nginx

RUN apk add --update lsof nodejs

COPY . /app/

RUN chown -R nginx.nginx /app

COPY ./dockerconf/entrypoint.sh /entrypoint.sh

WORKDIR /app

RUN npm install && \
    cd web && npm install && cd .. && \
    npm run build && \
    apk del nodejs

EXPOSE 80

ENTRYPOINT ["/entrypoint.sh"]
