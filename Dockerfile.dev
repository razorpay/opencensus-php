FROM razorpay/pithos:rzp-alpine3.6-php7.1-nginx

VOLUME ["/app"]

RUN apk add --update lsof && \
    apk add --virtual nodejs-deps nodejs-current nodejs-npm && \
    chown -R nginx.nginx /app

COPY ./dockerconf/entrypoint.sh /entrypoint.sh

WORKDIR /app

#Please run these manually. TODO:Avoid Errors while doing directly.
#RUN npm install && \
#    cd web && npm install && cd .. && \
#    npm run build && \
#    echo $GIT_COMMIT_HASH > public/commit.txt && \
##   Skipping tests till deploy to QA
##   npm test && \
#    apk del nodejs-deps

EXPOSE 80

ENTRYPOINT ["/entrypoint-dev.sh"]
