#!/bin/bash

EXIT_CODE=0

while read FILE; do
if [[ -f $FILE ]]; then
    php -l "$FILE" 1> /dev/null
    if [ $? -ne 0 ]; then
        EXIT_CODE=1
    fi
fi
done < <(git diff --cached --name-only | grep -i ".php$")

if [[ $EXIT_CODE -eq 1 ]];then
  printf "\e[1;31m\tAborting commit due to files with syntax errors.\e[0m\n" >&2;
fi

exit $EXIT_CODE
