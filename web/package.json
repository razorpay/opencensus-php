  "scripts": {
    "unit-tests": "NODE_PATH=./js mocha 'test/**/*.js' --full-trace --require @babel/register",
    "test": "nyc --reporter=text yarn unit-tests",
    "test:jest": "jest --config=./jest.config.js",
    "test:jest:ci": "yarn test:jest --silent --ci --json --coverage --testLocationInResults --outputFile=report.json",
    "test:jest-watch-changed": "jest --watch",
    "test:jest-watch": "jest --watchAll --silent=false",
    "compress": "cd css && simple-webp-converter assets/*",
    "storybook": "start-storybook -p 6006 -s ../public",
    "build-storybook": "build-storybook",
    "tsc": "tsc",
    "chromatic": "chromatic --project-token $CHROMATIC_TOKEN --auto-accept-changes --exit-once-uploaded",
    "test:build:merchant": "NODE_OPTIONS=--max-old-space-size=8192 DANGER_ENV=true STAGE=production PROJECT=merchant universe build --disable-image-optimization --disable-differential-builds",
    "test:setup": "universe-test web-e2e install",
    "test:e2e": "universe-test web-e2e test",
    "test:e2e:payments-automation": "INCLUDE_GROUPS=@suite=payments-automation yarn test:e2e",
    "test:e2e:payments-canary": "INCLUDE_GROUPS=@suite=payments-canary yarn test:e2e",
    "test:e2e:show-report": "universe-test web-e2e show-report",
    "devstack-deploy": "universe-test infra-e2e devstack-deploy",
    "devstack-revert": "universe-test infra-e2e devstack-revert",
    "test:e2e-infra": "universe-test infra-e2e e2e-run",
    "dev:build-merchant": "STAGE=development PROJECT=merchant universe dev",
    "dev:build-merchantLA": "STAGE=development PROJECT=merchantLA universe dev",
    "dev:build-razorx": "STAGE=development PROJECT=razorx universe dev",
    "dev:build-pokedex": "STAGE=development PROJECT=pokedex universe dev",
    "dev:build-newAuth": "STAGE=development PROJECT=newAuth universe dev",
    "dev:build-merchantTnc": "STAGE=development PROJECT=merchantTnc universe dev",
    "prod:build-merchant": "STAGE=production PROJECT=merchant universe build --disable-image-optimization --disable-differential-builds",
    "prod:build-merchantLA": "STAGE=production PROJECT=merchantLA universe build --disable-image-optimization --disable-differential-builds",
    "prod:build-razorx": "STAGE=production PROJECT=razorx universe build --disable-image-optimization --disable-differential-builds",
    "prod:build-pokedex": "STAGE=production PROJECT=pokedex universe build --disable-image-optimization --disable-differential-builds",
    "prod:build-newAuth": "STAGE=production PROJECT=newAuth universe build --disable-image-optimization --disable-differential-builds",
    "prod:build-merchantTnc": "STAGE=production PROJECT=merchantTnc universe build --disable-image-optimization --disable-differential-builds",
    "prod-build-all": "NODE_OPTIONS=--max-old-space-size=8192 STAGE=production run-p prod:build-*"
  },
