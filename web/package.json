  "scripts": {
    "unit-tests": "NODE_PATH=./js mocha 'test/**/*.js' --full-trace --require @babel/register",
    "test": "nyc --reporter=text npm run unit-tests",
    "test:jest": "jest",
    "test:jest-watch": "jest --watchAll --silent=false",
    "test:e2e": "jest -c jest.e2e.config.js",
    "dev:e2e": "jest -o -c jest.e2e.config.js",
    "start": "STAGE=development node tools/build.js --project=merchant",
    "debug": "STAGE=development node --nolazy --inspect-brk=9229 tools/build.js --project=merchant",
    "start:all": "STAGE=development run-p build:*",
    "start:newAuth": "STAGE=development node tools/build.js --project=newAuth",
    "build:merchant": "node tools/build.js --project=merchant",
    "build:merchantLA": "node tools/build.js --project=merchantLA",
    "build:razorx": "node tools/build.js --project=razorx",
    "build:pokedex": "node tools/build.js --project=pokedex",
    "build:newAuth": "node tools/build.js --project=newAuth",
    "build:merchantTnc": "node tools/build.js --project=merchantTnc",
    "staging:build": "STAGE=staging run-p build:*",
    "production:build": "STAGE=production run-p build:*",
    "e2e:build": "STAGE=production REDIRECTOR=true npm run build:merchant",
    "storybook": "start-storybook -p 6006 -s ../public",
    "build-storybook": "build-storybook",
    "tsc": "tsc",
    "chromatic": "chromatic --project-token $CHROMATIC_TOKEN --auto-accept-changes --exit-once-uploaded"
  },
