.Button
  background: #fff linear-gradient(to bottom, transparent 60%, rgba(0,0,0,0.04))
  color: #414141
  padding: 11px 20px
  line-height: 16px
  border-radius: 2px
  border: 1px solid #e6e7e8
  outline: none
  margin-right: 12px
  transition: 0.15s, 0.3s border
  &:active
    color: #58666e
    background-color: #cfcfcf
    border-color: #94abb1
    box-shadow: inset 0 3px 5px rgba(0,0,0,0.125)

  &:hover
    background-color: #f2f2f2

  &.disabled
    cursor: not-allowed
    opacity: 0.5

.Button--primary
  background-color: $primary-color
  color: #fff
  border: darken($primary-color, 10%)

  &:hover
    color: #fff
    background-color: #2371ec
    border-color: #135fd9

  &:active
    color: #fff
    background-color: #135fd9
    border-color: #0e449c

.Button-icon
  float: left
  margin: 0 4px 0 -4px

.Button-icon--after
  float: right
  margin: 0 -4px 0 4px
