.Button
  background: #fbfbfb
  color: #414141
  padding: 11px 20px
  line-height: 16px
  border-radius: 2px
  border: 1px solid #e6e7e8
  outline: none
  margin-right: 12px
  transition: 0.15s, 0.3s border

  &:hover:not(:disabled)
    background: #ececec
    border-color: #d8d8d8

  &:active:not(:disabled)
    color: #58666e
    background: #dcdcdc

  &:disabled
    cursor: not-allowed !important
    opacity: 0.5

.Button--transparent
  background: transparent
  color: $primary-color
  border: 0
  padding: 0
  margin: 0
  line-height: inherit

  &:hover:not(:disabled)
    background: transparent
    color: $primary-color-hover
    opacity: 0.85

  &.Button--Link
    &:not(:disabled)
      &:active, &:focus
        background: transparent
        color: #135fd9
        box-shadow: none
        text-decoration: none

      &:hover
        text-decoration: underline

.Button--primary
  background: $primary-color
  color: #fff
  border: darken($primary-color, 10%)

  &:hover:not(:disabled)
    color: #fff
    background: $primary-color-hover
    border-color: #135fd9

  &:active:not(:disabled)
    color: #fff
    background: #135fd9
    border-color: #0e449c

.Button-icon
  float: left
  margin: 0 4px 0 -4px

.Button-icon--after
  float: right
  margin: 0 -4px 0 4px
