.Modal-backdrop
  position: fixed
  background-color: rgba(17, 30, 60, 0.4)
  top:0
  left: 0
  width: 100%
  height: 100%
  z-index: 9999
  transition: opacity 250ms ease-in-out

  &--hide
    opacity: 0

    .Modal-content
      opacity: 0


.Modal-content
  position: relative
  margin: 65px auto
  width: 90%
  max-width: 960px
  background: #fff
  animation: moveDown 250ms ease-in-out
  border-radius: 4px
  overflow: hidden

.Modal-close
  position: absolute
  color: #58666E
  font-size: 30px
  padding: 10px
  right: 8px
  top: 8px
  line-height: 20px
  cursor: pointer
  z-index: 1


@keyframes moveDown
  0%
    transform: translateY(-48px)

  100%
    transform: translateY(0)
