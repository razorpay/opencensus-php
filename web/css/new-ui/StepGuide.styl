/* stylelint-disable */
$stepIndicatorSize = 36px

.StepGuide
  border-radius: 3px
  background: #fff
  box-shadow: 0 0 0 1px rgba(63,63,68,0.05), 0 1px 3px 0 rgba(63,63,68,0.15)
  padding: 24px
  margin-bottom: 24px
  position: relative

  .StepGuide-indicator
    position absolute
    top 50%
    font-size 22px
    &.i-chevron-left
      left 20px
    &.i-chevron-right
      right 20px
          
  .StepGuide--Close
    position: absolute
    top: 24px
    right: 24px
    z-index: 1
    cursor: pointer

  .StepGuide--Steps
    padding: 24px 0
    display: table
    width: 100%
    height: 100%
    position: relative
    z-index: 1

.StepGuide--Step
  display: table-cell
  vertical-align: top
  position: relative
  width: 200px
  height: 100%
  text-align: center

  .PlaceholderLoader
    height: 1em

  &:first-child .Step--Connector
    display: none

  &.status-active
    .Step--Indicator
      padding: 0

    .Step--Connector
      .Connector--Content
        background-image: url('assets/onboarding/active_connector.png')

  .Step--Connector
    position: absolute
    top: 16px
    left: 0
    transform: translate(-50%, 0)
    width: 100%
    padding-left: 26px
    padding-right: 26px
    height: 4px

    .Connector--Content
      background: transparent url('assets/onboarding/inactive_connector.png') 50% 0 no-repeat
      width: 100%
      height: 100%

  .Step--Indicator
    margin: 0 auto
    width: $stepIndicatorSize
    height: $stepIndicatorSize
    border-radius: 50%
    overflow: hidden
    margin-bottom: 22px
    padding: 6px

    .PlaceholderLoader
      vertical-align: top
      width: 100%
      height: 100%
      border-radius: 50%

    img
      display: block
      width: 100%
      height: 100%

  .Step--Content
    padding: 0 8px

    .Content--Title
      font-weight: bold
      font-size: 16px
      line-height: 19px
      margin-bottom: 12px

    .Content--Body
      font-size: 14px
      line-height: 20px
      max-width: 300px
      margin: auto

    .btn
      margin-top: 18px

.StepGuide--Switcher
  display: table
  position: absolute
  top: 100%
  left: 50%
  transform: translate(-50%, -100%)
  line-height: 8px
  margin-top: -20px

  .Switcher-switch
    display: inline-block
    width: 8px
    height: 8px
    margin-left: 18px
    background-color: #D9D9D9
    border-radius: 50%
    cursor: pointer

    &.active
      cursor: default
      background-color: #939393

    &:first-child
      margin-left: 0

.QuickGuide
  position: relative
  overflow: hidden

  &:after
    content: ''
    width: 418px
    height: 158%
    background: linear-gradient(173.46deg, #FDFDFF 0%, #EDF8FE 100%)
    position: absolute
    right: -194px
    z-index: 1
    bottom: -8px
    transform: rotateZ(222deg) rotateY(122deg) rotateX(18deg)

    @media (max-width: 767px)
      display: none

  &:not(.StepGuide-mobile):before
    content: ''
    background-image: url('assets/product_onboarding/quick_guide.svg')
    background-position: bottom left
    background-repeat: no-repeat
    position: absolute
    z-index: 3
    left: 0
    bottom: 0
    width: 100%
    height: 100%

    @media (min-width: 768px) and (max-width: 1024px)
      opacity: 0.2

  &.i18N-Org:before
    background-image: url('assets/product_onboarding/quick_guide_i18n.svg')

    @media (min-width: 768px) and (max-width: 1024px)
      opacity: 0.2

  .StepGuide--Title
    position: relative
    z-index: 2
    font-weight: bold

    &:before
      content: ''
      position: absolute
      z-index: -1
      left: -40px
      top: -48px
      width: 150px
      height: 400px
      background: #f1fafe
      transform: rotateZ(-27deg)

      @media (min-width: 768px) and (max-width: 1024px)
        opacity: 0.2

      @media (max-width: 767px)
        display: none

  .divider
    height: 3px
    width: 20px
    background-color: #6EEDB3
    margin-top: 6px
    z-index: 2

  .StepGuide--Steps
    width: 70%
    margin: 0 auto
    z-index: 4
    @media (min-width: 768px) and (max-width: 1024px)
      width: 100%

  .StepGuide--Close
    z-index: 4
    .done
      color: #528FF0
      font-size: 16px
      font-weight: bold

.QuickGuide.no-img::before
    background: none
    
.StepGuide--Route,
.StepGuide--Invoices,
.StepGuide--PaymetPages,
.StepGuide--PaymentLinks,
.StepGuide--SmartCollect
  position: relative
  overflow: hidden
  &:after
    content: ''
    width: 418px
    height: 158%
    background: linear-gradient(173.46deg, #fbfdff 0%, #edf8fe 100%)
    position: absolute
    right: -194px
    z-index: 1
    bottom: -8px
    transform: rotateZ(222deg) rotateY(122deg) rotateX(18deg)
    @media (max-width: 767px)
      display: none
  .StepGuide--Steps
    width: 50%

.QuickGuide-v2
  margin: 20px 20px 0

.QuickGuide-v2.batch-payment-page
  .StepGuide--Steps
    width: 70%