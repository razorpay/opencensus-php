.RangeSlider--container
  background: rgba(22, 47, 86, 0.05);
  border-radius: 10px;
  width: 100%;
  height: 10px;
  position: relative;
  margin: 10px 0px;

  &:hover
    background: rgba(27, 34, 106, 0.1);

  .RangeSlider--track
    position: absolute;
    background: #528FF0;
    height: 10px;
    border-radius: 10px;
    max-width: 100%;

  .RangeSlider--thumb
    width: 10px;
    height: 10px;
    position: absolute;
    border-radius: 10px;
    cursor: pointer;
    transform: translateX(-50%);
