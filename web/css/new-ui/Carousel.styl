.bannerCarouselModal {
    max-width: fit-content;
    border-radius: 10px;
}

.primaryCta {
    width: 122px;
    height: 40px;
    background: #2B83EA;
    border-radius: 2px;
    border: none;
    color: $text;
    font-weight: bold;
    &:not(:disabled):hover,
    &:not(:disabled):focus,{
        color: $text;
        background: #2B83EA;
    }

}
.disableTextCta {
    font-weight: bold;
    font-size: 14px;
    line-height: 20px;
    color: rgba(255, 255, 255, 0.38);
    border: none;
    background: transparent;
    &:not(:disabled):hover{
        color: rgba(255, 255, 255, 0.38);
        border: none;
        background: transparent;
    }
}
#carousel {

    position relative;
    max-width: 1166px;
    flexProp(row,flex-start);
    margin: 20px;
    background-color: $text;
    border-radius: 8px;
    .carouselNav {
        height: 24px;
        width: 24px;
        border: 2px solid #2B83EA;
        border-radius: 100%;
        background: #F3F8FE;
        box-shadow: 0px 0px 0 6px #f3f8fe;
        flexProp(row);
        color: #2b83ea;
        font-size: 15px;
        cursor: pointer;

        &:hover {
            background: #2B83EA;
        }
        .arrowHover:hover {
            color: #fff;
        }
    }


    .carousel__left{
        position: absolute;
        left: -10px;
        top:50%;
    }


    .carousel__right{
        position: absolute;
        right: -10px;
        top:50%;
    }
    .carousel__list{

        width:1166px;
        flexProp(row,flex-start);
        overflow: scroll;

        .carouselCard {
            flexProp(row,space-between);
            flex: 1 0 100%;

            &__content {
                padding-left: 32px;
                div:nth-of-type(1){
                    margin: 10px 0;
                }
                div:nth-of-type(2){
                    font-style: normal;
                    font-weight: bold;
                    font-size: $ft24;
                    margin-bottom: 16px;
                }
                div:nth-of-type(3){
                }

            }
        }
        @media only screen and (max-width: 500px) {
                .carouselCard {
                    flexProp(column,space-between);
                }
        }
    }
}
#carouselModal {

    width: 1012px;
    height: 580px;
    position: relative;
    background-color: #181D32;

    background-image: url('https://cdn.razorpay.com/static/assets/growth-assets/carousel-banner/modalBack.svg');
    & > button {
        background: transparent;
        border: none;
        font-size: 20px;
        position: absolute;
        right: 25px;
        top: 25px;
    }
    .carouselModal__image {
        width: fit-content;
        height: 580px;
        img {
            width: 100%;
            height: 100%;
        }
    }
    .modalCta {
        position: absolute;
        right: 160px;
        bottom: 80px;
        .disable {
            color: rgba(255, 255, 255, 0.38);
            background: none;
            font-size: $ft14;
            font-weight: bold;
        }
    }
}
