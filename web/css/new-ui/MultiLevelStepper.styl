$parent-step-bullet-radius = 14px;
$step-bullet-radius = 8px;
$base-step-trail-width = 2px;
$active-step-trail-width = 3px;
$completed-step-trail-width = 3px;
$timeline-left-distance = 22px;
$timeline-right-distance = 18px;
$timeline-parent-step-info-left-padding = 40px;
$timeline-parent-step-info-padding-top = 16px;
$timeline-step-info-left-padding = 40px;
$timeline-step-info-padding-top = 10px;
$timeline-reveal-animation-container = 18px;
$base-step-trail-zIndex = 1;
$timeline-step-trail-zIndex = 2;
$timeline-reveal-animation-container-zIndex = 3;
$timeline-step-zIndex = 4;

.multilevel-stepper{
  list-style: none;
  margin: 0;
  position: relative;
  padding: 0;

  &:before {
    z-index: $timeline-reveal-animation-container-zIndex;
    content: "";
    position: absolute;

    /* same as status bullet */
    width: 12px;
    left: $timeline-left-distance - ($timeline-reveal-animation-container / 2);
    bottom: 0;
    background: white;
    // animation: progress-fill 1.5s;
  }

  &:after {
    z-index: $base-step-trail-zIndex;
    opacity: 0.4;
    content: "";
    position: absolute;
    top: $timeline-parent-step-info-padding-top + $parent-step-bullet-radius;

    bottom: 0;
    border-right: $base-step-trail-width dashed rgba(59, 128, 238, 0.4);
    /* 10px from left, 6px -> radius of circle, -1px -> border width of line */
    left: $timeline-left-distance - ($base-step-trail-width/2);
  }

  .multilevel-step{
    position: relative;
    .multilevel-step__wrapper {
      position: relative;
      display: flex;
      padding: $timeline-parent-step-info-padding-top $timeline-parent-step-info-left-padding;

      &:after{
        z-index: $timeline-step-trail-zIndex;
        content: " ";
        /* half the radius of status = left + radius - line-width/2 */
        left: ($timeline-left-distance - ($active-step-trail-width / 2));
        top: ($timeline-parent-step-info-padding-top + ($parent-step-bullet-radius/ 2));
        height: 0;
        position: absolute;
      }

      .multilevel-step__status{
        z-index: $timeline-step-zIndex;
        position: absolute;
        display: flex;
        justify-content: center;
        align-items: center;
        border-radius: 50%;
        border: none;
        color: white;
      }
    }

    &:last-child .multilevel-step__wrapper{
      &:after{
        height: 100% - $parent-step-bullet-radius;
        /* 2px-> Border radius */
        top: $timeline-parent-step-info-padding-top + 2px;
        border-right: 2px solid white !important;
      }
    }
    &.parent-step.active.highlight{
      &:last-child .multilevel-step__wrapper{
        &:after{
          border-right: 2px solid #f3f8fd !important;
        }
      }
    }
    &.parent-step.pending.highlight{
      &:last-child .multilevel-step__wrapper{
        &:after{
          border-right: 2px solid rgb(254 250 245) !important;
        }
      }
    }
    &.parent-step.error.highlight{
      &:last-child .multilevel-step__wrapper{
        &:after{
          border-right: 2px solid rgba(11,112,231,0.05) !important;
        }
      }
    }
  }

  .multilevel-step.parent-step{
    .multilevel-step__wrapper {
      .multilevel-step__status {
        height: $parent-step-bullet-radius;
        width: $parent-step-bullet-radius;
        left: $timeline-left-distance - $parent-step-bullet-radius / 2 - 1px;
      }
      .multilevel-step__info_container {
        .title {
          margin: 0;
          margin-bottom: 2px;
          font-size: 15px;
          color: rgba(22, 47, 86, 0.74);
          font-weight: 600;
        }

        .description {
          font-size: 14px;
          color: rgba(22, 47, 86, 0.54);
        }

        .multilevel-step__step-action {
          display: block;
          margin: 12px 0;
        }
      }
    }
  }

  /* status wise styles*/
  .multilevel-step.parent-step.not_started{
    cursor: not-allowed;
    pointer-events: none;
    .multilevel-step__wrapper{
      .multilevel-step__status{
        background: white;
        height: $parent-step-bullet-radius + 2px;
        width: $parent-step-bullet-radius + 2px;
        border: 2px solid rgba(11, 112, 231, 0.8);
        left: $timeline-left-distance - ($parent-step-bullet-radius / 2) - 1px;
        top: $parent-step-bullet-radius + 2*2px + 2px;
      }
    }
  }

  //removed .active
  .multilevel-step.parent-step.partial-complete.expanded{
    .multilevel-step__wrapper{
      &:after{
        height: 100%;
        border-right: $active-step-trail-width solid rgba(59, 128, 238, 0.8);
      }
    }
  }
  //removed .active
  .multilevel-step.animate.parent-step.partial-complete{
    .multilevel-step__wrapper{
      &:after{
        animation: line-height-fill 0.4s;
      }
    }
  }

  .multilevel-step.active.highlight {
    transition: all 0.4s;
    transition-delay: 0.5s;
    background: rgba(11, 112, 231, 0.05);
    border-radius: 4px;
  }

  .multilevel-step.parent-step.active {
    .multilevel-step__wrapper{
      .multilevel-step__status{
        border: 2px solid #0b70e7;
        background: white;
        height: $parent-step-bullet-radius + 4px;
        width: $parent-step-bullet-radius + 4px;
        left:
                $timeline-left-distance - (($parent-step-bullet-radius + 4px)/ 2);
      }
    }
  }

  .multilevel-step.parent-step.animate.active {
    .multilevel-step__wrapper{
      .multilevel-step__status{
        transition: border 0.4s;
      }
    }
  }

  /* Pending state styles */
  .multilevel-step.active.pending {
    .multilevel-step__wrapper{
      .multilevel-step__status {
        border: none;
        width: 20px;
        height: 20px;
        left: $timeline-left-distance - (20px/2);
        top: $parent-step-bullet-radius + 2*2px;
        background: transparent;
      }
    }
  }

  .multilevel-step.pending.active.highlight {
    background: rgba(240, 138, 10, 0.05);
    border-radius: 4px;
  }

  /* Error state styles */
  .multilevel-step.active.error {
    .multilevel-step__wrapper{
      .multilevel-step__status {
        border: none !important;
        width: 24px;
        height: 24px;
        left: $timeline-left-distance - (24px/2);
        background: transparent;
      }
    }
  }

  .multilevel-step.error.active.highlight {
    background: rgba(238, 102, 25, 0.05);
    border-radius: 4px;
  }

  /* Completed states styles */
  .multilevel-step.parent-step.completed {
    cursor: pointer;
    .multilevel-step__wrapper {
      &:after{
        height: 100%;
        border-right: $completed-step-trail-width solid rgba(36, 168, 49, 0.8);
      }
    }
  }

  .multilevel-step.animate.parent-step.completed {
    .multilevel-step__wrapper {
      &:after{
        animation: line-height-fill 0.4s;
      }
    }
  }

  .multilevel-step.parent-step.completed{
    .multilevel-step__wrapper{
      .multilevel-step__status{
        border: 2px solid #24a832;
        background: #24a832;
        height: ($parent-step-bullet-radius + 2px);
        width: ($parent-step-bullet-radius + 2px);
        left: (
        $timeline-left-distance - (($parent-step-bullet-radius + 2px)/2)
        );
        top: $parent-step-bullet-radius + 4px
      }
    }
  }

  /* Steps */
  .multilevel-step.step{
    .multilevel-step__wrapper{
      top: ($timeline-step-info-padding-top + $parent-step-bullet-radius) / 2;
      position: relative;
      display: flex;
      padding: $timeline-step-info-padding-top $timeline-parent-step-info-left-padding;
      height: 100%;
      .multilevel-step__status{
        height: $step-bullet-radius + 4px;
        width: $step-bullet-radius + 4px;
        left: $timeline-left-distance - (($step-bullet-radius + 4px)/ 2) ;
        top: $step-bullet-radius;
      }
      &:after {
        //24px
        top: $timeline-step-info-padding-top + $parent-step-bullet-radius;
      }
      .multilevel-step__info_container{
        .title{
          margin: 0;
          font-size: 12px;
          color: rgba(22, 47, 86, 0.74);
        }
      }
    }
    &.highlight{
      background: none !important;
      .multilevel-step__wrapper .multilevel-step__info_container .title {
        font-weight: 600;
        color: rgba(11, 112, 231, 0.87);
      }
    }
  }
  .multilevel-step.step.completed.parent-partial-complete{
    cursor:pointer;
    .multilevel-step__wrapper{
      &:after{
        border-right: $active-step-trail-width solid rgba(59, 128, 238, 0.8);
        height: calc(100% - 4px);
      }
      .multilevel-step__status{
        background: #3b80ee;
      }
    }
  }

  // Completed step && parent complete
  .multilevel-step.step.completed.parent-complete{
    cursor:pointer;
    .multilevel-step__wrapper{
      &:after{
        height: 100%;
        border-right: $completed-step-trail-width solid rgba(36, 168, 49, 0.8);
      }
      .multilevel-step__status{
        background: #29c038;
      }
    }
  }

  .multilevel-step.step.active{
    cursor: pointer;
    .multilevel-step__wrapper{
      .multilevel-step__status{
        border: 2px solid #0b70e7;
        height: $step-bullet-radius + 3px;
        width: $step-bullet-radius + 3px;
        left: $timeline-left-distance - ($step-bullet-radius/ 2) - 3px;
        // left: $timeline-left-distance - ($parent-step-bullet-radius / 2) - 3px;
        /* border-width increased by 1, move left by same units */
        background: white;
      }
    }
  }

  // Pending step
  .multilevel-step.step.pending{
    .multilevel-step__wrapper{
      .multilevel-step__status{
        border: none;
        height: $step-bullet-radius;
        width: $step-bullet-radius;
        /* icon size: 24px */
        top: $step-bullet-radius + 6px + 4px;
        left: 18px;
        background: transparent;
      }
    }
  }

  // not_started step
  .multilevel-step.step.not_started{
    cursor: not-allowed;
    pointer-events: none;
    .multilevel-step__wrapper{
      .multilevel-step__status{
        visibility: hidden;
      }
    }
  }

  .multilevel-step.step.animater-enter{
    animation: slide-bottom 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94) both;
  }
}

// loading state
.multilevel-stepper.loading{
  &:after{
    border-right: $base-step-trail-width dashed #ebecf2;
  }
  .multilevel-step{
    &:not(:last-child){
      .multilevel-step__wrapper{
        &:after{
          display: none;
        }
      }
    }
  }

  .multilevel-step{
    .multilevel-step__wrapper{
      .multilevel-step__status {
        left: $parent-step-bullet-radius + 1px;
        border-color: #ebecf2 !important;
        background: #ebecf2 !important;
        background-size: 800px 100px;
        animation: placeHolderShimmer 1.2s forwards infinite linear;
      }
      .multilevel-step__info_container{
        .title,.description, .multilevel-step__step-action {
          color: transparent;
          background: #ebecf2;
          border: none;
          background: linear-gradient(to right, #ebecf2 0%, #dfe1ea 10%, #ebecf2 20%);
          background-size: 800px 100px;
          animation: placeHolderShimmer 1.2s forwards infinite linear;
        }
        .title {
          width: 120px;
          height: 16px;
        }
        .description {
          width: 220px;
          height: 14px;
        }
      }
    }
  }
}

@keyframes placeHolderShimmer {
  0% {
    background-position: -300px 0;
  }
  100% {
    background-position: 300px 0;
  }
}

@keyframes line-height-fill {
  0% {
    height: -300px 0;
  }
  100% {
    height: 300px 0;
  }
}
