    position: relative;
    top: -1px;
  }

  .modal-title {
    color: '#515978';
  }

  .modal-body {
    padding-top: 0;
  }
}

.refund-fee-structure {
  border-radius: 3px;
}

.block-refunds-note {
  display: flex;
  flex-direction: row;
  align-items: center;
  height: 60px;
  margin-bottom: 10px;
  border-radius: 2px;
  background: #FEF6DD;

  i {
    padding-left: 15px;
    font-size: 25px;
    color: #CD8214;
  }

  p {
    padding-left: 15px;
    padding-right: 6px;
    font-size: 12px;
