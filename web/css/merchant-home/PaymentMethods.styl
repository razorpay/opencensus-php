.dashboard .panel.payment-methods-container {
  .more-options-button .dropdown-menu {
    width: 180px;
  }

  ol.rzp-breadcrumb {
    margin-bottom: 0;

    li+li:before {
      content: '\f10d';
      font-family: merchant-icons !important;
    }
  }

  .rzp-tooltip {
    .rzp-tooltip-inner {
      font-size: 12px;
      line-height: 15px;
      overflow: hidden;

      .payment-amount {
        font-size: 14px;
        line-height: 16px;
        margin-bottom: 8px;

        small {
          font-size: 12px;
          vertical-align: bottom;
        }
      }

      .tooltip-footer {
        background-color: #E9E9E9;
        color: #A9A9A9;
        padding: 4px 10px;
        margin: 15px -10px -5px;

        i.i {
          display: inline-block;
          font-size: 10px;
          vertical-align: middle;
          margin-right: 6px;
        }
      }
    }
  }
}

.ir-help {
  color: #9fb1c7;
  padding-left: 5px;
}

.instant-refund-disable {
  opacity: 0.5;
}

.low-funds {
  height: 36px;
  width: 279px;
  color: #99A6AD;
  font-family: Lato;
  font-size: 12px;
  line-height: 18px;
  margin-top: -10px;

  .instant-refund-breakup-para {
    .external-gateway-instant-refund {
      font-weight: 700;
    }
  }
}

.low-funds > a {
  padding-left: 5px;
}

.refund-entity-update {
  display: flex;
  flex-direction: column;
}

.refund-update {
  display: flex;
  flex-direction: row;
  width: 30%;
  justify-content: space-between;
}

.refund-strike-text {
  color: #BDC6C8;
  text-decoration: line-through;
}

.update-description {
  color: #7C8299;
  font-family: Lato;
  font-size: 12px;
  line-height: 18px;
}

.refunds-overflow-box {
  margin: 0 -40px;
  border: 1px solid #adbcc92b;
  padding: 23px 18px 15px;
  box-shadow: 0 2px 6px #3e475421;
  border-radius: 2px;
  background-color: #fff;

  .InputField {
    input {
      border-left: 0 !important;
    }
  }

  .add-comment-div {
    margin-top: 20px;
    margin-bottom: 10px;
  }

  .text-danger, .help-block {
    text-align: left;
    margin-top: 10px;
  }

  /* Chrome, Safari, Edge, Opera */
  input::-webkit-outer-spin-button, input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  /* Firefox */
  input[type=number] {
    -moz-appearance: textfield;
    border-top-right-radius: 3px !important;
    border-bottom-right-radius: 3px !important;
    border-left: 0 !important;
  }

  .input-group-addon {
    border-top-left-radius: 3px;
    border-bottom-left-radius: 3px;

    &.focussed {
      background: #528ff02b;
      border-left-color: #528ff0;
      border-bottom-color: #528ff0;
      border-top-color: #528ff0;
      border-right-color: transparent;
      border-right: 0 !important;

      & + div {
        input {
          border-top: 1px solid #528ff0 !important;
          border-right: 1px solid #528ff0 !important;
          border-bottom: 1px solid #528ff0 !important;
        }
      }
    }

    &.error {
      background: #f04f501a;
      border-left-color: #F04F50;
      border-bottom-color: #F04F50;
      border-top-color: #F04F50;
      border-right-color: transparent;

      & + div {
        input {
          border-top: 1px solid #F04F50 !important;
          border-right: 1px solid #F04F50 !important;
          border-bottom: 1px solid #F04F50 !important;
        }
      }
    }
  }

  .refund-amt-input {
    font-size: 16px;
    padding-top: 2px;
    color: #0d2366;
  }

  .route-transfer-checkbox {
    padding-left: 14px;
  }

  .Input--checkbox {
    float: left;
    margin: 0;
  }

  div.low-funds {
    width: 100%;
    padding: 10px 10px 0 0;
    margin: -7px 0 15px;
  }
}

.comment-link-optional {
  font-size: 13px;
  margin: 14px 0 !important;
  display: block !important;
}

.instant-refund-check {
  background: #adbcc91a;
  padding: 10px;
  margin-top: 30px;
  border-radius: 3px;

  label {
    padding-left: 0;
  }

  input[type=checkbox] {
    margin-right: 12px;
  }

  .fee {
    float: right;
    color: #7B8199;
  }
}

.instant-refund-check.focussed {
  background: #edf4fe;
}

.instant-refund-breakup-para {
  font-size: 13px;
}

.mt10 {
  margin-top: 10px;
}

.mt20 {
  margin-top: 20px;
}

.refund-panel {
  padding: 15px 10px 10px;

  .refunds-speed-tag {
    background-color: #EBEFF2;
    color: #7B8199;
    border-radius: 3px;
    font-weight: 600;
    padding: 5px 10px;
    font-size: 12px;

    .i-help {
      position: relative;
      top: -1px;
    }
  }

  .p5 {
    padding: 5px;
  }

  .pl10 {
    padding-left: 10px !important;
  }

  p {
    color: #7B8199;
  }

  .refund-panel-col {
    border: 1px solid #EBEFF0;

    .radio-pointer {
      width: 30px;
      height: 30px;
      margin-top: -2px;
      float: right;
      margin-right: -5px;
    }

    .refund-speed-change-permission {
      float: right;
      margin: 0 !important;
      cursor: pointer;
      width: 20px;
      height: 20px;

      @media screen and (max-width: $screen-sm-min) {
        width: 15px;
        height: 15px;
      }
    }

    input[type=checkbox] {
      position: relative;
      bottom: 5px;
    }

    i.i-instant-refund {
      font-size: 18px;
      position: relative;
      bottom: 2px;
      margin-right: 5px;
    }

    i.i-outline-lock {
      float: right;
      font-size: 15px;
      padding: 4px 3px 3px 3px;
      background-color: #CD8214;
      border-radius: 100%;
      color: #F8FAFF;
    }

    &.active {
      background: #F8FAFF;
      border: 1px solid #528FF0;
    }

    &.disabled {
      border-color: #CD8214;
    }

    padding: 5px 12px 19px;
    border-radius: 3px !important;
  }

  .instant-refund-disabled-text {
    color: #CD8214;
  }

  .know-more {
    font-size: 13px;
    margin-left: 10px;
  }

  .panel-heading {
    .know-more {
      font-size: 15px;
      font-weight: 400;
    }
  }
}

#default-refund-container {
  .panel-heading {
    padding-top: 0;

    .know-more-label {
      margin-left: 5px;
    }

    .guide-link {
      border-left: 1px solid #528ff0;
      padding-left: 9px;
    }
  }

  .refund-speed-pannel {
    padding-bottom: 6px;

    .contact-support-link {
      margin-left: 0;

      strong {
        color: #528ff0;
      }
    }

    .pointer {
      color: #528ff0;
    }
  }
}

.route-transfer-check-container {
  i.i-check:before, .icon.i-check:after {
    content: none;
  }
}

.instant-refund-check-container {
  padding-left: 25px;

  input[name=instant_refund] {
    cursor: pointer;
  }
}

.route-transfer-check {
  margin-right: 8px !important;
}

.refunds-enable-overflow-box {
  margin: 0 -40px;
  border: 1px solid #adbcc92b;
  padding: 0 30px 15px;
  box-shadow: 0 2px 6px #3e475421;
  border-radius: 2px;
  background-color: #fff;

  .refunds-enable-title {
    font-size: 15px;
    font-weight: 700;
  }

  .refunds-enable-details {
    width: 60%;
    float: left;
  }

  .refunds-enable-image {
    width: 40%;
    float: left;
    position: relative;
    top: 25px;
  }
}

.d-block {
  display: block;
}

.main-page-process-instantly {
  button {
    margin-left: 10px;
    padding: 5px 10px;
  }

  p {
    color: #515978;
  }
}

.paypal-auto-onboarding {
  .know-more {
    margin-left: 10px;
    padding-right: 20px;
    border-right: 1px solid #b1abab;
  }

  .alert {
    border: 0;
    border-left: 4px solid #7397ff;
    background: #f1f4ff;

    h4 {
      color: #000;
      font-weight: 400;
      font-size: 14px;
    }

    p {
      color: #303133;
      font-weight: 500;
      font-size: 12px;
    }

    .inr {
      background: #f1f1f1;
      padding: 0 3px;
      border-radius: 2px;
    }
  }

  .paypal-onboard-img {
    position: relative;
    width: 15px;
    margin-right: 5px;
    top: -2px;
  }

  .paypal-onboard-button {
    float: right;
    background: #2B83EA;
    font-weight: 700;
    padding-right: 18px;
  }

  .paypal-onboard-icon {
    margin-right: 10px;
    margin-left: 5px;
  }
}

.status-text {
  text-transform: uppercase;
  font-size: 12px;
  padding: 0 16px;
}

.status-pill {
  border-radius: 28px;
  padding: 4px 0;
  font-weight: 700;
  margin-left: 20px;
  font-size: 10px;
  line-height: 16px;
  pointer-events: none;
}

.status-pill-warning {
  background: #cd82141a;
  color: #CD8214;
  width: 85px;
}

.status-pill-success {
  background: #1f890e1a;
  color: #1F890E;
}

.status-pill-danger {
  background: #d12d2d1a;
  color: #D12D2D;
}

.change-default-speed-btn {
  margin: 5px 5px 0;
  width: 100%;
  padding: 0 12px;
}

.refund-fee-structure {
  border-radius: 3px;

  .amt {
    color: grey;
    margin: 5px 0;
    font-size: 12px;
  }

  .panel-heading {
    background: #fff;
    padding: 10px 8px;
    font-size: 13px;
  }

  .panel-body {
    padding: 10px 8px 0;
    font-size: 13px;
  }

  .action-arrow {
    font-size: 20px;
    position: absolute;
    right: -8px;
    top: 0;
  }

  .show-fee-struct {
    color: #528ff0;
    position: relative;
    margin-right: 5px;
    cursor: pointer;
    padding-right: 11px;
  }

  .t-heading {
    color: #515978;
    font-weight: 700;
  }
}

div.enable-instant-refund-modal, div.instant-refund-fee-modal {
