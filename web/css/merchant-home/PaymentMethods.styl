.dashboard .panel.payment-methods-container {

  .more-options-button .dropdown-menu {

    width: 180px;
  }

  ol.rzp-breadcrumb {

    margin-bottom: 0;

    li+li:before {

      content: "\f10d";
      font-family: merchant-icons !important;
    }
  }

  .rzp-tooltip {

    .rzp-tooltip-inner {

      font-size: 12px;
      line-height: 15px;
      overflow: hidden;

      .payment-amount {

        font-size: 14px;
        line-height: 16px;
        margin-bottom: 8px;

        small {

          font-size: 12px;
          vertical-align: bottom;
        }
      }

      .tooltip-footer {

        background-color: #E9E9E9;
        color: #A9A9A9;
        padding: 4px 10px;
        margin: 15px -10px -5px -10px;

        i.i {

          display: inline-block;
          font-size: 10px;
          vertical-align: middle;
          margin-right: 6px;
        }
      }
    }
  }
}
