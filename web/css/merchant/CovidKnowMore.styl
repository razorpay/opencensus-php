.covid-know-more-container
  background-color white

  .description
    margin 10px 27px
    font-size 12px

  .content
    height 575px
    display flex
    flex-direction column
    background-color white

    .upper-panel
      display flex
      flex .9
      padding 0px 10px

      .info
        display flex
        flex-direction column
        background-color #FAFAFA
        border 1px solid rgba(173, 188, 201, 0.47)
        border-radius 3px
        margin 10px 18px
        font-size 13px

        p{
          margin-top 10px
        }

        .headline
          padding 12px 13px
          font-size 13px

        .item
          display flex
          flex .3
          flex-direction column

          .title
            display flex
            flex .5
            padding 6px 13px
            align-items center

            img
              border 1px solid #EDEDED

            span
              position relative
              margin-left 13px
              margin-top -20px

              i{
                position absolute
                width 100%
                top 20px
                left 0px
              }

          .bio
            display flex
            flex .5
            padding 5px 13px

    .lower-panel
      display flex
      flex .1
      justify-content center
      align-items center
      padding 5px 0px

      button
        width 80%
        font-weight bold

.covid-info-sidebar
  position absolute
  top 6%
  left 100%
  background-color #FAFAFA
  box-shadow inset 0px 0px 4px -1px rgb(0, 0, 0, 0.3)
  width 82%
  height 580px

  div:nth-child(1)
    text-align left
    margin 20px 0px 25px 26px

  div:nth-child(2)
    padding 0px 20px

  div:nth-child(3)
    width 65%
    margin auto

  ul
    padding-left 20px
    li
      margin-top 10px

    li:last-child
      margin-bottom 15px

  ul li::marker
    color black

  img
    width 100%
    height 100%

.covid__donations
  display flex

  i{
    margin 5px 5px 0px 0px
  }

