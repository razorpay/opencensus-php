.Shopify-Migration
  background: linear-gradient(60deg, #02042b, #2b178b 100%);
  content: '';

  @media (max-width: 768px)
    background: linear-gradient(60deg, #02042b, #2b178b 100%);
    transform: translateY(180deg);
    padding: 18px;

  .style-bg
    width: 100%;
    height: 100%;
    position: absolute;
    left: 0;
    top: 0;

  .deadline-style
    font-weight: bold;
    color: #FFFFFF;

  .shopify-bg-container
    z-index: 1;

  .btn
    color: #fefefe;
    opacity: 0.7;
    position: relative;
    z-index: 2;
    right: 30px;
    bottom: 10px;

    &:hover
      opacity: 1;

    @media (max-width: 768px)
      color: #a5a4a4;

  .content
    max-width: 40%;
    margin: 20px 0 28px 40px;
    z-index: 1;
    position: relative;

    @media (max-width: 768px)
      max-width: 90%;
      margin: 0 auto;

    .timer img
      width: 75px;
      height: 75px;
      padding: 2px;
      border-radius: 4px;

      @media (max-width: 768px)
        font-size: 13px;

    .hero-illustration img
      width: 466.2px;
      height: 384.8px;

      @media (max-width: 768px)
        width: 100%;
        height: 100%;

    .hero-illustration
      position: absolute;
      right: -500px;
      bottom: 7px;

      @media (max-width: 768px)
        position: static;
        display: flex;
        justify-content: center;
        align-items: center;

    .mweb-coupon-img
      height: 168px;

    .payments-text
      color: white;
      font-weight: 900;
      font-size: 34px;
      font-weight: 700;
      margin: 20px 0;
      width: 400px;

      .amount
        color: #1F890D;

      @media (max-width: 768px)
        text-align: left;
        line-height: 31.92px;
        font-size: 24px;
        font-weight: 700;
        margin-top: 50px;
        width: 100%;

    .below-text-line
      border: 4px solid #58C19C;
      width: 30px;
      margin: 0;
      position: relative;

      @media (max-width: 768px)
        bottom: 5px;

    .bottom-shopify-text
      color: #BDBFC2;
      font-family: 'Mulish';
      font-style: normal;
      font-weight: 500;
      font-size: 16px;
      margin-top: 22px;
      max-width: 96%;
      line-height: 24px;

      @media (max-width: 768px)
        text-align: left;
        margin-top: 8px;
        line-height: 22px;

    &__btn
      margin-top: 24px;

      @media (max-width: 768px)
        margin-bottom: 10px;
        display: flex;

      .accept-payment
        margin-right: 25px;
        padding: 12px 24px;

        @media (max-width: 768px)
          width: 100%;
          padding: 0;
          margin: 0;

    .find-out-more
      background: transparent;
      color: #2783F3;
      border: none;
      text-decoration: underline;
      font-weight: 900;

      @media (max-width: 768px)
        width: 100%;
