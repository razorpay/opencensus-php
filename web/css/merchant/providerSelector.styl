$white-color = #ffffff;

.provider-selector
  background: $white-color
  cursor: pointer
  position: relative
  display: inline-block
  width: 100%
  &::before
    content: "\f120"
    font-family: merchant-icons
    font-style: normal
    font-weight: normal
    position: absolute
    right: 2px
    font-size: 150%
    top: 3px
  
  input
    cursor: pointer
    &[disabled], &[readonly]
      background-color: $white-color
  
  ul 
    list-style-type: none
    padding-left: 0
    overflow-y: scroll
    max-height: 210px
    color: #162f56de
    margin-bottom: 0
    li 
      padding: 10px
      background: $white-color
      &:hover
        background: #e0e4f93d
  
  .input-select
    box-shadow: 0px 1px 3px -1px
    width: 20%
    position: absolute
    z-index: 1
    background: $white-color
    min-width: 215px
  
  .col-xs-10
    padding-left: 0
    padding-right: 0
  .col-xs-2
    padding-left: 0
    padding-right: 0
