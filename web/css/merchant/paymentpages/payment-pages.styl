.ModalForm--Share
  .Share-section
    padding-top: 24px

  .Share-section:not(:last-child)
    border-bottom: 1px solid rgba(155,155,155,0.19);
    padding-bottom: 24px

  .i-share-circle, .i-embed-btn
    color: $primary-color
    vertical-align: middle
    font-size: 20px
    margin-right: 12px

  .social-media
    float: right
    overflow: auto

    a
      margin-left: 16px
    img
      pointer-events: none
      width: 24px

  .ClipboardCustom .Input
    margin: 0
    width: 179px

  .Form .Input
    margin-top: 0

.Entity--paymentpage .panel-heading .text
  width: 68%
  display: inline-block
  white-space: nowrap
  overflow: hidden
  text-overflow: ellipsis
  vertical-align: bottom
  font-weight: 600

.Entity--paymentpage-v2 .panel-heading .text
  width 48%
