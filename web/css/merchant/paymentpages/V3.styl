.payment-pages-v3
  .btn-dotted
    display: inline-block
    border: 1px dashed rgba(82, 143, 240, .3)
    padding: 4px 12px
    line-height: 18px
    margin: 0

    span
      vertical-align: middle
      display: inline-block

    .enclose-circle
      width: 20px
      height: 20px
      border-radius: 50%
      line-height: 20px
      background-color: rgba(82,143,240,0.17)


  .Modal-container--CreatorModal-BaseForm
    overflow: unset
    padding: 20px 16px

    .base-form-side-btn
      position: absolute
      top: 24px
      font-size: 12px
      color: #fff
      margin: 0

      span
        display: block
        width: 32px
        height: 32px
        font-size: 20px
        border-radius: 2px
        color: $primary-color
        border: 1px solid rgba(82,143,240,0.77)
        margin-bottom: 4px
        line-height: 30px


    .base-form-close
      left: -48px
      &:hover
        color: #fff
        opacity: .8
      span
        background-color:#fff

    .base-form-save
      right: -48px
      &:hover
        color: #fff
        opacity: .8
      span
        color: #fff
        background-color: $primary-color

    .Input
      margin: 0
      .Input-error
        font-size: 12px

    .Input.Input--title
      display: inline-block
      width: 140px
      margin-right: 20px
      padding: 4px 0
      vertical-align: top

      .Input-el--resizer
        height: 24px

      .Input-el
        min-height: 24px
        padding: 0 2px
        border-top: none
        border-left: none
        border-right: none
        border-radius: 0

      .Field--fakeDisplay
        margin: 0
        pointer-events: none
        display: inline-block
        position: absolute
        left: 0
        top: 0
        z-index: 1
        padding: 0 2px // To mimic padding of actual element
        word-break: break-word

        .symbol--red
          position: absolute // Check if same can be done for hostedpage style, because sometimes, this star come in next line when text is full for previous line

    .placeholder-field
      cursor: not-allowed
      .Field-el
        pointer-events: none

    .Field--representation
      display: inline-block
      width: 262px
      margin-right: 0
      vertical-align: top

      select
        color: rgba(13, 35, 102, .3)

    .Input.Input--description
      margin: 4px 0

      .Input-el--resizer
        height: 24px

      .Input-el
        font-size: 12px
        min-height: 24px
        padding: 0 2px
        border-top: none
        border-left: none
        border-right: none
        border-radius: 0

    .Input--enum-list
      .Input-content
        max-height: 232px
        overflow-y: scroll
    .Input-enum-option
      .Input-el
        height: 32px

      .Input-el-btn
        top: 8px

    .OptionsDropdown
      position: absolute
      top: 20px
      right: 16px

    .OptionsDropdown-list
      left: 50%
      transform: translateX(-50%)
      animation-name: appearInCenter
      animation-duration: .12s

    .dropdown__trigger
      width: 32px
      height: 32px
      text-align: center
      padding: 5px
      border: 1px solid #dadada
      border-radius: 2px
      background-color: rgba(216, 216, 216, 0.27)

      &:active
        border: 1px solid $primary-color

      button
        color: #949494
        margin-right: 0


  .OptionsDropdown
    display: inline-block

    &:not(:first-child)
      margin-left: 13px

  .OptionsDropdown-list
    margin-top: 8px
    width: 214px
    border-radius: 4px
    border: 1px solid rgba(82,143,240,0.16)
    list-style: none
    padding: 0
    background-color: #fff
    box-shadow: 0 5px 9px 0 rgba(69,75,85,0.22)
    animation: appearIn 0.1s cubic-bezier(0.13, 1.04, 1, 1)
    transform-origin: center top

  .OptionsDropdown-title
    margin: 4px 8px
    font-size: 12px
    font-weight: bold
    margin-right: 20px

  .OptionsDropdown-item
    position: relative
    width: 100%
    margin: 0
    padding: 6px 12px
    line-height: 24px
    font-size: 14px
    cursor: pointer

    &:not(:last-child)::after
      content: ''
      position: absolute
      bottom: 0
      right: 12px
      left: 12px
      height: 1px
      background: #F6F6F6

    i
      display: inline-block
      vertical-align: middle
      font-size: 16px
      margin-right: 8px
      line-height: inherit
      pointer-events: none

    &:hover
      background-color: #f5f7f9

    .i-check
      display: none
      position: absolute
      top: 8px
      right: 8px
      color: $primary-color

  .OptionsDropdown-item--selected
    background: #f5f7f9
    .i-check
      display: block

  .FieldsDropdown
    &--udf .OptionsDropdown-list
      border-left: 2px solid rgba(13,186,147,0.78)

    &--amount .OptionsDropdown-list
      border-left: 2px solid #FFCA73

  .FieldOptionsDropdown
    .OptionsDropdown-item
      padding: 0
      & > div
        padding: 6px 12px


@keyframes appearIn
  0%
    opacity: 0
    transform: scale(.8)

  100%
    opacity: 1
    transform: scale(1)

@keyframes appearInCenter
  0%
    opacity: 0
    transform: translateX(-50%) scale(.8)

  100%
    opacity: 1
    transform: translateX(-50%) scale(1)
