.payment-pages-v3
  .btn-dotted
    display: inline-block
    border: 1px dashed rgba(82, 143, 240, .3)
    padding: 4px 12px
    line-height: 18px
    margin: 0

    span
      vertical-align: middle
      display: inline-block

    .enclose-circle
      width: 20px
      height: 20px
      border-radius: 50%
      line-height: 20px
      background-color: rgba(82,143,240,0.17)

  .OptionsDropdown
    display: inline-block

    &:not(:first-child)
      margin-left: 13px

    .OptionsDropdown-list
      width: 214px
      border-radius: 4px
      border: 1px solid rgba(82,143,240,0.16)
      list-style: none
      padding: 0
      background-color: #fff
      box-shadow: 0 5px 9px 0 rgba(69,75,85,0.22)

    .OptionsDropdown-title
      margin: 4px 8px
      font-size: 12px
      font-weight: bold
      margin-right: 20px

    .OptionsDropdown-item
      position: relative
      width: 100%
      margin: 0
      padding: 6px 12px
      line-height: 24px
      font-size: 14px
      cursor: pointer

      &:not(:last-child)::after
        content: ''
        position: absolute
        bottom: 0
        right: 12px
        left: 12px
        height: 1px
        background: #F6F6F6

      i
        display: inline-block
        vertical-align: middle
        font-size: 16px
        margin-right: 8px
        line-height: inherit
        pointer-events: none

      &:hover
        background-color: #f5f7f9

      .i-check
        display: none
        position: absolute
        top: 8px
        right: 8px
        color: $primary-color

    .OptionsDropdown-item--selected
      background: #f5f7f9
      .i-check
        display: block

  .FieldsDropdown
    .OptionsDropdown-list
      margin-top: 8px

    &--udf
      .OptionsDropdown-list
        border-left: 2px solid rgba(13,186,147,0.78)

    &--amount
      .OptionsDropdown-list
        border-left: 2px solid #FFCA73
