.request-chart
  padding-inline: 24px
  background-color: #ffffff
  padding-block: 12px

  .request-chart-toolbar
    display: flex
    justify-content: space-between
    padding-block: 12px

    .api-request
      padding-right: 10px
      font-weight: bold
      font-size: 16px
      padding-top: 2px

    .selected-filter-tag
      margin-left: 8px
      padding-inline: 10px
      padding-block: 2px
      border-radius: 20px
      background-color: #F7FBFF
      border: 0.897986px solid #1583F1
      color: #F7FBFF
      height: 26px

      span
        color: #262D3A
        font-size: 12px
    .aggregations-btn
      margin-right: 1px

    .aggregations
      width: 100%
      height: 100%
      padding-inline: 24px
      padding-top: 4px

  .request-chart-body
    border: 0.531164px solid #E0E8F4
    border-radius: 1.06233px
    padding: 16px
    height: 350px

  .request-chart-footer
    padding-block: 12px
    padding-inline: 36px
    background-color: #FCFCFC
    border: 0.531164px solid #E0E8F4
    border-radius: 1.06233px
    font-size: 11px
    color: #858C9A
