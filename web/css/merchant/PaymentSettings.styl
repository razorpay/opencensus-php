.capture-settings{
  background: white
  .content{
    display: flex
    flex-direction: column
    background: white

    .section{
      display: flex
      flex: .4
      flex-direction: row
      padding-left: 20px

      .section-action{
        display: flex
        flex: .1
        margin-top: 15px
        margin-left: -5px
        justify-content: center
      }

      .margin-top-20{
        margin-top: 20px
      }

      .margin-top-2{
        margin-top: 2px
      }

      .section-content{
        display: flex
        flex: .9
        flex-direction: column
        justify-content: center

        .title{
          font-weight: 600
          font-size: 15px
          line-height: 20px
          color: #515978
        }

        .description{
          color: #7B8199
          font-size: 13px
          padding-right: 30px
          padding-top: 5px
        }
      }
    }

    .actions{
        display: flex
        flex: .2
        flex-direction: column
        padding: 15px 23px 15px 23px
        justify-content: center
    }

    .dual-actions{
      display: flex
      flex: .2
      flex-direction: row
      padding: 15px 23px 15px 23px
      justify-content: space-evenly

      button{
        width: 42%
        height:75%
      }
    }
  }

  .content-small{
    height: 250px
  }

  .content-medium{
    height: 280px
  }
}

.payment-capture-panel{
  .panel-content{
   display: flex
   flex-direction: row
   justify-content: space-evenly

   .left-panel, .right-panel{
     display: flex
     flex: .5
     flex-direction: column
     background: #FFFFFF;
     border: 1px solid #d5d7d8;
     border-radius: 3px;

     .rzp-content-toggler{
       padding-left: 15px
      }

     .panel-header{
       display: flex
       flex: .4
       padding: 10px 15px 0px 15px
       justify-content: space-between

       input{
         margin-top: 10px
       }
      }

      .panel-description{
       display: flex
       flex: .4
       padding: 0px 0px 3px 15px
       @media screen and (max-width: $screen-sm-min) {
         display block
       }
      }
    }

    .is-active{
      background: #F8FAFF
      border: 1px solid #528FF0
      border-radius: 3px
    }
  }
}

.payment-capture-configuration-container{
  background: white

  .configuration-content{
    display: flex
    flex-direction: column

    .custom-timeout-subtitle{
      padding: 5px 0px 0px 25px
      font-size: 12px
    }

    .configuration-row__automatic{
      display: flex
      flex: .3
      flex-direction: column
      margin:0px

      .content-header{
        display: flex
        flex: .2
        justify-content: flex-start
        padding: 15px 0px 10px 45px
        font-weight: 600
        font-size: 14px
        line-height: 20px
        color: #515978
        position: relative
      }

      .content-subtitle{
        display: flex
        flex: .2
        justify-content: flex-start
        padding: 0px 0px 0px 45px
        font-size: 12px
        color: #4B95ED
      }

      .content-container{
        display: flex
        flex: .3
        flex-direction: column
        padding: 5px 0px 5px 45px

        >div{
          display: flex
          flex-direction: row
          height: 31px

          .input-mask{
            width: 16%

            &:nth-child(1){
              width: 14%
            }

            &:nth-child(even){
              width: 14%
            }

            &::after{
              content: attr(data-attr)
              position: relative
              top: -23px;
              left: 19px;
            }

            &:nth-child(1)::after{
              content: attr(data-attr)
              position: relative
              top: -23px;
              left: 11px;
            }
          }

          p{
            padding-right: 5px
            padding-left: 5px
          }
        }

        input{
          border-left: 0px;
          border-right: 0px;
          border-top: 0px;
          border-bottom-color: #8dc1ff;
          color: rgba(22, 47, 86, 0.54);
          text-align: left
        }

        input:not(:nth-child(1)){
          margin-left: -15px;
          width: 20%;
        }

        p{
          color: rgba(22, 47, 86, 0.54)
          font-size: 12px
        }
      }

      .content-action{
        display: flex
        flex: .3
        justify-content: flex-end;
        padding: 15px 35px;
      }
    }

    .configuration-row__manual{
      display: flex
      flex: .3
      flex-direction: column
      margin:0px

      .help-text{
        padding: 0px 5px 10px 45px
        font-size: 13px
        color: #7B8199
      }

      .info-text{
        position: relative
        padding-top: 10px

        >div{
          border: 2px solid #528FF0;
          position: absolute;
          height: 36px;
          left: 45px;
        }

        p{
          padding: 1px 5px 0px 60px
          font-size: 13px
        }
      }

      .content-header{
        display: flex
        flex: .2
        justify-content: flex-start
        padding: 15px 0px 10px 45px
        font-weight: 600
        font-size: 14px
        line-height: 20px
        color: #515978
        position: relative

        button{
          margin-left: 30px
          height: 23px
          width: 51px
          padding-top: 0px
        }
      }

      .content-subtitle{
        display: flex
        flex: .2
        justify-content: flex-start
        padding: 0px 0px 0px 45px
        font-size: 12px
        color: #4B95ED
      }

      .content-container{
        display: flex
        flex: .3
        flex-direction: column
        padding: 5px 0px 5px 45px

        >div{
          display: flex
          flex-direction: row
          height: 31px

          .input-mask{
            width: 16%

            &:nth-child(1){
              width: 14%
            }

            &:nth-child(even){
              width: 14%
            }

            &::after{
              content: attr(data-attr)
              position: relative
              top: -23px;
              left: 19px;
            }

            &:nth-child(1)::after{
              content: attr(data-attr)
              position: relative
              top: -23px;
              left: 11px;
            }
          }

          p{
            padding-right: 5px
            padding-left: 5px
          }
        }

        input{
          border-left: 0px;
          border-right: 0px;
          border-top: 0px;
          border-bottom-color: #8dc1ff;
          color: rgba(22, 47, 86, 0.54);
          text-align: left
        }

        input:not(:nth-child(1)){
          margin-left: -15px;
          width: 20%;
        }

        p{
          color: rgba(22, 47, 86, 0.54)
          font-size: 12px
        }
      }

      .content-action{
        display: flex
        flex: .3
        justify-content: flex-end
        padding: 15px 35px

        button:nth-child(1){
          margin-right: 15px
        }
      }
    }

    .configuration-row__refund{
      display: flex
      flex: .3
      flex-direction: column
      margin:0px

      .help-text{
        padding: 0px 5px 10px 45px
        font-size: 13px
        color: #7B8199
      }

      .content-header{
        display: flex
        flex: .2
        justify-content: flex-start
        padding: 15px 0px 10px 45px
        font-weight: 600
        font-size: 14px
        line-height: 20px
        color: #515978
        position: relative
      }

      .content-subtitle{
        display: flex
        flex: .2
        justify-content: flex-start
        padding: 0px 0px 0px 45px
        font-size: 12px
        color: #4B95ED
      }

      .content-container{
        display: flex
        flex: .3
        flex-direction: column
        padding: 5px 0px 5px 45px

        .Input{
          width: 90%
          margin:0px
        }

        p{
          padding-top: 5px
          color: rgba(22, 47, 86, 0.54)
          font-size: 12px
        }
      }

      .content-action{
        display: flex
        flex: .3
        justify-content: flex-end
        padding: 15px 30px

        button:nth-child(1){
          margin-right: 15px
          width: 30%
        }

        button:nth-child(2){
          width: 35%
        }
      }

      .rzp-tooltip-inner{
        position: relative;
        left: -553px;
        top: -65px;
      }
    }

    .highlight{
      margin: 0px -25px 0px -25px
      background: white
      box-shadow: 0px 2px 6px rgba(62, 71, 84, 0.13)
      border-radius: 2px
      padding-left: 25px
      padding-right: 15px
    }

    input[type=number]::-webkit-inner-spin-button,
    input[type=number]::-webkit-outer-spin-button {
      -webkit-appearance: none;
    }
 }
}

.full-span-modal-manual-normal{
  height:400px
}

.full-span-modal-manual-optimum{
  height:425px
}

.full-span-modal-automatic-normal{
  height : 450px
}

.full-span-modal-automatic-optimum{
  height : 490px
}

.content-header{
  &::before{
    content: ''
    position: absolute
    height:15px
    width: 15px
    background: #F8F8F8;
    left: 20px;
    top: 17px;
    border-radius: 7px;
    border: 1px solid #5D8FE9;
  }
}

.content-filled{
  &::before{
    content: url('assets/tick.svg')
    position: absolute
    height:16px
    width: 16px
    left: 20px;
    top: 17px;
    border-radius: 8px;
    border: 1px solid #5D8FE9;
    background: #c1dbf9;
    color:#2B83EA;
    font-size: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
}

.vertical-connector{
  position: absolute
  height:32px
  width: 1px
  background: #F8F8F8
  left: 26.5px
  border-radius: 7px
  border: 1px solid rgba(93, 143, 233, 0.24);
}


.timeouts-container
  .timeout-item{
    font-size: 13px
    color: #7B8199
    padding: 5px 0px 7px 0px
    position: relative
  }

  div:last-child{
    cursor: pointer
  }

.timeoutview-toggler
  margin-bottom 6px

.payments-capture__help-text
  margin-bottom 16px
