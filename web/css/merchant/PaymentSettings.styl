.full-span-modal{
  height:430px
}

.content-header{
  &::before{
    content: ''
    position: absolute
    height:15px
    width: 15px
    background: #F8F8F8;
    left: 20px;
    top: 17px;
    border-radius: 7px;
    border: 1px solid #5D8FE9;
  }
}

.content-filled{
  &::before{
    content: '\2713'
    position: absolute
    height:16px
    width: 16px
    left: 20px;
    top: 17px;
    border-radius: 8px;
    border: 1px solid #5D8FE9;
    background: #c1dbf9;
    color:#2B83EA;
    font-size: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
}


.vertical-connector{
  position: absolute
  height:32px
  width: 1px
  background: #F8F8F8
  left: 26.5px
  border-radius: 7px
  border: 1px solid rgba(93, 143, 233, 0.24);
}

.horizontal-timeline-toggle {
  display: inline-block
  cursor: pointer
  color:#528FF0
  font-size: 13px
  line-height: 18px
  margin:18px 0px

}

.horizontal-timeline {
  display: flex
  width: 100%
  border: 1px solid #e5e5e5
  border-radius: 2px
  padding: 20px
  justify-content: center

  .line-container {
    display: flex
    width: 100%;
    justify-content: center
    align-items: center
    margin-left: 20px
  }

  .line {
    flex-grow: 1
    height: 1px
    background: #528ff0
    position: relative
  }

  .line.arrow-right:after {
    position: absolute
    content: ""
    bottom: -5px
    right: 0
    width: 0
    height: 0
    border-top: 5px solid transparent
    border-bottom: 5px solid transparent
    border-left: 5px solid #528ff0
  }

  .line.arrow-left:after {
    position: absolute
    content: ""
    top: -5px
    left: 0
    width: 0
    height: 0
    border-top: 5px solid transparent
    border-bottom: 5px solid transparent
    border-right: 5px solid #528ff0
  }

  .circle {
    height: 10px
    width: 10px;
    border: 2px solid #528ff0
    border-radius: 50%
  }


  .item-one {
    flex-shrink: 0
    display: flex;
    flex-direction: column
    width: 100%
    min-width: 500px
  }

  .title {
    font-size: 14px
    font-style: bold
    text-align: left
    color: #515978
    line-height: 18px
    margin-bottom: 10px
  }
  .details {
    display: flex
    width: 100%
    font-size: 14px
    align-items: flex-start
    justify-content: flex-start
    margin-left: 22px
  }
  .details_time {
    flex: 1
    text-align: left
    color: #9fa8ae
    margin-top: 10px
  }
  .details_text {
    margin: 10px
    margin-right: 24px
    padding: 10px
    flex: 2
    text-align: center
    background: #f2f6f9
    color: #58666e
    font-size: 12px
    line-height: 18px
    border-radius: 4px
  }
}

