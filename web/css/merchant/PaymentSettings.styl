.capture-settings{
  background: white
  .content{
    display: flex
    flex-direction: column
    background: white

    .section{
      display: flex
      flex: .4
      flex-direction: row
      padding-left: 20px

      .section-action{
        display: flex
        flex: .1
        margin-top: 15px
        margin-left: -5px
        justify-content: center
      }

      .margin-top-20{
        margin-top: 20px
      }

      .margin-top-2{
        margin-top: 2px
      }

      .section-content{
        display: flex
        flex: .9
        flex-direction: column
        justify-content: center

        .title{
          font-weight: bold
          font-size: 15px
          line-height: 20px
          color: #515978
        }

        .description{
          color: #7B8199
          font-size: 13px
          padding-right: 30px
          padding-top: 5px
        }
      }
    }

    .actions{
        display: flex
        flex: .2
        flex-direction: column
        padding: 15px 23px 15px 23px
        justify-content: center
    }

    .dual-actions{
      display: flex
      flex: .2
      flex-direction: row
      padding: 15px 23px 15px 23px
      justify-content: space-evenly

      button{
        width: 42%
        height:75%
      }
    }
  }

  .content-small{
    height: 250px
  }
  
  .content-medium{
    height: 280px
  }
}

.payment-capture-panel{
  .panel-content{
   display: flex
   flex-direction: row
   justify-content: space-evenly

   .left-panel, .right-panel{
     display: flex
     flex: .5
     flex-direction: column
     background: #FFFFFF;
     border: 1px solid #d5d7d8;
     border-radius: 3px;

     .panel-header{
       display: flex
       flex: .4
       padding: 10px 15px 5px 15px
       justify-content: space-between

       input{
         margin-top: 10px
       }
      }

      .panel-description{
       display: flex
       flex: .4
       padding: 0px 0px 10px 15px
      }
    }

    .is-active{
      background: #F8FAFF
      border: 1px solid #528FF0
      border-radius: 3px
    }
  }
}

.payment-capture-configuration-container{
  background: white

  .configuration-content{
    display: flex
