.ftx-container
  background url('assets/ftx_2020_easteregg.gif')
  width 65px
  height 65px
  background-repeat no-repeat
  position absolute
  background-size contain
  cursor pointer
  z-index 1

.ftx-popup
  background url('https://cdn.razorpay.com/static/assets/ftx_2020_modal.png')
  width 100%
  height 600px
  background-size cover
  position relative

  .pop-close
    font-size 25px
    position absolute
    right 23px
    top 27px
    cursor pointer
    color #126E96

  button
    background-color #0500FF
    border-color #0500FF
    color #FFFFFF
    border-radius 0px
    font-weight 400
    line-height 21px
    padding 12px
    position absolute
    bottom 100px
    left 45px

    &:hover, &:focus
      background-color #0500FF
      border-color #0500FF
      color #FFFFFF

  i 
    margin-left 5px

  a
    position absolute
    bottom 55px
    left 45px
    text-decoration underline
    font-weight bold
    color #126E96

.ftp-parent
  position relative

.ftx-profile-page
  left -195px
  bottom 0px

.ftx-payments-page, .ftx-payment-links
  bottom 5px
  left 0px

.ftx-home-page
  right 25px
  bottom 0px