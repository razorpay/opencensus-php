.Partner-Dashboard {
  &__View-Credentials {
    .toggle-password {
      position: relative;

      .btn-show-secret {
        position: absolute;
        top: 50%;
        bottom: 50%;
        right: 15px;
        font-size: 12px;
      }
    }
  }
}

.partner-dashboard-header {
  @media (max-width: 625px) {
    padding-top: 40px;
  }
}

.partner-welcome {
  min-height: 492px;
  display: flex;
  flex-direction: column;

  .main-title {
    font-family: Lato;
    font-style: normal;
    font-weight: bold;
    font-size: 24px;
    line-height: 30px;
    /* or 125% */
    text-align: center;
    color: #58666E;
  }

  .sub-title {
    font-family: Lato;
    text-align: center;
    color: #58666E;
    font-weight: 400;
  }

  .action-area {
    div {
      display: flex;
      flex-direction: row;

      @media (max-width: 768px) {
        flex-direction: column;
      }

      div {
        flex: 1;
        align-self: center;
        justify-content: center;
        flex-direction: column;
        align-items: center;

        p {
          font-family: Lato;
          font-style: normal;
          font-size: 14px;
          line-height: 17px;
          color: #58666E;
        }

        .social-share-btn-grp {
          flex-direction: row;
          padding-top: 20px;
          display: 'flex';
          justify-content: space-around;

          img {
            padding-left: 20px;
            height: 35px;
            cursor: pointer;
          }

          img:hover {
            opacity: 0.8;
          }
        }
      }
    }
  }

  .line-height-9 {
    line-height: 9px;
  }
}

.social-share-btn-grp {
  padding-top: 24px;
  text-align: center;

  div {
    display: inline-block;
  }

  img {
    display: inline-block;
    padding-left: 20px;
    height: 35px;
    cursor: pointer;
  }

  img:hover {
    opacity: 0.8;
  }
}

.SubmerchantDetail__Panel {
  .submerchant-name {
    display: inline-block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    width: 300px;
    height: 50px;
  }
}

.SelectBox.SelectBox-partner-dashboard
  cursor: pointer
  padding: 18px 24px;
  margin-bottom: 0;
  display: block;

  .content
    display: flex;
    justify-content: space-between;
    align-items: center;

  &:not(:last-child)
    margin-bottom: 0;

  .SelectBox-action
    i.i-check
      font-size: 18px;
      color: #E7EBF1;
  
  &:hover
    background: #F6F9FE;
  
  &.checked
    border-left: 5px solid #518FF0;
    padding: 18px 24px 18px 20px;

    .SelectBox-action
      i.i-check
        color:#518FF0;

.referral-box-modal
  .social-share-btn-grp
    text-align: right;
    padding-top: 20px;
    
  .input-group
    width: 100%;
    .ClipboardCustom
      display: block;
      input
        width: calc(100% - 100px)
      
.sub-merchants-list
  .submerchant-filter-wrapper
    display: flex;
    justify-content: space-between;
    align-items: center;

    button.btn.export-all-btn
      position: relative
      top: -5px;

  .list-filter-container
    width: calc(100% - 160px);