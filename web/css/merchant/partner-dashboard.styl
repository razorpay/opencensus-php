.Partner-Dashboard {
  &__View-Credentials {
    .toggle-password {
      position: relative;

      .btn-show-secret {
        position: absolute;
        top: 50%;
        bottom: 50%;
        right: 15px;
        font-size: 12px;
      }
    }
  }
}

.partner-dashboard-header {
  @media (max-width: 625px) {
    padding-top: 40px;
  }
}

.partner-welcome {
  min-height: 492px;
  display: flex;
  flex-direction: column;

  .main-title {
    font-family: Lato;
    font-style: normal;
    font-weight: bold;
    font-size: 24px;
    line-height: 30px;
    /* or 125% */
    text-align: center;
    color: #58666E;
  }

  .sub-title {
    font-family: Lato;
    text-align: center;
    color: #58666E;
    font-weight: 400;
  }

  .action-area {
    div {
      display: flex;
      flex-direction: row;

      @media (max-width: 768px) {
        flex-direction: column;
      }

      div {
        flex: 1;
        align-self: center;
        justify-content: center;
        flex-direction: column;
        align-items: center;

        p {
          font-family: Lato;
          font-style: normal;
          font-size: 14px;
          line-height: 17px;
          color: #58666E;
        }

        .social-share-btn-grp {
          flex-direction: row;
          padding-top: 20px;
          display: 'flex';
          justify-content: space-around;

          img {
            padding-left: 20px;
            height: 35px;
            cursor: pointer;
          }

          img:hover {
            opacity: 0.8;
          }
        }
      }
    }
  }

  .line-height-9 {
    line-height: 9px;
  }
}

.social-share-btn-grp {
  padding-top: 24px;
  text-align: center;

  div {
    display: inline-block;
  }

  img {
    display: inline-block;
    padding-left: 20px;
    height: 35px;
    cursor: pointer;
  }

  img:hover {
    opacity: 0.8;
  }
}

.SubmerchantDetail__Panel {
  .submerchant-name {
    display: inline-block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    width: 300px;
    height: 50px;
  }
}

.SelectBox.SelectBox-partner-dashboard
  cursor: pointer
  padding: 18px 24px;
  margin-bottom: 0;
  display: block;

  .content
    display: flex;
    justify-content: space-between;
    align-items: center;

  &:not(:last-child)
    margin-bottom: 0;

  .SelectBox-action
    i.i-check
      font-size: 18px;
      color: #E7EBF1;
  
  &:hover
    background: #F6F9FE;
  
  &.checked
    border-left: 5px solid #518FF0;
    padding: 18px 24px 18px 20px;

    .SelectBox-action
      i.i-check
        color:#518FF0;

.referral-box-modal
  .social-share-btn-grp
    text-align: right;
    padding-top: 20px;
    
  .input-group
    width: 100%;
    .ClipboardCustom
      display: block;
      input
        width: calc(100% - 100px)
      
.sub-merchants-list
  .submerchant-filter-wrapper
    display: flex;
    justify-content: space-between;
    align-items: center;

    button.btn.export-all-btn
      position: relative
      top: -5px;

  .list-filter-container
    width: calc(100% - 160px);

  &.page-x
    .data-table
      td:nth-child(4)
        align-items: flex-start;

  .data-table
    th
      text-align: center;
    td 
      text-align: center;
      vertical-align: middle;

      // to truncate name email
      white-space: nowrap;
      max-width: 220px;
      overflow: hidden; 
      text-overflow: ellipsis; 

    // aligining component SubMerchantKycStatusLabel in table
    td:nth-child(4)
      max-width: 260px;
      display: flex;
      align-items: center;
      flex-direction: column;

      .no-description
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 8px 0px;
    
  .reseller-kyc-experiment-disabled
    .data-table
      th
        text-align: left;
      td 
        text-align: left;
        vertical-align: middle;


.submerchant-kyc-description
  font-family: Lato;
  font-size: 12px; 
  font-weight: 400;
  font-style: normal;
  line-height: 17px;
  min-height: 17px;
  // color: #A8A8A8;

// Styles for SubMerchant/components/DetailsAction.js
.details-action-container
  position: absolute;
  left: 0;
  right: 0;
  padding-bottom: 70px;

.action-kyc-request
  white-space: nowrap;
  display: flex;
  justify-content: center;

.action-kyc-request-disable
  opacity: 30%;
  pointer-events: none;

.submerchant-details-action
  display: flex;
  padding-right: 20px;
  border: 1px #162F561A;
  border-style: solid none;
  &:last-child
    border-style: none;

  .icon-container
    flex: 0 0 14%;
    display: flex;
    justify-content: center;
    margin-top: 18px;

  .icon
    max-width: 24px;
    border-radius: 100%;
    min-width 22px;
  
  .details-container
    margin-top: 20px;
    margin-bottom: 20px;

    .title 
      color: #162F568A;
      
    .description
      color: #162F56BD;
      margin-top: 5px;
      margin-bottom: 10px;

      span
        white-space:nowrap;

    button 
      margin-top: 16px;

  .waiting-approval
    display: flex
    justify-content: center
  
  .default-img
    margin: 17px 0;

.request-access-kyc
  background-color: #F8FBFF; 
  margin-top: 16px

