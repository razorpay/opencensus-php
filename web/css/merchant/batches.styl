.batch-upload-wrapper
  .empty-table-message
    .helper
      width: 60%
      margin: 20px auto
.batch-upload-modal
  background: #fff
  &.success
    background-color: rgba(255, 187, 0, 0.1)
  .modal-file
    width: 70%
    margin: 0 auto
  .modal-heading
    text-align: center
    font-weight: bold
    margin: 20px 0
  .modal-info
    background-color: #FAFAFA
    border-radius: 2px
    border: 1px solid #DBDBDB
    margin: 30px 0 0
    padding: 0 15px
    ul
      list-style-type: none
      padding: 0
    .btn-link
      cursor: pointer
    &.stretch  
      margin: 0 -24px -24px
    &.error
      background-color: #fff8e5
      padding: 20px
    &.create
      border: none
      background-color: #f5f5f5
      .rzpCheckbox
        display: inline-block
      h5
        color: #58666E
      button 
        display: block
        margin: 30px auto 10px
        padding: 10px 45px

  .notification
    margin: 25px 0
    text-align: center
    &.error, &.exceed
      color: #FF6363
  h4, h5
    color: #2D2D2D
.batch-table
  font-size: 12px
  thead > tr > th
    background-color: #eeeeee
    border: 1px solid #ddd
    white-space: nowrap
  tbody > tr > td
    white-space: nowrap

.batch-details
  .panel-heading
    span
      color: #5E70D2
      font-size: 13px
  .stats-info
    padding: 20px
    width: 100%
    .table
      border: 1px solid #eaeff0
      .td-info::after
        content: '';
        height: 20px;
        background: #eaeff0;
        width: 1px;
        position: absolute;
        margin-top: -30px;
        margin-left: -9px;
      .td-heading
        display: block
        color: rgba(0,0,0,0.54)
        text-align: center
        font-size: 13px
      .td-value
        display: block
        text-align: center
        font-size: 16px
