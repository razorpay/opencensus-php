$max-width = 640px

.StandAloneContainer
  position: relative
  width: 92%
  margin: 80px auto

  .spinner-container
    height: 300px

/* PaymentLinks wizard screen */
.PaymentLinks--Create
  max-width: $max-width
  height: 85vh
  min-height: 560px
  max-height: 690px
  background: #fafafa
  position: relative

  .form-container
    padding: 30px 40px

  .Form--tabular
    .Input-content
      margin-left: 156px
    .Input-label
      width: 136px


  $side-width = 240px

  main
    left: 0
    right: 0
    padding: 30px
    position: absolute
    bottom: 80px
    top: 0
    overflow: auto

    &.main--full
      bottom: 0

    &::-webkit-scrollbar
      display: none;

  footer
    left: 0
    padding: 20px
    right: 0
    background: #F6F6F6
    border-top: 1px solid #e0e0e0
    bottom: 0
    position: absolute
    text-align: right

    button
      vertical-align: top

    .Loader
      float: left
      opacity: 0
      transition: 1s opacity
      margin-top: 4px
      line-height: 27px

      i, .spin-btn
        margin-right: 8px
        vertical-align: middle

      .spin-btn
        opacity: 1

      &--visible
        opacity: 1

  main-title
    display: block
    font-weight: 600
    margin-bottom: 20px
    font-size: 18px !important

  .Form
    margin-top: 36px

/* Modal-container size */
.Modal-container
  &--PaymentLinks
    width: 90%
    max-width: $max-width
    min-height: 560px
    max-height: 690px
    height: 90vh

    .PaymentLinks--Create
      height: 90vh

// For linked-account activation form
.Modal-mask--Account-Activation
  .Modal-container--PaymentLinks, .PaymentLinks--Create
    min-height: 400px
    height: 70vh
    max-height: 480px


/* Small screens for Payment Links Modal */
@media (max-width: 972px)
  .PaymentLinks--Create
    .Input-elWrapper
      width: 300px !important

    .Input-pair
      width: 302px

    .form-container
      padding: 30px

    .InputGroup
      &--inline
        .Input-label
          position: relative !important

        .Input
          display: block

        .Input .Input-content
          margin: 4px 0

      &--near .Input
        margin-top: 0


  .StandAloneContainer .PaymentLinks--Create
    .Input-content
      margin: 0

    .Input-label
      margin-bottom: 12px
      text-align: left
      float: unset


@media (max-width: 820px)
  .Modal-container .PaymentLinks--Create
    .Input-content
      margin: 0 0 16px

    .Input-label
      margin-bottom: 12px
      text-align: left
      float: unset


/*
TODO: Style written in consideration that instead of modal, standalone page would open for activation wizard on small screen
TODO: Display aside on top of form as expandable slider OR else show PREV button
*/
@media (max-width: 610px)
  .StandAloneContainer
    margin: 80px auto 40px

  .PaymentLinks--Create
    overflow: hidden

    main-title
      position: relative
      padding: 20px
      text-align: center
      top: -30px
      margin-left: -24px
      margin-right: -40px
      margin-bottom: 4px
      background: white
      font-size: 14px

    .Form
      margin-top: 0

    .Input-el
      width: 100%

    .Select-elWrapper::before
      left: unset !important
      right: 4px

    aside
      display: none

    main, footer
      left: 0 !important


.Entity--paymentpage
  .stats-info
    margin-bottom: 24px

  .paymentpage-link-payments-table
    .detail-row
      padding-left: 0
    .row-item.content
      width: 100%

.Input--custom.Input--custom
  padding-left: 48px
  position: relative

  &:before
    content: ''
    display: block
    width: 2px
    background: #e2e2e2
    height: 100%
    position: absolute
    left: 182px

  .Input-label
    float: inherit
    width: auto
    display: block
    margin-bottom: 12px
    padding-left: 12px
    color: #58666e
    text-align: left
    font-weight: 400
    margin-left: 156px
    left: -16px

    .help-content
      vertical-align: text-bottom


@media(max-width: 972px)
  .Input--custom.Input--custom
    padding-left: 28px

    &:before
      left: 0

    .Input-label
      margin-left: 3px

.TemplateCard
  border-radius: 4px
  background: #fff
  width: 220px
  overflow: hidden
  cursor: pointer
  display: flex
  flex-direction: column
  margin: 12px
  transform-origin: center
  transition: 0.19s cubic-bezier(0.42, 0, 0.35, 1)

  &:hover
    transform: translateY(-16px)

    .link
      border-top: 1px solid rgba(0,0,0,0.08)
      padding: 8px 0 0
      max-height: 33px
      opacity: 1

  img
    width: 100%
    height: 132px

  &-list
    display: flex
    align-items: baseline
    margin-top: 80px
    width: 100vw
    justify-content: center
    flex-wrap: wrap
    opacity: 0
    transform: translateX(40%)
    animation: 0.35s 0.2s slide-in cubic-bezier(0.16, 1.13, 1, 1) forwards

  &-details
    padding: 12px 16px
    height: 100%
    display: flex
    flex-direction: column
    position: relative
    font-size: 16px
    font-weight: 600
    line-height: 24px
    text-align: left

  &-desc
    font-weight: normal
    margin: 8px 0 24px 0
    font-size: 13px
    line-height: 20px
    min-height: 80px


  .link
    position: relative
    margin: auto 0 -4px 0
    font-size: 14px;
    font-weight: 600
    color: $primary-color
    display: flex
    align-items: center
    justify-content: center
    max-height: 0
    overflow: hidden
    padding: 0
    opacity: 0
    transition: 0.19s cubic-bezier(0.42, 0, 0.35, 1)

    i
      position: absolute
      right: 8px

  @keyframes slide-in
    50%
      opacity: 0

    100%
      transform: translateX(0)
      opacity: 1
