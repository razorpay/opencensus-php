.StandAloneContainer
  position: relative
  width: 92%
  margin: 80px auto

  .spinner-container
    height: 300px

.PaymentLinks--Create
  side-title
    font-size: 18px
    font-weight: bold
    display: block
    margin-bottom: 20px

/* Activation wizard screen */
.PaymentLinks--Create
  max-width: 960px
  height: 80vh
  max-height: 640px
  min-height: 560px
  background: #fafafa
  position: relative

  $side-width = 240px

  main
    left: 0
    right: 0
    padding: 30px
    position: absolute
    bottom: 80px
    top: 0
    overflow: auto

  footer
    left: 0
    padding: 20px
    height: 80px
    right: 0
    background: #F6F6F6
    border-top: 1px solid #e0e0e0
    bottom: 0
    position: absolute
    text-align: right

    button
      vertical-align: top

    .Loader
      float: left
      opacity: 0
      transition: 1s opacity
      margin-top: 4px
      line-height: 27px

      i, .spin-btn
        margin-right: 8px
        vertical-align: middle

      .spin-btn
        opacity: 1

      &--visible
        opacity: 1

  main-title
    text-transform: uppercase
    display: block
    font-weight: 600
    margin-bottom: 12px
    font-size: 14px !important

  .Form
    margin-top: 36px

/* Modal-container size */
.Modal-container
  &--PaymentLinks
    width: 90%
    max-width: 960px
    min-height: 560px
    height: 80vh
    max-height: 640px

// For linked-account activation form
.Modal-mask--Account-Activation
  .Modal-container--PaymentLinks, .PaymentLinks--Create
    min-height: 400px
    height: 70vh
    max-height: 480px


/* Small screens for Activation wizard */
@media (max-width: 972px)
  .StandAloneContainer .PaymentLinks--Create
    .Input-content:not(.Input--checkbox)
      margin: 0 0 16px

    .Input--checkbox
      margin: 24px 0 16px

    .Input-label
      margin-bottom: 8px
      text-align: left
      float: unset


@media (max-width: 820px)
  .Modal-container .PaymentLinks--Create
    .Input-content
      margin: 0 0 16px

    .Input-label
      margin-bottom: 8px
      text-align: left
      float: unset

/*
TODO: Style written in consideration that instead of modal, standalone page would open for activation wizard on small screen
TODO: Display aside on top of form as expandable slider OR else show PREV button
*/
@media (max-width: 610px)
  .StandAloneContainer
    margin: 80px auto 40px

  .PaymentLinks--Create
    overflow: hidden

    main-title
      position: relative
      padding: 20px
      text-align: center
      top: -30px
      margin-left: -30px
      margin-right: -30px
      background: white
      font-size: 14px

    .Form
      margin-top: 0

    .Input-el
      width: 100%

    .Select-elWrapper::before
      left: unset !important
      right: 4px

    aside
      display: none

    main, footer
      left: 0
