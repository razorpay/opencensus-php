.balances-container{
    min-height: 200px;
    background-color : white;
    display: flex;
    flex-direction: column;
}

.bal-cont-header{
    display: flex; 
    flex: 0.7 1 0%;
    flex-direction:  row;
}

.bal-cont-footer{
    display: flex;
    flex: 0.3 1 0%;
    color: #5D666D;
    justify-content:  center;
    align-items: center;
    text-align: left;
    font-size: 15px;
    opacity: .7;
    padding-left: 20px;
}

.balance-type-container{
    display: flex;
    flex: 0.5 1 0%;
    justify-content: flex-start;
    align-items: flex-end;
    padding-left: 20px;
    color: #58666E;
    font-size: 16px;
    font-weight: bold;
}

.balance-amount-container{
    display: flex;
    flex: 0.5 1 0%;
    justify-content: flex-start;
    align-items: baseline;
    padding-left: 20px;
    color: #0D2366;
    font-size: 24px;
}

.processing-note{
    min-height: 30px;
    background: #FBF8E3;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding-left: 10px;
}

.balances-lhs-container{
    display: flex;
    flex: 0.5 1 0%;
    flex-direction: column;
}

.balances-add-funds{
    display: flex;
    flex: 0.5 1 0%;
    justify-content: flex-end;
    align-items: center;
    padding-right: 15px;
}