.product-onboarding-card-container
  padding: 20px

.product-onboarding-card
  background: #FFF
  border-radius: 4px
  position: relative
  padding: 20px 20px 15px

  @media (max-width 768px)
    padding: 16px 16px 24px

  .illustration-top
    position: absolute
    top: 0
    left: 0

    @media (max-width 768px)
      display: none

    img
      display: block
      height: 100%
      width: 90px

  .illustration-right
    position: absolute
    z-index: 1
    right: 0

    @media (max-width 768px)
      display: none

  .illustration-bottom
    position: absolute
    z-index: 2
    right: 0
    bottom: 0

    @media (max-width 768px)
      display: none

    img
      height: 100px
      background: #FFF

  .title
    font-size: 18px
    font-weight: 600
    color: rgb(22 47 86 / 0.74)
    z-index: 2;
    position: relative;

.card-container
  padding: 16px 4px 4px
  white-space: nowrap
  overflow: auto
  position: relative
  z-index: 5
  display: flex

  &::-webkit-scrollbar
    display: none;

  -ms-overflow-style: none;
  scrollbar-width: none;

  .plo-card
    min-width: 368px
    height: 220px
    background: rgb(255 255 255 / 1)
    border-radius: 4px
    box-shadow: 0 0 0 1px #C4CBD7
    padding: 16px 20px
    margin-right: 25px
    flex-grow: 1
    flex-basis: 0

    &:last-child
      margin-right: 0

    @media (max-width 768px)
      min-width: 270px
      padding: 16px
      margin-right: 13px

    .wrapper
      height: 100%
      display: flex
      flex-direction: column
      justify-content: space-between

    .content
      display: flex
      white-space: initial

      .header
        text-transform: uppercase
        font-size: 12px
        font-weight: 600
        color: rgb(33 53 84 / 0.67)
        padding: 0 0 4px
        border: 0

      .description
        font-size: 18px
        font-weight: 600
        line-height: 25px
        color: #213554
        padding-bottom: 10px

      .subtext
        font-size: 14px
        font-weight: 400

    .btn-container
      padding-top: 20px

    .multiple-btn
      display: flex
      justify-content: space-between
      padding-top: 15px
      gap: 16px

      .btn
        margin: 0

    .card-illustration
      height: 80px
      width: 80px

      @media (max-width 768px)
        display: none

    .plugins
      img,
      .rzp-image
        width: 24px
        padding-right: 5px

      span
        padding-left: 5px
        font-size: 14px
        font-weight: 400

  .handle-link
    height: 32px
    background: #EEE
    border-radius: 4px
    display: flex
    align-items: center
    padding: 0 8px

    & > *
      overflow: hidden

.quick-options
  .bg-right
    height: 145px

  .card-container
    white-space: initial

    .plo-card
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      height: initial
      padding: 16px 20px

      @media (max-width 768px)
        width: 256px

    .card-description
      font-size: 14px
      font-weight: 600
      line-height: 25px
      padding-bottom: 8px
      color: #213554

      @media (max-width 768px)
        line-height: 20px
        white-space: normal
        width: 220px

    .handle-link
      height: 28px
      flex-grow: 1
      overflow: hidden

      @media (max-width 768px)
        font-size: 12px

    .cta-container
      display: flex
      column-gap: 16px
      row-gap: 8px
      flex-wrap: wrap

      .button-container
        display: flex
        gap: 16px

        @media (max-width 768px)
          width: 100%

      .btn
        padding: 3px 16px
        height: initial

        @media (max-width 768px)
          font-size: 12px

      .ph-btn
        @media (max-width 768px)
          flex-grow: 1;
          flex-basis: 0;

      .payment-link-cta
        margin: 0

        @media (max-width 768px)
          margin-top: 12px
