.product-onboarding-card
  background: #FFF
  border-radius: 4px
  position: relative
  padding: 20px 20px 15px

  @media (max-width 768px)
    padding: 16px 16px 24px

  .illustration-top
    position: absolute
    top: 0
    left: 0

    @media (max-width 768px)
      display: none

    img
      display: block
      height: 100%
      width: 90px

  .illustration-right
    position: absolute
    z-index: 1
    right: 0

    @media (max-width 768px)
      display: none

  .illustration-bottom
    position: absolute
    z-index: 2
    right: 0
    bottom: 0

    @media (max-width 768px)
      display: none

    img
      height: 100px
      background: #FFF

  .title
    font-size: 18px
    font-weight: 700
    color: rgb(22 47 86 / 0.74)

.card-container
  padding-top: 16px
  padding-bottom: 5px
  white-space: nowrap
  overflow: auto
  position: relative
  z-index: 5

  .card
    width: 358px
    height: 220px
    display: inline-block
    background: rgb(255 255 255 / 1)
    border-radius: 4px
    box-shadow: 0 0 0 1px #C4CBD7
    padding: 16px 20px
    margin-right: 23px
    margin-left: 2px

    @media (max-width 768px)
      width: 270px
      box-shadow: 0 3px 8px rgb(21 45 75 / 0.2), 0 0 1px rgb(21 45 75 / 0.2);
      margin-right: 13px

    .wrapper
      height: 100%
      display: flex
      flex-direction: column
      justify-content: space-between

    .content
      display: flex
      white-space: initial

      .header
        text-transform: uppercase
        font-size: 12px
        font-weight: 700
        color: rgb(33 53 84 / 0.67)
        padding: 0 0 4px
        border: 0

      .description
        font-size: 18px
        font-weight: 700
        line-height: 25px
        color: #213554
        padding-bottom: 10px

      .subtext
        font-size: 14px
        font-weight: 400

    .btn-container
      padding-top: 20px

    .multiple-btn
      display: flex
      justify-content: space-between
      padding-top: 15px

      .btn
        width: 152px

        @media (max-width 768px)
          width: 110px

    .placeholder
      height: 72px
      width: 72px
      background: #EEE

      @media (max-width 768px)
        display: none

    .plugins
      img,
      .rzp-image
        width: 24px
        padding-right: 5px

      span
        padding-left: 5px
        font-size: 14px
        font-weight: 400

  .handle-link
    height: 32px
    background: #EEE
    border-radius: 4px
    display: flex
    align-items: center
    padding-left: 8px

.quick-options
  .bg-right
    height: 145px

  .card-container
    display: flex
    justify-content: space-between
    width: 100%

    .card
      flex-grow: 1
      width: initial
      height: initial
      display: block
      padding: 16px 20px
      margin-right: 20px
      margin-left: 2px

      &:last-child
        margin-right: 2px

    .card-description
      font-size: 14px
      font-weight: 700
      line-height: 25px
      padding-bottom: 10px
      color: #213554

    .handle-link
      height: 28px
      flex-grow: 1

    .cta-container
      display: flex
      align-items: center
      justify-content: space-between
      padding-top: 8px

      .btn
        padding: 3px 12px
        margin-left: 16px

    .no-margin
      margin: 0
