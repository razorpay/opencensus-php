.dual-column-table
    display: grid;
    //TODO replace with the standard samller size for the application
    font-size: 0.9em;

    >span
        padding-top: 10px;

    >span:first-child
        font-weight: bold;
        text-align: right;
        padding-right: 15px;
        text-transform: capitalize;

.horizontally-stacked-checkbox
    align-items: center;
    flex-wrap: wrap;

    >div
        display: grid;
        grid-template-columns: 25px 100%;

    >label
        font-weight: bold;
        position:relative;
        width: 100%;
     
.horizontally-stacked-checkbox p.required::after
    content: '*';
    font-size: 12px;
    position: absolute;
    margin-left: 1px;
    top: 0;
    color: #f05050;