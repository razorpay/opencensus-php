.dual-column-table
    display: grid;
    //TODO replace with the standard samller size for the application
    font-size: 0.9em;

    >span
        padding-top: 10px;

    >span:first-child
        font-weight: bold;
        text-align: right;
        padding-right: 15px;
        text-transform: capitalize;

.horizontally-stacked-checkbox
    display: flex;
    align-items: center;
    flex-wrap: wrap;

    >input[type="checkbox"]
        margin-right: 20px;
    >span
        font-weight: bold;
    >p
        width: 100%;