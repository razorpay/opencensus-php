.dual-column-table
    display: grid;
    //TODO replace with the standard samller size for the application
    font-size: 0.9em;

    >span
        padding-top: 10px;

    >span:first-child
        font-weight: bold;
        text-align: right;
        padding-right: 15px;
        text-transform: capitalize;

.no-cost-emi-loader
    display : flex
    align-content: center
    justify-items: center

.no-cost-emi-footnote
    font-family: Lato;
    font-style: normal;
    font-weight: normal;
    font-size: 13px;
    line-height: 18px;
    color: #828282;
    margin-left: 130px;

.horizontally-stacked-checkbox
    align-items: center;
    flex-wrap: wrap;

    >div
        display: grid;
        grid-template-columns: 25px 100%;

    >label
        font-weight: bold;
        position:relative;
        width: 100%;

        &::after
            content: '*';
            font-size: 12px;
            position: absolute;
            margin-left: 1px;
            top: 0;
            color: #f05050;

.offers-api-note
    margin-left: 156px;
    margin-top: 24px;
    color: #838383;
    font-size: 13px;
    
.offers-emi-options-container
    border-width: 1px;
    border-color: #e2e2e2;
    border-style: solid;
    margin-top: 10px;
    margin-bottom: 10px;
    margin-left: 156px;

    > div:nth-of-type(even)
        background: #FFFFFF;

.offers-emi-options-row
    display: flex;
    flex-direction: row;
    justify-content:flex-start;
    align-items: center;
    padding-left: 15px;

    .emi-checkfield
        width: 110px;

    .Input-content
        margin-left: 0px !important;


