.ComingSoon--QR_codes
  .ComingSoon--Landing
    overflow: hidden
    z-index: 2
    position: relative
    &::before
      content: ''
      color: #7a47c2
      position: absolute
      left: 0
      background: linear-gradient(95deg, #0B0B57 16.04%, #5C5CF7 62.56%);
      box-shadow: 1px 1px 0 #0B0B57, 2px 2px 0 #0B0B57, 3px 3px 0 #0B0B57, 4px 4px 0 #0B0B57

  .ComingSoon--Banner
    .Button
      background: linear-gradient(100.11deg, #2A2A77 2.2%, #5C5CF7 103%)


$formHeight = 471px

.Modal-container.Modal-container--QRCode--Create
  width: 90%
  max-width: 400px
  overflow: initial
  @media screen and (max-width: $screen-xs-max)
    width: 100%
    height: 100%
    max-width: none !important

.StandAloneContainer
  .QRCode--Create-wizard
    max-height: $formHeight
    background: white
    position: relative
    height: 80vh
    max-width: 400px
    @media screen and (max-width: $screen-xs-max)
      height: 100vh
      max-height: none
      max-width: none !important

.QRCode--Create-wizard
  .title
    padding: 24px 24px 32px 24px
    font-weight: 600
    font-size: 18px
    position: absolute
    top: 0
    left: 0
    background: white
    z-index: 1
    width: 100%
    @media screen and (max-width: $screen-xs-max)
      position: fixed
      height: 62px
      background: #FFFFFF
      border-radius: 2px
      display: flex
      align-content: center
      justify-content: space-between

  .mt-16
    @media screen and (max-width: $screen-xs-max)
      margin-top: 16%

  main
    padding: 81px 24px 132px 24px
    overflow: auto

    > .Input:first-child
      margin-top: 0

  footer
    position: absolute
    left: 0
    right: 0
    bottom: 0
    padding: 24px
    background: #F6F6F6
    border-top: 1px solid #e0e0e0
    text-align: right

    @media screen and (max-width: $screen-xs-max)
      display: flex
      justify-content: center
      align-items: center
      position: fixed
      z-index: 9999
      background: #F6F6F6

    .Button
      width: 168px
      padding: 9px 12px

      &:first-child
        margin: 0 16px 0 0

      &:last-child
        margin: 0

  .Form
    height: $formHeight;
    overflow-y: scroll
    @media screen and (max-width: $screen-xs-max)
      height: 100vh

  .pb-8
    @media screen and (max-width: $screen-xs-max)
        padding-bottom: 8px

    .amount
      margin-top: 0

    .Input-label small
      font-weight: 400

  .additional-options-btn
    font-size: 12px
    display: flex
    align-items: center
    justify-content: space-between
    cursor pointer
    padding: 12px 0
    margin-top: 20px
    border-top: 1px solid #eee

    &.btn-hide
      border-bottom: 1px solid #eee

    .heading
      color: #586663
      font-weight: bold

    .description
      color: #838383

    .i
      font-size: 24px

  .Input--custom
    &:before
      left: 22px

    .Input-label
      margin-left: 0
      left: 0
      padding: 0

    .Input
      margin-top 0

.QRCode--Details
  .info
    background: #F8FAFF
    display: flex
    line-height: 19px
    padding: 24px
    border-bottom: 1px solid #eaeff0;

    > div
      width: 50%

    .heading
      font-size: 13px
      color: #8991AE
      margin-bottom: 8px

    .value
      font-size: 18px
      color: #5A666D
      font-weight: bold

  .status
    display: flex
    align-items: baseline

    .btn-link
      font-weight: bold
      padding: 0 8px

  .qr-usage .pair-value
    text-transform: capitalize

  .actions
    border: 1px solid #DEE5E7
    padding: 16px 20px
    display: flex
    align-items: center

    button
      text-align: center
      width: 50%
      position relative

      &:first-child:after
        content: ''
        display: block
        content: ''
        background: #dee5e7
        width: 1px
        height: 20px
        position: absolute
        right: 0
        top: 0

.QRCode-test-payment
  margin-top: 24px
  .rzp-banner-text
    display: flex
    align-items: center

    .Button
      min-width: 175px

.QRCode--Preview
  max-width: 400px
  background: #E0E0E0
  @media screen and (max-width: $screen-xs-max)
    max-width: none
    background: #E5E5E5
    margin: none !important
    height: 100%
    width: 100%
    margin-left: 0px
    position: fixed
    bottom: -66px

  .heading
    padding: 24px
    font-size: 18px
    line-height: 24px
    color: #58666E

    img
      height: 16px

  .content
    display: flex
    align-items: center
    justify-content: center
    height: 487px
    padding: 24px

    img
      max-width: 100%
      max-height: 100%

  .footer
    background: #F6F6F6
    padding: 16px 24px
    height: 74px
    display: flex
    justify-content: space-between
    align-items: center
    @media screen and (max-width: $screen-xs-max)
      padding: 16px 14px
      position: fixed
      width: 100%
      bottom: 0
      white-space: nowrap
      justify-content: space-around
    button
      width: 168px
      margin-right: 0
      @media screen and (max-width: $screen-xs-max)
        width: 154px

.QRCode--List
  .qr_usage
    text-transform: capitalize
  .mobile-text
    color: rgba(90, 102, 109, 0.6)
    font-size: 12px
    line-height: 20px
    padding-top:  2px
.Modal-container--QRCode--Preview
  width: 400px

.MobileAppQRCode--container
  height 420px
  background-color #FAFAFA

  .qrcode
    display flex
    justify-content center
    align-items center
    margin 35px 0px

    div
      display flex
      justify-content center
      align-items center
      width 200px
      height 200px
      border-radius 2px
      background-color white
      filter drop-shadow(1px 1px 4px #F2F6F9)

  img
    height 60%
    width 60%

  .note
    padding 15px
    background-color #E7EBF1
    border-left 2px solid #CD8214
