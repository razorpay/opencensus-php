.payment-pages-v2
  .page-nav
    color: #fff
    background-color: #2F3445
    box-shadow: 0 2px 24px 0 rgba(0,0,0,0.24)
    padding: 12px
    position: relative
    z-index: 2

    .page-size
      width: 100%
      max-width: 1440px
      margin: 0 auto
      display: table
      position: relative

      > div
        display: table-cell
        vertical-align: middle

      .page-title
        font-size: 18px
        font-weight: 600
        padding-left: 8px

      .page-action
        float: right
        margin-right: 56px

        button
          line-height: 10px
          padding: 10px 28px

    .close-btn
      font-size: 24px
      line-height: 14px
      position: absolute
      top: 5px
      right: 4px
      color: #fff
      cursor: pointer
      padding: 4px

      &:hover
        color: #fff
        opacity: 0.7

  .btn-link
    padding-left: 0

    &:hover
      color: $primary-color
      text-decoration: none


  #details-section
    .Input-elWrapper
      font-size: inherit

    .title--big
      .Input-el
        height: 40px
        font-size: 24px
        line-height: 32px
        font-weight: 600

    textarea.Input-el
      min-height: 72px
      max-height: 230px // Supports 720 char on desktop


  #share-details, #support-details, #terms-details
    .wysiwyg-edit-layer
      margin-top: -8px

  #share-details, #support-details
    .share-icons
      img:not(:nth-last-child(1))
        margin-right: 12px

    .icons--grayscale
      float: right
      filter: grayscale()
      opacity: 0

  #share-details
    input
      position: absolute
      display: block
      width: 100%
      height: 100%
      opacity: 0
      left: 0
      top: 0
      right: 0
      margin: 0
      cursor: pointer

  #support-details
    .sub-detail
      .Input
        width: calc(100% - 28px)
        display: inline-block
        vertical-align: middle
        margin: 0

      .Input-el
        height: 28px
        border: none
        background: transparent
        color: #0D2366 // Same as in customer-facing view


  .Input
    margin: -4px -6px

    .Input-el
      padding: 3px 5px
      position: relative


  .title--big .Input-el
    padding: 1px 5px 2px // 1px less cuz of border


  .wysiwyg-edit-layer
    position: relative
    margin: -4px -6px
    padding: 4px 6px
    border-radius: 2px
    cursor: pointer

    &.Field
      margin-left: -44px
      margin-right: -44px
      padding: 8px 44px

      .Field-description
        transform: none
        margin-bottom: 0

    &:hover
      background-color: #fff
      box-shadow: 0 5px 13px 0 rgba(0,0,0,0.14)

      .close-btn
        opacity: 0.5

      .share-icons.icons--grayscale
        opacity: 0.2

      .Input-info
        transform: translateY(-50%)
        opacity: 1

        @media (max-width: 1024px)
          transform: none


  //Override Styles
  .Input-info
    left: 100%
    color: #fff
    background-color: #2c3243
    line-height: 20px
    min-width: 180px

    &::before
      border-right-color: #2c3243

    @media (max-width: 1024px)
      left: 0

      &::before
        border-right-color: transparent
        border-bottom-color: #2c3243


.fakeTextArea
  overflow: hidden
  word-wrap: break-word
  white-space: pre-wrap
  height: 0
  margin: 0 16px 0 -6px // Has no vertical footprint. 16px to act as look-ahead while typing -6 is same as .Input
  padding: 0 5px
  line-height: 20px
  font-size: 14px
