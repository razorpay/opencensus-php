.payment-pages-v2
  .page-nav
    color: #fff
    background: linear-gradient(270deg, #2682FF 0%, #415BD3 100%)
    padding: 12px
    position: relative

    .page-size
      width: 854px
      margin: 0 auto
      display: table

      > div
        display: table-cell
        vertical-align: middle

      .page-title
        font-size: 18px
        font-weight: 600

      .page-action
        float: right

        button
          line-height: 10px
          padding: 10px 28px

    .close-btn
      font-size: 24px
      line-height: 14px
      position: absolute
      top: 20px
      right: 28px
      color: #fff

      &:hover
        color: #cbdfff
