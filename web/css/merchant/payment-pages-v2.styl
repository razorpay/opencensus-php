.payment-pages-v2
  .page-nav
    color: #fff
    background: linear-gradient(223.96deg, #5D89E5 0%, #3059C0 100%)
    padding: 12px
    position: relative

    .page-size
      width: 100%
      max-width: 1440px
      margin: 0 auto
      display: table
      position: relative

      > div
        display: table-cell
        vertical-align: middle

      .page-title
        font-size: 18px
        font-weight: 600
        padding-left: 8px

      .page-action
        float: right
        margin-right: 56px

        button
          line-height: 10px
          padding: 10px 28px

    .close-btn
      font-size: 24px
      line-height: 14px
      position: absolute
      top: 9px
      right: 8px
      color: #fff

      &:hover
        color: #cbdfff

  .btn-link
    padding-left: 0

    &:hover
      color: $primary-color
      text-decoration: none


  #details-section
    .title--big
      .Input-elWrapper
        font-size: inherit

        .Input-el
          height: 40px
          font-size: 24px
          line-height: 32px
          font-weight: 600

    textarea.Input-el
      min-height: 72px
      max-height: 230px // Supports 720 char on desktop


#wysiwyg-root
  .Input
    margin: -4px -6px

    .Input-el
      padding: 3px 5px
      position: relative

  .title--big .Input-el
    padding: 1px 5px 2px // 1px less cuz of border

  .wysiwyg-edit-layer
    position: relative
    margin: -4px -6px
    padding: 4px 6px
    cursor: pointer
    border-radius: 2px

    &:hover
      background-color: #fff
      box-shadow: 0 5px 13px 0 rgba(0,0,0,0.14)


  //Override Styles
  .Input-info
    color: #fff
    background-color: #2c3243
    line-height: 20px

    &::before
      border-right-color: #2c3243

      @media (max-width: 1024px)
        border-right-color: transparent
        border-bottom-color: #2c3243


#fakeTextArea
  overflow: hidden
  word-wrap: break-word
  white-space: pre-wrap
  height: 0
  margin: 0 16px 0 -6px // Has no vertical footprint. 16px to act as look-ahead while typing -6 is same as .Input
  padding: 0 5px
  line-height: 20px
  font-size: 14px
