.plan-fields-wrapper
  .Field-amount-wrapper
    .Input--Currency
      display: inline-block

      .value
        height: 34px

      .PowerSelect__Trigger
        height: 32px

        &_Status, &_Label
          height: 32px

      .Input--Currency-dropdown
        border: 1px solid #cfdadd

    .InputField
      display: inline-block
      width: calc(100% - 70px)


.Modal-container
  &--NewSubscriptionLink, &--UpdateSubscriptionLink, &--NewRegistrationLink
    width: 90%
    max-width: 880px
    height: 90vh
    max-height: 690px
    min-height: 560px
    position: relative

.Wizard
  //subscription links wizard screen
  &.SubscriptionLinks--new,
  &.SubscriptionLinks--update,
  &.RegistrationLinks--New
    width: 100%
    height: 90vh
    max-width: unset

    .PowerSelect__TriggerInput
      font-size: 14px
      &::placeholder
        opacity: 0.8
        text-transform: initial

.Subscription
  &--New
    &-addons
      .Addon--Item
        display: inline-block
        width: 70%

      .remove-btn
        float: right
        cursor: pointer

      .list
        li
          padding: 20px 0 20px 30px
          &.no-counter
            list-style-type: none
          &:not(:last-child)
            border-bottom: 1px solid #D8D8D8

          &:before
            content: ''
            display: block
            height: 0
            width: 0
    &-review
      .Payments
        &--item
          &:first-child
            margin-top: 30px
            .Payments--item-inner
              border-left: 1px solid #9EC0F5
              padding-bottom: 30px
          &-inner
            display: inline-block
            margin-left: -8px
            padding-left: 20px
            width: calc(100% - 36px)

          &:before
            content: ''
            display: inline-block
            height: 16px
            width: 16px
            border-radius: 50%
            border: 2px solid #9EC0F5
            float: left
            background: #FAFAFA
            position: relative
            z-index: 2
    &-quant-select
      .Input
        display: inline-block
        margin-right: 10px
        .Input-label
          width: auto
          &:after
            content: ''
        .Input-content
          margin-left: 10px
          display: inline-block

.SubscriptionsBatch
    &--upload-modal
      .panel
        cursor: pointer
        transition: background-color 400ms
        &:hover
          background-color: alpha($primary-color, 0.2)
        .panel-body
          display: flex
          align-items: center
          .description
            flex-grow: 1
          .logo
            background-size: contain
            background-repeat: no-repeat
            width: 35px
            height: 28px
          .i-chevron-right
            font-size: 16px
        &.registration-link
          .logo
            background-image: url('assets/symbols/al.svg')
        &.recurring-charge
          .logo
            background-image: url('assets/symbols/rc.svg')

.SubscriptionLinks--Update
  &-review
    .changed-values
      display: flex
      align-items: baseline
      line-height: 20px
      &:not(:last-child)
        margin-bottom: 24px
      .big-dot-separator
        margin-left: 0
      .current-change
        i
          margin: 0 4px
    .summary
      padding: 16px 24px
      margin-top: 32px
      border: 1px solid rgba(88, 102, 110, 0.18)
      background-color: rgba(216, 216, 216, 0.18)

      ul
        padding-left: 0
        line-height: 20px
        margin-top: 12px
        padding-left: 16px
        i
          margin: 0 10px

.SubscriptionLinks--Details
  .update-subscription-preview
    .less-content
      margin-top: 8px
    .more-content
      border-top: 1px solid rgba(151, 151, 151, 0.14)
      font-size: 12px
      margin-top: 8px
      padding-top: 8px
      strong
        margin: 0 10px 12px 0
        display: block
      .changed-values
        line-height: 15px
        &:not(:last-child)
          margin-bottom: 12px
        .current-change
          display: flex
          align-items: end
          i
            margin: 0 4px
  .entity-detail-list
    .credit-note-row
      .item-left
        width: 20px
      .item-right
        float: right
        width: calc(100% - 20px)

  .eMandate-status
    display: flex
    align-items: center

  .payment_method
    text-transform:capitalize;
    font-weight: 600;

.Modal-container--UploadNACHForm
  width: 90%
  max-width: 640px

.UploadNACH
  .file-desc
    max-width: 80%
    margin-bottom: 28px
    .btn-link
      padding-left: 0

  .Details, .Desc
    margin: 30px auto 30px auto

  .Details
    margin-top: 0

    .Accordion__title
      font-weight: normal

  .Desc
    margin: 30px auto 0 auto
    .alert-warning
      margin-top: 10px
      max-width: 70% 

.UploadNACH--Form.Links--Create
  height: 390px
  min-height: 390px

.RegistrationLinks--Details,
.Token--Details
  .nach-download-btn
    padding: 0px

.RegistrationLinks--Details
  .cancel-link
    margin-left: 16px

.Subscriptions--Settings
  .panel-theme
    margin: auto

  .title
    font-weight: 600
    font-size: 17px

  .panel-heading
    background: #fff
    border-color: transparent

  .panel-body
    padding: 0 15px 15px

  .ToggleCard
    background: rgba(82, 143, 240, 0.02)
    border: 1px solid rgba(82, 143, 240, 0.1)
    border-radius: 2px

    .title
      color: #58666E
      font-size: 16px
      font-weight: 600

    .bg-success
      background-color: #27c24c !important

    .panel-heading
      background: #fff
      border-color: transparent
      padding: 12px

    .panel-body
      padding: 0 12px 12px

      .settings-banner
        min-height: 92px

    .rzp-banner-text
      display: flex
      align-items: flex-start

  .rzp-amount span
    font-weight: 600

.SubscriptionLinks--new,
.SubscriptionLinks--update
  .upi-banner
    background: white !important

  .terms
    font-size: 12px
    color: #777777

  .Payments--item.offer-details
    margin-top 30px
    &:before
      margin-left 8px
      background: url('https://cdn.razorpay.com/static/assets/offers/offers-icon.svg')
      border: none

  .offer-selector
    .Input-elWrapper
      display: flex
      align-items: center

    .TypeAhead
      width 500px

  &.upi-banner-visible main
    bottom: 140px

.Subscription--New-review
  .offer-details .heading
    padding: 0
    line-height: 1
    font-weight: 600
    margin-bottom: 10px

.Subscription--Manual-charge
  .billing-details
    background: rgba(82, 143, 240, 0.02)
    border: 1px solid rgba(82, 143, 240, 0.1)
    border-left-width: 3px 
    border-left-color: #528FF0
    padding: 12px
    margin: 16px 0

    .heading
      color: #838383
  
  .title
    font-size: 14px
    font-weight: 600
    color: #58666E
    margin: 12px 0
    
.PaymentMethodOption
  .method
    font-weight: 600
    font-size: 14px
    padding: 0px 6px
    color: #58666E
  
  .desc
    width: 75%
    display: inline-block
    font-size: 12px
    overflow: hidden
    text-overflow: ellipsis
    white-space: nowrap
    vertical-align: bottom


.PowerSelect__Menu .PaymentMethodOption
  padding: 9px 4px
  display: flex
  line-height: 8px

  .title
    padding-left: 6px
    line-height: 10px
    display: flex
    flex-direction: column
    width: 100%;
    .method
      font-weight: 600
      font-size: 14px
      padding: 0px

    .desc
      padding-top: 8px
      color: #838383
      font-weight: 400
      font-size: 12px
      width: 75%
      line-height: 14px
      white-space: normal

.RegistrationLinks--New
  .PowerSelect
    border-radius: 2px

  .Input.billing-frequency .Input-el
    border: none
    background: transparent
    padding: 9px 0

  .Input.billing-frequency

    .InputGroup
      margin: 18px 0 0
  
    .Input-label
      top: 12px !important;
  
    label
      display: block
      margin-bottom: 8px;
  
    .token-radio-label
      margin-top: 12px;
      display: block;

  .Input--Calendar .Input-elWrapper
    width: 210px !important

.Token--Details
  .charge-now
    border: 1px solid #528FF0
    border-left-width: 4px
    display: flex
    align-items: center
    justify-content: space-between
    padding: 20px 16px
    margin-bottom: 20px

    button
      margin: 0

  .actions
    display: flex
    align-items: center

.Subscription--Expiry
  display: flex
  flex-wrap: wrap
  justify-content: flex-start
  padding: 0px 20px 16px 20px
  background: #FAFCFF
  border-bottom: 1px solid #dee5e7

  .card
    padding: 16px 24px
    min-width: 220px
    max-width: 270px
    background: #FFFFFF
    border: 1px solid #E2E8EA
    box-sizing: border-box
    border-radius: 2px
    border-left: 3px solid
    align-items: center
    display flex
    flex: 1
    flex-basis: auto
    flex-grow: 0
    min-height: 62px
    margin-top 16px
    cursor pointer
    position relative

    .i-close
      position: absolute
      right: 5px
      top: 5px
      line-height: 1

    &:not(:last-child)
      margin-right 20px

    &.active
      border: 1px solid #528FF0
      border-left-width 3px
      &:after
        content: ''
        position: absolute
        width: 0
        height: 0
        border-left: 8px solid transparent
        border-right: 8px solid transparent
        border-top: 8px solid #528FF0
        left: 50%
        transform: translateX(-50%)
        bottom -8px

  .count
    font-size: 24px
    margin-right 20px
    color: #212121
    .PlaceholderLoader
      height 24px

  .details
    font-size: 14px
    line-height 1.5
    color: #6E6E6E
    min-width 50%

// Mobile
@media (max-width: 768px)
  .Subscription--Expiry .card
    width 100%
    margin-right 0
    width: 100%
    max-width: 100%

div.Modal-container--CardPaymentsBlockedModal
  width: 400px

  a
    color: #528FF0

  .header
    padding: 34px 80px
    text-align: center
    position: relative
    background: #ce4a38
    img
      position: absolute
      z-index: 0
      left: 0
      bottom: 0

    > div
      z-index: 1
      position: relative

  .heading
    font-weight: 800
    font-size: 18px
    line-height: 22px
    color: #FAFAFA

  .description
    font-size: 14px
    line-height: 20px
    text-align: center
    color: rgba(255, 255, 255, 0.8)

  .content
    padding: 24px 32px 0 32px
    font-size: 14px
    line-height: 20px
    color: #58666E

    > div
      margin-bottom: 24px

  .banner
    background: #F8FAFF
    border: 1px solid rgba(82, 143, 240, 0.2)
    border-radius: 2px
    margin: 0 -16px
    font-size: 14px
    line-height: 20px
    padding: 12px

  .italic
    font-size: 12px
    line-height: 18px

  .doc-link
    font-weight: 600

  .footer
    display: flex
    align-items: center
    justify-content: flex-end

.card-blocked-banner,
.SubscriptionLinks--new .upi-banner,
.SubscriptionLinks--update .upi-banner
  position: absolute
  z-index: 1
  background: linear-gradient(0deg, rgba(255, 227, 124, 0.26), rgba(255, 227, 124, 0.26)), linear-gradient(96.19deg, rgba(255, 255, 255, 0.024) 0%, rgba(0, 0, 0, 0.0144) 90.24%);
  width: 100%
  height: 32px
  line-height: 32px
  left: 0
  bottom: 0
  border: 1px solid #e2e2e2
  text-align: left
  padding: 0 4px

  a
    padding: 0
    margin-left: 4px

  &.upi-banner-visible
    top: -76px

@media screen and (max-width 767px)
  .ReactModal__Overlay .batch-details .rzp-banner
    margin-top 65px
    & + .panel-body
      margin-top 0
  .plan-fields-wrapper, .batch-details, .SubscriptionLinks--Details, .txn-details
    > .panel
      > .panel-heading
        display flex
        align-items center
        justify-content flex-start
        min-height 65px
        .i + strong
          top 0
        .btn-toolbar
          padding-top 0
          margin-top 0
          margin-left auto
        > button
          position relative
          top 0