.plan-create {
  .billing-frequency {
    display: table;

    > * {
      display: table-cell;
      padding-right: 8px;
    }

    .InputField {
      width: 50px;

      .form-control {
        padding-left: 8px;
        padding-right: 8px;
      }
    }
  }
}


.Modal-container
  &--NewSubscriptionLink
    width: 90%
    max-width: 880px
    height: 90vh
    max-height: 690px
    min-height: 560px
    position: relative

.Wizard
  &.SubscriptionLinks--new, &.SubscriptionLinks--update //subscription links wizard screen
    width: 100%
    height: 90vh
    max-width: unset

    .PowerSelect__TriggerInput
      font-size: 14px
      &::placeholder
        opacity: 0.8
        text-transform: initial

.Subscription
  &--New
    &-addons
      .Addon--Item
        display: inline-block
        width: 70%

      .remove-btn
        float: right
        cursor: pointer

      .list
        li
          padding: 20px 0 20px 30px
          &.no-counter
            list-style-type: none
          &:not(:last-child)
            border-bottom: 1px solid #D8D8D8

          &:before
            content: ''
            display: block
            height: 0
            width: 0
    &-review
      .Payments
        &--item
          &:first-child
            margin-top: 30px
            .Payments--item-inner
              border-left: 1px solid #9EC0F5
              padding-bottom: 30px
          &-inner
            display: inline-block
            margin-left: -8px
            padding-left: 20px
            width: calc(100% - 36px)

          &:before
            content: ''
            display: inline-block
            height: 16px
            width: 16px
            border-radius: 50%
            border: 2px solid #9EC0F5
            float: left
            background: #FAFAFA
            position: relative
            z-index: 2
    &-quant-select
      .Input
        display: inline-block
        margin-right: 10px
        .Input-label
          width: auto
          &:after
            content: ''
        .Input-content
          margin-left: 10px
          display: inline-block

.SubscriptionsBatch
    &--upload-modal
      .panel
        cursor: pointer
        transition: background-color 400ms
        &:hover
          background-color: alpha($primary-color, 0.2)
        .panel-body
          display: flex
          align-items: center
          .description
            flex-grow: 1
          .logo
            background-size: contain
            background-repeat: no-repeat
            width: 35px
            height: 28px
          .i-chevron-right
            font-size: 16px
        &.auth-link
          .logo
            background-image: url('assets/symbols/al.svg')
        &.recurring-charge
          .logo
            background-image: url('assets/symbols/rc.svg')

.SubscriptionLinks--Update
  &-review
    .changed-values
      display: flex
      align-items: baseline
      line-height: 20px
      &:not(:last-child)
        margin-bottom: 24px
      .big-dot-separator
        margin-left: 0
      .current-change
        i 
          margin: 0 4px
    .summary
      padding: 16px 24px
      margin-top: 32px
      border: 1px solid rgba(88, 102, 110, 0.18)
      background-color: rgba(216, 216, 216, 0.18)