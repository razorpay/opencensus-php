.TransfersPreviewModal
  .modal-header
    padding: 0
    position: absolute
    right: 10px
    z-index: 1 
    .i-close
      font-size: 12px

  .modal-body
    padding: 32px 32px 16px 32px
  
  .TimedSliderTabs
    width: 75%
    margin: auto
  
  .TimedSlider-frame
    margin-bottom: 16px 
    .TimedSlide img
      width: 100%
  
  .TimedSliderTab
    padding-top: 16px 
    opacity: 0.5
    color: #58666E
    font-size: 12px
    line-height: 15px
    font-weight: 600
    text-align: center
    &.active
      opacity: 1
      color: #528FF0
    
    .progress-bar-success
      background: #5490f0

  .got-it-button
    position: absolute
    bottom: -40px
    font-size: 14px
    line-height: 17px
    font-weight: 600
    color: white
    left: 50%
    transform: translate(-50%, 0)
    cursor: pointer


$formHeight = 568px

.Modal-container.Modal-container--Transfers--DirectTransfer
  width: 90%
  max-width: 400px
  height: $formHeight
  overflow: initial

.StandAloneContainer
  .Transfers--DirectTransfer
    max-height: $formHeight
    background: white
    position: relative
    height: 80vh
    max-width: 400px

.Transfers--DirectTransfer
  .Form
    height: $formHeight;
    overflow-y: scroll

  .title
    padding: 24px
    font-weight: 600
    font-size: 18px
    position: absolute
    top: 0
    left: 0
    background: white
    z-index: 3
    width: 100%

  main
    padding: 70px 24px 132px 24px
    overflow: auto

  footer
    position: absolute
    left: 0
    right: 0
    bottom: 0
    padding: 24px
    background: #F6F6F6
    border-top: 1px solid #e0e0e0
    text-align: right

    .Button
      width: 168px
      padding: 9px 12px

      &:first-child
        margin: 0 16px 0 0

      &:last-child
        margin: 0

  .rzp-whole
    color: black

  .settlement-schedule
    .Input-inlineLabel
      .Input-label
        font-weight normal

      .Input--Calendar
        margin 0

    .Input--radioLabels > label:not(:last-child)
      margin-bottom 8px
    .Input--radioLabels > label
      margin-right: 0

    .Input-radio
      margin-top: 4px
      vertical-align: top

  .PlaceholderLoader
    max-width: 100px

.direct-transfer-banner
  position: relative
  &:before
    content: ''
    position: absolute
    left: -2px
    background: #29c24d
    width: 2px
    height: 90%
    bottom: 5%
    top: 5%

  .alert
    background: rgba(242, 246, 249, 0.8)
    border: 1px solid #E2E8EA
    border-radius: 3px
    position relative
    overflow hidden
    &:after
      content: ''
      position: absolute
      right: -10px
      width: 200px
      height: 201px
      background: #fff
      transform: rotate(-20deg)
      z-index: 1
      top: -63px

  .content
    width: 100%
    margin-top: -3px

    h4
      margin-bottom: 16px

  .desc
    line-height: 20px
    max-width: 261px

  .i-route
    font-size: 15px
    margin-right: 8px
    color #29c24d
    line-height 1

  .rzp-banner-text
    display: flex
    z-index: 2
    position: relative

  .btn-link
    padding: 0
    margin-left: 8px

  .explore-now-btn
    position: absolute
    bottom: 0px
    right: 0
    @media screen and (max-width $screen-xs-max){
      position relative
      margin-top 10px
    }

.RouteBatch--dropdown
  
  .panel
    cursor: pointer
    transition: background-color 400ms

  .panel-body
    display: flex
    align-items: center
    padding: 13px

    .description
      flex-grow: 1

    .i-chevron-right
      font-size: 16px

    img
      margin-right: 13px

.LinkedAccountsList
  .tooltip-cta
    background-color: #32374a
    margin-top: 5px
    float: right

@media screen and (max-width $screen-xs-max)
  .create-payment-transfer
    padding 15px 0
    > .pair-group-item .pair-label, 
    > .pair-group-item .pair-value
      width 100%
      padding 0
