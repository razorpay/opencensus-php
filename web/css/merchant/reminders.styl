$primary = #538FF0

.reminders-settings {
  .reminders-setting {
    button.checkbox-knob {
      margin-left: 25px 
    }

    .status-text {
      margin-left: 10px
      vertical-align: middle
    }

    &.enabled {
        .status-text {
          color: $primary
          font-weight: bold
        }
    }

    .setting {
      display: flex;
      margin-bottom: 30px

      .pair-label {
        color: black;
        font-weight: bold;
      }

      .pair-group-item {
        padding-left: 0; 
      }
    }

    &_footer {
      align-items: center;
      display: flex;
      justify-content: space-between;

      .description {
        width: 70%;
      }
    }
  }
}

.removable-select {
  display: flex;
  align-items: center;
  max-width: 300px;

  &:not(:last-child) {
    margin-bottom: 15px;
  }

  .PowerSelect {
    width: 100%
    margin: 0
    z-index: 0
    border: 1px solid #D8DBDC
    border-radius: 0
    
    &--focused {
      border-color: $primary
    }
  }

  .close-btn {
    border-radius: 75%;
    background-color: #FFFFFF;
    border: 1px solid #D8DBDC;
    display: inline-block;
    padding: 0px 2px;
    margin-left: 10px;
  
    i.i-close {
      color: #58666E;
      display: block;
      line-height: 1;
      margin-top: 2px;
    }
  }
}