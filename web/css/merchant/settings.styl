#settings-content
  background: transparent
  max-width: 900px

  .panel-default
    background: #fff

  .panel-heading
    background: transparent
    border-bottom: 0
    padding: 20px 20px 12px 20px

    .title
      vertical-align: middle
      font-size: 18px
      font-weight: 600

    .toggler-btn
      vertical-align: middle
      margin-left: 20px

      button
        margin-right: 4px

      b
        vertical-align: middle

  .panel-body
    padding: 0 20px 20px

    .form-group
      margin-bottom: 0

    .description
      margin: 8px 0 12px 0

  .footer-note
    margin: 64px -20px -20px -20px
    padding: 24px
    border-top: 1px solid #EBEFF0

  .color-picker
    position: absolute
    overflow: hidden
    width: 34px
    height: 34px
    border: none
    border-radius: 2px
    display: inline-block

  strong
    color: #4A4A4A

  input[type="color"]
    position: absolute
    right: -8px
    top: -8px
    height: 48px
    width: 48px
    border: none

  input[name="brand_color"]
    padding-left: 44px

  img.media-object
    border: 1px solid #D8DBDC
