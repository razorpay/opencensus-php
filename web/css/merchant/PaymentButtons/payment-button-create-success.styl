.PaymentButton-Create-SuccessView
  .Form-buttonIntegration
    width: 100%
    padding: 24px
    border: 1px solid #EDF0F5
    background: #F9FBFE
    box-shadow: 2px 4px 8px rgba(0, 0, 0, 0.1)
    border-radius: 3px

    .m-l
      margin-left: 4px

    .Form-buttonIntegration-code, .Form-buttonIntegration-others
      display: inline-block
      width: 50%
      vertical-align: top

      > *
        margin-top: 8px

    .Form-buttonIntegration-code
      padding-right: 64px

    .Form-buttonIntegration-others
      padding-left: 24px
      padding-right: 40px

    .Form-buttonIntegration-title
      margin-bottom: 4px

    .Form-buttonIntegration-code
      .Button
        line-height: 12px
        font-size: 10px
        padding: 5px 11px
        margin-right: 0

      .ClipboardCustom
        float: right
        margin-top: -2px

      .Input--codeCopy
        margin-top: 8px

        .Input-el
          height: 80px
          font-size: 13px
          padding: 6px 12px

  .Form-buttonActions
    width: 100%
    margin-top: 40px

    .Form-buttonActions-title
      font-size: 16px
      margin-bottom: 8px

    .Form-buttonActions-receipt, .Form-buttonActions-postPayment
      display: inline-block
      width: 50%
      vertical-align: top
      margin-top: 8px

      & > div
        margin-top: 8px

    .Form-buttonActions-receipt
      padding-right: 64px

    .Form-buttonActions-postPayment
      padding-left: 24px
      padding-right: 40px

    .Button
      line-height: 12px
      font-size: 10px
      float: right
      margin-right: 0
      background: rgba(11,112,231,0.05)

    .help-text-settings
      margin-top: 16px

  .Form-controls
    justify-content: unset

    .Button
      margin-right: 0
