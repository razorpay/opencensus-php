// stylelint-disable color-function-notation
.PaymentButton-PreviewFormShell
  position: relative
  width: 240px
  border-radius: 4px
  box-shadow: 0 0 20px rgba(0, 0, 0, 0.08)
  background-color: #FFF
  overflow: hidden
  z-index: 0
  color: #263A4A

  .PreviewFormShell-header
    box-shadow: 2px 2px 15px #6B6C6D26
    border-bottom: 1px solid #E1E5EA

  .PreviewFormShell-header-details
    display: flex
    padding: 12px
    gap: 12px
    align-items: center

    > img
      border-radius: 4px

  .header-details-merchant
    text-overflow: ellipsis
    overflow: hidden
    font-weight: 600
    font-size: 14px

  .Preview-topbar
    padding: 5px 12px
    display: flex
    align-items: center
    justify-content: space-between

  .Preview-topbar-border
    display: flex;
    height: 1px;
    align-items: center;
    justify-content: center;

    > div
      height: 2px;
      width: 95%;
      border-radius: 999em;
      background: linear-gradient(to right, transparent, rgba(191, 219, 254, 0.5), transparent);

  .Preview-topbar-title
    font-size: 8px
    line-height: 16px
    letter-spacing: 0.5px
    font-weight: 600

  .Preview-progressDots,
  .Preview-cross
    display: inline-block

  .Preview-progressDots
    height: 16px

    span
      display: inline-block
      vertical-align: middle
      margin: -1px 3px 5px
      width: 8px
      height: 8px
      border-radius: 50%
      text-align: center
      border: 1px solid #FFF
      filter: brightness(0.5);

    span.marked
      // stylelint-disable-next-line declaration-no-important
      background: #48D08C !important
      // stylelint-disable-next-line declaration-no-important
      border-color: #48D08C !important
      filter: none

    span.active
      width: 32px
      border-radius: 20px

  .PreviewFormShell-checkout-form
    display: flex
    flex-direction: column

    .empty-msg
      width: 70%
      font-weight: 600
      font-size: 12px
      line-height: 14px
      text-align: center
      color: rgba(22, 47, 86, 0.74)

    .Body
      padding: 24px 12px
      flex: 1
      min-height: 290px
      max-height: 290px
      overflow-y: auto

    .Footer
      padding: 7px 12px
      display: flex
      justify-content: space-between
      align-items: center
      box-shadow: 2px -2px 15px #6B6C6D26;
      font-weight: 600
      font-size: 13px

      .Footer--Amount
        text-overflow: ellipsis
        overflow: hidden
        white-space: nowrap

    .Field-dummy-btn
      width: 145px
      padding: 7px
      border-radius: 5px
      text-align: center
      position: relative
      color: #FFF
      background: #000
      font-size: 12px

      &::after
        left: 0
        top: 0
        opacity: 1
        position: absolute
        width: 100%
        height: 100%
        content: ""

    .Field--dummy
      position: relative
      opacity: 0
      animation: 0.15s fadeIn 0.2s cubic-bezier(0.95, 0.11, 1, 1) forwards

      &:not(:first-of-type)
        margin-top: 24px

      .Field-label
        font-size: 9px
        margin-bottom: 1px
        margin-bottom: 8px
        font-weight: 600

      .Field-description
        font-size: 8px
        color: #8D97A1
        margin-top: 4px
        overflow-wrap: break-word

    .Field--dummy--udf
      .Field-el
        width: 100%
        border: 1px solid #DCDEDF
        font-size: 10px
        padding: 6px
        border-radius: 8px

    .Field--dummy--amount
      .Field-el
        height: 29px
        padding: 0 8px
        line-height: 27px
        font-size: 10px
        border: 1px solid #DCDEDF
        border-radius: 8px
        font-weight: 600

        .Field-el-addon
          font-size: 9px

        .currency-decimal
          font-size: 8.5px
          font-weight: normal

      .Input--checkbox
        margin: -2px 0 0

      .Input-checkbox
        width: 14.5px
        height: 14.5px

      .Input--counterTooltip
        top: 25px
        right: 6px

        .Input-content
          // stylelint-disable-next-line max-nesting-depth
          button,
          input
            height: 18px
            line-height: 18px

          // stylelint-disable-next-line max-nesting-depth
          button
            width: 18px
            font-size: 14px
            margin: 2px

          // stylelint-disable-next-line max-nesting-depth
          input
            font-size: 11px
            width: 68px

@keyframes fade-in
  0%
    opacity: 0

  100%
    opacity: 100

.PaymentButton-Create-Preview
  position: relative
  width: 300px
  padding: 32px 28px
  border-left: 1px solid rgba(22, 47, 86, 0.1)
  overflow: hidden
  transition: 0.1s

  .Preview-title
    font-size: 20px
    line-height: 30px
    font-weight: 600
    color: rgba(22, 47, 86, 0.54)
    margin-bottom: 8px

  &.PaymentButton-Create-Preview--hide
    width: 0
    opacity: 0

  .PaymentButton-PreviewFormShell
    margin: 28px auto

  .GuideBox
    background: #FFF
    border: 1px solid rgba(22, 47, 86, 0.1)
    box-shadow: 0 0 15px rgba(11, 112, 231, 0.08)
    border-radius: 2px
    position: absolute
    bottom: 20px
    padding: 12px
    width: 240px

    .title
      margin-bottom: 15px

    .i-help-outline
      margin-right: 4px

    .see-video-btn
      font-weight: 600
      color: rgba(22, 47, 86, 0.87)

      .i-play
        color: #2B83EA

    .doc-link
      font-weight: 600
      color: #2B83EA
      margin-top: 20px
      display: block
