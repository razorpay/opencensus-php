$height-currency = 24px

.PaymentButton-Create-Form
  .Form-content.PaymentButtonForm-AmountDetails
    .EditableDisplayField
      .Input--withCurrency
        margin: 0
        pointer-events: none

      .Input-addons--before
        border: none
        line-height: 24px
        position: absolute
        left: 6px
        top: 6px
        width: 48px !important
        font-size: 13px
        height: 24px
        margin: 0
        background: rgba(224,228,249,0.38)
        border-radius: 2px

      .Input-el--before
        padding-left: 60px

  .Form-content.PaymentButtonForm-AmountDetails--donation
    > .Form
      position: relative
      display: flex
      justify-content: space-between
      flex-basis: auto
      flex-wrap: unset

      .Button--transparent
        margin-top: 4px

      .Input.Input--description
        margin-top: 10px

    .togglePresetsContainer
      margin: 20px 0 32px

      div > *
        vertical-align: middle

    .remove-preset-btn
      position: absolute
      right: -24px
      top: 32px
      cursor: pointer
      opacity: .9

      &:hover
        opacity: 0.7


  .Form-content.PaymentButtonForm-CustomerDetails, .Form-content.PaymentButtonForm-AmountDetails
    flex-direction: column
    justify-content: unset

    .EditableDisplayField
      position: relative
      display: flex
      justify-content: space-between
      cursor: pointer

      margin: -24px -24px 16px -24px
      padding: 24px

      .Input--dummy
        margin: 0
        pointer-events: none

      .Input-desc
        font-size: 12px
        margin-bottom: 0

      .edit-btn
        display: none
        position: absolute
        top: 0
        right: 0
        padding: 8px 12px
        font-size: 11px
        pointer-events: none

        i
          margin-left: 4px

      &.EditableDisplayField--disabled
        margin: 0 -24px 0 -24px
        padding: 0 24px
        margin-bottom: 112px

      &.EditableDisplayField--editMode
        cursor: initial

      &:not(.EditableDisplayField--disabled)
        &::before
          content: ''
          position: absolute
          background: #fff
          left: 0
          right: 0
          top: 0
          bottom: 0
          border: 1px solid #EDF0F5
          box-shadow: 0 4px 10px rgba(11, 112, 231, 0.1)
          border-radius: 3px
          transition: .12s
          opacity: 0
          transform: scale(.97)
          pointer-events: none

        &:hover
          &::before
            pointer-events: unset
            opacity: 1
            transform: scale(1)

          .edit-btn
            display: unset

  .addFieldBtn
    width: 240px
    height: 36px
    background: rgba(11, 112, 231, 0.05)


  .Modal-content--PaymentButton-CreateForm .Form
    display: flex
    justify-content: space-between

    .Input
      margin: 0

  .Input--TextareaAutoResize
    font-size:  12px
    color: #58666e

    textarea.Input-el
      min-height: 28px

    textarea.Input-el, .Input-el--resizer
      height: 28px
      font-size: 12px
      line-height: 28px
      padding: 0 12px

    .Input-el--resizer
      padding-right: 12px


  .CreatorModal-BaseForm, .CreatorModal-AdvancedForm
    background: rgba(32,31,45,0.55)
    z-index: 3
    position: fixed
    left: 0
    right: 0
    top: 0
    width: 100%
    bottom: 0
    box-shadow: 0 2px 8px 0 rgba(43,47,60,0.36)
    animation: 0.55s fadeIn cubic-bezier(0.08, 0.98, 1, 1)

  .CreatorModal-BaseForm-footer
    position: absolute
    bottom: -64px
    margin: 0
    display: flex
    width: 100%
    left: 0
    justify-content: flex-end
    font-weight: 600

    button
      color: #fff
      font-size: 12px

      &:hover
        color: #fff
        opacity: 0.8

      span
        display: block
        width: 32px
        height: 32px
        margin: 0 auto
        font-size: 20px
        border-radius: 2px
        color: #528ff0
        border: 1px solid rgba(82,143,240,0.77)
        margin-bottom: 4px
        line-height: 30px

    .cancel-btn
      margin-right: 16px
      span
        background-color: #fff

    .save-btn
      margin: 0
      span
        color: #fff
        background-color: #528ff0

  .Modal-container--CreatorModal-BaseForm
    position: absolute
    top: 50%
    z-index: 4
    transform: translateY(-50%)
    overflow: unset
    padding: 20px 24px
    background: transparent
    margin-bottom: 120px
    margin-top: 4px
    right: 0
    left: 0
    min-height: 100%

    &::before
      content: ""
      position: fixed
      top: 0
      bottom: 0
      left: 0
      right: 0
      background: rgba(43,47,60,0.36)
      pointer-events: all

    .mimic-expand
      position: absolute
      top: 0
      left: -20px
      right: -20px
      height: 100%
      background: #fff
      animation: modalAppearIn-EditableDisplayField 0.3s .08s cubic-bezier(0.53, 1.78, 1, 1) forwards
      transform-origin: center
      transform: scale(.97)

      border: 1px solid #EDF0F5
      border-radius: 3px


    .Input--Currency
      position: absolute
      left: 6px
      top: 6px
      width: 48px !important
      font-size: 13px
      height: $height-currency
      margin: 0
      z-index: 2
      background: rgba(224, 228, 249, 0.38)
      border-radius: 2px

    .Alert
      position: relative
      margin-left: -44px
      margin-right: -44px
      bottom: -32px
      padding: 12px 16px
      font-size: 13px
      border: none
      color: #8a6d6b

  .Modal-container--CreatorModal-BaseForm .Input--Currency,
  .Input--CurrencyAmount .Input--Currency,
  .PaymentButtonForm-AmountDetails--donation .Input--limits .Input--Currency
    .Input-content
      margin: 0 !important

    .value
      background: none
      border: none
      line-height: 24px
      margin: 0

    .Input-el
      border: none
      height: $height-currency
      font-size: 13px

    .Input--Currency-dropdown
      border: none
      height: $height-currency
      background: inherit

      .PowerSelect__TriggerLabel
        padding: 0 0 0 2px
        overflow: visible

      .PowerSelect__Trigger, .PowerSelect__TriggerLabel, .PowerSelect__TriggerStatus
        height: $height-currency

    & + .Input--Amount
      z-index: 1
      display: block

      .Input-content
        margin: 0

      .Input-el
        padding-left: 60px

  .CreatorModal-AdvancedForm
    z-index: 5

  .CreatorModal-AdvancedForm-title
    font-weight: 600
    font-size: 14px
    margin-bottom: 24px
    letter-spacing: 1px

  .CreatorModal-AdvancedForm-footer
    background: #F9FBFE
    box-shadow: 0 4px 10px rgba(11, 112, 231, 0.05)
    border-radius: 3px
    padding: 12px
    position: absolute
    bottom: 0
    text-align: right
    width: 100%
    left: 0
    border-top: 1px solid #E7F1FD

    button
      padding: 5px 11px
      margin: 0
      min-width: 60px
      height: 28px

      & + button
        margin-left: 16px

  .Modal-container--CreatorModal-AdvancedForm
    width: 380px
    padding: 16px 24px 80px 24px
    z-index: 6
    transform: none
    left: unset
    right: -20px
    bottom: -84px
    top: unset
    //z-index: 10000

    .Form
      flex-direction: column

      .Input
        width: 100%

        & + .Input
          margin-top: 24px

      .InputGroup > .Input + .Input
        margin-top: 8px

  .InputGroup.InputGroup--inline.Input--limits
    display: flex !important
    justify-content: space-between

    .separator
      line-height: 36px

    .Input--limits-content
      width: 45%

      .Input
        margin: 0

    .Input-addons--after
      border-radius: 12px
      height: 20px
      font-size: 12px
      width: 40px
      top: 8px
      right: 4px
      line-height: 21px

    .Input.Input--Currency
      .value
        position: absolute
        border: transparent
        border-radius: 3px
        height: 24px
        font-size: 12px
        width: 40px
        top: 6px
        left: 6px
        line-height: 24px
        background: rgba(224,228,249,.6)

      & + .Input .Input-el
        padding-left: 50px
        font-size: 13px

  .Input--Currency--fullDisplay + .InputGroup
    .Input-el
      padding-right: 8px

    .Input--limits
      .Input-error
        font-size: 11px
        margin-top: 16px

      .Input-addons--after
        top: 36px
        right: 0
        background: none !important
        width: unset
        text-transform: uppercase
        opacity: .55
        font-size: 11px


@keyframes modalAppearIn-EditableDisplayField
  0%
    transform: scale(.97)
  100%
    transform: scale(1)
