.OnBoarding--Optimizer .OnBoarding--ImageSlide
  .Product--Details
    flex: 1
    margin-top: 0
    align-self: center

    @media (max-width 1024px)
      padding-bottom: 60px
      margin-top: 120px

    .Details-desc .points-wrapper
      padding-left: 12px
      margin: 10px 0
      list-style: none

      li
        &:not(:last-child)
          margin-bottom: 7px

        i
          color: #1F890E
          margin-right: 5px
          font-size: 90%
          vertical-align: middle
