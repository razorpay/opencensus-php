.partner-onboarding-base-screen
    min-height:503px
    min-width:850px
    border-radius: 4px;
    background: #FEFEFF;
    background-image:url('assets/onboarding/prt-bkg.png')
    background-repeat:no-repeat;
    background-size:603px;
    background-position: top 0 right 0%;
    font-family: Lato;
    font-style: normal;
    .partner-onbr-info
      width:50%;
      height:400px;
      padding: 50px 0px 50px 50px;
    .title
      font-weight: bold;
      font-size: 24px;
      line-height: 29px;
      color: #57666E;
    .line-shadow-box
      background-color: #fff;
      box-shadow: 0px 2px 5px rgba(0,0,0,0.284);
      border-radius: 2px;
      border-radius: 2px;
      border: solid 1px;
      border-left: 4px solid;
      padding: 15px 0px 15px 10px;
      margin-top: 20px;
      list-style-type: none;
      font-size: 14px;
      line-height: 20px;
      color: #57666e;      
    .brd-primary
      border-color:rgba(63, 214, 154, 0.4);
      border-left-color:rgb(63, 214, 154);
    .info
      font-weight: bold;
      font-size: 14px;
      line-height: 22px;
    .info-green
      color: #3FD69A;
    .info-grey
      color: #57666E;
    .info-blue
      color:#518FF0;
     .options-group
       margin-top:21px;
       div
         height: 102px;
         background: #FFFFFF;
         border: 1px solid #D6D6D6;
         box-sizing: border-box;  
         padding:20px;
      .no-bottom-border
        border-bottom-width:0px !important;
      .no-top-border
        border-top-width:0px !important;
      .tnc-box
        background: #FFFFFF;
        border: 1.8px solid #EBEBFD;
        box-sizing: border-box;
        border-radius: 4px;
        padding:16px;
        max-height: 300px;
        overflow-y: scroll;
        margin-top:22px;
    .slide-controller
      display:flex;
      align-items:center;
      .SliderDots
          text-align: left;
          margin-left:50px;  