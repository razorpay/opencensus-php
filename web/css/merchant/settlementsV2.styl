.settlements-v2
  position: relative
  border: 1px solid #DFE5E7
  border-radius: 3px
  max-width: unset
  margin: 20px
  margin-top: 124px
  @media screen and (max-width: $screen-sm-min)
    margin 20px 10px

  span
    font-style normal

  &.entity-list-table
    margin-top 55px

    .no-transactions-data
      text-align center
      margin-top 30px
      font-size 20px

  .content-header
    position: absolute
    top: -44px
    font-size: 14px

    &:before 
      content unset

    .i-arrow-back
      font-size: 20px
      line-height: 14px
  
  .mis-match-banner
    margin-bottom: 0
    background: #FCF8E5
    .banner-heading
      font-weight: 700
      line-height: 20px
      color: #515978
      .i.i-info-outline
        margin-right: 10px
        color: #CD8214
      .rzp-amount
        .rzp-currency, .rzp-whole, .rzp-paise
          font-weight: 700
    p
      margin-left: 25px
      font-size: 12px
      line-height: 14px
      color: #515978

  .panel
    overflow: hidden
    transition: .8s cubic-bezier(0.26, 0.7, 1, 1)
    max-height: 2000px
    position: relative
    margin-bottom: 48px

  &.settlements-v2-collapse
    &::after
      content: ''
      background: linear-gradient(180deg, rgba(255, 255, 255, 0.15) 0%, #FFFFFF 100%)
      position: absolute
      height: 34px
      bottom: 48px
      left: 0
      right: 0

    .panel
      max-height: 312px

  .panel-collapser
    position: absolute
    bottom: 12px
    left: 50%
    transform: translateX(-50%)
    padding: 2px 6px


  .panel-body
    display: table
    padding-bottom: 0

    .entity-details, .item-details
      display: table-cell
      vertical-align: top

    .entity-details
      min-width: 500px

    .item-details
      width: 100%

      .InputGroup
        margin: 0

      table
        width: 100%
        border-spacing: 0 12px
        border-collapse: separate

      tr
        border-radius: 3px
        padding: 16px
        transform: translateY(8px)
        opacity: 0
        animation: move-up .3s ease-in forwards .2s
        // Added media query to support the multirow view for this info to support m-web
        @media screen and (max-width: $screen-sm-min)
          display flex
          flex-wrap wrap
          padding 0
          margin: 16px 0
          background: #f3f4f7
          @media screen and (max-width: 392px)
            // Specific css to support the device with even lesser width
            margin 16px -8px


        td.item-details-units
          min-width: 148px
            
        td
          background: #f3f4f7
          max-width: 112px
          min-width: 80px

          & > div
            min-height: 64px
            padding: 14px 0px
            overflow-wrap: break-word
            text-align center

          &:first-child
            border-bottom-left-radius: 3px
            border-top-left-radius: 3px
            padding-left 14px
            width 80px
            
            div
              display flex
              align-items center
              width 80px
              overflow scroll
              text-align inherit

              &::-webkit-scrollbar 
                display none
          
          &:first-child.highlight-unreconciled
            div
              width 85px

          &:last-child
            border-bottom-right-radius: 3px
            border-top-right-radius: 3px

      .title
        color: #8991AE
        font-size: 13px
        line-height: 16px
        vertical-align: top
  
  .settlement-total-amount
    float right
    @media screen and (max-width: $screen-sm-min)
      float none
      line-height: 1
      margin-bottom: 10px

  .settled-amount
    font-weight bold
    font-size 13px
    line-height 18px
    padding-top 7px

    i 
      color #ADBCC9
      padding-left 5px
  
  .highlight-debit, .highlight-debit-row
    border-left 3px solid #fbc9a1
  
  .highlight-credit, .highlight-credit-row
    border-left 3px solid #b4e397
  
  .highlight-unreconciled, .highlight-unreconciled-row
    border-left 3px solid #ffe670
  // for the m-web we don't want the left border to show for mweb as we are showing the TR border
  @media screen and (max-width: $screen-sm-min)
    .highlight-debit, .highlight-credit 
      border-left-width 0
  
  .div--loading
    display flex
    height 197px
  
  .entity-tabs
    display flex
    justify-content flex-start
    flex-direction row
    padding 20px 0px 0px 20px
    max-width 100%
    overflow scroll
    border-bottom 1px solid #e2e8ea

    &::-webkit-scrollbar 
      display none
  
    .tab
      padding 0px 8px 6px 6px
      font-size 14px
      line-height 19px
      font-weight bold
      color #515978
      cursor pointer
      height 40px
    
    .active
      color #528FF0
      position relative
      border-bottom 4px solid #528FF0

@media (max-width: 720px)
  .settlements-v2
    .entity-tabs
      .count
        display none

      .active
        &:after
          content none
    
    .link-all
      display none

.entity-details
      .pair-group-item
        .pair-label
          @media screen and (max-width: $screen-sm-min)
            width 25%
          @media screen and (max-width: 359px)
            width 15%

@media (max-width: 1023px)
  .settlements-v2
    .panel-body
      display: block
      width: 100%

      .entity-details, .item-details
        display: block
        width: 100%

    &.settlements-v2-collapse
      .panel
        max-height: 532px


@keyframes move-up
  0%
    opacity: .3

  100%
    opacity: 1
    transform: translateY(0)

.settlements-v2 .panel-heading .text
  width: 68%
  display: inline-block
  white-space: nowrap
  overflow: hidden
  text-overflow: ellipsis
  vertical-align: bottom
  font-weight: 600

.settlements-v2 .panel-heading .text
  width 48%

.settlements-v2
  .panel-heading .btn
    padding: 5px
    min-width: 72px
    line-height: 1.5em

  .panel-heading .btn-xs
    min-width: 40px

  .stats-info
    margin-bottom: 0

    .table > tbody > tr > td
      padding: 12px

    .table .td-info:not(:first-child)::before
      top: 12px
      bottom: 12px
      height: unset

  .stats-info-footer
    margin-bottom: 24px
    padding: 12px
    background: #f9f9f9
    text-align: right
    border: 1px solid #eaeff0
    border-top: none

    .i
      vertical-align: unset

      &:before
        vertical-align: middle
        font-size: 20px

.settlement-components-filter
  display flex
  justify-content flex-start
  align-items flex-end
  flex-wrap wrap
  margin -24px 0px 10px -12px

  >div
    padding 0px 15px

    &:nth-child(2)
      .Input
        width 40%

    &:nth-child(3)
      padding-bottom 10px
      margin-left -100px
    
    &:nth-child(4)
      padding-bottom 18px
      color #528ff0
      cursor pointer

  .Input-label
    top 0px !important

.settlement-info-popup
  position relative

  .amount-row
    opacity .72

  .amount-value
    position absolute
    right 0px
  
  .settled-amount-row
    margin-top 5px
    padding-top 5px
    border-top 1px
    border-top-style solid 
    border-top-color white