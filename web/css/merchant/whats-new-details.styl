.content-wrapper.announcement-details
  overflow: hidden;

.content-wrapper.announcement-details
  .panel.SliderPanel
    display: flex;
    flex-direction: column;
    height: 100%;
    border: none;

    .panel-heading
      border-bottom: none;
      line-height: 64px;
      background-color: #fff;
      vertical-align: middle;
      padding-top: 0;
      padding-bottom: 0;

      .heading-content
        border-bottom: 1px solid #E6EBF3;

        b
          font-size: 16px;

        a
          color: inherit

          i
            font-size: 31px
            vertical-align: middle

.announcement-details
  &__container
    height: 100%;
    display flex;
    flex-direction: column;


  .panel-heading
    background transparent;
    padding-top: 10px;
    padding-bottom: 10px;


  .panel-body
    padding: 24px 40px 0 40px;


  &__content
    flex: auto;
    font-size: 16px;
    max-height: 100%;
    overflow-y: scroll;
    line-height: 1.75;

    .paragraph
      padding: 20px 0 20px 0;


    .image
      display: flex;
      justify-content: center;
      padding: 32px 20px;
      height: 100%;
      width: 100%;

      img
        height: 100%;
        width: 100%;



    ol, li
      margin-left: -24px;


    a, i
      font-size: 16px;
      font-weight: bold;


    .title
      display: flex;
      flex-direction: row;
      align-items: flex-start;
      padding: 1.5rem 0 2rem;
      font-size: 20px;

      p
        margin 0;
        padding-left 15px;
        padding-right 10px;



    .description
      line-height: 1.6;
      padding-bottom 3rem;


    .i.i-chevron-left
      margin-left: -20px



  &__footer
    display flex;
    flex-direction row;
    justify-content: space-evenly;
    padding: 25px 115px 25px 40px;
    box-shadow: 0px -4px 12px rgba(0, 0, 0, 0.03);

    .btn
      font-size: 15px;
      padding: 10px 20px;
      width: 100%;


    .btn-link
      color: $primary-color;


    :not(:last-of-type)
      margin-right: 20px;


    i
      display: inline-block;
      margin-left: 2px;


    .btn-link
      padding: 8px 4px;


    .btn-primary--invert
      background-color: #fff;
      color: #3b80ee;
      border-color: #3b80ee;


    .btn-primary
      i
        color: #fff
        width: 100%;




