.Dashboard {
  .h1, h4 {
    margin: 0;
    font-weight: 300;
  }

  .panel {
    box-shadow: 0 1px 1px rgba(0,0,0,.05);
  }
}

.clearfix:after {
  display: table;
  content: '';
  clear: both;
}

.webkit-sec {
  -webkit-text-security: disc;
}

.InfoCard {
  padding-top: 15px;
  padding-bottom: 15px;

  .LoaderDots span {
    font-size: 28px;
  }
}

.InfoCard__value {
  height: 36px;
  line-height: 36px;
}

.InfoCard__label {
  font-size: 12px;
  color: rgb(214, 211, 230);
}

.WidgetContainer {
  height: 304px;
  margin-bottom: 20px;

  h4 {
    margin-bottom: 10px;
  }

  .panel,
  .panel-body {
    height: 100%;
    position: relative;
  }

  &.Transaction__Vol {
    margin-right: 30%;
    @media (max-width $screen-sm-min) {
      margin-right: 0;
    }
  }

  &.Transaction__Types {
    display: inline-block;
    float: right;
    width: 30%;
    color: #58666e;
    @media (max-width $screen-sm-min) {
      width: 100%;
      float: none;
    }

    .panel-body {
      background-color: #e4eaec;
    }
  }
}

.RecentTxns .WidgetContainer {
  height: auto;

  .panel-body {
    min-height: 175px;
  }
}

.EntityTable {
  code {
    padding: 0;
  }
}

.report-wrapper {
  background-color: #fff;
  padding: 0;
  float: none;
  padding-top: 8px;
  margin: 0px auto;

// This is only needed for desktop
  @media(min-width: 992px) {
    &:before {
      content: '';
      display: block;
      position: absolute;
      top: 0;
      bottom: 0;
      left: 33.33%;
      border-left: 1px solid #DEE5E7;
    }
  }

  &:after {
    clear: both;
    content: '';
    display: table;
  }

  .report-list-panel {
    .title {
      color: #7f7f7f;
      font-size: 12px;
    }
    &--mobile {
      padding: 16px 16px 0;

      .title {
        padding: 0 0 8px 0;
      }
    }
    &--desktop {
      padding: 0;
      padding-top: 16px;
      padding-bottom: 8px;

      .title {
        padding: 0 0 8px 24px;
      }
    }
  }

  .report-generate-panel {
    padding: 11px 24px 24px;
    min-height: 300px;

    .title {
      color: #7f7f7f;
      font-size: 12px;
      padding-bottom: 8px;
    }

    .account {
      line-height: 36px;
    }

    .custom-date {
      position: relative;

      .custom-icon {
        right: 10px;
        display: inline-block;
        height: 100%;
        line-height: 2.2;
      }
    }

    .form-heading {
      font-weight: 600;
      border-bottom: 1px solid #e2e8ea;
      padding-bottom: 6px;
      margin-bottom: 24px;
      font-size: 16px;
    }

    .form-element {
      margin-bottom 16px;

    //<select> has default radius which can't be changed using CSS. So, set parent as .form-control and don't add .form-control to <select>
      .fix-select {
        background: transparent;
        border: none;
        margin-left: -5px;
        width: 100%;
      }

      &:last-child {
        margin-bottom: 4px;
      }

      &:after {
        clear: both;
        content: '';
        display: table;
      }

      footer {
        padding: 12px 0 0 0;
      }

      [class^='col-'] {
        padding: 0;
        &:not(:last-child) {
          margin-right: 16px;
        }
      }
    }
  }
}

.radio-group-container{
  label {
    padding: 5px 15px 5px 0;
    input{
      margin-right: 5px;
    }
  }
  .radio-error{
    border: 1px solid red;
  }
  span.error{
    font-size: 11px;
    color: red;
    float: right;
  }
}

.custom-date-error{
  input{
    border:1px solid red;
  }
  span.error{
    font-size: 11px;
    color: red;
    float: right;
  }
}

.custom-icon {
  position: absolute;
  z-index: 1;
  color: #e0e0e0;
  pointer-events: none;
}

.typeAheadSkin {
  position: absolute;
  z-index: 2;
  background-color: rgb(255, 255, 255);
  top: 10px;
  width: 87%;
  margin-left: 30px;
  pointer-events none;
  font-size: 12px;

  .option-title {
    margin-right: 5px
    max-width: 33%
    text-overflow: ellipsis
    display: inline-block
    white-space: nowrap
    overflow: hidden
    vertical-align: middle
  }
}


.transfers-powerselect + .typeAheadSkin {
  margin-left: 10px;
}

.auto-complete-search {
  position: relative

  .typeAheadSkin {
    margin-left: 2px;
    padding-left: 6px;
    width: 80%;
  }
}

.custom-select .custom-icon {
  top: 11px;
  left: 8px;
  font-size: 20px;
}

.custom-select .PowerSelect__Trigger {
  height: 35px;
}

// Onboarding Card

.media.onboarding-card.new-features {
  > .media-body {
    max-width: 100%;
    padding: 24px;
  }
}
.onboarding-illustration {

  width: 280px;
  height: 310px;
  position: absolute;
  top: 0;
  right: 0;
  background: transparent url("assets/onboarding.svg") 0 0 no-repeat;
  opacity: 1;

  @media (max-width: 1234px) {

    opacity: 0.7;
  }
}

.v2-onboarding-card {

  .onboarding-card-wrapper-content {

    width: 100%;
    max-height: 0;
    overflow: hidden;
    transition: max-height 1s ease-in-out;
  }

  &.expand {

    .onboarding-card-wrapper-content {

      max-height: 700px;
      transition: max-height 1s ease-in-out;
    }
  }

  &.old-analytics {

    margin-bottom: 20px;
  }
}

body.analytics-v2-active .onboarding-card-wrapper {

  padding: 20px;
}

.onboarding-card.media {
  background-color: #5D89E5;
  padding: 54px 48px 54px 48px;
  box-shadow: 0 0 8px 0 rgba(0,0,0,0.16);
  border-radius: 2px;
  position: relative;
  transition: 0.1s linear;
  box-shadow: none;
  background: linear-gradient(223.96deg, #5D89E5 0%, #3059C0 100%);
  color: white;

  .close {
    position: absolute;
    top: 16px;
    right: 16px;
    font-size: 18px;
    color: #ffffff;
    opacity: 0.8;

    &:hover {

      opacity: 1;
    }
  }

  > .media-left {
    vertical-align: middle;
    @media(max-width: 480px) {
      display: none;
    }

    .media-object {
      width: 320px;
      min-height: 200px;
      max-height: 220px;
    }
  }

  > .media-body {
    width: 1px;
    padding: 0;
    max-width: 800px;
    min-height: 200px;
    position: relative;
    z-index: 1;

    @media (max-width: 974px) {

      width: 100%;
    }

    p {
      margin-bottom: 16px;
    }

    ul.row {
      margin-bottom: 8px;
      padding-left: 30px;

      > li {
        padding-left: 0;
        margin-bottom: 8px;
      }
    }

    .btn {
      padding-left: 12px;
      font-size: 14px;
      border-radius: 2px;
      margin-top: 12px;
      background-color: #fff;
      color: #528ff0;
      border: none;
      box-shadow: 0 1px 3px 0 rgba(0,0,0,0.14);

      &:hover {

        box-shadow: inset 0 1px 3px 0 rgba(0,0,0,0.24);
      }

      > span {
        margin-right: 8px;
      }
    }
  }

  div.new-products-row {

    display: flex;
    flex-direction: row;
    align-items: stretch;

    div.product-item {
      padding-left: 10px;
      flex: 1;
      &:first-child {
        padding-left: 0;
      }
    }

    div.media {

      height: 100%;
      color: #58666e;
      border-radius: 2px;
      background-color: #FAFAFA;
      padding: 14px;
      border: 1px solid #D8E1E3;
      vertical-align: top;

      &:hover {
        border: 1px solid #BAACEA;
        background-color: #FAFBFF;
      }

      .media-object {
        width: 31px;
        height: 31px;
      }
    }
  }

  .media-heading {
    font-size: 24px;
    line-height: 36px;
    font-weight: bold;
    margin-bottom: 16px;

    .highlight {

      display: inline-block;
      padding-bottom: 20px;
      border-bottom: 4px solid #96C5FF;
    }

    @media(max-width: 778px) {

      .highlight {

        padding-bottom: 0;
        border-bottom: 0;
      }
    }
  }

  .onboarding-cta {

    color: $primary-color;
  }

  .onboarding-checklist-item {

    display: table;
    width: 100%;
    padding-bottom: 16px;

    > div {

      display: table-cell;
      vertical-align: top;

      &.icon-cont {

        width: 20px;
        text-align: center;
        padding-right: 6px;

        > i {

          display: inline-block;
          width: 16px;
          height: 16px;
          line-height: 12px;
          border-radius: 50%;
          background-color: rgba(255, 255, 255, 0.2);

          &:before {

            font-size: 12px;
            vertical-align: middle;
          }
        }
      }
    }
  }

  .onboarding-desc {

    margin-bottom: 24px;

    a {

      color: inherit;
      text-decoration: underline;
    }
  }

  .onboarding-steps {

    .rzp-group {

      width: 100%;

      .rzp-group-item {

        border: 0;
        padding: 0;

        &:first-child {

          padding-right: 12px;
        }
      }

      @media (min-width: $screen-sm-min + 1px) and (max-width: 820px), (max-width:688px) {

        display: block;

        > .rzp-group-item {

          display: block;

          &:first-child {

            padding-right: 0;
            padding-bottom: 12px;
          }
        }
      }
    }
  }

  a.Onboarding__Step:hover {

    background-color: rgba(250, 250, 250, 0.9);
  }

  .Onboarding__Step {
    display: block;
    color: #58666e;
    border-radius: 2px;
    background-color: #FAFAFA;
    padding: 14px;
    min-width: 275px;

    @media (max-width: 893px) {

      min-width: auto;
    }

    &.loading {

      pointer-events: none;

      div.media > div {

        &.media-body {

          b * , .step-desc * {

            opacity: 0;
          }

          b .PlaceholderLoader, .step-desc .PlaceholderLoader {

            position: absolute;
            display: inline-block;
            opacity: 1;
            top: 0;
            left: 0;
          }
        }

        &.media-icon {

          padding-right: 8px;

          > .activation-step-icon {

            background-image: none !important;
            background-color: #dfe1ea;
            border-radius: 50%;
            width: 32px;
            height: 32px;
          }
        }

        &.media-arrow {

          display: none;
        }
      }
    }

    div.media {

      display: table;
      width: 100%;

      > div {

        display: table-cell;
        vertical-align: middle;

        b, div.step-desc {

          white-space: nowrap;

          .rzp-popover {

            .rzp-tooltip-inner {

              .rzp-popover-content {

                white-space: normal;
              }
            }
          }

          @media (max-width: 974px) {

            white-space: normal;
          }
        }

        b {

          font-size: 14px;
          line-height: 19px;
          display: inline-block;
          position: relative;
          color: rgba(0,0,0,0.87);

          i.i-info-circle {

            display: inline-block;
            margin-left: 2px;
            vertical-align: middle;
          }
        }

        div.step-desc {

          margin-top: 4px;
          position: relative;
          color: rgba(0,0,0,0.54);
        }

        &.media-icon {

          width: 1px;
          vertical-align: middle;

          @media (max-width: 372px) {

            display: none;
          }

          .activation-step-icon {

            display: block;
            width: 46px;
            height: 32px;
            background-position: top left;
            background-repeat: no-repeat;

            &.keygen {

              background-image: url('assets/activation_icons/keygen.svg');
            }

            &.integrate {

              background-image: url('assets/activation_icons/integrate.svg');
            }

            &.browse {

              background-image: url('assets/activation_icons/browse.svg');
            }

            &.done {

              background-image: url('assets/activation_icons/done.svg');
            }

            &.activation-form {

              background-image: url('assets/activation_icons/activation-form.svg');
            }

            &.activation-form-submitted {

              background-image: url('assets/activation_icons/activation-form-submitted.svg');
            }

            &.activation-form-rejected {

              background-image: url('assets/activation_icons/activation-form-rejected.svg');
            }

            &.activation-form-need-clarification {

              background-image: url('assets/activation_icons/activation-form-need-clarification.svg');
            }
          }
        }

        &.media-body .activation-progress-cont {

          display: table;
          width: 100%;

          @media (min-width: 768px) and (max-width: 978px) {

            .activation-progress, .activation-progress-num {

              display: none !important;
            }
          }

          @media (max-width: 440px) {

            .activation-progress {

              display: none !important;
            }
          }

          @media (max-width: 412px) {

            .activation-progress-num {

              display: none !important;
            }
          }

          > div {

            display: table-cell;
            white-space: nowrap;
            vertical-align: middle;

            @media (max-width: 412px) {

              white-space: normal;

              span.activation-progress-num, div.activation-progress {

                display: none;
              }
            }

            &:first-child {

              width: 1%;
            }

            b {

              white-space: nowrap;
            }

            span.activation-progress-num {

              display: inline-block;
              padding-left: 10px;
              padding-right: 5px;
            }

            div.activation-progress {

              width: 100%;
              margin-left: 0;

              .progress {

                height: 6px;
                border-radius: 4px;
                overflow: hidden;
                background-color: #ced7d9;

                div.progress-bar {

                  border-radius: 4px;
                }
              }
            }
          }
        }

        &.media-body {

          width: auto;
        }

        &.media-arrow {

          width: 32px;
          text-align: right;

          > i {

            font-size: 20px;
            vertical-align: middle;
            position: relative;
            right: -7px;
            padding-left: 8px;
          }
        }
      }
    }

    a {
      text-decoration: underline;
    }

    .i-external-link {
      font-size: 100%;
    }

    .media-heading {
      margin-bottom: 2px;
    }

    .media-body {
      font-size: 13px;
    }

    .media-object {
      width: 53px;
      height: 42px;
    }

    .activation-progress {
      width: 75px;
      display: inline-block;
      margin-left: 12px;

      .progress {
        height: 8px;
        border-radius: 2px;
        background-color: #e4e9ea;
        margin-bottom: 0;
      }
    }
  }
}

.onboarding-card-wrapper-content.first-step {

  position: relative;
  /* 9999px box-shadow spread radius does not work in safari, max is 1016 */
  box-shadow: 0 0 0 1000px rgba(0,0,0,.7), 0 0 15px rgba(0,0,0,.25);
  z-index: 9999;
  border-radius: 2px;

  div.onboarding-card.media {

    padding-right: 328px;

    @media (max-width: 1278px) {

      padding-right: 250px;
    }

    @media (max-width: 1200px) {

      padding-right: 301px;
    }

    @media (max-width: 1095px) {

      padding-right: 48px;
    }

    @media (max-width: 450px) {

      padding: 24px;
    }

    > div.media-body {

      width: 100%;
    }

    .onboarding-illustration {

      opacity: 1;
    }
  }
}

@media(max-width: 1095px) {

  .onboarding-illustration {

    display: none;
  }

  .onboarding-card.media {

    padding: 54px 48px 54px 48px;
  }
}

@media(max-width: 500px) {

  .onboarding-card.media {

    padding: 24px;

    .close {

      top: 8px;
      right: 8px;
    }
  }
}

.media.onboarding-card.servicetax-news {
  min-height: inherit;
  width: 100%;
  padding: 24px;

  img, >div {
    vertical-align: middle;
  }

  img {
    max-width: 75px;
    width: 4em;
    margin-right: 20px;
  }

  > div {
    display: inline-block;
    width: 73%;
    margin-right: 12px;

    .heading {
      font-weight: bold;
      font-size: 16px;
      margin-bottom: 4px;
    }

    .news {
      > a {
        padding: 0;
      }
    }
  }

  a {
    margin-top: 16px;
    padding: 8px;
  }
}



.reports-entity-options {

  input[type=radio].report-type {
    display: none;
  }

  input[type=radio].report-type + label {
    width: 100%;
    padding: 12px 24px;
    margin: 0;
    color: #555555;
    font-size: 14px;
    font-weight: 400;
    cursor: pointer;
  }

  &:not(:last-child) {
    input[type=radio].report-type + label {
      border-bottom: 1px solid rgba(0,0,0,0.03);
    }
  }

  input[type=radio].report-type + label:hover {
    background-color: #f9f9f9;
  }

  input[type=radio].report-type:checked + label {
    color: $primary-color;
    background-color: #f9f9f9;
  }

  @media(min-width: 992px) {
    input[type=radio].report-type:checked + label:after {
      float: right;
      content: "\25BA";
      color: #a5a5a5;
      font-size: 11px;
    }
  }

  &.new {

    label {
      width: 100%;
      padding: 12px 24px;
      margin: 0;
      color: #555555;
      font-size: 14px;
      font-weight: 400;
      cursor: pointer;

      :hover {
        background-color: #f9f9f9;
      }

      &.active {
        color: $primary-color;
        background-color: #f9f9f9;
      }
    }

    &:not(:last-child) {
      label {
        border-bottom: 1px solid rgba(0,0,0,0.03);
      }
    }

    @media(min-width: 992px) {
      label:after {
        float: right;
        content: "\25BA";
        color: #a5a5a5;
        font-size: 11px;
      }
    }
  }
}

