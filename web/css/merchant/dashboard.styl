$sidebar-bg-color = #2E3345;

.Dashboard {
  .h1, h4 {
    margin: 0;
    font-weight: 300;
  }

  .panel {
    box-shadow: 0 1px 1px rgba(0,0,0,.05);
  }
}

.clearfix:after {
  display: table;
  content: '';
  clear: both;
}

.webkit-sec {
  -webkit-text-security: disc;
}

.InfoCard {
  padding-top: 15px;
  padding-bottom: 15px;

  .LoaderDots span {
    font-size: 28px;
  }
}

.InfoCard__value {
  height: 36px;
  line-height: 36px;
}

.InfoCard__label {
  font-size: 12px;
  color: rgb(214, 211, 230);
}

.WidgetContainer {
  height: 304px;
  margin-bottom: 20px;

  h4 {
    margin-bottom: 10px;
  }

  .panel,
  .panel-body {
    height: 100%;
    position: relative;
  }

  &.Transaction__Vol {
    margin-right: 30%;
    @media (max-width $screen-sm-min) {
      margin-right: 0;
    }
  }

  &.Transaction__Types {
    display: inline-block;
    float: right;
    width: 30%;
    color: #58666e;
    @media (max-width $screen-sm-min) {
      width: 100%;
      float: none;
    }

    .panel-body {
      background-color: #e4eaec;
    }
  }
}

.RecentTxns .WidgetContainer {
  height: auto;

  .panel-body {
    min-height: 175px;
  }
}

.EntityTable {
  code {
    padding: 0;
  }
}

.report-wrapper {
  background-color: #fff;
  padding: 0;
  float: none;
  padding-top: 8px;
  margin: 0px auto;

// This is only needed for desktop
  @media(min-width: 992px) {
    &:before {
      content: '';
      display: block;
      position: absolute;
      top: 0;
      bottom: 0;
      left: 33.33%;
      border-left: 1px solid #DEE5E7;
    }
  }

  &:after {
    clear: both;
    content: '';
    display: table;
  }

  .report-list-panel {
    .title {
      color: #7f7f7f;
      font-size: 12px;
    }
    &--mobile {
      padding: 16px 16px 0;

      .title {
        padding: 0 0 8px 0;
      }
    }
    &--desktop {
      padding: 0;
      padding-top: 16px;
      padding-bottom: 8px;

      .title {
        padding: 0 0 8px 24px;
      }
    }
  }

  .report-generate-panel {
    padding: 11px 24px 24px;
    min-height: 300px;

    .title {
      color: #7f7f7f;
      font-size: 12px;
      padding-bottom: 8px;
    }

    .account {
      line-height: 36px;
    }

    .custom-date .custom-icon {
      top: 12px;
      right: 10px;
    }

    .PowerSelect__TriggerInput {
      padding-left: 32px;
    }

    .form-heading {
      font-weight: 600;
      border-bottom: 1px solid #e2e8ea;
      padding-bottom: 6px;
      margin-bottom: 24px;
      font-size: 16px;
    }

    .form-element {
      margin-bottom 16px;

    //<select> has default radius which can't be changed using CSS. So, set parent as .form-control and don't add .form-control to <select>
      .fix-select {
        background: transparent;
        border: none;
        margin-left: -5px;
        width: 100%;
      }

      &:last-child {
        margin-bottom: 4px;
      }

      &:after {
        clear: both;
        content: '';
        display: table;
      }

      footer {
        padding: 12px 0 0 0;
      }

      [class^='col-'] {
        padding: 0;
        margin-right: 16px;
      }
    }
  }
}

.custom-icon {
  position: absolute;
  z-index: 1;
  color: #e0e0e0;
  pointer-events: none;
}

.typeAheadSkin {
  position: absolute;
  z-index: 2;
  background-color: rgb(255, 255, 255);
  top: 10px;
  width: 87%;
  margin-left: 30px;
  pointer-events none;
  font-size: 12px;
}


.transfers-powerselect + .typeAheadSkin {
  margin-left: 10px;
}

.custom-select .custom-icon {
  top: 11px;
  left: 8px;
  font-size: 20px;
}


// Onboarding Card

.media.onboarding-card.new-features {
  > .media-body {
    max-width: 100%;
    padding: 24px;
  }
}

.onboarding-illustration {

  width: 280px;
  height: 310px;
  position: absolute;
  top: 0;
  right: 0;
  background: transparent url("assets/onboarding.svg") 0 0 no-repeat;
  opacity: 1;

  @media (max-width: 1234px) {

    opacity: 0.7;
  }
}

.v2-onboarding-card {

  .onboarding-card-wrapper-content {

    width: 100%;
    max-height: 0;
    overflow: hidden;
    transition: max-height 1s ease-in-out;
  }

  &.expand {

    .onboarding-card-wrapper-content {

      max-height: 700px;
      transition: max-height 1s ease-in-out;
    }
  }

  &.old-analytics {

    margin-bottom: 20px;
  }
}

body.analytics-v2-active .onboarding-card-wrapper {

  padding: 20px;
}

.onboarding-card.media {
  background-color: #5D89E5;
  padding: 54px 48px 54px 48px;
  box-shadow: 0 0 8px 0 rgba(0,0,0,0.16);
  border-radius: 2px;
  position: relative;
  transition: 0.1s linear;
  box-shadow: none;
  background: linear-gradient(223.96deg, #5D89E5 0%, #3059C0 100%);
  color: white;

  .close {
    position: absolute;
    top: 16px;
    right: 16px;
    font-size: 18px;
    color: #ffffff;
    opacity: 0.8;

    &:hover {

      opacity: 1;
    }
  }

  > .media-left {
    vertical-align: middle;
    @media(max-width: 480px) {
      display: none;
    }

    .media-object {
      width: 320px;
      min-height: 200px;
      max-height: 220px;
    }
  }

  > .media-body {
    width: 1px;
    padding: 0;
    max-width: 800px;
    min-height: 200px;
    position: relative;
    z-index: 1;

    @media (max-width: 974px) {

      width: 100%;
    }

    p {
      margin-bottom: 16px;
    }

    ul.row {
      margin-bottom: 8px;
      padding-left: 30px;

      > li {
        padding-left: 0;
        margin-bottom: 8px;
      }
    }

    .btn {
      padding-left: 12px;
      font-size: 14px;
      border-radius: 2px;
      margin-top: 12px;
      background-color: #fff;
      color: #528ff0;
      border: none;
      box-shadow: 0 1px 3px 0 rgba(0,0,0,0.14);

      &:hover {

        box-shadow: inset 0 1px 3px 0 rgba(0,0,0,0.24);
      }

      > span {
        margin-right: 8px;
      }
    }
  }

  div.new-products-row {

    display: flex;
    flex-direction: row;
    align-items: stretch;

    div.product-item {
      padding-left: 10px;
      flex: 1;
      &:first-child {
        padding-left: 0;
      }
    }

    div.media {

      height: 100%;
      color: #58666e;
      border-radius: 2px;
      background-color: #FAFAFA;
      padding: 14px;
      border: 1px solid #D8E1E3;
      vertical-align: top;

      &:hover {
        border: 1px solid #BAACEA;
        background-color: #FAFBFF;
      }

      .media-object {
        width: 31px;
        height: 31px;
      }
    }
  }

  .media-heading {
    font-size: 24px;
    line-height: 36px;
    font-weight: bold;
    margin-bottom: 16px;

    .highlight {

      display: inline-block;
      padding-bottom: 20px;
      border-bottom: 4px solid #96C5FF;
    }

    @media(max-width: 778px) {

      .highlight {

        padding-bottom: 0;
        border-bottom: 0;
      }
    }
  }

  .onboarding-cta {

    color: $primary-color;
  }

  .onboarding-checklist-item {

    display: table;
    width: 100%;
    padding-bottom: 16px;

    > div {

      display: table-cell;
      vertical-align: top;

      &.icon-cont {

        width: 20px;
        text-align: center;
        padding-right: 6px;

        > i {

          display: inline-block;
          width: 16px;
          height: 16px;
          line-height: 12px;
          border-radius: 50%;
          background-color: rgba(255, 255, 255, 0.2);

          &:before {

            font-size: 12px;
            vertical-align: middle;
          }
        }
      }
    }
  }

  .onboarding-desc {

    margin-bottom: 24px;

    a {

      color: inherit;
      text-decoration: underline;
    }
  }

  .onboarding-steps {

    .rzp-group {

      width: 100%;

      .rzp-group-item {

        border: 0;
        padding: 0;

        &:first-child {

          padding-right: 12px;
        }
      }

      @media(max-width:688px) {

        display: block;

        > .rzp-group-item {

          display: block;

          &:first-child {

            padding-right: 0;
            padding-bottom: 12px;
          }
        }
      }
    }
  }

  a.Onboarding__Step:hover {

    background-color: rgba(250, 250, 250, 0.9);
  }

  .Onboarding__Step {
    display: block;
    color: #58666e;
    border-radius: 2px;
    background-color: #FAFAFA;
    padding: 14px;
    min-width: 275px;

    @media (max-width: 893px) {

      min-width: auto;
    }

    &.loading {

      pointer-events: none;

      div.media > div {

        &.media-body {

          b * , .step-desc * {

            opacity: 0;
          }

          b .PlaceholderLoader, .step-desc .PlaceholderLoader {

            position: absolute;
            display: inline-block;
            opacity: 1;
            top: 0;
            left: 0;
          }
        }

        &.media-icon {

          padding-right: 8px;

          > .activation-step-icon {

            background-image: none !important;
            background-color: #dfe1ea;
            border-radius: 50%;
            width: 32px;
            height: 32px;
          }
        }

        &.media-arrow {

          display: none;
        }
      }
    }

    div.media {

      display: table;
      width: 100%;

      > div {

        display: table-cell;
        vertical-align: middle;

        b, div.step-desc {

          white-space: nowrap;

          .rzp-popover {

            .rzp-tooltip-inner {

              .rzp-popover-content {

                white-space: normal;
              }
            }
          }

          @media (max-width: 974px) {

            white-space: normal;
          }
        }

        b {

          font-size: 14px;
          line-height: 19px;
          display: inline-block;
          position: relative;
          color: rgba(0,0,0,0.87);

          i.i-info-circle {

            display: inline-block;
            margin-left: 2px;
            vertical-align: middle;
          }
        }

        div.step-desc {

          margin-top: 4px;
          position: relative;
          color: rgba(0,0,0,0.54);
        }

        &.media-icon {

          width: 1px;
          vertical-align: middle;

          @media (max-width: 372px) {

            display: none;
          }

          .activation-step-icon {

            display: block;
            width: 46px;
            height: 32px;
            background-position: top left;
            background-repeat: no-repeat;

            &.keygen {

              background-image: url('assets/activation_icons/keygen.svg');
            }

            &.integrate {

              background-image: url('assets/activation_icons/integrate.svg');
            }

            &.browse {

              background-image: url('assets/activation_icons/browse.svg');
            }

            &.done {

              background-image: url('assets/activation_icons/done.svg');
            }

            &.activation-form {

              background-image: url('assets/activation_icons/activation-form.svg');
            }

            &.activation-form-submitted {

              background-image: url('assets/activation_icons/activation-form-submitted.svg');
            }

            &.activation-form-rejected {

              background-image: url('assets/activation_icons/activation-form-rejected.svg');
            }

            &.activation-form-need-clarification {

              background-image: url('assets/activation_icons/activation-form-need-clarification.svg');
            }
          }
        }

        &.media-body .activation-progress-cont {

          display: table;
          width: 100%;

          @media (min-width: 768px) and (max-width: 978px) {

            .activation-progress, .activation-progress-num {

              display: none !important;
            }
          }

          @media (max-width: 440px) {

            .activation-progress {

              display: none !important;
            }
          }

          @media (max-width: 412px) {

            .activation-progress-num {

              display: none !important;
            }
          }

          > div {

            display: table-cell;
            white-space: nowrap;
            vertical-align: middle;

            @media (max-width: 412px) {

              white-space: normal;

              span.activation-progress-num, div.activation-progress {

                display: none;
              }
            }

            &:first-child {

              width: 1%;
            }

            b {

              white-space: nowrap;
            }

            span.activation-progress-num {

              display: inline-block;
              padding-left: 10px;
              padding-right: 5px;
            }

            div.activation-progress {

              width: 100%;
              margin-left: 0;

              .progress {

                height: 6px;
                border-radius: 4px;
                overflow: hidden;
                background-color: #ced7d9;

                div.progress-bar {

                  border-radius: 4px;
                }
              }
            }
          }
        }

        &.media-body {

          width: auto;
        }

        &.media-arrow {

          width: 32px;
          text-align: right;

          > i {

            font-size: 20px;
            vertical-align: middle;
            position: relative;
            right: -7px;
            padding-left: 8px;
          }
        }
      }
    }

    a {
      text-decoration: underline;
    }

    .i-external-link {
      font-size: 100%;
    }

    .media-heading {
      margin-bottom: 2px;
    }

    .media-body {
      font-size: 13px;
    }

    .media-object {
      width: 53px;
      height: 42px;
    }

    .activation-progress {
      width: 75px;
      display: inline-block;
      margin-left: 12px;

      .progress {
        height: 8px;
        border-radius: 2px;
        background-color: #e4e9ea;
        margin-bottom: 0;
      }
    }
  }
}

.onboarding-card-wrapper-content.first-step {

  position: relative;
  /* 9999px box-shadow spread radius does not work in safari, max is 1016 */
  box-shadow: 0 0 0 1000px rgba(0,0,0,.85), 0 0 15px rgba(0,0,0,.25);
  z-index: 9999;
  border-radius: 2px;

  div.onboarding-card.media {

    padding-right: 328px;

    @media (max-width: 1278px) {

      padding-right: 250px;
    }

    @media (max-width: 1200px) {

      padding-right: 301px;
    }

    @media (max-width: 1095px) {

      padding-right: 48px;
    }

    @media (max-width: 450px) {

      padding: 24px;
    }

    > div.media-body {

      width: 100%;
    }

    .onboarding-illustration {

      opacity: 1;
    }
  }
}

@media(max-width: 1095px) {

  .onboarding-illustration {

    display: none;
  }

  .onboarding-card.media {

    padding: 54px 48px 54px 48px;
  }
}

@media(max-width: 500px) {

  .onboarding-card.media {

    padding: 24px;

    .close {

      top: 8px;
      right: 8px;
    }
  }
}

.media.onboarding-card.servicetax-news {
  min-height: inherit;
  width: 100%;
  padding: 24px;

  img, >div {
    vertical-align: middle;
  }

  img {
    max-width: 75px;
    width: 4em;
    margin-right: 20px;
  }

  > div {
    display: inline-block;
    width: 73%;
    margin-right: 12px;

    .heading {
      font-weight: bold;
      font-size: 16px;
      margin-bottom: 4px;
    }

    .news {
      > a {
        padding: 0;
      }
    }
  }

  a {
    margin-top: 16px;
    padding: 8px;
  }
}

.reports-entity-options {

  input[type=radio].report-type {
    display: none;
  }

  input[type=radio].report-type + label {
    width: 100%;
    padding: 12px 24px;
    margin: 0;
    color: #555555;
    font-size: 14px;
    font-weight: 400;
    cursor: pointer;
  }

  &:not(:last-child) {
    input[type=radio].report-type + label {
      border-bottom: 1px solid rgba(0,0,0,0.03);
    }
  }

  input[type=radio].report-type + label:hover {
    background-color: #f9f9f9;
  }

  input[type=radio].report-type:checked + label {
    color: $primary-color;
    background-color: #f9f9f9;
  }

  @media(min-width: 992px) {
    input[type=radio].report-type:checked + label:after {
      float: right;
      content: "\25BA";
      color: #a5a5a5;
      font-size: 11px;
    }
  }

  &.new {

    label {
      width: 100%;
      padding: 12px 24px;
      margin: 0;
      color: #555555;
      font-size: 14px;
      font-weight: 400;
      cursor: pointer;

      :hover {
        background-color: #f9f9f9;
      }

      &.active {
        color: $primary-color;
        background-color: #f9f9f9;
      }
    }

    &:not(:last-child) {
      label {
        border-bottom: 1px solid rgba(0,0,0,0.03);
      }
    }

    @media(min-width: 992px) {
      label:after {
        float: right;
        content: "\25BA";
        color: #a5a5a5;
        font-size: 11px;
      }
    }
  }
}

.custom-tag {
  color: $primary-color;
  float: right;
  font-size: 14px;

  &.i {
    margin-top: 2px;
  }
}

// To be checked and later generalized. Currently, styles are inconsisent
.virtual-account-powerselect {
  border: 1px solid #cfdadd;
  border-radius: 2px;
}

.virtual-account-powerselect__Tether {
  z-index: 100000
}

.transfers-powerselect {
  input {
    padding: 0 12px;
  }
}

.transfers-powerselect__Tether {
  z-index: 100000;
}

.transfers-powerselect__Menu {
  .PowerSelect__Option {
    border-bottom: 1px solid #eaeff0;
    padding: 8px 0;
    border-bottom: 1px solid #eaeff0;
    line-height: 28px;
  }

  .heading {
    color: #8991ae;
    padding: 12px 12px 8px;
  }
}

.custom-powerselect {
  border: 1px solid #cfdadd;
  border-radius: 3px;

  .PowerSelect__Trigger,
  .PowerSelect__TriggerLabel,
  .PowerSelect__TriggerStatus {
    height: 28px;
  }

  .PowerSelect__TriggerLabel {
    padding-top: 0;
    padding-bottom: 0;
  }
}

.custom-powerselect-options {
  line-height: 24px !important;
  padding: 2px 12px !important;
  min-height: 28px;
}

// Entity Detail Row
.entity-detail-row {
  padding: 8px;
  border-bottom: 1px solid #ebecee;

  &.clickable:hover {
    background-color: #f7f6f6;
    cursor: pointer;
  }

// To highlight selected row
  &.active {
    background-color: rgba(255,255,215,0.75);
  }

  .row-item {
    display: inline-block;
    vertical-align: middle;

    &.content {
      width: 93%;
    }

    &.i {
      width: 7%;
      text-align: center;
      font-size: 22px;
      padding: 10px;
      cursor: pointer;
    }
  }

  .detail-row {
    display: table;
    width: 100%;
    margin-bottom: 4px;

  // Style for 3rd row
    &:nth-of-type(3) {
      font-size: 13px;
    }
  }

  .row-element {
    display: table-cell;
  }

  .left {
    width: 60%;
  }
  .right {
    width: 40%;
    text-align: right;
  }
}

// Entity Detail List & Data Table
.entity-detail-list, .data-table {
  .list-heading {
    background-color: #F7F8FA;
    border-top: 1px solid #dfe0e2;
    padding: 12px;

    &:before {
      display: table;
      content: " ";
    }

    &:after {
      clear: both;
    }

    .label--secondary {
      line-height: 21px;
      float: right;
    }
  }
}

div.data-table.has-panel {
  div.table-responsive {
    margin-top: 0;

    > table.table {
      margin-bottom: 0;
    }
  }
}

.sub-entity-list {
  margin-top: 16px;
  margin-bottom: 24px;
}

// Data table
.details-row-container .data-table {
  margin: 20px 0;
  border-bottom: 1px solid #C6CFD9;
}

// Stats Info
.stats-info
  width: 100%
  .table
    border: 1px solid $stats-border
    margin-bottom: 0px
    table-layout: fixed

    .td-info
      position: relative

    .td-info:not(:first-child)::before
      content: '';
      height: 20px;
      background: $stats-border;
      width: 1px;
      position: absolute;
      top: 18px;
      bottom: 18px;
    .td-heading
      display: block
      color: rgba(0,0,0,0.54)
      text-align: center
      font-size: 13px
    .td-value
      display: block
      text-align: center
      font-size: 16px

// Entity Detail List
.entity-detail-list {
  margin: 16px 0;
  border-bottom: 1px solid #C6CFD9;

  .show-btn {
    padding: 12px;
    cursor: pointer;

    .i {
      vertical-align: middle;
    }
  }

  .list-heading {
    border-bottom: 1px solid #e2e3e5;
  }
}

.details-row-container .data-table {
  table {
    margin-bottom: 0;
    border-bottom: none;
  }
}

@media (max-width: 996px) {
  div.new-products-row {
    height: auto !important;
    flex-direction: column !important;

    div.product-item {
      width: 100% !important;
      margin-bottom: 10px;
      padding: 0 !important;
    }
  }
}

div.feature-activation-banner {
  padding: 20px 20px 0 20px;

  div.media {
    background-color: #fff;
    border: 1px solid #e2e8ea;
    padding: 15px;

    div.media-body {
      div.media-heading {
        font-weight: bold;
        font-size: 15px;
      }
    }

    div.media-left {
      padding-right: 15px;

      .media-object {
        height: 100px;
        width: 100px;
        margin: 0 10px;
      }

      @media (max-width $screen-sm-min) {
        display: none;
      }
    }
  }
}

.payment-link-form {

  .i-date-range.custom-icon {
    display: none;
  }

  .rdtPicker {
    width: 200px;
  }
}

.rollkey .RadioButton {
  margin: 8px 0;
}

.media-object {
  background: no-repeat center;
  background-size: contain;
  &.route {
    background-image: url('assets/symbols/route.svg');
  }
  &.sub {
    background-image: url('assets/symbols/sub.svg');
  }
  &.sc {
    background-image: url('assets/symbols/sc.svg');
  }
  &.activate {
    background-image: url('assets/activate-account.svg');
  }
  &.activated {
    background-image: url('assets/account-activated.svg');
  }
  &.submitted {
    background-image: url('assets/activation-submitted.svg');
  }
  &.first-pay {
    background-image: url('assets/first-payment.svg');
  }
  &.genkeys {
    background-image: url('assets/genkeys.svg');
  }
  &.integrate {
    background-image: url('assets/integrate.svg');
  }
  &.onboarding {
    background-image: url('assets/onboarding.svg');
  }
}

.more-options-button {

  .dropdown-menu {
    right: 0;
    left: unset !important;
    padding: 0;
  }

  .option {
    padding: 10px 15px 15px 5px;
    cursor: pointer;

    &:hover {
      background-color: #F0F1F6;
    }
  }
}

.fileupload-btn input {
  display: none;
}

.layout.rzp {

  > .navbar.navbar-fixed-top {

    .navbar-toggle-container {

      color: white;

      button.navbar-toggle {

        display: inline-block !important;
        padding-left: 0;
        padding-right: 0;
        margin-left: 10px;
        float: none;
        border: none;
        vertical-align: middle;

        &:hover, &:focus {

          background-color: transparent;
        }

        .i-bar {

          background-color: currentColor;
        }
      }
    }
  }
}

@media (min-width: 0px) {

  // Do not collapse navbar even in mobile
  .layout.rzp ul.navbar-nav.navbar-right {

    float: right;
    margin: 0 -15px 0 0;

    &> li {

      float: left;
    }
  }
}

@media (max-width: $screen-sm-min) {

  .layout.rzp {

    > .navbar.navbar-fixed-top {

      background-color: $sidebar-bg-color;

      ul.navbar-nav.navbar-right {

        > li > div.dropdown > a {

          color: white;
        }

        .dropdown-menu.ProfileDropdown {

          left: auto;
          right: 0;
        }
      }
    }
  }
}

#profile-dropdown {

  .merchant-logo-preview{

    border-radius: 50%;
    width: 24px;
    height: 24px;
    display: inline-block;
    vertical-align: middle;
    text-align: center;
    overflow: hidden;

    .rzp-image > img {

      border-radius: 50%;
    }
  }

  a {
    color: inherit;
  }

  .rzp-image.invalid-src {

    color: #949494;
  }

  .loggedin-as {

    background-color: #F5F7F8;

    .account-details {

      padding: 12px 0;
      font-size: 16px;
      line-height: 19px;
      max-width: 250px;
      white-space: nowrap;
      text-overflow: ellipsis;
      
      i.i-account {

        font-size: 24px;
        vertical-align: middle;
        color: #BDC3C6;
        display: inline-block;
        height: 24px;
        line-height: 1em;
      }
    }

    .logout-btn {

      display: block;
      width: 100%;
    }
  }
}

.switch-merchant-modal-content {

  div.modal-body {

    max-height: 90vh;
    overflow: auto;

    ul.merchants-list {

      > li {

        border: 1px solid rgba(0,0,0,0.05);
        border-top: none;

        &.active {

          background-color: $primary-color;
          color: white;

          > a .i.i-check {

            display: inline;
          }
        }

        > a {

          color: inherit;
          cursor: pointer;
          
          .i.i-check {

            display: none;
          }
        }
      }
    }
  }
}

// Bars
.i-bar
  display block
  width 22px
  height 2px
  border-radius 1px
.i-bar + .i-bar
  margin-top 4px
