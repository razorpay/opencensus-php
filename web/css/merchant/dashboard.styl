  .onboarding-card-instant-content {

    width: 100%;
    height: 100%;
    padding: 66px 300px 50px 50px;
    position: relative;
    background-color: #fff;

    @media (max-width: 1234px) {

      padding-right: 30%;
    }

    @media (max-width: 1150px) {

      padding-right: 25%;
    }

    @media (max-width: 1095px) {

      padding-right: 40px;
    }

    @media (max-width: 910px) {

      padding-left: 16px;
      padding-right: 16px;
    }

    .onboarding-illustration-top, .onboarding-illustration-bottom {

      position: absolute;
      top: 0;
      left: 0;
      display: block;
      height: 40px;

      img {

        display: block;
        height: 100%;
        width: auto;
      }
    }

    .onboarding-illustration-bottom {

      top: auto;
      bottom: 0;
    }

    .onboarding-steps {

      display: table;
      width: 100%;
      height: 100%;
      position: relative;
      z-index: 1;

      .onboarding-step {

        display: table-cell;
        vertical-align: top;
        position: relative;
        width: (100/3)%;
        height: 100%;
        text-align: center;

        .PlaceholderLoader {

          height: 1em;
        }

        &:first-child .step-connector {

          display: none;
        }

        .step-connector {

          position: absolute;
          top: 16px;
          left: 0;
          transform: translate(-50%, 0);
          width: 100%;
          padding-left: 26px;
          padding-right: 26px;
          height: 4px;

          &.align-left {
            transform: translate(-96%, 0);
          }

          .step-connector-content {

            background: transparent url('assets/onboarding/inactive_connector.png') 50% 0 no-repeat;
            width: 100%;
            height: 100%;
          }
        }

        &.align-left {
          text-align: left;
        }

        &.status-active {

          .step-indicator {

            padding: 0;
          }

          .step-connector {

            .step-connector-content {

              background-image: url('assets/onboarding/active_connector.png');
            }
          }
        }

        .step-indicator {

          margin: 0 auto;
          width: $stepIndicatorSize;
          height: $stepIndicatorSize;
          border-radius: 50%;
          overflow: hidden;
          margin-bottom: 22px;
          padding: 6px;

          &.align-left {
            margin: 0 0 20px -6px;  
          }

          .PlaceholderLoader {

            vertical-align: top;
            width: 100%;
            height: 100%;
            border-radius: 50%;
          }

          img {

            display: block;
            width: 100%;
            height: 100%;
          }
        }

        .step-content {

          padding: 0 8px;

          &.align-left{
            padding: 0 40px 0 0;

            .step-content { 
                padding: 0;
            }
          }

          .step-content-title {

            font-weight: bold;
            font-size: 16px;
            line-height: 19px;
            margin-bottom: 12px;
          }

          .btn {

            margin-top: 18px;
          }
        }
      }
    }

    @media (max-width: 640px) {

      overflow: hidden;
      box-shadow: 0 3px 6px 0 rgba(0,0,0,0.13);

      .onboarding-steps {

        display: block;
        width: 300%;
        transform: translate(0, 0);
        transition: transform 0.2s ease;

        &:after {

          display: table;
          clear: both;
        }

        .onboarding-step {

          display: block;
          float: left;
          width: (100/3)%;
          height: auto;
        }

        &.active-step-0 {

          transform: translate(0, 0);
        }

        &.active-step-1 {

          transform: translate(-(100/3)%, 0);
        }

        &.active-step-2 {

          transform: translate(-(200/3)%, 0);
        }
      }
    }

    .btn-close {

      color: #fff;
      position: absolute;
      top: 4px;
      right: 14px;
      font-size: 28px;
      line-height: 28px;
    }
  }

  @media (max-width: 640px) {
    padding-bottom: 40px;

    .onboarding-step-switcher {

      display: table;
      position: absolute;
      top: 354px;
      left: 50%;
      transform: translate(-50%, -100%);
      line-height: 8px;
      margin-top: -20px;

      .onboarding-step-switch {

         display: inline-block;
         width: 8px;
         height: 8px;
         margin-left: 18px;
         background-color: #D9D9D9;
         border-radius: 50%;
         cursor: pointer;

         &.active {

           cursor: default;
           background-color: #939393;
         }

         &:first-child {

           margin-left: 0;
         }
       }
    }
  }
}

