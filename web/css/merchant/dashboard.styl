.Dashboard {
  .h1, h4 {
    margin: 0;
    font-weight: 300;
  }

  .panel {
    box-shadow: 0 1px 1px rgba(0,0,0,.05);
  }
}

.clearfix:after {
  display: table;
  content: '';
  clear: both;
}

.webkit-sec {
  -webkit-text-security: disc;
}

.InfoCard {
  padding-top: 15px;
  padding-bottom: 15px;

  .LoaderDots span {
    font-size: 28px;
  }
}

.InfoCard__value {
  height: 36px;
  line-height: 36px;
}

.InfoCard__label {
  font-size: 12px;
  color: rgb(214, 211, 230);
}

.WidgetContainer {
  height: 304px;
  margin-bottom: 20px;

  h4 {
    margin-bottom: 10px;
  }

  .panel,
  .panel-body {
    height: 100%;
    position: relative;
  }

  &.Transaction__Vol {
    margin-right: 30%;
    @media (max-width $screen-sm-min) {
      margin-right: 0;
    }
  }

  &.Transaction__Types {
    display: inline-block;
    float: right;
    width: 30%;
    color: #58666e;
    @media (max-width $screen-sm-min) {
      width: 100%;
      float: none;
    }

    .panel-body {
      background-color: #e4eaec;
    }
  }
}

.RecentTxns .WidgetContainer {
  height: auto;

  .panel-body {
    min-height: 175px;
  }
}

.EntityTable {
  code {
    padding: 0;
  }
}

.report-wrapper {
  background-color: #fff;
  padding: 0;
  float: none;
  padding-top: 8px;
  margin: 0px auto;

// This is only needed for desktop
  @media(min-width: 992px) {
    &:before {
      content: '';
      display: block;
      position: absolute;
      top: 0;
      bottom: 0;
      left: 33.33%;
      border-left: 1px solid #DEE5E7;
    }
  }

  &:after {
    clear: both;
    content: '';
    display: table;
  }

  .report-list-panel {
    .title {
      color: #7f7f7f;
      font-size: 12px;
    }
    &--mobile {
      padding: 16px 16px 0;

      .title {
        padding: 0 0 8px 0;
      }
    }
    &--desktop {
      padding: 0;
      padding-top: 16px;
      padding-bottom: 8px;

      .title {
        padding: 0 0 8px 24px;
      }
    }
  }

  .report-generate-panel {
    padding: 11px 24px 24px;
    min-height: 300px;

    .title {
      color: #7f7f7f;
      font-size: 12px;
      padding-bottom: 8px;
    }

    .account {
      line-height: 36px;
    }

    .custom-date .custom-icon {
      top: 12px;
      right: 10px;
    }

    .PowerSelect__TriggerInput {
      padding-left: 32px;
    }

    .form-heading {
      font-weight: 600;
      border-bottom: 1px solid #e2e8ea;
      padding-bottom: 6px;
      margin-bottom: 24px;
      font-size: 16px;
    }

    .form-element {
      margin-bottom 16px;

    //<select> has default radius which can't be changed using CSS. So, set parent as .form-control and don't add .form-control to <select>
      .fix-select {
        background: transparent;
        border: none;
        margin-left: -5px;
        width: 100%;
      }

      &:last-child {
        margin-bottom: 4px;
      }

      &:after {
        clear: both;
        content: '';
        display: table;
      }

      footer {
        padding: 12px 0 0 0;
      }

      [class^='col-'] {
        padding: 0;
        margin-right: 16px;
      }
    }
  }
}

.custom-icon {
  position: absolute;
  z-index: 1;
  color: #e0e0e0;
  pointer-events: none;
}

.typeAheadSkin {
  position: absolute;
  z-index: 2;
  background-color: rgb(255, 255, 255);
  top: 10px;
  width: 87%;
  margin-left: 30px;
  pointer-events none;
  font-size: 12px;
}


.transfers-powerselect + .typeAheadSkin {
  margin-left: 10px;
}

.custom-select .custom-icon {
  top: 11px;
  left: 8px;
  font-size: 20px;
}


// Onboarding Card

.media.onboarding-card.new-features {
  > .media-body {
    max-width: 100%;
    padding: 24px;
  }
}

.onboarding-illustration {

  width: 280px;
  height: 310px;
  position: absolute;
  top: 0;
  right: 0;
  background: transparent url("assets/onboarding.svg") 0 0 no-repeat;
}

body.analytics-v2-active .onboarding-card-wrapper {

  padding: 20px 20px 0 20px;
}

.onboarding-card.media {
  background-color: #5D89E5;
  padding: 54px 328px 54px 48px;
  margin-bottom: 20px;
  box-shadow: 0 0 8px 0 rgba(0,0,0,0.16);
  border-radius: 2px;
  position: relative;
  min-height: 200px;
  transition: 0.1s linear;
  box-shadow: none;
  background: linear-gradient(223.96deg, #5D89E5 0%, #3059C0 100%);
  color: white;

  &.first-step {
    box-shadow: 0 0 0 9999px rgba(0,0,0,.25), 0 0 15px rgba(0,0,0,.25);
    z-index: 9999;
  }

  .close {
    position: absolute;
    top: 16px;
    right: 16px;
    font-size: 18px;
  }

  > .media-left {
    vertical-align: middle;
    @media(max-width: 480px) {
      display: none;
    }

    .media-object {
      width: 320px;
      min-height: 200px;
      max-height: 220px;
    }
  }

  > .media-body {
    padding: 0;
    max-width: 800px;
    min-height: 200px;

    p {
      margin-bottom: 16px;
    }

    ul.row {
      margin-bottom: 8px;
      padding-left: 30px;

      > li {
        padding-left: 0;
        margin-bottom: 8px;
      }
    }

    .btn-lg {
      padding-left: 12px;
      font-size: 14px;
      border-radius: 2px;

      > span {
        margin-right: 48px;
      }
    }
  }

  div.new-products-row {

    display: flex;
    flex-direction: row;
    align-items: stretch;

    div.product-item {
      padding-left: 10px;
      flex: 1;
      &:first-child {
        padding-left: 0;
      }
    }

    div.media {

      height: 100%;
      color: #58666e;
      border-radius: 2px;
      background-color: #FAFAFA;
      padding: 14px;
      border: 1px solid #D8E1E3;
      vertical-align: top;

      &:hover {
        border: 1px solid #BAACEA;
        background-color: #FAFBFF;
      }

      .media-object {
        width: 31px;
        height: 31px;
      }
    }
  }

  .media-heading {
    font-size: 24px;
    line-height: 36px;
    font-weight: bold;
    margin-bottom: 16px;

    .highlight {

      display: inline-block;
      padding-bottom: 20px;
      border-bottom: 4px solid #96C5FF;
    }

    @media(max-width: 778px) {

      .highlight {

        padding-bottom: 0;
        border-bottom: 0;
      }
    }
  }
  
  .onboarding-cta {

    color: $primary-color;
  }

  .onboarding-checklist-item {

    display: table;
    width: 100%;
    padding-bottom: 20px;

    > div {

      display: table-cell;
      vertical-align: top;

      &.icon-cont {

        width: 20px;
        text-align: center;
        padding-right: 6px;

        > i {

          display: inline-block;
          width: 20px;
          height: 20px;
          line-height: 18px;
          border-radius: 50%;
          background-color: rgba(255, 255, 255, 0.2);

          &:before {

            vertical-align: middle;
          }
        }
      }
    }
  }

  .onboarding-desc {

    margin-bottom: 24px;
  }

  .onboarding-steps {

    .rzp-group {

      width: 100%;

      .rzp-group-item {

        border: 0;
        padding: 0;

        &:first-child {

          padding-right: 12px;
        }
      }

      @media(max-width:688px) {

        display: block;

        > .rzp-group-item {

          display: block;

          &:first-child {

            padding-right: 0;
            padding-bottom: 12px;
          }
        }
      }
    }
  }

  .Onboarding__Step {
    display: block;
    color: #58666e;
    box-shadow: 0 1px 1px 0 rgba(0, 0, 0, 0.05);
    border-radius: 2px;
    background-color: #FAFAFA;
    padding: 14px;
    border: 1px solid #D8E1E3;

    &:hover {
      border: 1px solid #BAACEA;
      background-color: #FAFBFF;
    }

    &.loading div.media > div.media-body {

      b * , .step-desc * {

        opacity: 0;
      }

      b .PlaceholderLoader, .step-desc .PlaceholderLoader {

        position: absolute;
        display: inline-block;
        opacity: 1;
        top: 0;
        left: 0;
      }
    }

    div.media {

      display: table;
      width: 100%;

      > div {

        display: table-cell;
        vertical-align: middle;      

        b {

          font-size: 16px;
          line-height: 19px;
          display: inline-block;
          position: relative;
        }

        div.step-desc {

          margin-top: 6px;
          position: relative;
        }

        &.media-body .activation-progress-cont {

          display: table;
          width: 100%;

          > div {

            display: table-cell;
            white-space: nowrap;
            vertical-align: middle;

            &:first-child {

              width: 1%;
            }

            span.activation-progress-num {

              display: inline-block;
              padding-left: 10px;
              padding-right: 5px;
            }

            div.activation-progress {

              width: 100%;
              margin-left: 0;

              .progress {

                height: 6px;
                border-radius: 4px;
                overflow: hidden;

                div.progress-bar {

                  border-radius: 4px;
                }
              }
            }
          }
        }

        &.media-body {

          width: auto;
        }
 
        &.media-arrow {

          width: 32px;
          text-align: right;

          > i {

            font-size: 20px;
            vertical-align: middle;
          }
        }
      }
    }

    a {
      text-decoration: underline;
      color: inherit;
    }

    .i-external-link {
      font-size: 100%;
    }

    .media-heading {
      margin-bottom: 2px;
    }

    .media-body {
      font-size: 13px;
    }

    .media-object {
      width: 53px;
      height: 42px;
    }

    .activation-progress {
      width: 75px;
      display: inline-block;
      margin-left: 12px;

      .progress {
        height: 8px;
        border-radius: 2px;
        background-color: #e4e9ea;
        margin-bottom: 0;
      }
    }
  }
}

@media(max-width: 1095px) {

  .onboarding-illustration {

    display: none;
  }

  .onboarding-card.media {

    padding: 54px 48px 54px 48px;
  }
}

.media.onboarding-card.servicetax-news {
  min-height: inherit;
  width: 100%;
  padding: 24px;

  img, >div {
    vertical-align: middle;
  }

  img {
    max-width: 75px;
    width: 4em;
    margin-right: 20px;
  }

  > div {
    display: inline-block;
    width: 73%;
    margin-right: 12px;

    .heading {
      font-weight: bold;
      font-size: 16px;
      margin-bottom: 4px;
    }

    .news {
      > a {
        padding: 0;
      }
    }
  }

  a {
    margin-top: 16px;
    padding: 8px;
  }
}

.reports-entity-options {

  input[type=radio].report-type {
    display: none;
  }

  input[type=radio].report-type + label {
    width: 100%;
    padding: 12px 24px;
    margin: 0;
    color: #555555;
    font-size: 14px;
    font-weight: 400;
    cursor: pointer;
  }

  &:not(:last-child) {
    input[type=radio].report-type + label {
      border-bottom: 1px solid rgba(0,0,0,0.03);
    }
  }

  input[type=radio].report-type + label:hover {
    background-color: #f9f9f9;
  }

  input[type=radio].report-type:checked + label {
    color: $primary-color;
    background-color: #f9f9f9;
  }

  @media(min-width: 992px) {
    input[type=radio].report-type:checked + label:after {
      float: right;
      content: "\25BA";
      color: #a5a5a5;
      font-size: 11px;
    }
  }

  &.new {

    label {
      width: 100%;
      padding: 12px 24px;
      margin: 0;
      color: #555555;
      font-size: 14px;
      font-weight: 400;
      cursor: pointer;

      :hover {
        background-color: #f9f9f9;
      }

      &.active {
        color: $primary-color;
        background-color: #f9f9f9;
      }
    }

    &:not(:last-child) {
      label {
        border-bottom: 1px solid rgba(0,0,0,0.03);
      }
    }

    @media(min-width: 992px) {
      label:after {
        float: right;
        content: "\25BA";
        color: #a5a5a5;
        font-size: 11px;
      }
    }
  }
}

.custom-tag {
  color: $primary-color;
  float: right;
  font-size: 14px;

  &.i {
    margin-top: 2px;
  }
}

// To be checked and later generalized. Currently, styles are inconsisent
