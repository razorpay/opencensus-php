// Entity Detail Row
.entity-detail-row {
  padding: 8px;
  border-bottom: 1px solid #ebecee;

  &.clickable:hover {
    background-color: #f7f6f6;
    cursor: pointer;
  }

// To highlight selected row
  &.active {
    background-color: rgba(255,255,215,0.75);
  }

  .row-item {
    display: inline-block;
    vertical-align: middle;

    &.content {
      width: 93%;
    }

    &.i {
      width: 7%;
      text-align: center;
      font-size: 22px;
      padding: 10px;
      cursor: pointer;
    }
  }

  .detail-row {
    display: table;
    width: 100%;
    margin-bottom: 4px;

    // Style for 3rd row
    &:nth-of-type(3) {
      font-size: 13px;
    }
  }

  .row-element {
    display: table-cell;
  }

  .left {
    width: 60%;
  }
  .right {
    width: 40%;
    text-align: right;
  }
}

// Entity Detail List & Data Table
.entity-detail-list, .data-table {
  .list-heading {
    background-color: #F7F8FA;
    border-top: 1px solid #dfe0e2;
    padding: 12px;

    &:before {
      display: table;
      content: " ";
    }

    &:after {
      clear: both;
    }

    .label--secondary {
      line-height: 21px;
      float: right;
    }
  }
}

div.data-table.has-panel {
  div.table-responsive {
    margin-top: 0;

    > table.table {
      margin-bottom: 0;
    }
  }
}

.sub-entity-list {
  margin-top: 16px;
  margin-bottom: 24px;
}

// Data table
.details-row-container .data-table {
  margin: 20px 0;
  border-bottom: 1px solid #C6CFD9;
}

// Entity Detail List
.entity-detail-list {
  margin: 16px 0;
  border-bottom: 1px solid #C6CFD9;

  .show-btn {
    padding: 12px;
    cursor: pointer;

    .i {
      vertical-align: middle;
    }
  }

  .list-heading {
    border-bottom: 1px solid #e2e3e5;
  }
}

.details-row-container .data-table {
  table {
    margin-bottom: 0;
    border-bottom: none;
  }
}

@media (max-width: 996px) {
  div.new-products-row {
