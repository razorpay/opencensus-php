.Onboarding
  font-size: 14px
  text-align: center

  .illustration
    padding: 130px
    width: 160px
    background-repeat: no-repeat
    background-size: contain
    background-position: center
    margin: 20px auto 0

  .description
    margin: 20px 16px 0

  .form-fields
    margin: 20px 16px 0

    .Input
      margin: 0

  .Button
    margin 20px auto 0


.Onboarding--PaymentPages
  .illustration
    background-image: url('assets/onboarding/reusable-links.svg');
    margin-bottom: 20px

  .btn
    margin-top: 20px

.Onboarding--EarlyAccessRPL
  max-width: 520px
  margin: 32px auto 0

  .illustration
    padding: 96px
    width: auto
    background-image: url('assets/onboarding/reusable-links.svg');

  .form-fields
    .Input
      pointer-events: none

    textarea.Input-el
      max-height: unset
      height: 102px
      line-height: 20px

    .Input-el
      opacity: 0;
      transform: scaleY(0)
      transform-origin: top center

    .Input-el, .Button
      transition: 0.3s

    .Button
      transform: translateY(-122px)

    &.drishy
      .Input
        pointer-events: all

      .Input-el
        opacity: 1
        transform: scaleY(1)

      .Button
        transform: translateY(0)

