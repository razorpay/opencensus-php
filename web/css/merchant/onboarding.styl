.Onboarding
  font-size: 14px
  text-align: center

  .illustration
    padding: 130px
    width: 160px
    background-repeat: no-repeat
    background-size: contain
    background-position: center
    margin: 20px auto 0

  .description
    margin: 20px 16px 0

  .form-fields
    margin: 20px 16px 0

    .Input
      margin: 0

  .Button
    margin 20px auto 0


.Onboarding--PaymentPages
  margin: 20px 0 80px
  color: #58666E

  .Onboarding-heading
    font-size: 20px
    font-weight: 600
    margin-bottom: 16px

    span
      color: $primary-color

  .Onboarding--content
    margin-top: 100px

  .step
    position: relative
    text-align: center
    display: inline-block
    width: 30%
    min-width: 240px
    font-size: 14px
    padding: 0 8px

    img
      height: 124px

    .title
      font-size: 18px
      font-weight: 600
      margin-bottom: 8px;

    .i
      position: absolute
      top: 50%
      right: -18px
      transform: translateY(-50%)
      font-size: 36px
      font-weight: 600
      color: $primary-color

  @media (max-width: 1023px)

    .Onboarding--content  .step
      display: block
      margin: 48px auto 0

      .i
        display: none

