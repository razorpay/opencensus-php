$max-width = 640px

.StandAloneContainer
  position: relative
  width: 92%
  margin: 80px auto

  .spinner-container
    height: 300px

/* PaymentLinks wizard screen */
.PaymentLinks--Create
  max-width: $max-width
  height: 85vh
  min-height: 560px
  max-height: 690px
  background: #fafafa
  position: relative

  .form-container
    padding: 30px 40px

  .Form--tabular
    .Input-content
      margin-left: 156px
    .Input-label
      width: 136px


  $side-width = 240px

  main
    left: 0
    right: 0
    padding: 30px
    position: absolute
    bottom: 80px
    top: 0
    overflow: auto

    &.main--full
      bottom: 0

    &::-webkit-scrollbar
      display: none;

  footer
    left: 0
    padding: 20px
    right: 0
    background: #F6F6F6
    border-top: 1px solid #e0e0e0
    bottom: 0
    position: absolute
    text-align: right

    button
      vertical-align: top

    .Loader
      float: left
      opacity: 0
      transition: 1s opacity
      margin-top: 4px
      line-height: 27px

      i, .spin-btn
        margin-right: 8px
        vertical-align: middle

      .spin-btn
        opacity: 1

      &--visible
        opacity: 1

  main-title
    display: block
    font-weight: 600
    margin-bottom: 20px
    font-size: 18px !important

  .Form
    margin-top: 36px

/* Modal-container size */
.Modal-container
  &--PaymentLinks
    width: 90%
    max-width: $max-width
    min-height: 560px
    max-height: 690px
    height: 90vh

    .PaymentLinks--Create
      height: 90vh

// For linked-account activation form
.Modal-mask--Account-Activation
  .Modal-container--PaymentLinks, .PaymentLinks--Create
    min-height: 400px
    height: 70vh
    max-height: 480px


/* Small screens for Payment Links Modal */
@media (max-width: 972px)
  .PaymentLinks--Create
    .Input-elWrapper
      width: 300px !important

    .Input-pair
      width: 302px

    .form-container
      padding: 30px

    .InputGroup
      &--inline
        .Input-label
          position: relative !important

        .Input
          display: block

        .Input .Input-content
          margin: 4px 0

      &--near .Input
        margin-top: 0


  .StandAloneContainer .PaymentLinks--Create
    .Input-content
      margin: 0

    .Input-label
      margin-bottom: 12px
      text-align: left
      float: unset


@media (max-width: 820px)
  .Modal-container .PaymentLinks--Create
    .Input-content
      margin: 0 0 16px

    .Input-label
      margin-bottom: 12px
      text-align: left
      float: unset


/*
TODO: Style written in consideration that instead of modal, standalone page would open for activation wizard on small screen
TODO: Display aside on top of form as expandable slider OR else show PREV button
*/
@media (max-width: 610px)
  .StandAloneContainer
    margin: 80px auto 40px

  .PaymentLinks--Create
    overflow: hidden

    main-title
      position: relative
      padding: 20px
      text-align: center
      top: -30px
      margin-left: -24px
      margin-right: -40px
      margin-bottom: 4px
      background: white
      font-size: 14px

    .Form
      margin-top: 0

    .Input-el
      width: 100%

    .Select-elWrapper::before
      left: unset !important
      right: 4px

    aside
      display: none

    main, footer
      left: 0 !important


.Entity--paymentpage
  .stats-info
    margin-bottom: 24px

  .paymentpage-link-payments-table
    .detail-row
      padding-left: 0
    .row-item.content
      width: 100%

.Input--custom.Input--custom
  padding-left: 48px
  position: relative

  &:before
    content: ''
    display: block
    width: 2px
    background: #e2e2e2
    height: 100%
    position: absolute
    left: 182px

  .Input-label
    float: inherit
    width: auto
    display: block
    margin-bottom: 12px
    padding-left: 12px
    color: #58666e
    text-align: left
    font-weight: 400
    margin-left: 156px
    left: -16px

    .help-content
      vertical-align: text-bottom


@media(max-width: 972px)
  .Input--custom.Input--custom
    padding-left: 28px

    &:before
      left: 0

    .Input-label
      margin-left: 3px

.PaymentLinks--Migration
  min-width: 590px

  &::after
    content: ""
    background-image: url("assets/payment_links/switchV2.svg")
    background-repeat: no-repeat
    width: 100%
    height: 100%
    position: absolute
    top: 0px
    right: -330px

  .modal-body
    padding-right: 263px

.PaymentLinks--MigrationSuccess

  .i-check-circle
    color: #00BB55;
    vertical-align: middle;

  .btn-default
    display: none;
  
  .btn-primary
    margin-left: 0 !important;
    width: 100% !important;

.btn-shine {
  position: relative;
  overflow: hidden;

  &::after {
    animation: shine 10s forwards ease-in-out;
    content: "";
    position: absolute;
    top: 115%;
    left: -225%;
    width: 335%;
    height: 85%;
    opacity: 0;
    transform: rotate(145deg);
    background: rgba(255, 255, 255, 0.13);
    background: linear-gradient(to right, rgba(255, 255, 255, 0.8) 0%, rgba(255, 255, 255, 0.7) 77%, rgba(255, 255, 255, 0.7) 92%, rgba(255, 255, 255, 0.0) 100% );
    animation-iteration-count: 1;
  }
  @keyframes shine{
    10% {
      opacity: 1;
      top: -30%;
      left: -30%;
      transition-property: left, top, opacity;
      transition-duration: 0.8s, 0.8s, 0.15s;
      transition-timing-function: ease;
    }
    100% {
      opacity: 0;
      top: -30%;
      left: -30%;
      transition-property: left, top, opacity;
    }
  }
}

.mob-header {
  display: inline-flex;
    flex-direction: row;
    align-items: center;
    margin-left: 4px;
}
