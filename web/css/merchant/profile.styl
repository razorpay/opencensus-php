  margin-top: 15px !important
  color: $light-blue-color

.gst-help-block
  padding: 1px
  margin-bottom: 15px
  color: $blue-980

.gst-confirmation-modal-header
  line-height: 25px

.rzp-gst-content
  .rzp-tooltip-inner
    left: -502px
    top: -50px

  .Input-label
    margin-bottom: 9px

  .Input
    margin-top: 5px

  .label-info
    margin-top: -4px
    margin-bottom: 14px
    font-size: 12px
    color: $blue-940
    background-color: #FAFAFA

  input
    margin-bottom: 18px

  .suggested-address-row
