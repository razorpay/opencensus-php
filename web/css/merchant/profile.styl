    justify-content: center
    padding: 10px 0 22px

    button
      width: 87%
      font-size: 13px

.website-update-form
  font-size: 13px

  .Input-label
    margin-bottom: 10px

  .Input
    margin-top: 15px

  .Input-checkbox + .Input-inlineLabel
    font-size: 13px

  .actions-header
    display: flex
    justify-content: flex-start

    div:last-child
      margin-left: 45px

    label
      margin-left: 10px

  .note
    background-color: #FCF8E5
    border: 1px solid $blue-910
    padding: 5px 5px 7px
    margin-top: 20px

  .upload-invoice
    >label
      margin-top: 13px

    .notify-error
      color: #F05050

  .info-container
    position: relative

    .rzp-popover.rzp-tooltip .rzp-tooltip-inner
      position: fixed
      left: 17px
      top: 825px

.profile-container .divider {
  border-left: 1px solid #8A949A
  margin: 0 5px
  opacity: 0.3
}

.bank-account-details-change-modal {
  width: 100%;
  background: $white-color;
  border: 1px solid #0B70E705;
  margin: auto;

  .bank-details-change {
    .modal-header {
      height: 48px;
      padding: 14px 24px;
      background: #162F5605;

      .modal-title {
        font-size: 14px;
        line-height: 20px;
        color: $dark-blue-100;
      }

      .close {
        color: #2E3345;
        opacity: 1;
        font-weight: normal;
        font-size: 18px;
        line-height: 20px;
      }
    }
  }

  .modal-body {
    padding: 24px 24px 42px;

    .bank-details-change-content {
      max-width: 416px;
      margin: auto;

      &.sync-failed-async-started {
        max-width: 550px;
      }

      .bank-details-header {
        font-weight: 600;
        font-size: 16px;
        line-height: 24px;
        color: $blue-900;
        margin-bottom: 14px;
      }
    }
  }

  .form-group {
    margin-bottom: 24px;

    &:focus-within {
      >label {
        color: $primary-900;
      }

      .material-input {
        border-bottom: 1px solid $primary-900;
      }
    }

    >label {
      width: unset;
      font-weight: normal;
      font-size: 12px;
      line-height: 18px;
      color: $blue-960;
      padding-top: 0;
      margin-bottom: 0;
    }

    .label-required::after,
    .text-danger {
      color: $accent-negative-900;
    }

    .label-required::after {
      right: 10px;
      top: 0;
    }

    .InputField__ErrorText {
      font-size: 12px;
      line-height: 18px;
      text-align: left;
      margin-top: 4px;
    }

    .input-group:not(.fileupload-input-group) {
      width: 100%;
      display: flex;
      flex-direction: column;
    }

    .material-input {
      height: 36px;
      background: $white-110;
      border-radius: 2px 2px 0 0;
      border: none;
      border-bottom: 1px solid $blue-910;
    }

    .material-input + .input-group-addon {
      color: $accent-positive-900;
      font-size: 11px;
      line-height: 18px;
      margin-left: auto;
      width: auto;
      height: auto;
      margin-top: -36px;
      border: none;
      background: transparent;
      padding: 9px 12px;
      max-width: calc(100% - 96px);
      white-space: nowrap;
      text-overflow: ellipsis;
      overflow-x: hidden;
    }

    [role="loader"] {
      border-width: 1.5px;
    }

    .Dropzone-content {
      &.small {
        display: flex;
        justify-content: center;
        align-items: center;
      }
    }

    .Dropzone-cavity {
      margin-bottom: 0;
      border: 1px dashed #4B95ED;
      background: #F9FBFE;

      &--staged {
        .Dropzone-content {
          padding-left: 12px;
        }
      }
    }

    .Dropzone-content-desc {
      font-size: 14px;
      line-height: 20px;
      padding-left: 12px;
      width: auto;
      max-width: 100%;

      &--secondary {
        white-space: normal;
      }
    }
  }

  .form-actions {
    margin-top: 36px;

    button {
      width: 100%;
      background: $light-blue-color;
      border-radius: 2px;
      color: $white-color;
      font-weight: 600;
      padding: 10px 24px;
      border: none;
    }
  }

  .Alert {
    display: flex;
    color: $dark-blue-100;

    &-icon--before {
      align-self: center;
      font-size: 18px;
      margin-right: 14px;
    }

    &--warning {
      background: #FAF2E7;
      border-color: #FFF3E2;
    }

    &-content {
      color: $blue-800;
    }

    &:last-of-type {
      margin-bottom: 36px;
    }
  }

  .needs-clarification-form {
    .Alert {
      margin-bottom: 36px;

      .Alert-icon--before {
        align-self: flex-start;
        font-size: 16px;
        margin-right: 14px;
      }
    }

    .razorpay-support {
      .title {
        color: $dark-blue-100;
        font-weight: 600;
        font-size: 12px;
        line-height: 18px;
      }

      .description {
        margin-top: 8px;
        font-size: 13px;
        line-height: 18px;
        color: $blue-900;
        word-break: break-all;
      }
    }

    .Input {
      margin-bottom: 0;
    }

    .is-focused > .Input-label {
      border-color: $primary-900;
    }

    .Input:not(.Input--disabled) .Input-el:focus {
      border-color: $primary-900;
    }

    .Input--vTop .Input-label {
      color: $blue-960;
      font-weight: normal;
      font-size: 12px;
      line-height: 18px;
    }

    textarea::placeholder {
      // Chrome, Firefox, Opera, Safari 10.1+
      color: $blue-910;
      opacity: 1;
      // Firefox
    }

    // stylelint-disable-next-line selector-no-vendor-prefix
    textarea::-ms-input-placeholder {
      // Microsoft Edge
      color: $blue-910;
    }

    textarea.Input-el {
      resize: vertical;
      min-height: 72px;
      margin-bottom: 4px;
    }

    .Input--required .Input-label::after {
      color: $accent-negative-900;
    }

    .Input-error,
    .notify-error {
      color: $accent-negative-900;
      font-size: 12px;
      line-height: 18px;
    }

    .Dropzone {
      margin-top: 24px;
    }

    .form-group {
      margin-bottom: 0;
    }
  }
}

.bank-details-change-content {
  .file-upload {
    .description {
      font-size: 16px;
      line-height: 20px;
      color: $blue-980;

      .sub-title {
        font-weight: 600;
      }
    }

    .divider {
      border: 1px solid #F0F3F4;
      width: 100%;
    }

    .upload-info {
      color: $gray-600;
      margin-bottom: 36px;

      label {
        color: $blue-800;
        margin-bottom: 4px;
        font-weight: 400;
        font-size: 13px;
        line-height: 18px;
      }

      fieldset > div:last-child {
        margin-top: 24px;
      }

      label + div {
        color: $gray-600;
      }
    }

    .form-group {
      margin-bottom: 0;
    }

    .form-actions {
      text-align: center;

      button {
        max-width: 416px;
      }
    }
  }
}

.bank-account-update-form,
.file-upload,
.bank-details-change-states-wrapper {
  min-height: 450px;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.watch-sample-video-link {
  color: $primary-900;
  border: 1px solid $primary-300;
  border-radius: 16px;
  background: $primary-100;
  margin-top: 16px;
  margin-left: 28px;
  font-size: 10px;
  line-height: 14px;

  .m-r {
    margin-right: 6px;
  }

  &:hover,
  &:focus {
    color: $primary-900;
  }
}

.bank-details-change-states-wrapper {
  max-width: 320px;
  margin: auto;

  .bank-details-change-state {
    text-align: center;

    &-muted-text {
      font-size: 12px;
      line-height: 18px;
      color: $blue-960;
    }

    hr {
      background: $blue-910;
    }

    .bank-details-icon {
      display: inline-block;
      height: 84px;
      width: 84px;
      background: no-repeat center background-size contain;

      &--account-blocked {
        background-image: url($bank-account-update-assets + 'account_blocked.svg');
      }

      &--invalid-ifsc {
        background-image: url($bank-account-update-assets +'invalid_ifsc.svg');
      }

      &--nre-account {
        background-image: url($bank-account-update-assets + 'bank_error_circle.svg');
      }

      &--account-number {
        background-image: url($bank-account-update-assets + 'bank_error_circle.svg');
      }

      &--account-closed {
        background-image: url($bank-account-update-assets + 'bank_error_triangle.svg');
      }

      &--couldnt-verify {
        background-image: url($bank-account-update-assets + 'bank_error_triangle.svg');
      }

      &--bank-circle {
        background-image: url($bank-account-update-assets + 'bank_circle.svg');
      }
    }
  }

  .mb-20 {
    margin-bottom: 20px;
  }
}

.bank-account-update-status {
  .Alert {
    display: flex;
    align-items: center;
    margin: 4px;
    padding: 8px;
    border: none;

    .Alert-icon--before,
    .Alert-icon--close {
      font-size: 16px;
      line-height: 16px;
    }

    .Alert-icon--before {
      margin-right: 6px;
    }

    .Alert-icon--close {
      margin-left: 6px;
      cursor: pointer;
      color: $blue-900;
    }

    &--warning {
      background: #CD82141A;

      .Alert-icon--before {
        color: $accent-neutral-900;
      }
    }

    &--error {
      background: #D12D2D1A;

      .Alert-icon--before {
        color: $accent-negative-900;
      }
    }

    &--success {
      background: #1F890E1A;

      .Alert-icon--before {
        color: $accent-positive-900;
      }
    }

    &-content {
      font-size: 12px;
      line-height: 18px;
      color: $blue-900;
    }
  }

  .needs-clarification {
    .Alert-icon--before {
      align-self: flex-start;
    }

    .action-required {
      color: $blue-980;

      .title {
        color: $accent-neutral-900;
        font-weight: 600;
      }

      .btn-link {
        color: $primary-900;
        padding: 0;
        font-size: 12px;
        line-height: 18px;
      }
    }
  }

  & + .list-group {
    .list-group-item:first-child {
      border-top: none;
    }
  }
}

.pr-12 {
  padding-right: 12px
}

.bank-details-review {
  color: $accent-neutral-900
}

.profile-container {
  .nav-link {
    color: $blue-100
    cursor: pointer
  }

  .gray {
    color: #808080
  }
}

.under-review {
  opacity: 0.5
}

.firc-form-container {
  padding: 24px;

  .dropdown-container {
    display: flex;
    justify-content: space-between;
  }

  .label {
