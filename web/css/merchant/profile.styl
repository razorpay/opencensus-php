// stylelint-disable declaration-no-important
// stylelint-disable no-descending-specificity
$white-color = #FFF;
$label-suggestions-border-color = #E8EAEE;
$selected-label-bg-color = #DBE9FF;
$light-blue-color = #2B83EA;
$shadow-black-color = #3A45671E;
$accent-negative-900 = #D12D2D;
$accent-neutral-900 = #CD8214;
$accent-positive-900 = #1F890E;
$gray-600 = #818FA4;
$dark-blue-100 = #536582;
$blue-800 = #344A6C;
$blue-900 = #162F56;
$blue-910 = #162F561A;
$blue-940 = #162F5661;
$blue-960 = #162F568A;
$blue-980 = #162F56BD;
$primary-100 = #FAFCFF;
$primary-900 = #0B70E7;
$primary-300 = #E7F1FD;
$white-110 = #E0E4F91A;
$blue-100 = #528FF0;
$white-200 = #E1E5EA;

$bank-account-update-assets = "https://cdn.razorpay.com/static/assets/profile/bank-details-change/";

.profile-container {
  .panel-heading {
    padding-top: 10px;
    padding-bottom: 10px;
  }

  .background-highlight {
    background-color: #0B70E70C;
    color: #5B666D;
  }

  .list-group-item .i-notes {
    padding: 8px 8px 4px;
    margin-left: 8px;
    vertical-align: middle;
    font-size: 12px;
    border-radius: 50%;
    background: #F14F50;
    color: $white-color;
  }

  .activation-bar-text {
    display: inline-block;
    margin-right: 8px;
    vertical-align: middle;
  }

  .activation-bar {
    width: 80px;
    display: inline-block;
    vertical-align: middle;

    .progress {
      border-radius: 4px;
      height: 6px;
      margin: 0
    }
  }

  .account-access {
    .title {
      text-align: right;
    }

    .help-content {
      vertical-align: text-bottom;
      padding-left: 4px;
    }
  }

  .terms-and-cond {
    display: flex;

    .edit-details-btn {
      padding: 3px 8px;
      font-size: 12px;
    }
  }
}

@media screen and (max-width $screen-sm-min)
  .panel-heading
    display: flex
    flex-wrap: wrap
    justify-content: space-between

.rzp-gst-content.modal-body {
  .gst-update-note > .rzp-banner {
    border-width: 1px;
  }
}

.profile-container,
.brand-name-label {
  .help-content i {
    font-size: 130%;
    margin-left: 4px;
  }
}

.billing-label-info {
  position: relative;
  top: -2px;
  left: 7px;
}

.help-curr-billing-div {
  color: $blue-940;
  margin-top: 16px;
  margin-bottom: 5px;
  font-weight: 600;
  cursor: default;
}

.curr-billing-label-input {
  background-color: $white-color !important;
  cursor: default;
  border-right: 0;
}

.curr-billing-label-input + .input-group-addon {
  background-color: $white-color;
}

.billing-label-suggestions {
  padding: 10px 12px;
  border: 1px solid $label-suggestions-border-color;
  border-bottom: none;
  cursor: pointer;
}

.billing-label-suggestions-border-bottom {
  border-bottom: 1px solid $label-suggestions-border-color;
}

.modal-white-background {
  background-color: $white-color;
}

.billing-label-popover.show {
