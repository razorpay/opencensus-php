  left: 24px !important;
  width: 380px;
  z-index: 3;
}

.billing-label-popover.rzp-popover.rzp-tooltip.align-bottom .rzp-tooltip-inner > .rzp-popover-arrow,
.billing-label-popover.rzp-popover.rzp-tooltip.align-top .rzp-tooltip-inner > .rzp-popover-arrow {
  left: 30%;
}

.add-cutom-label-header {
  font-size: 13px;
  line-height: 20px;
  color: $light-blue-color;
  margin-top: 20px;
}

.add-cutom-label-header > span {
  cursor: pointer;
}

.hide-element {
  display: none;
}

.suggested-label-selected {
  background-color: $selected-label-bg-color;
}

.suggested-label-selected-tick {
  float: right;
  height: 12px;
  margin-top: 5px;
}

