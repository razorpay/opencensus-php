$white-color = rgb(255, 255, 255);
$label-suggestions-border-color = #E8EAEE;
$selected-label-bg-color = #dbe9ff;
$light-blue-color = #2B83EA;

.profile-container {
  .panel-heading {
    padding-top: 10px;
    padding-bottom: 10px;
  }

  .list-group-item .i-notes {
    padding: 8px 8px 4px;
    margin-left: 8px;
    vertical-align: middle;
    font-size: 12px;
    border-radius: 50%;
    background: rgb(241, 79, 80);
    color: rgb(255, 255, 255);
  }

  .activation-bar-text {
    display: inline-block;
    margin-right: 8px;
    vertical-align: middle;
  }

  .activation-bar {
    width: 80px;
    display: inline-block;
    vertical-align: middle;

    .progress {
      border-radius: 4px;
      height: 6px;
      margin: 0
    }
  }

  .account-access {
    .title {
      text-align: right;
    }
    .help-content {
      vertical-align: text-bottom;
    }
  }
}

.rzp-gst-content.modal-body {

  .gst-update-note > .rzp-banner {

    border-width: 1px;
    margin-bottom: 0;
    margin-top: 20px;
  }
}

.profile-container .help-content i {
  font-size: 130%;
  margin-left: 4px;
}

.billing-label-info {
  position: relative;
  top: -2px;
  left: 7px;
}

.help-curr-billing-div {
  color: rgba(22, 47, 86, 0.38);
  margin-top: 16px;
  margin-bottom: 5px;
  font-weight: bold;
  cursor: default;
}

.curr-billing-label-input {
  background-color: $white-color !important;
  cursor: default;
  border-right: 0;
}
.curr-billing-label-input + .input-group-addon {
  background-color: $white-color;
}

.billing-label-suggestions {
  padding: 10px 12px;
  border: 1px solid $label-suggestions-border-color;
  border-bottom: none;
  cursor: pointer;
}
.billing-label-suggestions-border-bottom {
  border-bottom: 1px solid $label-suggestions-border-color;
}

.modal-white-background {
  background-color: $white-color;
}

.billing-label-popover.show {
  top: 60px !important;
  left: 24px !important;
  width: 380px;
  z-index: 3;
}
.billing-label-popover.rzp-popover.rzp-tooltip.align-bottom .rzp-tooltip-inner > .rzp-popover-arrow, .billing-label-popover.rzp-popover.rzp-tooltip.align-top .rzp-tooltip-inner > .rzp-popover-arrow {
  left: 30%;
}

.add-cutom-label-header {
  font-size: 13px;
  line-height: 20px;
  color: $light-blue-color;
  margin-top: 20px;
}
.add-cutom-label-header>span {
  cursor: pointer;
}
.hide-element {
  display: none;
}

.suggested-label-selected {
  background-color: $selected-label-bg-color;
}
.suggested-label-selected-tick {
  float: right;
  height: 12px;
  margin-top: 5px;
}

.transaction-limit {
  text-align: right;
  .help-content {
    padding-left: 5px;
  }
}

.gst-invoice-note
  border-left 3px solid #CD8214
  padding-left 10px
  color rgba(22, 47, 86, 0.54)

.gst-opt-out-cta
  display flex
  flex-direction column

  span 
    display flex
  
  div
    display flex
    flex-direction row
  
  .address-section span:nth-child(1), .pincode-section span:nth-child(1)
    padding 10px 0px 0px 15px
    flex .3
  
  .address-section span:nth-child(2), .pincode-section span:nth-child(2)
    padding 10px 15px 0px 15px
    flex .7
    align-items end
    display flex
    flex-direction row
    justify-content flex-end

  .action span
    display flex
    flex 1
    padding 10px 15px 0px 15px
    justify-content flex-end

    p
      padding-top 10px
      font-weight bold
      cursor pointer
      color #528ff0

.btn-highlight, .btn-highlight:hover
  border 1px solid rgba(11, 112, 231, 0.74)
  background rgba(11, 112, 231, 0.05)
  margin-top 15px !important
  color #2B83EA

.gst-help-block
  padding 1px
  margin-bottom 15px
  color rgba(22, 47, 86, 0.74)

.gst-confirmation-modal-header
  line-height 25px

.rzp-gst-content
  .rzp-tooltip-inner
    left -502px
    top -50px

  .label-info
    margin-top -5px
    margin-bottom 10px
    font-size 12px
    color rgba(22, 47, 86, 0.38)
    background-color #FAFAFA
  
  input
    margin-bottom 18px

  .suggested-address-row
    padding 5px 0px 5px 10px
    border-left 3px solid #528FF0
    border-radius 2px
    margin-bottom 10px

    p{
      display inline
      color #528FF0
      font-weight 500
      cursor pointer
    }