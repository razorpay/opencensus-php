  .note
    color: $blue-960
    margin: 15px 0
    font-size: 13px

  .transactionlimit-fileupload
    margin-bottom: 20px

  .notify-error
    color: #F05050

.bank-account
  width: 50%

  .help-content
    padding-left: 5px

  .bank-account__change-info
    width: 200%
    margin-top: 10px
    padding-left: 10px

    &.inprogress
      border-left: 4px solid $accent-neutral-900

    &.rejected
      border-left: 4px solid $accent-negative-900

    &.success
      border-left: 4px solid $accent-positive-900

.gst-invoice-note
  border-left: 3px solid $accent-neutral-900
  padding-left: 10px
  color: $blue-960

.gst-opt-out-cta
