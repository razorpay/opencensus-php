.hbspt-form
  &-details

    .rx-logo
      width: 300px
      padding: 40px 0 0 50px

    .section
      display: flex
      padding: 40px 0px 50px 50px
      align-items: end

      .left-section
        max-width: 580px

        .heading
          font-weight: bold
          font-size: 32px
          line-height: 60px
          color: black
          margin: 0

        .list
          list-style: none
          padding: 0
          display: flex
          flex-wrap: wrap
          margin: 30px 0 50px

          li
            width: 50%
            margin-bottom: 10px
            margin-bottom: 25px

            img
              margin-right: 10px
              width: 20px

        .btn-wrapper
          text-align: left

          .btn 
            padding: 10px 40px
            font-weight: 600

      
      .right-section
        width: calc(100% - 580px)
        overflow: hidden

        img 
          width: 830px;
          margin-left: -50px;

  .hbspt-ca-form
    padding: 20px

    .hs-button
      background: #3281FF 
      color: #fff
      border: none
      width: 260px
      margin: 0px auto
      display: block
      height: auto 
      border-radius: 3px
      padding: 15px 16px 
      font-size: 15px
      cursor: pointer

    .hs-error-msgs label
      color: red
      font-weight: 400
      display: block
  
    form.hs-form fieldset
      max-width: none

    .form-brand-logo
      width: 200px
      margin: 0 auto
      display: block

    fieldset.form-columns-2 .hs-form-field
      padding: 10px 40px 20px 60px
      width: 50%
      display: inline-block

      input[type="text"],
      input[type="email"],
      input[type="tel"],
      textarea
        border: none
        height: 35px
        width: 100%
        border-radius: 8px
        padding: 0 10px
        background: #f5f5f5

      input[type="checkbox"],
      input[type="radio"]
        margin-right: 8px


      .inputs-list
        display: flex
        align-items: center
        flex-wrap: wrap
        list-style: none
        padding: 0

        li
          width: 30%
          margin-bottom: 5px
      
      label
        span
          font-size: 15px

  .submitted-message
    padding: 50px

    p
      font-size: 16px

      strong
        font-size: 20px
        margin-bottom: 15px
        display: block


#hubspot-ca-form-modal
  width: 1020px !important
  max-width: 100vw
  // padding: 20px 0 0px !important
  background: $nitro-dark-bg

  button.close
    padding-right: 20px
    color: white
    opacity: 0.8

    &:hover, &:focus
      opacity: 1
    
  .btn-close-modal
    position: absolute
    right: 10px
    top: 20px

  .hs-main-font-element

    img
      margin-left: 50px !important
