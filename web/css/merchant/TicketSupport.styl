.ticket-support {
    padding: 30px 20px;

    .img-round {
        display: block;
        margin: auto;
        border-radius: 50%;
        width: 56px;
    }

    .user-image {
        position: relative;
        // top: 10px;
    }

    .label {
        padding: 4px;
        font-size: 10px;
        text-transform: uppercase;
    }

    .message-owner {
        color: #162F56;
    }

    .reply-message-container {
        padding-left: 0;
    }

    .message-to {
        margin-top: 8px;
        color: rgba(22, 47, 86, 0.54);
    }

    .message-body {
        margin-top: 20px;

        img {
            max-width: 100%;
        }

        .file-attachment {
            display: inline-block;
            color: #162F56;
            font-size: 12px;
            margin: 0 12px 12px 0;
            background: rgba(22, 47, 86, 0.02);
            border: 1px solid rgba(22, 47, 86, 0.12);
            border-radius: 50px;
            padding: 0 16px;
            line-height: 30px;

            &:hover {
                cursor: pointer;
                background: rgba(22, 47, 86, 0.12);
            }

            img {
                height: 16px;
                margin-right: 10px;
            }
        }
    }

    .message {
        // margin-bottom: 25px;

        .row {
            overflow: hidden;
        }

        .Dropzone-content {
            font-size: 12px;
        }

        .Dropzone-file-icon {
            display: none !important;
        }

        .Dropzone-file-icon + .Dropzone-content-desc {
            padding-left: 0;
        }

        .Dropzone .Dropzone-cavity {
            border-radius: 0 0 2px 2px;
            border-color: #cfdadd;
            border-style: solid;
            border-top-color: transparent;
        }

        .Dropzone-cavity--staged .Dropzone-close {
            margin-top: 0;
        }

        .reply-textarea {
            padding-left: 0;
        }

        .reply-text {
            border-radius: 2px 2px 0 0;
        }
    }

    .ticket-subject {
        color: rgba(22, 47, 86, 0.87);
        font-weight: 700;
        margin-bottom: 5px;
    }

    .ticket-short-details {
        color: rgba(81, 89, 120, 0.72);
    }

    .ticket-conv-body {
        background: rgba(216, 219, 223, 0.1);
        border: 1px solid rgba(22, 47, 86, 0.24);
        box-sizing: border-box;
        padding: 15px 0;
        border: 1px solid rgba(22, 47, 86, 0.1);
        overflow: hidden;
    }

    .tickets-section-separator {
        margin-bottom: 40px;
    }

    .ticket-row-panel {
        margin-bottom: 0;
        border: 1px solid rgba(22, 47, 86, 0.1);
        border-bottom: 0;

        &:last-child {
            border-bottom: 1px solid rgba(22, 47, 86, 0.1);
        }

        .label-active {
            background: #1F890E;
        }

        .ticket-detail-separator {
            padding: 0 9px;
        }
    }

    .ticket-reply-btn {
        font-size: 12px;
        line-height: 14px;
        padding: 7px 16px;
        float: right;
        margin-top: 12px;

        .reply-icon {
            font-size: 13px;
            vertical-align: middle;
            margin-left: 6px;
        }
    }

    .reply-quill {
        margin-top: 10px;
    }

    .active-ticket-grey {
        font-size: 12px;
        color: grey;
        margin-top: 5px;
    }

    .tickets-container {
        min-height: 35rem;
    }

    .tickets-section-title {
        font-size: 16px;
        line-height: 24px;
        font-weight: bold;
        margin: 0 0 22px;

        .section-collapse {
            color: rgba(22, 47, 86, 0.54);
            margin-left: 6px;
            vertical-align: middle;
            font-size: 24px;
        }
    }

    .ticket-cont-spinner {
        transform: translate(-50%, -50%);
        position: absolute;
        top: 20rem;
        left: 50%;
        z-index: 9999;
        text-align: center;
    }

    .tickets-list-title {
        font-weight: bold;
        margin-bottom: 22px;
        font-size: 16px;
    }

    .escalate-banner {
        margin-top: 15px;
        margin-bottom: -15px;
        background: rgba(22, 47, 86, 0.1);
        color: rgba(22, 47, 86, 0.87);
        font-size: 12px;
        line-height: 14px;
        padding: 8px 0;

        &.escalation-warning {
            color: #F89A23;
            background: linear-gradient(0deg, rgba(255, 159, 0, 0.1), rgba(255, 159, 0, 0.1)), #FFFFFF;
        }

        .link {
            font-weight: bold;
        }
    }

    .ticket-escalated-response {
        font-size: 12px;
        line-height: 14px;
        color: #F2B852;

        .ticket-escalated-response-time {
            margin-left: 4px;
            color: #F39F31;
        }
    }

    .ticket-escalated-icon {
        vertical-align: middle;
        margin-right: 6px;
    }

    .ticket-replies-container {
        .message:not(:last-child)  {
            border-bottom: 0;
        }
    }

    .ticket-replies-title {
        margin: 25px 0 16px;
        font-size: 14px;
        line-height: 20px;
        font-weight: bold;
        color: rgba(22, 47, 86, 0.87);
    }

    .ticket-details-caption {
        padding-left: 6px;
    }

}

// .active-ticket-label {
// margin-left: 6px;
// position: relative;
// top: 2px;
// }
.edit-conv-email {
    font-size: 25px;
    position: relative;
    top: 8px;
}

#ticket-system .active-ticket-label {
    font-weight: 600;
}

.ticket-title-section {
    padding-bottom: 16px;
}

.ticket-title-divider {
    border-bottom: 1px solid rgba(22, 47, 86, 0.1);
}

.ticket-img-round {
    margin-left: 0px !important;
}

.ticket-status-label {
    display: inline;
    padding: 0.2em 0.6em 0.3em;
    font-size: 75%;
    font-weight: 700;
    line-height: 1;
    color: #fff;
    text-align: center;
    white-space: nowrap;
    vertical-align: baseline;
    border-radius: 0.25em;
    padding: 2px 6px;
    font-size: 12px;
    margin-left: 10px;

    &.label-active {
        background: #1f890e;
    }

    &.label-info {
        background-color: #37ABFF;
    }

}

.message-user-circle {
    font-size: 56px;
    position: relative;
    top: 6px;
    left: 20px;
}

.reply-user-circle {
    font-size: 56px;
    position: relative;
    top: 8px;
    left: 20px;
}

.no-tickets-f {
    font-weight: bold;
    font-size: 20px;
    text-align: center;
}

.ticket-conv-body {
    .ticket-status-label {
        position: relative;
        top: 1px;
        border-radius: 3px;
    }
}

.ticket-row-panel {
    .ticket-status-label {
        float: right;
    }
}
