.full-view-wizard {
  max-width: none;
  height: 100vh;
  max-height: none;
  background: #fff;
  position: relative;

  main {
    top: 118px;
    padding: 10px 30px;
  }

  main-title {
    text-transform: none;
    font-weight: bold;
    font-size: 17px !important;
  }

  .side-bar {
    background: '#F9FBFE';
    padding: 24px 0 0;

    .side-bar-container {
      position: relative;
      height: 100%;
    }

    .img-container {
      text-align: center;
      padding: 25px 0 36px;
      border-bottom: 1px solid rgba(22,47,86,0.1);
      margin: 0 15px;

      img {
        max-width: 145px;
        max-height: 35px;
        display: inline-block;
      }
    }

    .footer-img-container {
      position: absolute;
      bottom: 0;
    }

    a {
      cursor: pointer;
    }
  }

  footer {
    background: #FFFFFF;
  }

  .reverse-flex {
    display: flex;
    flex-direction: row-reverse;
    justify-content: flex-end;
  }

  .footer-content {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    padding-left: 50px;
  }

  .main-title {
    text-transform: none;
  }

  .onboarding-tab-subtitle-error {
    font-size: 15px;
  }

  .content-container {
    padding: 20px 50px;
  }

  @media (max-width: 640px) {
    main {
      top: 60px;
      padding: 30px;
    }

    .content-container {
      padding: 20px;
    }
  }
  
}

.fullViewFormContainer {
  width: 100%;
  margin: auto;
}

.full-view-header {
  display: block;
  position: absolute;
  left: 240px;
  right: 0;
  padding: 30px 60px;
  margin: 0 20px;
  border-bottom: 1px solid rgba(22, 47, 86, 0.1);
  color: #344A6C;

  @media (max-width: 640px) {
    display: none;
  }
}

.header-container {
  display: flex;
  justify-content: space-between;
  align-items: center;

  .header-title {
    font-weight: bold;
    font-size: 20px;
    max-width: 500px;
  }

  a {
    cursor: pointer;
    font-weight: bold;
    font-size: 15px;
  }

  @media (max-width: 640px) {
    padding: 30px;
    color: #344a6c;
  }
}

.mobile-view-header {
  display: none;
  @media (max-width: 640px) {
    display: flex;
  }
}
