.activation-wizard {
  .nav-tabs {
    position: relative;
    top: 1px;
  }

  .panel {
    box-shadow: none;
    border-color: #dee5e7;
  }

  small.help-block {
    font-size: 12px;
  }

  small.help-block,
  .nav-tabs > li > a {
    .i + span {
      margin-left: 5px;
    }
  }

  .btn-toolbar {
    margin-top: 16px;
    margin-bottom: 16px;
  }

  .wizard-header {
    margin-top: 15px;
    margin-bottom: 30px;
    font-weight: bold;
    font-size: 20px;
  }

  .rzpCheckbox {
    label::before {
      border-color: #5f73cf !important;
    }
    [type='checkbox']:checked + label::before {
      border-color: #cfdadd !important;
      background-color: #fff9e9 !important;
    }

    label::after {
      color: #27c24c !important;
    }

    .left-label {
      display: inline-block;
      position: absolute;
      margin-left: 4px;
    }
  }
}
