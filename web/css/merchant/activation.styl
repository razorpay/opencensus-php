// Parent control the width of ActivationWizard component
$height = 600px
$warningFill = #ffa665
.ActivationContainer
  position: relative
  width: 92%
  margin: 80px auto

  .spinner-container
    height: 300px

$side-width = 240px

/* Activation wizard screen */
.Activation--wizard
  max-width: 1024px
  height: 80vh
  max-height: 640px
  min-height: 560px
  background: #fafafa
  position: relative

  .disable-ca-option
    opacity: 0.35
    cursor: not-allowed
    
  .rx-ca
    width: 100%

    .divider
      height: 1px
      width: 100%
      background-color: rgba(22, 47, 86, 0.1);
      margin: 30px auto
      z-index: 2

    .rx-ca-container
      display: flex
      font-size: 14px
      color: #58666E
      margin-bottom: -12px
      
      .left-container
        text-align: right
        margin-right: 17px
        width: 26%
        
        .rx-logo
          width: 93px
          height: 19px
          margin-bottom: 14px

        .text-ca
          font-weight: bold
      
      .right-container
        width: 70%
        
        .Input-content
          margin-left: 0px
        .title
          margin-bottom: 12px
        .benefits
          display: flex
          flex-wrap: wrap
          
          .info:nth-child(odd) { 
              flex: 0 43%
              margin-bottom: 12px
              width: 100px
          }
          
          .info
            margin-right: 20px
            color: #838383
            
            .points-img
              margin-right: 8px
              width: 12px

        .footer-info
          color: #838383
          font-size: 12px
          margin-left: 24px
          
    @media (max-width: 640px) 
      .rx-ca-container
        display: block

        .left-container
          width: 100%
          display: flex
          text-align: left

          .rx-logo
            margin-right: 8px
            margin-bottom: 12px
        
        .right-container
          width: 100%

          .title
            margin-bottom: 16px
          
          .benefits
            display: block

            .info
              margin-bottom: 12px
              width: 100% !important

          .ca-checkbox
            margin-top: 32px

  .warning-svg
    svg
      width: 23px
      height: 19px
      fill: $warningFill
      vertical-align: top
      margin-right: 4px
      transform: scale(0.8)

    &.red svg
      fill: $textDangerColor

    span
      display: inline-block
      width: 80%

  aside .li--submit
    margin-top: 28px


  main
    left: 0
    right: 0
    padding: 30px
    position: absolute
    bottom: 80px
    top: 0
    overflow: auto

    &.main--full
      bottom: 0

    &.block-scroll
      overflow: hidden
      bottom: 0

    &.overlay-container
      background-color: #fafafa
      z-index: 100000

  main.overlay-container
    bottom: 45px

  .device--mobile
    display: none

  .device--desktop
    display: inline

  .subfooter
    display: flex
    margin-right: 40px

    .footer-checkbox
      margin: 0
    .checkbox-cursor
      cursor: not-allowed

  footer
    left: 0
    padding: 20px
    right: 0
    background: #F6F6F6
    border-top: 1px solid #e0e0e0
    bottom: 0
    position: absolute
    text-align: right

    button
      vertical-align: top

    .Loader
      float: left
      opacity: 0
      transition: 1s opacity
      margin-top: 4px
      line-height: 27px

      i, .spin-btn
        margin-right: 8px
        vertical-align: middle

      .spin-btn
        opacity: 1

      &--visible
        opacity: 1

    .footer-content
      display: flex
      align-items: center
      justify-content: flex-end

  // File upload component
  .document-group
      margin: 8px 0
      
  .Input-content
    &.Input-File
      width: 300px

    .Dropzone
      .Dropzone-content
        font-size: 14px
    
    .Input-desc
      max-width: 280px
      margin-top: 10px
      .Input-desc-list
        margin-top: 20px
        width: 340px
        li 
          margin-bottom: 10px
        .tnc-guideline
          list-style: none
          background: rgba(22, 47, 86, 0.05)
          padding: 8px 12px
          display: flex
          margin-top: 16px
          .tnc-info
            font-size: 22px
            padding-right: 8px
          .guideline-text
            color: rgba(22, 47, 86, 0.74)
            display: inline-block

      .bullet-list-container
        display: flex
        max-width: 280px
        margin-top: 10px

        .bullet-list
          padding-left: 15px

        .bullet-list--left
          width: 40%
        
        .bullet-list--right
          width: 60%

    .Input--business-description
      max-width: 260px;
      text-align: justify;

    .e-aadhar__desc
      max-width: 330px;
      font-size: 12px
    
    .Input-error
      max-width: 260px
      font-size: 13px
      margin: 6px 0 8px 0
    
    .ps-in-modal
      max-width: 260px
    
    .Input--aov-heading
      max-width: 340px;
      line-height: 20px;
      padding: 8px 0;
      color: #58666E;

  main-title
    text-transform: uppercase
    display: block
    font-weight: 600
    margin-bottom: 12px
    font-size: 14px !important

  .Form
    margin-top: 30px
    padding-bottom: 50px

  .SubmitForm-modal
    p
      width: 95%

    .tnc-text
      margin-bottom: 8px
      position: relative

      p
        width: 92%
        padding-left: 32px

      .Input--checkbox
        position: absolute
        margin: 4px 8px 0 0

  .SubmitForm-content
    margin-top: 36px

    button:nth-of-type(1)
      margin-left: 0

    .text-error
      margin-bottom 32px
      color: #f05050;

    .text-fade
      font-size: 14px
      margin-bottom 32px

  .CollapsibleFields
    .Collapsible--title
      margin-left: 190px
      width: 260px
      line-height: 40px

.Activation--success, .Activation--welcome
  border-radius: 2px
  background: #fafafa
  margin: 0 auto
  position: relative

.Modal-container--Activation--success
  overflow: visible !important

/* Activation success screen */
.Activation--success
  padding: 24px

  side-title
    text-align: center
    font-size: 18px
    font-weight: bold
    display: block
    margin-bottom: 12px

  .submit-illustration
    width: calc(100% + 48px)
    padding: 12px 0 12px 24px
    margin-left: -24px

  .LinkCard
    color: #58666e
    margin: 0 auto

  .Activation-info
    text-align: center
    font-size: 16px
    background: #fff
    padding: 24px 6%
    margin: -20px -12% 20px -12%
    border: 1px solid #e0e0e0
    box-shadow: 8px 8px 8px 0 rgba(132,155,191,0.1)
    color: $heading-primary
    font-weight: 600
    border-radius: 2px
    position relative
    z-index: 2

    .desc
      font-size: 14px
      color: #515978
      font-weight: 400

    .i
      margin-right: 8px
      border-radius: 50%
      background: #2dbe6f
      font-size: 14px
      color: #fff
      padding: 2px 2px 0;
      vertical-align: middle

    .desc
      margin: 10px 0 0

  .Activation-actions
    color: #4d4d4d

    side-title
      text-align: center

/* Activation welcome screen */
.Activation--welcome
  padding: 40px

  .welcome-illustration
    position: absolute
    bottom: 0
    right: 0
    width: 58%
    z-index: 1

  .short-content
    width: 100%
    max-width: 320px
    position: relative
    z-index: 2

  h3
    line-height: 32px
    width: 100%
    max-width: 260px

  .underline
    width: 24px
    height: 4px
    background: #96c5ff
    margin: 24px 0

  p
    color: #515978
    margin: 16px 0

  button
    margin-top: 80px
    margin-bottom: 6px

/* Standalone page size */
.ActivationContainer
  .Activation--success
    max-width: 400px

  .Activation--welcome
    max-width: 720px

  &.instant {

    .Activation--wizard {

      height: auto;
      min-height: 0;
      max-height: max-content;

      main.form-container {

        position: relative;
        top: auto;
        right: auto;
        bottom: auto;

        main-title {

          font-size: 18px !important;
          line-height: 22px;
          font-weight: bold;
          text-transform: none;
          margin-bottom: 0;
        }
      }

      footer {
        position: relative
      }
    }
  }


/* Modal-container size */
.Modal-container.Modal-container
  &--Activation--wizard
    width: 90%
    max-width: 960px
    min-height: 560px
    height: 80vh
    max-height: 640px

    &--Instant {

      max-width: 700px;
      height: 90vh;
      max-height: none;
      overflow: visible;
      min-height: 0;

      // fixes scroll on mobile
      @media (max-width: 820px) and (max-height: 750px) {

        top: 30px;
        transform: translate(-50%, 0);
      }

      .Activation--wizard {
        height: 90vh
        max-height: none;

        main {
          main-title {

            font-size: 18px !important;
            line-height: 22px;
            font-weight: bold;
            text-transform: none;
            margin-bottom: 0;
          }

          .Input , .InputGroup {

            margin-top: 8px;
          }

          .Input-info, .Input-checkbox {

            transition: none;
          }

          .Input--Website {

            margin-top: 18px;
          }
        }
      }
    }

  &--Activation--success
    width: 90%
    max-width: 400px

  &--Activation--welcome
    width: 90%
    max-width: 720px

.instant-activations-modal-container {

  position: relative;
  width: 100%;
  height: 100%;
  overflow: auto;
}

// For linked-account activation form
.Modal-mask--Account-Activation
  .Modal-container--Activation--wizard, .Activation--wizard
    min-height: 400px
    height: 70vh
    max-height: 480px
    margin: auto

.Modal-container.Modal-container--Activation--wizard--old
  overflow: auto

  .activation-wizard
    margin-top: 20px

  .panel-body
    padding: 24px

.onboarding-tab-subtitle-error
  color: #f05050;
  width: 450px;
  text-transform: none;
  font-weight: 400;

.onboarding-tab-subtitle
  font-size: 13px
  line-height: 20px
  color: #58666e
  text-transform initial
  font-weight: 400
  
/* Small screens for Activation wizard */
@media (max-width: 972px)
  .ActivationContainer .Activation--wizard
    .Input-content:not(.Input--checkbox)
      margin: 0 0 16px
    .Input--checkbox
      margin: 24px 0 16px

    .Input-label
      margin-bottom: 12px
      text-align: left
      float: unset


@media (max-width: 820px)
  .Modal-container .Activation--wizard
    .Input-content
      margin: 0 0 16px

    div.Input {

      margin-top: 8px;
    }

    div.Input:first-child, .submit-btn {
      margin-top: 0 !important;
    }

    main-title, .form-footer, .Input-content  {
      margin-bottom: 0;
    }

    main-subtitle {

      display: none;
    }

    .Input-label
      margin-bottom: 12px
      text-align: left
      float: unset

/*
TODO: Style written in consideration that instead of modal, standalone page would open for activation wizard on small screen
TODO: Display aside on top of form as expandable slider OR else show PREV button
*/
@media (max-width: 610px)
  .ActivationContainer
    margin: 80px auto 40px

  .device--desktop
    display: none !important

  .device--mobile
    display: inline !important


  .Activation--welcome

    .short-content .Button--primary
      margin-top: 40px

    .welcome-illustration
      width: 70%
      opacity: 0.1


  .Activation--wizard
    overflow: hidden

    main-title
      position: relative
      padding: 20px
      text-align: center
      top: -30px
      margin-left: -30px
      margin-right: -30px
      background: white
      font-size: 14px

      .main-title-icon
        position: relative

        i
          position: absolute
          font-size: 16px
          left: -24px
          top: -2px
          opacity: 0
          transition: 0.2s

          &.drishy
            opacity: 1

    .btn--back
      position: absolute
      margin: 0
      left: 8px
      top: 50%
      padding: 0 12px !important
      font-size: 20px
      border: none !important
      background: transparent !important
      transform: translateY(-50%)

      i
        margin: 0

    .Form
      margin-top: 0

    .SubmitForm-content
      margin-top: 60px

    .Input-el
      width: 100%

    .Select-elWrapper::before
      left: unset !important
      right: 4px

    aside
      display: none

    main, footer
      left: 0 !important
    
    .subfooter
        width: 100%
