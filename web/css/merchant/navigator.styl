  background: #E7EBF1;
  border-radius: 2px;
  color: #162F56;
  padding: 1px 4px;
  font-size: 12px;
  margin-left: 5px;
}

.slide-up-appear {
  opacity: 0;
  z-index: 1;
  height: 0;
  transform: translateY(60%);
}

.slide-up-appear.slide-up-appear-active {
  opacity: 1;
  transform: translateY(0%);
  height: auto;
  transition: transform 800ms ease-in-out, opacity 800ms ease-in-out, height 800ms ease-in-out;
}

// Create rule css
.recommended-provider-img-block {
  display: inline-block;
