    font-size: 14px;
    padding: 3px;
    border: 1px solid rgba(22, 47, 86, 0.24);
    background: rgba(22, 47, 86, 0.05);
    display: inline-block;
    border-radius: 50%;
    padding-top: 5px;
    margin-top: 5px;
  }

  padding-left: 30px;
  position: relative;

  &::before {
    content: '\d7';
    font-weight: 800;
    display: block;
    height: 20px;
    width: 20px;
    border-radius: 50%;
    position: absolute;
    left: 0px;
    right: 2px;
    bottom: 0px;
    top: 15px;
    font-size: 14px;
    color: white;
    text-align: center;
    background: rgba(22, 47, 86, 0.05);
