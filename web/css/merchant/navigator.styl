.expression-row-end {
  padding-top: 20px;

  &::before {
    content: '';
    display: block;
    height: 6px;
    width: 6px;
    border-radius: 50%;
    position: relative;
    left: -14px;
    right: 2px;
    bottom: 0px;
    font-size: 14px;
    color: white;
    text-align: center;
    background: rgba(22, 47, 86, 0.54);
    color: rgba(22, 47, 86, 0.74);
    cursor: pointer;
  }

  &::after {
    content: '';
    display: block;
    background: rgba(22, 47, 86, 0.24);
    position: relative;
    z-index: 1;
    width: 2px;
    left: -12px;
    height: 52px;
    right: 2px;
    top: -1px;
  }

  &:last-of-type::after {
    display: none;
  }
}

.expression-row {
  padding-left: 12px;
  margin-top: 0;
  padding: 10px 12px;

  &.expression-row-readonly:last-of-type::after {
    display: none;
  }

  &.fadein, &.fadeout {
    opacity: 0 !important;
    -moz-transition: opacity 0.4s ease-in-out;
    -o-transition: opacity 0.4s ease-in-out;
    -webkit-transition: opacity 0.4s ease-in-out;
    transition: opacity 0.4s ease-in-out;
  }

  &.fadein {
    opacity: 1 !important;
  }

  pointer-events: none;

  &::before, .input-select-container, input {
    pointer-events: all !important;
  }

  .Input {
