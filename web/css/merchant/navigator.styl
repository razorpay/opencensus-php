      border-bottom-left-radius: 5px;
      border-bottom-right-radius: 5px;
      border-top: 0;
    }

    h3 {
      font-size: 15px;
    }

    .gateway-row {
      background: #FAFCFF;
      margin: 0 5px;
      margin-left: 0;
      padding: 15px 0;
      padding-left: 10px;
      border: 1px solid #F3F8FE;
      border-radius: 5px;

      p {
        white-space: nowrap;
        text-overflow: ellipsis;
        margin-top: 8px;
        font-size: 13px;
        overflow: hidden;
      }
    }

    .pt0 {
      padding-top: 0;
    }
  }

  .navigator--create-rule {
    .desc {
      margin: 15px;
      margin-top: 0;
      color: rgba(22, 47, 86, 0.74);
    }

    .operator-btn.readonly.priority-btn {
