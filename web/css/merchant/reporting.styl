

$failedColor = #f56a6a
$successColor = #0b5
$color-pending = #FFBA00;

// these styles will be deprecated once async reports UI is in production
.report-loader
  .i-info-circle
    margin-right: 5px
  .report-progress
    margin: 20px 0
    padding: 5px 10px
    &:hover
      box-shadow: 2px 2px 6px rgba(0,0,0,0.12)
    .help-block
      margin: 0
      &.success
        color: $successColor
      &.failed
        color: $failedColor
    &.current
      background: rgba(185, 185, 185, 0.1)
      border-radius: 5px
  .report-close
    display: inline-block
    width: 7%
    vertical-align: top
    text-align: right
    font-weight: bold
    margin-top: 2px
    color: #757575
    cursor: pointer
  .bar-loader
    width: 93%
    display: inline-block
    &.success
      background-color: $successColor
    &.failed
      background-color: $failedColor

.report-cancel-download
  p
    margin-top: -5px
  button
    padding: 6px 38px

// async report styles
$logItemBackground = #F8F8F8;
$logItemBorderColor = #DFE5E7;
.LogList
  .LogItem
    padding: 16px;
    background-color: $logItemBackground;
    border: 1px solid $logItemBorderColor;
    border-radius: 4px;

    &--created
      .LogStatus
        color: $color-pending;

    &--no-data
      .LogStatus
        color: $textDangerColor;

    &__Body
      display: flex;
      justify-content: space-between;
      align-items: center;
