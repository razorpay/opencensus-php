.Modal--PaymentpagesSuccess
  position: relative
  overflow: hidden

  .modal-title, .close
    color: #fff

  .close
    text-shadow: none
    opacity: 1

    &:hover
      color: #fff
      opacity: 0.5

  .gradient-header
    content: ''
    position: absolute
    width: 100%
    height: 96px
    left: 0
    top: 0
    z-index: -1
    display: block
    background: linear-gradient(to bottom, #1d7828, #10741f)

  .pattern-1, .pattern-1::before, .pattern-2, .pattern-2::before
    position: absolute
    width: 400px
    height: 160px
    background: rgba(255, 255, 255, 0.03)

  .pattern-1, .pattern-2
    transform: skew(65deg, -10deg)

  .pattern-1
    top: -173px
    left: -118px

    &::before
      content: ''
      top: 22px
      left: -48px

  .pattern-2
    top: -113px
    left: -115px

    &::before
      content: ''
      top: 21px
      left: -49px


  .share-section
    margin-top: 16px
    padding-top: 16px
    border-radius: 3px
    background: #fff
    box-shadow: 0 2px 6px rgba(62, 71, 84, 0.15)
    border: 1px solid rgba(173, 188, 201, 0.22)

  .social-section
    margin-top: 20px
    padding: 12px 4px 0
    border-top: 1px solid rgba(155,155,155,0.19)

  .ClipboardCustom
    display: inline

    div[data-tip="Copied"]
      display: inline

    .Input-copierText
      width: 100%
      text-align: center
      margin-bottom: 8px

      .Input
        margin: 0
        width: 180px

      .Input-el
        height: 28px
        background-color: rgba(227, 227, 227, 0.3)
        border: none
        font-weight: bold

    .Button
      margin-left: 73px

    .Button, & + .Button
      display: inline
      height: 20px
      line-height: 12px
      font-size: 12px
      padding: 0 8px

    & + .Button
      margin-right: 0


  .Collapsible
    .Collapsible--title
      font-size: 13px
      line-height: 24px
      text-align: right

      i
        float: none !important
        font-size: 20px
        color: $primary-color
        vertical-align: middle

  .Collapsible--body
    margin-top: 12px
    padding: 0 12px

  .i-share-circle, .i-embed-btn
    color: $primary-color
    vertical-align: middle
    font-size: 20px
    margin-right: 12px

  .social-media
    float: left
    overflow: auto
    width: 132px
    border-right: 1px solid rgba(155,155,155,0.19)
    line-height: 24px

    a
      margin-left: 12px
    img
      pointer-events: none
      width: 18px

  .Form
    .Input
      margin-top: 0

    .Button--Link
      margin-right: 0

  .preview-btn-help
    font-size: 13px
    margin-top: 8px

  #embed-btn-preview
    border: 1px dashed rgba(82, 143, 240, 0.08)
    border-radius: 3px
    background: #F4F8FF

    &::before
      content: ''
      position: absolute
      left: 0
      right: 0
      top: 0
      bottom:0
      background: repeating-linear-gradient(-45deg, transparent, transparent 8px, rgba(82, 143, 240, 0.1) 2px, rgba(82, 143, 240, 0.1) 9px)


  footer
    margin-top: 32px

    .Button
      margin-right: 8px
      padding: 10px 16px

      &:last-of-type
        margin-right: 0


.Entity--paymentpage .panel-heading .text
  display: inline-block
  white-space: nowrap
  overflow: hidden
  text-overflow: ellipsis
  vertical-align: bottom
  font-weight: 600
