      margin: 24px -44px -8px
      padding: 8px 44px

      .Field-description
        transform: none
        margin-bottom: 0

    &.Field--disabled .Field-el
      pointer-events: none

  .Input-info
      left: calc(100% - 44px)
      top: -4px
      margin-left: 0
      margin-top: 8px
      transform: translate(-100%, -100%) !important

      &:before
        border-right-color: transparent
        border-bottom-color: transparent
        border-top-color: #2c3243
        left: 50%
        transform: translateX(-50%)
        top: unset
        bottom: -16px


/* Styles for creator modal */
.paymentlinks-creator
