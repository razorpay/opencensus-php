#paymentpage-container
  min-height: 100vh
  font-family: "Mulish", "Lato", "Lato-Regular", "Helvetica Neue", Helvetica, Arial, sans-serif

  // Increase the padding for tooltips & add pointed arrow
  .rzp-tooltip-inner
    padding: 16px 12px
    position: relative
    &:after
      content: ""
      position: absolute
      top: 100%
      left: 50%
      margin-left: -10px
      border-width: 5px
      border-style: solid
      border-color: black transparent transparent transparent
    
  .rzp-whole
    font-weight: bold

  .no-merchant-logo
    font-size: 11px
    text-align: center
    color: #528FF0
    line-height: 14px
    margin-top: 10px
    cursor pointer

    .rzp-tooltip
      width: 400px
      font-size: 12px
      line-height: 18px
      margin-top: 12px

  // added to styling bug due to confirm modal empty divs
  .details-container
    > div
      margin-bottom: 40px

  // mweb changes particular to PP
  .TemplateCard
    @media (max-width: $screen-xs-max)
      flex-direction: row
      width: calc(100% - 40px)

      .img-wrapper
        width: 220px
        height: 100%

      img
        width: unset
        height: 170px
        margin: 0 -75px

// Caution: Not only being used in PP but other places also
.TemplateCard
  border-radius: 4px
  background: #fff
  width: 220px
  overflow: hidden
  cursor: pointer
  display: flex
  flex-direction: column
  margin: 12px
  transform-origin: center
  transition: 0.19s cubic-bezier(0.42, 0, 0.35, 1)

  &.disabled
    cursor: not-allowed

  &:hover
    transform: translateY(-16px)

    .link
      border-top: 1px solid rgba(0,0,0,0.08)
      padding: 8px 0 0
      max-height: 33px
      opacity: 1

    .hover-text
      display: block

  .img-wrapper
    width: 100%
    height: 100%
    overflow: hidden
  
  img
    width: 100%
    height: 132px


  &-list
    display: flex
    align-items: baseline
    margin-top: 80px
    width: 100vw
    justify-content: center
    flex-wrap: wrap
    opacity: 0
    transform: translateX(40%)
    animation: 0.35s 0.24s slide-in cubic-bezier(0.16, 1.13, 1, 1) forwards
    @media (max-width: $screen-xs-max)
      margin-top: 0px

  &-details
    padding: 12px 16px
    height: 100%
    display: flex
    flex-direction: column
    position: relative
    font-size: 15px
    font-weight: 700
    line-height: 24px
    text-align: left
    width 100%

  &-desc
    font-weight: normal
    margin: 8px 0 24px 0
    font-size: 13px
    line-height: 20px
    min-height: 80px
    position relative
    z-index 0
    @media (max-width: $screen-xs-max)
      margin-bottom: 10px

  .hover-text
    display none
    position  absolute
    z-index 1
    top 0
    background: white
    font-weight: bold

  .link
    position: relative
    margin: auto 0 -4px 0
    font-size: 14px;
    font-weight: bold
    color: $primary-color
    display: flex
    align-items: center
    justify-content: center
    max-height: 0
    overflow: hidden
    padding: 0
    opacity: 0
    transition: 0.19s cubic-bezier(0.42, 0, 0.35, 1)
    @media (max-width: $screen-xs-max)
      opacity: 1
      max-height: unset
      justify-content: start

    i
      position: absolute
      right: 8px
      @media (max-width: $screen-xs-max)
        position: static
        margin-left: 5px
        margin-top: 5px

@keyframes slide-in
  50%
    opacity: 0

  100%
    transform: translateX(0)
    opacity: 1

.Modal-mask.Modal-mask--payment-pages-v2-templates
  background-color: rgba(0,0,0,0.8)
  text-align: center
  z-index: 999999 // Has to be highest

  .slide-in
    animation: 0.35s 0.1s slide-in cubic-bezier(0.16, 1.13, 1, 1) forwards
    transform: translateX(240px)
    opacity: 0
    @media (max-width: $screen-xs-max)
      max-width: 100vw
      padding: 10px 20px
      text-align: left

  .back-btn
    position: absolute
    left: 20px
    top: 16px
    color: #fff
    z-index: 2
    padding: 0
    margin: 0
    font-weight: normal
    height: auto

    &:hover
      opacity: 0.84
      color: #fff

  .Modal-container
    top: 40%

  .heading
    font-size: 24px
    font-weight: bold
    color: #fff

  button
    height: 40px
    padding: 10px 60px
    margin: 12px auto 0
    font-weight: bold

  p
    color: #fff
    line-height: 24px
    font-size: 16px
    margin: 12px 0 16px

  .Modal-container
    background: transparent

.Modal-mask.Modal-mask--payment-pages-v2-templates.Modal-mask--view-1
  overflow-x: hidden
  top: 0
  left: 0
  right: 0
  transform: none

  .Modal-container
    overflow: hidden
    top: 0
    left: 0
    right: 0
    transform: none

  .Modal-body
    margin-top: 80px


.Modal-mask--payment-pages-v2-creator
  .Modal-container
    top: 40%
    overflow: visible

  footer
    padding: 16px
    background: #f6f6f6
    border-top: 1px solid #e0e0e0
    overflow: auto

    .group-right
      float: right
      margin-top: -4px

    button
      margin-right: 30px
      margin-top: 4px

    .Button--primary
      margin-right: 0
      padding: 8px 32px

#embed-btn-preview
  position: relative
  padding: 20px
  background: #fff
  border: 1px solid rgba(0,0,0,0.05)
  margin-top: 4px
  text-align: center

  .preview-label
    position: relative
    top: -10px
    padding: 2px 6px
    font-size: 12px
    background: #fff
    border-radius: 3px
    font-weight: bold
    color: #adadad
    z-index: 2

.embed-button-form
  .description
    font-size: 12px
    margin-bottom: 4px
    font-weight: 400
    color: #7F849C

  #code-copier
    font-size: 12px
    color: #7F849C
    word-break: break-all;

  .ClipboardCustom
    float: right
    margin-top: -2px
    margin-right: -4px

    .btn.btn-link i
      display: inline-block

.Modal-mask--paymentpages-settings
  background: #fff

  .main-title
    font-weight: bold
    padding: 16px 24px
    font-size: 18px

  .Modal-container
    width: 400px
    margin: 12px 0
    overflow: auto
    height: 600px
    @media (max-width: $screen-xs-max)
