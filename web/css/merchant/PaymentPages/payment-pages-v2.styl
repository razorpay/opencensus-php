      display: inline-block

    .Input-content
      margin-left: 28px
      margin-top: -4px
      vertical-align: middle

  .Input--expiryby
    .Input--Calendar
      .Input-content
        margin-top: 6px

  .custom-success-msg
    position: relative
    .Input-el
      margin-top: 0
      margin-bottom: 0
      padding: 4px 40px 4px 12px
      max-height: 64px

    .chars-pressed
      position: absolute
      opacity: 0.4
      bottom: 2px
      right: 8px

  .Settings-form
    @media (max-width: $screen-xs-max)
      height: 100vh

    &--body
      overflow: auto
      height: 474px
      background: linear-gradient(#FFFFFF 33%, rgba(255,255,255, 0)), linear-gradient(rgba(255,255,255, 0), #FFFFFF 66%) 0 100%, linear-gradient(rgba(209,209,209, 0.5), rgba(0,0,0,0)), linear-gradient(rgba(0,0,0,0), rgba(209,209,209, 0.5)) 0 100%;
      background-color: #FFFFFF;
      background-repeat: no-repeat;
      background-attachment: local, local, scroll, scroll;
      background-size: 100% 21px, 100% 21px, 100% 7px, 100% 7px;
      @media (max-width: $screen-xs-max)
        height: inherit
        padding-bottom: 160px

  footer
    padding: 16px 24px
    background: #f6f6f6
    border-top: 1px solid #e0e0e0
    text-align: right
    @media (max-width: $screen-xs-max)
      position: fixed
      bottom: 0
      width: 100%
      text-align: center

    .Button--transparent
      padding: 8px 20px

    button:last-of-type
      margin-right: 0
  
  .custom-url
    border: 3px solid white
    transition: border 1s
    padding-top: 4px

    &.fade-out
      border: 3px solid #0B70E7

.PluginsAndAddOns
  margin: 120px auto

  .main-title
    padding: 20px 20px 0
    font-size: 12px

    .heading 
      font-size: 16px
      font-weight: bold
      margin-bottom: 4px

  .section
    padding: 20px
    border-bottom: 1px solid #D0D0D0

    &:last-of-type
      border-bottom: none;

    .section-title
      font-weight: bold
      display: flex
      align-items: center

      img
        margin-right: 6px

    .section-body
      padding-left: 28px

      .help-text
        font-size: 12px

  .Input-label
    font-weight: normal

  .InputGroup
    margin-top: 8px

    .Input
      margin-bottom: 5px

  .Input--checkbox
