    display: inline-block
    margin: 10px 0 0 !important

    

#wysiwyg-root
  padding-top: 106px
  animation: 0.3s fadein ease-in

  .content-container
    min-width: 854px
    @media (max-width: $screen-xs-max)
      min-width: 100%

/* Paymentpages v2 styles*/
.payment-pages-v2
  .spinner-container
    text-align: center
    padding: 100px 0

  .page-nav-container
    position: fixed
    z-index: 2
    width: 100%

  .page-nav
    color: #fff
    background-color: #2F3445
    box-shadow: 0 2px 24px 0 rgba(0,0,0,0.24)
    padding: 9px 12px
    min-width: 854px

    .page-size
      width: 100%
      max-width: 1440px
      margin: 0 auto
      display: table
      position: relative

      > div
        display: table-cell
        vertical-align: middle

      .page-title
        font-size: 18px
        font-weight: bold
        padding-left: 8px

        span
          opacity: 0.35
          font-weight: 400

      .page-action
        display: flex
        justify-content: flex-end
        margin-right: 34px

        button
          line-height: 10px
          padding: 10px 8px
          //height: 32px
          vertical-align: middle
          margin-left: 20px
          font-weight: 700
          display: flex
          justify-content: center
          align-items: center

          i
            margin-right: 4px

        .Button--transparent
          padding: 10px 0

    .close-btn
      font-size: 24px
      line-height: 14px
      position: absolute
      top: 4px
      right: 4px
      color: #fff
      cursor: pointer
      padding: 4px

      &:hover
        color: #fff
        opacity: 0.7

  .btn-link
    padding-left: 0


  // Wysiwyg elements
  #details-section
    width: 100%

    #description-details
      white-space: inherit

      #description
        margin: 24px 0px 0px

    label
      display: inherit

    .remove-btn
      display: inline-block
      vertical-align: middle
      margin-left: 16px
      visibility: hidden
      opacity: 0
      transition: 0.08s

    > div
        &:hover
          .remove-btn
            opacity: 1
            visibility: visible

        .Input-el
          background: transparent
          resize: none
          border: 1px solid transparent
          color: #6F7691

        .Input-highlight .Input-el
          &[name="title"], &[name="description"]
            border-color: #eee

        .Input-el.Input-el
          &:hover
            border-color: #e2e2e2

          &:focus
            background: #fff
            border-color: $primary-color
            resize: vertical

    .Input
      .Input-error
        line-height: 14px
        font-size: 14px

      .Input-el
        font-size: 14px

    .title--big
      .Input
        margin: -4px 0px -16px; // avoid left, right spacing, for alignment between sections

      .Input-el
        min-height: 42px
        font-size: 24px
        line-height: 32px
        font-weight: bold
        padding: 1px 5px 2px // 1px less cuz of border
        color: #0d2366
        max-height: 70px

      .Input-error
        line-height: 14px
        margin-top: -8px

      .fake-textarea
        padding: 3px 0
        min-height: 42px
        line-height: 32px
        font-size: 24px

    textarea.Input-el
      min-height: 32px
      height: 32px
      max-height: 230px // Supports 720 char on desktop
      line-height: 22px

    .Input-highlight textarea.Input-el[name="description"]
      min-height: 70px

    .Input
      margin: -4px -6px

      .Input-el
        padding: 3px 5px
        position: relative

  #share-details, #support-details, #terms-details
    .wysiwyg-edit-layer
      margin-top: -8px

  #share-details, #support-details
    .share-icons
      span
        vertical-align: middle

      span:not(:last-of-type)
        margin-right: -8px
  
  #terms-details
    p
      display: inline-block
      color: #6f7691
      margin-top: 16px
      white-space: pre-line
      word-wrap: break-word
      cursor: pointer
    
    .rzp-tooltip-tnc
      margin-left: 125px
      margin-top: 16px
      white-space: pre-wrap

  #support-details
    .sub-detail
      .Input
        width: calc(100% - 132px)
        display: inline-block
        vertical-align: middle
        margin: 0

      .Input-el
        height: 28px
        background: transparent
        color: #0D2366 // Same as in customer-facing view

    .Input-error
      margin: -2px 0 4px


  #form-section
    #form-footer
      .btn > div
        position: absolute
        left: 50%
        top: 50%
        transform: translate(-50%, -50%)

    .i-fix-sort
      font-size: 10px

    .i-fix-number
      font-size: 10px

    .i-fix-alphabet
      font-size: 10px

    .i-fix-arrow-down
      font-size: 13px
      &::before
        border-radius: 50%
        border: 1px solid
        border-color: inherit
        width: 24px
        height: 20px

  .wysiwyg-edit-layer
    position: relative
    margin: -4px -6px
    padding: 4px 6px
    border-radius: 2px
    cursor: pointer

    .i
      position absolute
      top: 16px
      right: 4px
      font-size: 18px
      padding: 2px 8px
      cursor: pointer
      visibility: hidden
      color: #bfbfbf

      &:hover
        color: #7b8199

    &:not(.disable-hover):hover
      background-color: #fff
      box-shadow: 0 5px 13px 0 rgba(0,0,0,0.14)

    &:hover
      .i
        visibility: visible

      .Input-info
        transform: translateY(-50%)
        opacity: 1

        @media (max-width: 1024px)
          transform: none

  .help-content
    position: relative

    .rzp-popover
      white-space: normal

  //Override Styles
  .Input-info
    left: 100%
    color: #fff
    background-color: #2c3243
    line-height: 20px
    min-width: 180px
    white-space: pre-line

    &::before
      border-right-color: #2c3243

    @media (max-width: 1024px)
      left: 0

      &::before
        border-right-color: transparent
        border-bottom-color: #2c3243

  .Button--header
    background: rgba(11, 112, 231, 0.05)
    border: 1px solid #A2C9F6
    box-sizing: border-box
    border-radius: 2px
    padding: 8px 16px !important
    
/* Overriding styles of UI-form */
.payment-pages-v2 .UI-form
  .wysiwyg-edit-layer
