.ModalForm--Share
  .Share-section
    padding-top: 24px

  .Share-section:not(:last-child)
    border-bottom: 1px solid rgba(155,155,155,0.19);
    padding-bottom: 24px

  .i-share-circle, .i-embed-btn
    color: $primary-color
    vertical-align: middle
    font-size: 20px
    margin-right: 12px

  .social-media
    float: right
    overflow: auto

    a
      margin-left: 16px
    img
      pointer-events: none
      width: 24px

  .ClipboardCustom .Input
    margin: 0
    width: 179px

  .Form .Input
    margin-top: 0
