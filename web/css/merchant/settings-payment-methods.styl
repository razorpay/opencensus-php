$checkout-modal-width = 400px

.flex-end
  display: flex
  justify-content: flex-end
  align-items: center

.no-margin
  margin: 0

#settings-payment-methods
  .mr-25
    margin-right: 25px
  .ml-5
    margin-left: 5px
  .spacer-20
    height: 20px
  .spacer-10
    height: 10px
  .panel-heading
    padding: 15px 20px 15px 0px
    .title
      font-size: 18px
      font-weight: 600
  .methods-view
    height: 491px
    display: flex
    border: 1px solid #E6E7E8
    border-bottom: none
    border-left: none
    width: 100%
    background: rgba(238, 238, 238, 0.1)
    overflow-x: auto
    overflow-y: hidden
    .level-1, .level-2
      width: 320px
      flex-shrink:0
      border-right: 1px solid #E6E7E8
    .level-1
      background: white
      .icon
        margin-left: 22px
      ul
        border-left: 1px solid #E6E7E8
    .level-2
        ul > li
          height: 69px
    .level-2, .level-3
      border-bottom: 1px solid #E6E7E8
    ul  
      list-style-type: none
      padding: 0
      margin-bottom: 0
      li:hover
        background: rgba(11, 112, 231, 0.05);
        .show-expand
          visibility: visible
          cursor: pointer

      li
        display: flex
        height: 70px
        align-items: center
        padding-right: 5px
        margin: 0px
        border-bottom: 1px solid #E6E7E8
        background: #FFFFFF
        .icon
          width: 30px
        .detail
          flex:5
          padding-left: 15px
          strong
            user-select: none;
            color: #5D666D
            font-size: 14px
            line-height: 17px
          p
            user-select: none;
            color: #828282
            font-size: 12px
            line-height: 20px
        .expand
          margin-right: 10px
          color: #0B70E7
          font-size: 20px
        .show-expand
          visibility: hidden
        .highlight-expand
          visibility: visible
          cursor: pointer
      .highlight
        background: rgba(11, 112, 231, 0.05);

        
    .overflowY
      overflow-y: auto
    .level-3
      width: 100%
      padding: 32px
      background: #FFFFFF
      .heading
        display: flex
        width: 420px
        justify-content: space-between
        font-size: 12px
        color: #5D666D
        margin-bottom: 16px
        padding: 0 2px
      .filter 
        margin: 0px 0 20px 0;
        button:not(:last-child)
          margin-right: 16px

      .filter-btn
        outline: none;
        background: rgba(22, 47, 86, 0.02)
        border: 1px solid rgba(22, 47, 86, 0.1)
        border-radius: 2px
        font-size: 14px
        line-height: 20px
        padding: 4px 12px
        color: rgba(22, 47, 86, 0.74)
      
      .filter-active
        background: #E7F1FD
        color: #2B83EA
        border: 1px solid #E7F1FD
      
      li:first-child
        border-top: 1px solid #E6E7E8

      .international-leaf-item
        height: auto
        display: block
        padding: 20px
        &:hover
          background: unset
        &.alert-info
          background: #FBF8E3
          p
            font-weight: bold
        .toggler-btn
          display: inline-flex
          align-items: center
          float: right
          button
            &::after
              background: #5e90e9
            &.checked::after
              background: #fff
          b
            padding-left: 5px
        .detail
          padding-left: 0
        .status-label
          text-transform: uppercase
          padding: 5px 12px
          .rzp-popover
            text-transform: none
        .detail + .status-label
          align-self: flex-start
        .product-info
          display: block
          border-radius: 4px
          padding: 20px 10px
          background: rgba(232, 235, 239, 0.32)
          .product-title
            display: flex
            justify-content: space-between
      li
        width: 420px
        background: transparent
        border-right: 1px solid #E6E7E8
        border-left: 1px solid #E6E7E8
        display: flex
        height: 56px
        flex-direction: column
        justify-content: center
        align-items: center
        padding: 0 15px
        > div
          width: 100%
          display: flex
          align-items: center
          .icon
            flex:1
          .detail
            width: 180px
            padding-left: 15px
            strong
              user-select: none;
              color: #5D666D
              font-size: 14px
              line-height: 17px
            p
              user-select: none;
              color: #828282
              font-size: 12px
              line-height: 20px
          .raise-request
            display: flex
            align-items: center
            justify-content: space-between
            padding-left: 0
        + .paypal-leaf-item
            display: block
            height: auto
            padding: 20px
            .status-bar
              display: flex
              justify-content: space-between
              align-items: center
              .instrument
                display: flex
                align-items: center
                width: 100%
              .status
                text-transform: none;
                background: rgba(232, 235, 239, 0.32);
                font-weight: 400;
                font-size: 14px;
                height: auto;
                margin-top: 15px;
                border-radius: 4px;
              .status-pill-warning
                width: auto
              .change-account
                width: 100%
              .change-account-action
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-top: 10px;
                .merchant-id
                  margin-left: 5px
                  color: #4F4F4F
                  font-size: 12px
                  .i-user-circle
                    margin-right: 20px
            .bar-wrap
              flex-wrap: wrap
            .bar-nowrap
              flex-wrap: nowrap
            .disabled-text
              text-align: left
              text-transform: none
            .detail
              padding: 0
          &:hover
            background: unset
          .icon
            margin: 0
          .detail
            padding: 0
          .desc
            width: 80%
            font-size: 12px
            line-height: 16px
            color: rgba(22, 47, 86, 0.54)
          .status-pill
            font-size: 12px
            pointer-events: none
          .paypal-info
            display: block
            background: #F2F4FE
            border-left: 8px solid #2B83EA
            padding: 16px 12px
            font-size: 12px
            line-height: 17px
            color: #7B8199

        .instrument-description
          padding: 15px 0px
          .description-strong
            font-weight: 600
          .instrument-description-container
            display: flex
            flex-grow: 1
            flex-direction: row
            align-items: center
            justify-content: space-evenly
            flex-wrap: wrap
            background: rgba(232, 235, 239, 0.32)
            padding: 10px
            width: auto
            .est-date-para:
              fontSize: 14px
            i
              font-size: 20px
              margin-right: 10px
            .detail
              display: flex
              justify-content: space-between
              align-items: center
              width: auto
              #status
                margin-top: 14px
          .disclaimer
            color: #000000
            opacity: 0.3
            padding-top: 8px
            &:before
              content: '*'
              margin-right: 2px

      li.action-required-list-item
        height: auto
        padding: 15px
        .comment
          display: flex
          margin: 12px 0px
          background: rgba(232, 235, 239, 0.32)
          padding: 2px 10px
          font-size: 14px
          i
            padding: 5px 10px 2px 0px
            font-size: 20px
          p
            margin: 5px 10px
      li.activated-action-required-list-item
        height: auto
        padding: 15px
        .comment
          margin-top: 10px
          background: rgba(205, 130, 20, 0.1);
          details
            padding: 0 10px
            width: 100%
            summary
              display: flex
              align-items: center
              justify-content: space-between
              font-weight: 400
              font-size: 14px
              line-height: 20px            
              color: #CD8214
              padding: 10px 0
              cursor: pointer
              img
                margin-right: 10px
            .description
              padding-bottom: 10px
            .action
              padding-bottom: 10px
          details[open]
            .toggle
              transform: rotate(180deg)
            summary ~ * 
              animation: sweep .5s ease-in-out

          @keyframes sweep {
            0%    {opacity: 0; transform: translateX(0)}
            100%  {opacity: 1; transform: translateX(0)}
          }

      li.list-item-has-description 
        height: auto
        padding: 10px 15px
        > div
          flex-wrap: wrap
        .detail
          padding: 0
        .requested-list-item
          width: 100%
          display: flex
          align-items: center
          i
            margin: 5px 10px 2px 0
          p
            font-size: 14px
            margin: 5px 10px
      li.list-item-has-long-description
        min-height: 105px
        p
          max-width: 250px
      li.list-item
        min-height: 56px
      li.list-item-disabled
        background: rgba(232,235,239,0.32)

    .status
      text-transform: uppercase
      font-size: 10px
      font-weight: bold
      padding: 5px 15px
      border-radius: 15px
      border: none
      height: 25px
      user-select: none
    .activated, .activated-action-required
      min-width: 80px
      color: #1F890E
      background: rgba(31, 137, 14, 0.1)
    .pending
      min-width: 80px
      color: rgba(22, 47, 86, 0.87)
      background: rgba(22, 47, 86, 0.1)
    .requested
      min-width: 80px
      color: #2A8CFF
      background: rgba(11, 112, 231, 0.1);
    .rejected
      min-width: 80px
      color: #D12D2D
      background: rgba(209, 45, 45, 0.1)
    .action-required
      min-width: 80px
      color: #CD8214
      border-radius: 15px
      background: rgba(205, 130, 20, 0.1)
    
    .notify-badge
      cursor: pointer
      background: #CD8214
      color: white
      padding: 1px 4px
      border-radius: 20px
      font-size: 10px
      margin-left: 10px
    
    .foot-note
      margin-top: 40px
      width: 420px
      padding: 15px 10px
      border: 1px solid #DFE4E6
      display: flex
      background: #FBF8E3
      color: #828282
      height: 85px
      i
        font-size: 18px
        padding-top: 5px;
        margin-right: 10px;
    
    .all-active
      display: flex
      height: 36px
      background: #E5FAED
      border: 1px solid #70C692
      border-radius: 4px
      font-size: 14px;
      line-height: 17px
      color: #5D666D
      padding-left: 10px
      align-items: center

    .all-inactive
      display: flex
      height: 36px
      background: #FBF8E3
      border: 1px solid #DFE4E6
      border-radius: 4px
      font-size: 14px
      line-height: 17px
      color: #828282
      padding-left: 10px
      align-items: center

.checkout-modal 
  width: $checkout-modal-width
  .wizard-header
    z-index: 1;
    position: absolute;
    top: -40px;
    color: white;
    font-size: 16px;
    font-weight: 700;
    display: flex;
    align-items: center
    justify-content: space-between
    width: 100%
    .close
      display: flex
      flex-direction: column
      justify-content: space-between
      opacity: 1
      span:nth-of-type(1)
        display: block;
        height: 2px;
        width: 15px;
        background: white;
        transform: rotate(45deg);
      span:nth-of-type(2)
        display: block;
        height: 2px;
        width: 15px;
        margin-top: -2px
        background: white;
        transform: rotate(-45deg);


.paytm-wallet-integration
  $side-width = 240px
  position: relative
  box-shadow: 0px 0px 8px rgba(0, 0, 0, 0.3);
  #white-background
    background: #fff
    margin-top: 60px

  .details-drawer
    padding: 10px 20px
    background: #F3F6F8;
    border: 1px solid #528FF0;
    border-radius: 2px;
    display: flex
    align-items: center
    justify-content: space-between

  .details-side-drawer
    position: absolute;
    width: 300px
    left: $checkout-modal-width
    background: #ffffff
    top: 30px
    bottom: 30px
    padding: 15px
    z-index: -1
    img 
      height: 177px;
      width: 222px;
      margin: 10px 20px;
    .ellipse
      position: absolute;
      width: 116.79px;
      height: 116.79px;
      border: 1.5px solid #528FF0;
      box-sizing: border-box;
      border-radius: 50%
    .drawer-header
      font-size: 14px
      font-weight: 700
      margin: 26px 0px
    .drawer-list-item
      color: #7B8199
      font-size: 14px
    .drawer-list
      color: #515978
      font-size: 14px
      font-weight: 400


  .wizard
    min-height: 527px
    background: #ffffff
    .register-account
      display: flex
      justify-content: space-between
      align-items: center
      margin: 20px
      padding: 10px
      background: #F3F6F8;
      border-radius: 2px;
      .blue-bar
        width: 5px;
        height: 36px;
        background: #528FF0;
        opacity: 0.9;
        border-radius: 2px;
        margin-right: 15px
    .form-container
      padding: 20px 
    .form-title
      padding: 24px
      font-weight: 600
      font-size: 16px
      position: absolute
      top: 0
      left: 0
      background: white
      width: 100%
    .form-subtitle
      margin-top: 50px
      font-size: 14px
      i
        color: black
    .form-radio > div.form-control-radio:nth-of-type(1)
      border-bottom: 1px solid #ADBCC9
    .form-description
      background: #fafafa
      padding: 0px 12px 0px
      border: 1px solid rgba(173, 188, 201, 0.47)
      margin-top: 10px
      .form-control-input
        margin: 10px 0px
      .form-control-radio
        padding: 26px 0px
      label
        display: flex
        justify-content: flex-start

        span 
          color: #7B8199
          font-weight: 400
          font-size: 12px  
      input[type="radio"]
        margin-right: 10px    
    .Input
      margin: 0
      .Input-content
        margin-top: 12px
      ul
        margin: 30px 0
        padding: 0
      li
        cursor: pointer
        list-style: none
        padding: 10px 24px
        margin: 4px 0
        color: #57666d
        position: relative

        .li--broad
          padding: 2px 0
          font-weight: 600
          display: block
          pointer-events: none

        .description
          color: inherit
          opacity: 0.8
          font-weight: 400
          pointer-events: none

          &.small
            font-size: 12px

          &.large
            font-size: 14px
            line-height: 20px
            margin-top: 8px

        .i-check
          margin-right: 6px
          line-height: initial
          vertical-align: middle


        i.i-chevron-right
          color: #fff
          position: absolute
          right: 8px
          font-family: merchant-icons
          opacity: 0
          top: 50%
          transform: translate(-4px, -50%)
          transition: 0.35s

        &:hover
          background: #fafbfc
        &.text-success
          color: #27c24c
        &.active
          background: #528FF0
          color: #fff

          .i-check::before
            color: #fff

          i.i-chevron-right
            opacity: 1

        &.disabled
          cursor: not-allowed
          color: #b6c0c4

      & ~ main, & ~ footer
        left: $side-width

      & ~ footer .help-text
          width: 320px
  .footer
    border-top: 1px solid rgba(173, 188, 201, 0.47);
    padding: 22px 24px
    background: #EBEFF0
    .stepper
      position: relative
      width: 50px
      display: flex
      align-items: center
      justify-content: space-around
      .inactive
        width: 6px;
        height: 6px;
        border-radius: 50%
        background: #C4C4C4;
      .active
        display: block
        width: 6px;
        height: 6px;
        border-radius: 50%
        background: #528FF0;
    .action-buttons
      display: flex
      gap: 1.5rem
      .btn-link
        color: #2B83EA
        font-weight: 700