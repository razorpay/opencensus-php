@import "bootstrap/mixins/clearfix.styl";

// Only page layout styles should reside in this file.
// This will be moved under `rzp` later

a, .btn-link {
  color: $primary-color;
}

html, body {
  background-color: #f0f3f4;
}

body {
  -webkit-font-smoothing: antialiased;

  &.noscroll {
    overflow: hidden;
  }
}

*:focus {
  outline: 0 !important;
}

.i {
  vertical-align: text-bottom;
  font-size: 110%;
  line-height: 0.8;

  &--formal {
    background-color: #FAFBFC;
    border: 1px solid #DFE1EC;
  }
}

.layout {
  position: relative;
  min-height: 94vh;
  padding-bottom: 45px;
}

.main-content {
  margin-left: 200px;
  margin-top: 51px;
  @media (max-width $screen-sm-min) {
    margin-left: 0;
  }

  .rzp-error-boundary {

    padding: 20px;
  }
}

.btn {
  .i + span {
    margin-left: 5px;
  }
}

.no-padding {
  padding: 0;
}

.font-thin {
  font-weight: 300;
}

.sidebar-bg-overlay {

  position: fixed;
  top: 0;
  left: 0;
  bottom: 0;
  right: 0;
  z-index: 1110;
  cursor: pointer;
  background-color: rgba(46, 51, 68, 0.5);
}

.sidebar {
  position: fixed;
  top: 0;
  bottom: 0;
  background-color: $sidebar-bg-color;
  width: 200px;
  z-index: 1111;

  @media (max-width: $screen-sm-min) {

    transform: translate(-100%, 0);
    transition: transform 150ms ease-in;
    will-change: transform;

    &.show-mobile-menu {

      transform: translate(0);
    }
  }

  .brand-logo {
    &::after {
      content: '';
      position: absolute;
      border: 1px solid #45495A;
      left: 20px;
      right: 20px;
    }

    > a {
      display: block;
      line-height: 50px;
      text-align: center;
      padding: 10px;

      > img {
        max-width: 145px;
        max-height: 28px;
        display: inline-block;
      }
    }
  }

  .divider {
    margin: 5px;
    border-top: 1px solid transparent;
  }

  .divider-old {
    border-top: 2px solid #252939;
    margin-top: 10px;
    margin-bottom: 10px;
    padding-left: 20px;
    padding-top: 10px;
    @media (max-width $screen-sm-min) {
      display: none;
    }

    &::after {
      content: attr(data-label);
      font-size: 11px;
      color: #8b8e99;
    }
  }

  nav {
    position: absolute;
    top: 72px;
    bottom: 0;
    left: 0;
    right: 0;
    overflow-y: auto;
    overflow-x: hidden;
    padding-bottom: 15px;
    padding-top: 15px;
    @media (max-width $screen-sm-min) {
      padding-bottom: 60px;
    }

    .text-warning {
      color: #fbe165;
    }

    a.activation-status-link {
      padding: 0;
      line-height: inherit;
      border: none;
    }

    div.activation-status {

      color: white;
      padding: 12px 20px;
      background-color: #315BC2;
      margin-bottom: 15px;

      i.i-chevron-right {

        position: relative;
        display: inline-block;
        margin-right: 0;
      }

      &.not-personalised {

        i.i-chevron-right {

          top: 10px;
          left: 5px;
        }
      }

      div.activation-status-secondary {

        font-size: 80%;
        line-height: 20px;
        color: rgba(255, 255, 255, 0.7);
      }

      div.activation-bar-content {

        display: table;
        font-size: 80%;
        line-height: 20px;
        margin-top: 4px;

        > div {

          display: table-cell;
          vertical-align: middle;

          &.activation-bar-text {

            white-space: nowrap;
            width: 1%;
            padding-right: 8px;
          }

          &.activation-bar {

            div.progress {

              width: 100%;
              height: 6px;
              margin-bottom: 0;
              border-radius: 4px;
              background-color: #2B3972;

              div.progress-bar {

                background-color: #FFFFFF;
                border-radius: 4px;
              }
            }
          }
        }
      }
    }
  }

  .nav > a {
    border-left: 4px solid transparent;
    color: #b4b6bd;
    display: block;
    line-height: 40px;
    padding: 0 15px;
    @media (max-width $screen-sm-min) {
      white-space: nowrap;
    }

    .badge {
      margin-top: 13px;
      font-size: 9px;
      letter-spacing: 0.7px;
    }

    .i, .fa {
      margin-right: 10px;
      width: 16px;
      text-align: center;
    }

    &:hover, &:focus {
      background-color: #32374a;
    }

    &.active {
      border-color: $primary-color;
      color: #fff;
      background-color: #252939;
    }

    .spin-loader {
      margin-top: 10px
    }
  }

  .bg-primary-fuse {
    background-color: #444a60;
    color: rgba(255,255,255,0.8);
  }
}

.navbar-fixed-top {
  margin-left: 200px;
  margin-bottom: 0;
  border-bottom: 0;
  background-color: #fff;
  box-shadow:0px 2px rgba(0, 0, 0, 0.05), 0 1px 0 rgba(0, 0, 0, 0.05);
  @media (max-width $screen-sm-min) {
    margin-left: 0;
  }
}

.navbar-default .navbar-nav {
  .dropdown > a.dropdown__trigger {
    display: inline-block;
    color: #777;
    cursor: pointer;
    padding: 15px;

    &:hover {
      text-decoration: none;
    }
  }
}

.pagefooter {
  position: absolute;
  bottom: 0;
  padding: 10px 20px;
  font-size: 12px;
  color: #8F96B3;
  margin-left: 200px;
  @media (max-width $screen-sm-min) {
    margin-left: 0;
  }

  a {
    color: #8F96B3;
  }
}

.dropdown--active > .dropdown__content > .dropdown-menu {
  display: block;
}

.react-root {
  ::-webkit-input-placeholder { /* WebKit, Blink, Edge */
    color: #aaa;
  }
  :-moz-placeholder { /* Mozilla Firefox 4 to 18 */
   color: #aaa;
  }
  ::-moz-placeholder { /* Mozilla Firefox 19+ */
   color: #aaa;
  }
  :-ms-input-placeholder { /* Internet Explorer 10-11 */
    color: #aaa;
  }

  h3, h2 {
    margin: 0;
  }

  h3 {
    font-weight: bold;
    font-size: 20px;
  }

  .alert {
    > ul > li {
      line-height: 2;
    }
  }

  input[type='color'] {
    padding: 0 3px;
  }
}

.content-wrapper {
  padding: 24px;
  position: relative;


  /* General Input styles (new UI Component) */
  .Input {
    margin-top: 0
  }

  /* Input pairs inside details view (new UI Component) */
  .Input--pair {
    .Input-elWrapper {
      font-size: inherit
    }

    textarea.Input-el {
      height: 36px
    }
  }

    @media (max-width $screen-sm-min) {
    padding: 20px;
  }
}

.content-sm {
  max-width: 800px;
  margin: auto;
  min-height: 300px;
  background-color: #fff;
}

// For showing any message if data and loader not present on dual view
.no-data-message {
  position: relative;
  width: 100%;
  text-align: center;
  top: 200px;
}

.main-content .multi-content {
  font-size: 0;
  max-width: 1200px;
  margin: 90px 16px;
  background: #fff;
  border: 1px solid #eee
  position: relative;

  &:before {
    z-index: 1;
    content: '';
    border-left: 1px solid #eaeff0;
    height: 100%;
    top: 0;
    position: absolute;
    left: 50%;
    @media (max-width: 1000px) {
      content: none;
    }
  }

  // Empty content exists only for standalone views
  .empty-content {
    position: relative;
  }
  .empty-content:before, .content-sm:only-of-type:before {
    position: absolute;
    width: 100%;
    text-align: center;
    top: 200px;
    content: 'Click on an invoice to view its details here.'
  }

  .content-sm {
    position: relative;
    display: inline-block;
    vertical-align: top;
    font-size: 14px;
    width: 50%;
    @media (max-width: 1000px) {
      width: 100%
    }
    &:only-of-type:before {
      left: 100%;
    }
  }
}

// React Modal Style Overrides

body.ReactModal__Body--open {
  overflow: hidden;
}

.ReactModal__Content h4 {
  margin: 0;
}

.ReactModal__Content {
  transition: transform 300ms ease-in-out;
  transform: translateY(-15%);

  &--after-open {
    transform: translateY(0);
  }
  &--before-close {
    transform: translateY(-15%);
  }
}

.ReactModalPortal > * {
  // When the modal is closed, overlay div has no css class
  // This selector should be overridden by the `&--after-open` class below
  opacity: 0;
}

.ReactModal__Overlay {
  transition: opacity 250ms ease-in-out;
  opacity: 0;

  &--after-open {
    opacity: 1;
  }
  &--before-close {
    opacity: 0;
  }
}

.Modal .modal-body > .alert-dismissable {
  margin-left: -24px;
  margin-right: -24px;
}

.Modal {
  .form-group > label {
    font-weight: bold;
  }
}


// react-dates style overrides

.SingleDatePicker {
  display: block;
}

.SingleDatePicker_picker {
  margin-top: -25px;

  .CalendarDay__blocked_calendar {
    background-color: rgba(0, 0, 0, 0.05);
    border-color: #E4E7E7;
  }

  .CalendarMonth_caption {
    margin-bottom: 10px;
  }

  .CalendarDay__selected {
    border-color: $primary-color;
    background-color: $primary-color;
  }
}

.SingleDatePickerInput {
  border-color: #cfdadd;
  width: 100%;

  .DateInput {
    height: 32px;
  }

  .DateInput_fang {
    margin-top: -25px;
  }

  .DateInput_input__focused {
    border-bottom: 0;
  }

  .DateInput_input__disabled {
    font-style: normal;
  }

  .DateInput_input {
    border-bottom: 0;
    font-weight: 400;
    color: #757575;
    font-size: inherit;
    padding: 1px;
    padding-left: 8px;
    height: 100%;
  }
}

.SingleDatePicker__tether--show {
  top: -11px !important;
}

.SingleDatePicker__picker,
.DateRangePicker__picker {
  top: 45px;
}

.transfers-onhold-datepicker {

  .SingleDatePicker {

    .DateInput--with-caret:before, .DateInput--with-caret:after {
      border: 10px solid transparent;
      z-index: 3;
    }

    .DateInput--with-caret:before {
      top: -12px;
      border-top-color: rgba(0, 0, 0, 0.1);
      border-bottom: 0;
    }

    .DateInput--with-caret:after {
      top: -13px;
      border-top-color: #fff;
      border-bottom: 0;
    }
  }

  .SingleDatePicker__picker {
    top: auto;
    bottom: 46px;
    z-index: 2;
  }
}
.SingleDatePicker__picker.SingleDatePicker__picker--open-up {
  top: auto;
  bottom: 58px;
  z-index: 2;
}

.DateInput--open-up.DateInput--with-caret::after {
  z-index: 3;
}

.DateInput__input {
  cursor: pointer;
}

.DateInput {
  font-weight: inherit;
  font-size: 14px;
  padding: 0;
}

.DateInput--disabled {
  background-color: #eee;
}

.DateInput__display-text {
  color: #aaa;
  font-size: 14px;
}

.SingleDatePickerInput__clear-date {
  margin: 0;
  padding: 0 8px;
  svg {
    fill: #ccc;
  }
}

.SingleDatePickerInput__clear-date--hover,
.SingleDatePickerInput__clear-date:focus {
  background-color: transparent;
  border-radius: 0;
  svg {
    fill: #666;
  }
}

.DateInput__display-text--disabled {
  font-style: normal;
}

.DateInput__display-text--focused {
  background-color: #fff;
  border-color: inherit;
  color: inherit;
}

.DateInput__display-text--has-input {
  color: #555;
}

.DateInput--with-caret::before {
  top: 34px;
}

.DateInput--with-caret::after {
  top: 35px;
}

.CalendarDay--after-hovered-start,
.CalendarDay--hovered-span,
.CalendarDay--selected-span {
  background-color: rgba(82, 143, 240, 0.2);
  border-color: #e4e4e4;
  color: #706E77;
}

.CalendarDay--selected-span.CalendarDay--hovered,
.CalendarDay--selected-span:active {
  background-color: #d2cdf0;
  border-color: #CBCCE0;
}

.CalendarDay--selected,
.CalendarDay--selected-end,
.CalendarDay--selected-start,
.CalendarDay--selected-end:active,
.CalendarDay--selected-start:active,
.CalendarDay--selected:active {
  background-color: $primary-color;
  border-color: $primary-color;
  color: #fff;
}

.DateRangePicker__picker--valid-date-hovered .CalendarMonth__day--selected-start,
.DateRangePicker__picker--valid-date-hovered .CalendarMonth__day--selected-end,
.CalendarMonth__day--selected-start,
.CalendarMonth__day--selected-end,
.CalendarMonth__day--selected {
  background-color: #23b7e5;
  border-color: #23b7e5;
}

.tether-element {
  z-index: 1;
}

// Add class `ps-in-modal` to all PowerSelect elems that would be within a modal.
.super-impose,
.ps-in-modal__Tether,
.ps-in-modal__Menu {
  z-index: 100000;
}


// End of third party style overrides

.page-spinner-container {
  display: flex;
  height: 350px;

  .spinner {
    margin: auto;
  }
}

.modal-body .page-spinner-container {
  height: 150px;
}

.quick-create {
  padding: 2px 5px;
  background-color: rgba(195, 195, 195, 0.23);
  color: $primary-color;
  cursor: pointer;
  font-size: 12px;
}

.row-action > .btn-group,
.row-action.btn-group {
  visibility: hidden;
}

tr:hover .row-action > .btn-group,
tr:hover .row-action.btn-group {
  visibility: visible;
}

.panel-detail-container {
  .text-warning {
    color: #d8b617;
  }
}

.pair-group-item {
  width: 100%;
  padding: 8px;
  margin-bottom: -1px;
  position: relative;

  &:not(.description) {
    clearfix()
  }

  &.description {
    white-space: 'pre-wrap';
    word-wrap: 'break-word';
    overflow: auto;
  }

  .pair-label, .pair-value, .pair-separator {
    vertical-align: top;
    float: left;
  }

  .pair-label {
    width: 39%;
    color: #8991AE;
    padding: 0; // to override col- padding
  }

  .custom-item {
    width: 100%;

    .group-items {
      line-height: 20px;
      font-size: 12px;

      button, div {
        margin-top: 8px;
      }
    }
  }

  .pair-value {
    position: relative
    width: 60%;
    padding-left: 8px;

    > span {
      vertical-align: top;
    }

    > div {
      line-height: 20px;
    }

    // check icon looks mis-aligned without negative margin
    > .i {
      margin-left: -3px;
    }

    a .i {
      margin-left: 8px;
      vertical-align: middle;
      font-size: 100%;
    }

    textarea {
      resize: vertical;
    }

    .full-width-item {
      width: 168%;
      margin-left: -68%;
    }

    // For nested values
    .table-responsive {
      margin-top: 8px;

      .pair-list-item {

        margin-bottom: 8px;

        .item-label {
          font-weight: bold;
          margin: 0;
          text-transform: capitalize;
        }

        .item-label, .item-value {
          line-height: 24px;
        }
      }
    }
  }
}

.primary-link {
  color: $primary-color;
  background-color: transparent;
  border: none;
  padding: 0;
  word-break: break-word;
  display: inline-block;
}

.list-table {
  padding: 8px;
  margin-top: 8px;
  padding-top: 24px;
  border-top: 1px solid #e2e8ea;

  .list-label {
    color: #58666e;
  }
}

.details-row-container {
  .list-group-item {
    > span:first-child {
      margin-right: 20px;
    }

    .table > tbody > tr > td.empty-table {
      padding: 20px;
      border-top: 0;
    }

    &:not(.no-flex) {
      display: flex;
      justify-content: space-between;
    }

    .list-group, .table {
      margin-bottom: 0;
      border-bottom: 0;
    }
  }
}

.form-horizontal .control-label.label-required::after {
  right: 7px;
  top: 7px;
}

.btn-group > .tooltip-wrapper {
  display: inline-block;
}

.txn-details {
  > .panel {
    border: none;

    > .panel-heading {
      background-color: #fff;
      line-height: 74px;
      vertical-align: middle;
      padding-top: 0;
      padding-bottom: 0;
      font-size: 18px;

      .btn-toolbar {
        padding-top: 26px;
      }

      > .i {
        padding: 4px 4px 0;
      }

      .i + strong {
        margin-left: 8px;
      }

      > .close {
        display: none;
      }
    }
  }
}

.ModalSlider__Content {
  .panel > .panel-heading > .close {
    display: block;
  }
}

.panel-heading > .btn-toolbar {
  margin-top: -5px;
}

.SwitchMerchantDropdown {
  .PowerSelect {
    border: 0;
    width: 145px;
  }

  .PowerSelect__Trigger {
    height: auto
    padding: 8px;
  }

  .PowerSelect__TriggerStatus {
    padding-left: 0;
    &::before {
      border-top-color: #777;
    }
  }

  .PowerSelect__TriggerLabel {
    padding-right: 8px;
  }

  .PowerSelect__Placeholder {
    color: #777;
  }
}

.SwitchMerchantDropdown__option {
  padding: 6px 12px;
  display: inline-block;
  color: #777;

  .i-check {
    margin-top: 2px;
    margin-left: 5px;
  }
}

.detail-row {
  margin-bottom: 12px;
  padding-left: 5px;

  > label {
    font-weight: normal;
    color: #999;

    &::after {
      content: ':';
      position: absolute;
      right: 0;
      color: #ccc;
    }
  }
}

.ProfileDropdown {
  min-width: 300px;
  padding: 0;
  line-height: 1.8;

  .merchant-details-container {

    .rzp-group {

      width: 100%;

      .rzp-group-item {

        width: auto;
        padding: 0;
        border: none;

        &:last-child {

          text-align: right;
        }
      }
    }
  }

  .media {
    margin-top: 0;
    padding: 12px;

    + .media {
      border-top: 1px solid #eee;
    }
  }

  .media-left {
    vertical-align: middle;
  }

  .media-action {
    cursor: pointer;

    &:hover {
      background-color: #F7F8FA;
    }
  }

  .media-object {
    width: 40px;
    text-align: center;
  }

  .merchantname {
    font-size: 16px;
    font-weight: bold;
  }

  .i-business,
  .i-account {
    font-size: 40px;
    color: #dadada;
  }

  .i-help,
  .i-tour,
  .i-undo {
    font-size: 20px;
  }
}

ul.switch-modes-menu.nav.nav-stacked {

  padding: 0;

  > li {

    margin: 0;

    > a {

      border-top: 1px solid #eee;

      &.selected {
        background-color: #eee;
      }
    }

    &:first-child {

      > a {

        border-top: none;
      }
    }
  }
}

.pre {
  white-space: pre;
}

.notes {
  .note {
    position: relative;
    margin-bottom: 12px;

    .i-close {
      position: absolute;
      right: -31px;
      top: 1px;
      padding: 8px;
      cursor: pointer;
      color: #ccc;

      &:hover {
        color: #aaa;
      }
    }

    .key {
      margin-bottom: 4px;
    }
  }

  .add-note {
    padding-left: 0;
  }
}

.SliderPanel__Body {
  .note {
    .i-close {
      right: -3px;
    }
    .key{
      padding-right: 32px;
    }
  }

  label {
    font-weight: normal;
    line-height: 29px;
  }

  .btn-toolbar {
    padding: 8px;
    margin-left: 0;
    margin-right: 0;

    .btn {
      padding: 8px 12px;
    }
  }

  /* banner has bottom margin by default */
  .rzp-banner {
    margin-bottom: 0;
    border-color: #eaeff0;
    border-top-width: 0;
  }

  .rzp-definition {
    color: inherit;

    dd {
      color: #7B8199;
    }

    .LoaderDots > span {
      font-size: inherit;
    }
  }
}

.btn-toolbar {
  > .btn-half {
    width: 48%;
    margin-left: 0;
  }

  > .btn-half + .btn {
    margin-left: 4%;
  }
}

.ReactModal__Overlay .rzp-banner {
  border-width: 0;
  border-bottom-width: 1px;
}

.ReactModal__Overlay .pair-group-item .pair-value .full-width-item {
  width: 170%;
  margin-left: -70%;
}

.secondary-details {
  margin-top: 10px;
  border-left: 2px solid rgb(234, 239, 240);

  .table-responsive {
    max-width: 475px;
    border-left: 4px solid #e9eff0;
    border-right: 1px solid #e9eff0;
  }

  .table {
    margin: 0;
  }

  > .detail-row > label {
    margin-left: -15px;
    padding-left: 30px;
  }
}

.info-tooltip {
  font-size: 13px;
  color: #ccc;
  margin-left: 4px;
}

.empty-table-message, .table > tbody > tr > td.empty-table {
  padding: 75px 50px;
  text-align: center;

  &:hover {
    background: #fff;
  }
}

.text-fade {
  color: #919aa7;
  font-size: 12px;
}

.InfoCard__value .text-fade{
  font-size: 20px;
}

.label {
  &--primary {
    color: #58666E;
  }

  &--secondary {
    color: $secondary-color;
    font-size: 85%;

    i {
      margin-right: 2px;
    }
  }
}

// TODO: Remove txn-details class everywhere and make it generic
.txn-details-title {
  display: inline-block;
  vertical-align: middle;
  line-height: 21px;
  margin-left: 16px;

  &--primary {
    font-weight 600;
    font-size: 14px;
    color: #7B8199;
  }

  &--secondary {
    color: #58666E;
    font-size: 70%;
  }
}

.full-width {
  width: 100%;
  margin-top: 16px;
}

.transfers-onhold-datepicker div.DateInput {
  width: 100%;
}

form[name="createPaymentTransfer"], form[name="updatePaymentTransfer"] {
  div.RadioButton:first-child {
    margin-top: 0;
  }

  div.RadioButton .RadioButton__button {
    cursor: pointer;
  }

  .CalendarMonth__caption {
    margin-bottom: 10px;
  }

  .CalendarDay--blocked-calendar {
    background-color: rgba(0,0,0,0.05);
    cursor: not-allowed;
  }
}

form[name="updatePaymentTransfer"] {
  div.btn-toolbar {
    padding-left: 0;
  }
}

span.transfer-scheduled-text.text-warning,
span.transfer-scheduled-text.text-warning span.label--primary {
  color: #F5A623;
}

.light-placeholder {
  color: $light-grey;
}

.input-number-no-arrows
  &::-webkit-inner-spin-button,
  &::-webkit-outer-spin-button
    -webkit-appearance: none;
    -moz-appearance: none;
    appearance: none;
    margin: 0;

.PowerSelect--focused,
.PowerSelect__SearchInput:focus
  border-color: $primary-color;

// Temporary fix for invisible triggers until react-power-select library is updated
.PowerSelect__TriggerLabel
  overflow: hidden;
  max-width: 0px;
