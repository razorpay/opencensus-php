@import "./vars";

.form-control,
.form-control:focus {
  box-shadow: none;
}

.table {
  border-bottom: 1px solid #EAEFF0;
}

.table-noborder {
  border-color: transparent;

  > tbody > tr > td {
    border-color: transparent;
    vertical-align: middle;
  }
}

.table > thead > tr > th {
  background-color: #EAEFF0;
  border-bottom: 1px solid #DDD;
}

.table > thead:first-child > tr:first-child > th {
  border-top: 1px solid #DDD;
}

a {
  cursor: pointer;
}

a:hover,
a:focus,
a.active {
  text-decoration: none;
}

code {
  color: inherit;
  background-color: inherit;
  font-size: inherit;
  padding-left: 0;
}

.progress,
.progress-bar {
  box-shadow: none;
}

.progress-xs {
  height: 6px;
}

.text-info {
  color: #23B7E5;
}

.text-warm {
  color: #F19A5E;
}

.text-notice {
  color: #DF8700;
}

.text-faded {
  color: #99A6AD
}

.text-glow {
  color: #FBE165
}

.text-tertiary {
  color: #29E2AD;
}

.text-primary {
  color: $primary-color;
}

.text-main {
  color: $primary-color;
}

.text-danger {
  color: $textDangerColor;
}

.text-success {
  color: $brand-success;
}

.bg-success {
  background-color: $brand-success;
}

.bg-info {
  color: #FFF;
  background-color: #23B7E5;
}

.bg-primary {
  color: #FFF;
  background-color: $btn-primary-bg;
}

.bg-light {
  color: #58666E;
  background-color: #EDF1F2;
}

.bg-danger {
  color: #FFF;
  background-color: #F05050;
}

.font-lg {
  font-size: 16px
}

.font-sm {
  font-size: 13px;
}

.font-xs {
  font-size: 12px;
}

.btn-lg {
  font-size: 15px;
}

.btn-transparent {
  background-color: transparent;
}

.btn-default:hover,
.btn-default:focus {
  background-color: #F2F2F2;
}

.panel {
  box-shadow: none;
}

.panel-heading-sm {
  padding: 8px;
}

.modal-header .close {
  margin: 3px;

  .icon-close {
    font-weight: bold;
  }
}

.form-control[type="number"] {
  padding-right: 0;
}

.label-muted {
  background-color: #999;
}

.label-semi-muted {
  color: #58666E;
  background-color: #D8E1E3;
}

.label-danger {
  background-color: #F05150;
}

.label-pending {
  background-color: #E8B248;
}

.label-yellow {
  background-color: #FAD733;
}

.label-partial-process
  background-color: #A5FBD8;
  color: #59666E;

// Labels (Badges/Pills) Based on New Design System
.label-light-positive {
  color: #1F890E;
  background-color: #1F890E1A;
}

.label-light-negative {
  color: #D12D2D;
  background-color: #D12D2D1A;
}

.label-light-information {
  color: #162F56DE;
  background-color: #162F561A;
}

.label-light-warning {
  color: #CD8214;
  background-color: #CD82141A;
}

.label-light-neutral {
  color: #2A8CFF;
  background-color: #0B70E71A;
}

.checkbox label.i-switch {
  padding-left: 0;
}

.nav-tabs > li,
.nav-tabs > li.active {
  > a.text-success {
    color: #23AD44;
  }

  > a.text-danger {
    color: $textDangerColor;
  }
}

.dropdown-menu {
  margin-top: 0;
  border-radius: 0;
}

.dropdown {
  clearfix()
}

@media screen and (max-width 767px) {
  .table-responsive {
    border-color: transparent;
  }
}

.btn-sm,
.btn-group-sm > .btn {
  border-radius: 2px;
}
