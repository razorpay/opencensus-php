$secondary-color-disabled = #6F7691;

// Bootstrap variable overrides

$font-family-base = "Inter", "Inter Fallback Arial", "Lato", "Lato-Regular", "Helvetica Neue", helvetica, arial,sans-serif;
$font-family-monospace =  menlo, monaco, consolas, "Ubuntu Mono", monospace;
$text-color = #58666E;
$line-height-base = 1.42857143;
$brand-success = #27C24C;

$border-radius-base = 2px;
$btn-default-color = $text-color;
$btn-default-bg = #FAFAFA;
$btn-primary-bg = $primary-color;
$btn-default-border = #DEE5E7;
$btn-border-radius-base = 2px;
$btn-border-radius-large = 4px;

$input-border-radius = 2px;
