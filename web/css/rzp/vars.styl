// rzp variables
$textDangerColor = #F05050;
$baseBorderColor = #EAEFF0;

// Theme color
$prime = #528FF0 // TODO: merchant uses $primary-color and admin uses $prime. This is temporary and both has to be made same. (Added to common use spinner.styl)
$primary-color = #528FF0;
$secondary-color = #7B8199;
$heading-primary = #0D2366
$p-primary = #515978
$sidebar-bg-color = #2E3345
$sidebar-active-color = #252939

$primary-color-hover = #2371EC;
$primary-color-active = #528FF0;

$secondary-color-hover = #497FD6;
