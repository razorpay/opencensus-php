.custom-breadcrumb > li + li {
  padding-left: 16px;
  position: relative;
  line-height: 24px;

  &::before {
    content: "";
    display: block;
    height: 24px;
    border-left: 1px solid rgb(0 0 0 / 0.54);
    position: absolute;
    left: 0;
    bottom: -2px;
    transform: rotate(24deg);
  }
}

.rzpCheckbox {
  margin-bottom: 8px;

  [type="checkbox"] {
    position: absolute;
    left: -9999px;

    + label {
      position: relative;
      padding-left: 25px;
      cursor: pointer;

      &::before {
        content: "";
        width: 16px;
        height: 16px;
        border: 1px solid #E0E0E0;
        border-radius: 2px;
        background-color: #FFF;
        display: inline-block;
        position: absolute;
        left: 0;
      }

      &::after {
        content: "";
        display: block;
        width: 6px;
        height: 11px;
        opacity: 1;
        transition: 0.2s;
        border: solid #FFF;
        border-width: 0 2px 2px 0;
        transform: rotate(45deg) scale(1.5);
        margin: -19px 0 0 -20px;
      }
    }
  }

  // Customer css for submit-form as label can have text as well
  &.submit-form {
    [type="checkbox"] {
      + label {
        padding-left: 30px;
        user-select: none;

        &::before {
          top: 3px;
        }

        &::after {
          top: 4px;
        }
      }
    }
  }

  [type="checkbox"]:not(:checked) + label::after {
    opacity: 0;
  }

  [type="checkbox"]:checked + label::before {
    background: $primary-color;
    border-color: $primary-color;
  }

  [type="checkbox"]:checked + label::after {
    opacity: 1;
    transform: rotate(45deg);
  }

  [type="checkbox"]:disabled + label {
    cursor: not-allowed;
    opacity: 0.5;
  }

  // New custom checkbox style, replace it with above when needed across dashboard.
  &.next {
    label {
      span {
        margin-left: 4px;
      }
    }
  }
}

.note {
  .rzpCheckbox [type="checkbox"] + label::after {
    margin: -17px 0 0 -20px;
  }
}

