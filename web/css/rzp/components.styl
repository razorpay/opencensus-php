@import './animations';

// i-switch checkbox
.i-switch {
  position: relative;
  display: inline-block;
  width: 35px;
  height: 20px;
  margin: 0;
  cursor: pointer;
  background-color: #27c24c;
  border-radius: 30px;
}

.i-switch input {
  position: absolute;
  opacity: 0;
}

.i-switch input:checked + i:before {
  top: 50%;
  right: 5px;
  bottom: 50%;
  left: 50%;
  border-width: 0;
  border-radius: 5px;
}

.i-switch input:checked + i:after {
  margin-left: 16px;
}

.i-switch i:before {
  position: absolute;
  top: -1px;
  right: -1px;
  bottom: -1px;
  left: -1px;
  background-color: #fff;
  border: 1px solid #f0f0f0;
  border-radius: 30px;
  content: '';
  -webkit-transition: all 0.2s;
  transition: all 0.2s;
}

.i-switch i:after {
  position: absolute;
  top: 1px;
  bottom: 1px;
  width: 18px;
  background-color: #fff;
  border-radius: 50%;
  content: '';
  -webkit-box-shadow: 1px 1px 3px rgba(0, 0, 0, 0.25);
  box-shadow: 1px 1px 3px rgba(0, 0, 0, 0.25);
  -webkit-transition: margin-left 0.3s;
  transition: margin-left 0.3s;
}

// Tooltip
[data-tip] {
  position: relative;

  &[data-place=bottom] {
    &:before, &:after {
      bottom: auto;
      top: 100%;
      transform: translateX(-50%) translateY(-6px) scale(0.92);
      border-bottom-color: #222;
      border-top-color: transparent;
    }
  }

  &[data-place=right] {
    &:after {
      left: auto;
      right: 0;
      transform: translateY(6px) scale(0.92);
    }
  }

  &[data-place=left] {
    &:after {
      left: 0;
      transform: translateY(6px) scale(0.92);
    }
  }

  &:before, &:after {
    opacity: 0;
    transform: translateX(-50%) translateY(6px) scale(0.92);
    left: 50%;
    bottom: 100%;
    position: absolute;
    pointer-events: none;
    z-index: 1000;
    transition: 0.17s, 0.3s transform;
  }

  &:before {
    content: '';
    border: 7px solid transparent;
    border-top-color: #222;
    margin: -7px 0 -7px;
  }

  &:after {
    margin: 6px 0 6px;
    content: attr(data-tip);
    padding: 4px 12px;
    background: #222;
    border-radius: 3px;
    color: #fff;
    font-weight: normal;
    font-size: 14px;
    line-height: 20px;
    white-space: nowrap;
  }

  &:not([data-event]):hover, &[data-event=active]:active {
    &:before, &:after {
      opacity: 1;
      transform: translateX(-50%);
    }

    &[data-place=right], &[data-place=left] {
      &:after {
        transform: none;
      }
    }
  }

  &[data-event=active] {
    &:active {
      &:after, &:before {
        transition: 0s;
      }
    }

    &:after, &:before {
      transition-delay: 2s;
    }
  }
}

// Small Alert
