  @media (max-width 1024px)
    height: 100%
    max-height: 70vh
    display: block
    padding-top: 62px

  > div
    width: 50%

    @media (max-width 1024px)
      width: 100%

  .info
    display: flex
    justify-content: flex-end
    align-items: center

    @media (max-width 1024px)
      justify-content: center

      > div
        text-align: center

      .divider
        margin: 24px auto

  .heading
    font-weight: bold
    font-size: 24px
    line-height: 32px
    color: #3969CD

  .divider
    width: 24px
    height: 4px
    background: #E74B3C
    margin: 24px 0

  .desc
    font-weight: 600
    font-size: 18px
    line-height: 24px
    color: #2E3345
    max-width: 466px

  .error-img
    padding: 32px 0
    height: 100%
    display: flex
    align-items: center

    @media (max-width 768px)
      justify-content: center

    img
      max-height: 532px
      height: auto
      max-width: 100%
