// Component: merchant/components/File/Upload.js
.Dropzone {
  width: 100%;

  p {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin: 0;
  }

  .upload-file-heading {
    white-space: normal;
  }

  .m-t {
    margin-top: 8px;
  }

  .Dropzone-cavity {
    position: relative;
    display: block;
    width: 100%;
    border-radius: 2px;
    border: 1px dashed $primary-color;
    font-weight: unset;
    background: rgba(82 143 240 0.02);
    cursor: pointer;

    &--highlight,
    &:not(.Dropzone-cavity--staged):hover {
      background: #FFF;
      box-shadow: 2px 2px 6px rgb(0 0 0 / 0.12);
    }

    &--staged {
      border: 1px solid #DBDBDB;
      background: #FFF;
      border-radius: 2px;
    }

    &--error {
      background-color: #FFF2F2;
      border-color: #FF6363;
    }

    &--disabled {
      cursor: not-allowed;
      background-color: #F8F8F8;
    }
  }

  .Dropzone-content {
    vertical-align: middle;
    font-size: 16px;
    pointer-events: none;

    .Dropzone-file-icon + .Dropzone-content-desc {
      padding-left: 4%; // To adjust with icon on left
    }

    &-desc {
      display: inline-block;
      width: 88%;
      vertical-align: middle;
    }

    &-desc--secondary {
      font-size: 14px;
    }

    input[type="file"] {
      display: none;
    }

    .Dropzone-file-icon {
      display: inline-block;
      width: 12%;
      max-width: 28px;
    }

    i.pre-uploaded {
      color: #49A46F;
      vertical-align: sub;
      font-size: 16px;
      padding-right: 8px;
    }

    &.small {
      margin: 4%;
    }

    &.large {
      margin: 3%;
    }
  }
}

