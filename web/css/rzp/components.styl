// Component: Infinite Loader Bar
.bar-loader {
  height: 4px;
  width: 100%;
  position: relative;
  overflow: hidden;
  background-color: #DDD;
  margin: 10px 0;
  border-radius: 2px;

  &.pending {
    &::before {
      display: block;
      position: absolute;
      content: "";
      left: -200px;
      width: 200px;
      height: 4px;
      background-color: $primary-color;
      animation: bar-loading 2s linear infinite;
    }
  }
}

@keyframes bar-loading {
  from {
    left: -200px;
    width: 30%;
  }

  50% {
    width: 30%;
  }

  70% {
    width: 70%;
  }

  80% {
    left: 50%;
  }

  95% {
    left: 120%;
  }

  to {
    left: 100%;
  }
}

// End Component: Infinite Loader Bar
// Component: Infinite Loader Circle
.spin-loader {
  display: inline-block;
  margin: 0 5px;
  height: 20px;
  width: 20px;
  animation: spin-loading 0.8s infinite linear;
  border: 2px solid $primary-color;
  border-right-color: transparent;
  border-radius: 50%;
  vertical-align: middle;
}

@keyframes spin-loading {
  0% {
    transform: rotate(0deg);
  }

  100% {
    transform: rotate(360deg);
  }
}

// Component: common/ui//Accordion
.Accordion {
  .Accordion__item {
    margin-top: 16px;

    .Accordion__content {
      padding: 16px 8px 0;
      display: none;
    }

    .Accordion__title {
      background: #F6F6F6;
      padding: 10px;
      cursor: pointer;
      position: relative;
      font-weight: bold;

      &:hover {
        background: #EFEFEF;
      }

      .accordion__arrow {
        display: inline-block;
        position: absolute;
        width: 24px;
        height: 12px;
        top: 50%;
        right: 5px;
        margin-top: -7px;

        &::after,
        &::before {
          display: block;
          position: absolute;
          top: 50%;
          width: 10px;
          height: 2px;
          background-color: #58666E;
          content: "";
          transition: transform 0.25s ease;
        }

        &::before {
          left: 4px;
          transform: rotate(45deg);
        }

        &::after {
          right: 4px;
          transform: rotate(-45deg);
        }
      }
    }

    &.danger .Accordion__title {
      border: 1px solid #F35D5D;
      background: lighten(#F35D5D, 90%);

      .accordion__arrow {
        &::after,
        &::before {
          background-color: #F35D5D;
        }
      }
    }

    &.primary .Accordion__title {
      border: 1px solid $primary-color;
      background: lighten($primary-color, 90%);

      .accordion__arrow {
        &::after,
        &::before {
          background-color: $primary-color;
        }
      }
    }

    &.open {
      .Accordion__title > .accordion__arrow::before {
        transform: rotate(-45deg);
      }

      .Accordion__title > .accordion__arrow::after {
        transform: rotate(45deg);
      }

      .Accordion__content {
        display: block;
        animation: fadein 0.25s ease-in;
      }
    }
  }
}

