/* Component: merchant/components/File/Upload.js */
.Dropzone {
  width: 100%;

  p {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin: 0;
  }

  .upload-file-heading {
    white-space: normal;
  }

  .m-t {
    margin-top: 8px;
  }

  .Dropzone-cavity {
    position: relative;
    display: block;
    width: 100%;
    border-radius: 2px;
    border: 1px dashed $primary-color;
    font-weight: unset;
    background: rgba(82, 143, 240, 0.02);
    cursor: pointer;

    &--highlight, &:not(.Dropzone-cavity--staged):hover {
      background: #fff;
      box-shadow: 2px 2px 6px rgba(0, 0, 0, 0.12);
    }

    &--staged {
      border: 1px solid #DBDBDB;
      background: #fff;
      border-radius: 2px;
    }

    &--error {
      background-color: #FFF2F2;
      border-color: #FF6363;
    }

    &--disabled {
      cursor: not-allowed;
      background-color: #f8f8f8;
    }
  }

  .Dropzone-content {
    vertical-align: middle;
    font-size: 16px;
    pointer-events: none;

    .Dropzone-file-icon + .Dropzone-content-desc {
      padding-left: 4%; // To adjust with icon on left
    }

    &-desc {
      display: inline-block;
      width: 88%;
      vertical-align: middle;
    }

    &-desc--secondary {
      font-size: 14px;
    }

    input[type=file] {
      display: none;
    }

    .Dropzone-file-icon {
      display: inline-block;
      width: 12%;
      max-width: 28px;
    }

    i.pre-uploaded {
      color: #49A46F;
      vertical-align: sub;
      font-size: 16px;
      padding-right: 8px;
    }

    &.small {
      margin: 4%;
    }

    &.large {
      margin: 3%;
    }
  }
}

/* End Component: merchant/components/File/Upload.js */
/* Component: merchant/components/File/Staged */
.Dropzone-cavity--staged {
  .Dropzone-content {
    padding-right: 28px;
    pointer-events: auto;
  }

  .text-success {
    color: #00C452;
    position: relative;

    i {
      margin-right: 4px;
    }
  }

  .Dropzone-close {
    position: absolute;
    transform: translateY(-50%);
    top: 50%;
    right: 8px;
    margin-top: 2px;
    cursor: pointer;
  }

  .Loader {
    height: 3px;
    width: 100%;
    position: absolute;
    background-color: #ddd;
    overflow: hidden;
    visibility: hidden;
    margin-top: -3px;
    bottom: -1px;
    left: -1px;

    .Loader-progress {
      position: absolute;
      display: block;
      width: 100%;
      height: 4px;
      background-color: #00C452;
      transform: translateX(-100%);
      transition: all 0.2s cubic-bezier(0.07, 1.09, 1, 1);
      will-change: transform;
    }
  }

  &.Dropzone-cavity--process .Loader {
    visibility: visible;
    margin-top: 0;
  }
}

/* End Component: merchant/components/File/Staged */
