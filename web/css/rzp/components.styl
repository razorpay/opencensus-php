// Component: merchant/components/File/Staged
.Dropzone-cavity--staged {
  .Dropzone-content {
    padding-right: 28px;
    pointer-events: auto;
  }

  .text-success {
    color: #00C452;
    position: relative;

    i {
      margin-right: 4px;
    }
  }

  .Dropzone-close {
    position: absolute;
    transform: translateY(-50%);
    top: 50%;
    right: 8px;
    margin-top: 2px;
    cursor: pointer;
  }

  .Loader {
    height: 3px;
    width: 100%;
    position: absolute;
    background-color: #DDD;
    overflow: hidden;
    visibility: hidden;
    margin-top: -3px;
    bottom: -1px;
    left: -1px;

    .Loader-progress {
      position: absolute;
      display: block;
      width: 100%;
      height: 4px;
      background-color: #00C452;
      transform: translateX(-100%);
      transition: all 0.2s cubic-bezier(0.07, 1.09, 1, 1);
      will-change: transform;
    }
  }

  &.Dropzone-cavity--process .Loader {
    visibility: visible;
    margin-top: 0;
  }
}

