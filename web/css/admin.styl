html
  height: 100%
body
  height: 100%
  margin: 0
  > #react-root
    height: 100%

#app-container
  height: 100%
  $side-width = 200px
  > aside
    background: #3A3F51
    position: fixed
    left: 0
    width: $side-width
    height: 100%
    top: 0
  > header
    position: fixed
    top: 0
    left: $side-width
    right: 0
    top: 0
    height: 48px
    line-height: @height
    box-shadow: 0 2px 2px rgba(0, 0, 0, 0.05), 0 1px 0 rgba(0, 0, 0, 0.05)
    background: #fff
  > main
    background: #F0F3F4
    min-height: 100%

#fixed-container
  position: fixed