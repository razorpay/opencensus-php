@import 'react-day-picker/lib/style.css'
@import 'ui/vars'
@import 'ui/_'
@import 'ui/admin/*'
@import 'icons.css';

.pricing-container .table-container
  select
    width: 100px
  input
    width: 75px

#profile-icon
  min-width: 130px
  float: right
  cursor: pointer
  padding: 0 20px
  position: relative
  > i
    font-size: 70%
    margin-left: 8px
  .menu
    display: none
    position: absolute
    background: #fff
    box-shadow: 0 1px 2px rgba(0,0,0,.1)
    top: 100%
    right: 0
    width: 100%
    min-width: 120px
    i
      font-size: 80%
      color: #555
      position: relative
      top: -1px
      left: -2px
      margin-right: 6px
  a, .logout-btn
    display: block
    border-top: 1px solid #eee
    padding: 0 20px
    color: #555
    &:hover
      color: #000
  &:hover
    background: #eee
    .menu
      display: block
