/* Styles for Merchant module */


// Put in components class with new file
.btn-primary
  background-color:#7266ba
  color: #fff
  text-align: center

.entity-container.merchant
  display: flex;
  width 65%
  min-width: 800px
  margin: 30px auto

  main, aside
    display: flex
    flex-direction: column
    padding: 16px

    .heading
      background-color: #f6f8f8
      margin-bottom: 28px

    > div, > a
      border: 1px solid #edf1f2
      margin-bottom: -1px

  aside
    width: 35%
    max-width: 350px
    min-width: 200px

    border-right: 1px solid #edf1f2 // TODO: Take from theme variable file

    > div, > a
      padding: 12px
      cursor: pointer

      &:hover
        background-color: #f6f8f8

  main
    width: 70%
    border-left: 1px solid #edf1f2 // TODO: Take from theme variable file


// Other styles in merchant details
.heading
  padding: 12px
  border: 1px solid #edf1f2
  background-color: #f6f8f8
  margin-bottom: -1px
