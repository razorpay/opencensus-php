/* Styles for Merchant module */


// Put in components class with new file
.btn-primary
  background-color: #528ff0
  color: #fff
  text-align: center

.entity-container.merchant
  display: flex
  width 65%
  min-width: 800px
  margin: 30px auto

  main, aside
    display: flex
    flex-direction: column
    padding: 16px

    .heading
      background-color: #f6f8f8
      margin-bottom: 28px

  aside
    width: 35%
    max-width: 350px
    min-width: 200px

    border-right: 1px solid $faded-color // TODO: Take from theme variable file

    .group
      margin-bottom: 10px

      > div:not(.group-heading), > a
        position: relative
        display: block;
        border: 1px solid $faded-color
        margin-bottom: -1px
        padding: 12px
        cursor: pointer

        &:hover
          background-color: #f6f8f8

        i
          font-size: 14px

        .dot-loader
          top: auto
          left: auto
          bottom: 20px
          right: 30px
          transform: scale(0.7);
          opacity: 1

    .group-heading
        margin-top: 16px
        font-size: 11px
        font-weight: 600
        border-bottom: 2px solid #f3f3f3
        color: $color-semi-muted
        padding-left: 13px;
        text-transform: uppercase;
        letter-spacing: 0.5px;

  main
    width: 70%
    border-left: 1px solid $faded-color // TODO: Take from theme variable file

    > div, > a
      border: 1px solid $faded-color
      margin-bottom: -1px

// Other styles in merchant details
.heading
  padding: 12px
  border: 1px solid $faded-color
  background-color: #f6f8f8
  margin-bottom: -1px

// Edit features modal
.edit-features
  textarea
    width: 55%

  button
    margin-top: 30px


.custom-table
  display: inline-block;
  padding: 0;


.merchants-list .td
  max-width: 300px
  word-break: break-all

  span
    display: inline-block
    line-height: 14px


// Merchant stats
.merchant-stats
  .heading
    border-bottom: 2px solid #dadada
  .bold
    font-weight: 600

// view merchant banks
.merchant-banks-modal{
  min-width: 500px;
}

// merchant report config
.ReportConfig
  &--inline-fields
    display: flex
    margin-top: 5px
    flex-wrap: wrap

    label
      display: initial

    & > div
      width: 33%

  &--report-column
    display: flex
    margin-top: 10px

    .label
      flex: 1.5 0
      .reorder-icons
        margin-right: 5px
        cursor: pointer
        i:hover
          color: $prime
    .input
      flex: 1 0
    .filter
      &-op
        select
          width: 95%
      &-value
        input[type="text"]
          width: 95%
      &-op,
      &-value
        flex: 1 0
        &--type-in
          label
            display: initial
        &--type-between
          input[type="text"]
            width: 45%
            &:last-child
              margin-left: 5px

  .collapsible
    &--body
      overflow: hidden
      &.close
        height: 0
      &.open
        height: initial