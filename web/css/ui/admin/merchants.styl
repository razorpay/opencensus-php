/* Styles for Merchant module */


// Put in components class with new file
.btn-primary
  background-color:#7266ba
  color: #fff
  text-align: center

.entity-container.merchant
  display: flex
  width 65%
  min-width: 800px
  margin: 30px auto

  main, aside
    display: flex
    flex-direction: column
    padding: 16px

    .heading
      background-color: #f6f8f8
      margin-bottom: 28px

    > div, > a
      border: 1px solid $faded-color
      margin-bottom: -1px

  aside
    width: 35%
    max-width: 350px
    min-width: 200px

    border-right: 1px solid $faded-color // TODO: Take from theme variable file

    > div, > a
      padding: 12px
      cursor: pointer

      &:hover
        background-color: #f6f8f8

    i
      font-size: 14px

  main
    width: 70%
    border-left: 1px solid $faded-color // TODO: Take from theme variable file


// Other styles in merchant details
.heading
  padding: 12px
  border: 1px solid $faded-color
  background-color: #f6f8f8
  margin-bottom: -1px



// Download Reports Panel
.reports-modal
  width: 75%
  min-width: 720px

.reports-list-panel, .report-generate-panel
  display: inline-block
  vertical-align: top

  .title
    font-size: 12px
    color: #7f7f7f

.reports-list-panel
  width: 35%
  border-right: 1px solid #f1f1f1

  .title
    padding: 0 0 8px 24px

.reports-entity-options
  .field
    margin: auto
    width: 100%

  input[type=radio].report-type
    display: none

  input[type=radio].report-type + label
    width: 100%
    padding: 12px 24px
    margin: 0
    color: #555555
    font-size: 14px
    font-weight: 400
    cursor: pointer

  &:not(:last-child)
    input[type=radio].report-type + label
      border-bottom: 1px solid rgba(0,0,0,0.03)

  input[type=radio].report-type label:hover
    background-color: #f9f9f9

  input[type=radio].report-type:checked + label
    color: #6A55D1
    background-color: #f9f9f9

  input[type=radio].report-type:checked + label:after
    float: right
    content: "\25BA"
    color: #a5a5a5
    font-size: 10px;
    transform: scaleY(2);

.report-generate-panel
  width: 65%
  padding: 0 24px 8px

  .panel-header
    font-weight: 600
    border-bottom: 1px solid #e2e8ea
    padding-bottom: 6px
    margin-bottom: 24px
    font-size: 16px

  footer
    margin-top: 12px;
    color: $color-semi-muted

  .form-element
    margin-top: 20px

    .field, .btn
      margin: auto


