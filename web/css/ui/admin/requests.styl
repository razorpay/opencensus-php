.request-state
    float: right
    color: white
    padding: 2px 3px
    border-radius: 4px

    &.approved-state
        background-color: #fc9700

    &.executed-state
        background-color: #17C446

    &.closed-state
        background-color: #F14F4B

    &.rejected-state
        background-color: #F14F4B

    &.open-state
        background-color: #FCCB00

.comments-container
    .comment
        margin: 10px
        border: 1px solid #ebebeb

    .comment-body
        padding: 10px

.requests-content
    display: inline-block
    vertical-align: top
    width: 75%

    .comments-count
        padding: 10px
        color: #c3c3c3

    .levels-label
        margin: 10px

    .box-label
        background-color: #f6f8f8
        padding: 10px
        margin: 0
    .levels-container
        margin: 20px 0
    .level
        padding: 10px

        &.inactive
            opacity: 0.5

        span
            margin-left: 50px
            padding: 5px 10px
            border-radius: 4px

            &.level-box
                background-color: #ebebeb

.requests-actions
    display: inline-block
    vertical-align: top
    width: 15%
    margin: 20px 10px

    .header
        text-align: center
        margin-top: 5px

    .btn
        display: block
        text-align: center

    i
        padding: 4px
        border-radius: 50%
        color: #fff
        font-size: 8px
        line-height: 8px
        vertical-align: middle

    .request-checkers-list
      padding: 10px
      .checker-label
        margin-bottom: 10px
      .checker
        padding: 5px
        border-radius: 5px
        margin-top: 5px
        background-color: #ebebeb
        margin: 0 5px

.requests-header
    background-color: #f6f8f8
    border-bottom: 1px solid #dee5e7
