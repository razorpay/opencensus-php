.makeapicall
  form
    .field
      input, select, textarea
        margin-left: 0

      textarea
        width: 72%

    .url
      .base-url, input
        display: inline-block
        vertical-align: top

      .base-url
        padding: 4px 1px 4px 12px
        border-bottom-left-radius: 4px
        border-top-left-radius: 4px
        background-color: #f1f1f1
        border: 1px solid #dbdbdb;

      input
        width: 270px;
        border-bottom-left-radius: 0
        border-top-left-radius: 0
        border-left: 0
        padding-left: 4px

.bulk-verify-payments
  textarea
    width: 60%;

.bulk-response-modal
  min-width: 400px

form.sql-report-generator-form
  width: 600px
  .ant-calendar-picker-input
    margin-left: 10px
  .field .post-field-icon
    right: 35%
  textarea
    width: 50%;

.retry-bulk-refunds-action,
.process-bulk-refunds-action
  min-width: 500px;

.bulk-merchants-feature
  min-width: 400px
  .merchant-ids
    width: 50%