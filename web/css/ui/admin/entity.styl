.entity-page
  @media (min-width: 1180px)
    main
      right: 24px

    aside
      width: 220px
      position: fixed
      right: 0
      top: 80px
      text-align: center

      .header
        margin: 24px 10px 12px

      .btn
        min-width: 155px
  @media (max-width: 1179px)
    aside
      @extend .limited
      margin-bottom: 24px

      .header
        display: none



.assign-submerchants .td
  max-width: 250px
  word-break: break-word


.duplex-json
  white-space: normal
  word-break: break-all

.Modal-container--admin .edit-iin-modal
  .Modal-body
    padding: 0
  
  .form-fields
    padding: 24px;
    max-height: calc(90vh - 140px)
    overflow: auto

  .form-actions
    border-top: 2px solid #eee
    background: #f0f3f4
    padding: 5px 20px
    font-size: 20px
    text-align: right 