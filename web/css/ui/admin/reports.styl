// Download Reports Panel
.reports-modal
  width: 720px
  min-height: 360px
  .report-container
    padding: 10px
    margin: 0
    box-shadow: none
  .Modal-body
    margin: 24px 0

.reports-list-panel, .report-generate-panel
  display: inline-block
  vertical-align: top

  .title
    font-size: 12px
    color: #7f7f7f

.reports-list-panel
  width: 35%
  border-right: 1px solid #f1f1f1

  .title
    padding: 0 0 8px 24px

.reports-entity-options
  .field
    margin: auto
    width: 100%

  input[type=radio].report-type
    display: none

  input[type=radio].report-type + label
    width: 100%
    padding: 12px 24px
    margin: 0
    color: #555555
    font-size: 14px
    font-weight: 400
    cursor: pointer

  &:not(:last-child)
    input[type=radio].report-type + label
      border-bottom: 1px solid rgba(0,0,0,0.03)

  input[type=radio].report-type label:hover
    background-color: #f9f9f9

  input[type=radio].report-type:checked + label
    color: #6A55D1
    background-color: #f9f9f9

  input[type=radio].report-type:checked + label:after
    float: right
    content: "\25BA"
    color: #a5a5a5
    font-size: 10px;
    transform: scaleY(1.5);

.report-generate-panel
  width: 65%
  padding: 0 24px 8px

  .panel-header
    font-weight: 600
    border-bottom: 1px solid #e2e8ea
    padding-bottom: 6px
    margin-bottom: 24px
    font-size: 16px

  footer
    margin-top: 12px;
    color: $color-semi-muted

  .form-element
    margin-top: 20px

    .field, .btn
      margin: auto
      
.report-container
  padding: 50px
  &.box header
    border: none
    margin-bottom: 20px

  .PlaceholderLoader
    height: 12px
    width: 100%
    margin: 12px 0
  .loading-group
    margin: 0 24px
  footer
    margin-top: 16px

