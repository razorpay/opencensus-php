.row-item
  padding: 8px 12px

  .row-label, .row-value
    display: inline-flex

  .row-label
    width: 40%

  .row-value
    width: 60%
    justify-content: flex-end
    padding-left: 8px
    word-break: break-all;

    a
      color: #5f73cf

    i
      font-size: 8px;
      cursor: pointer
      transition: 0.3s all ease-in

.row-children
  border: 1px solid #eeeeee
  margin: 16px
