.rzp-error-boundary {

  width: 100%;
  height: 100%;
  position: absolute;
  top: 0;
  left: 0;

  div.js-error-container {

    display: table;
    width: 100%;
    height: 100%;

    div.js-error-content {

      display: table-cell;
      vertical-align: middle;
      width: 100%;
      background-color: #FFFFFF;
      text-align: center;
      padding: 20px;

      div.js-error-illustration {

        display: inline-block;
        width: 274px;
        height: 240px;
        background-image: url('assets/error_illustration.svg');
      }
    }
  } 

  a.error-report-link {

    cursor: pointer;
  }
}

div.sentry-error-embed-wrapper {

  z-index: 1112;

  .sentry-error-embed {

    padding: 24px;
    border-radius: 2px;
  }

  * {

    font-family: "Lato", "Helvetica Neue", Helvetica, Arial, sans-serif;
    color: #58666e;

    .btn[type=submit] {

      display: inline-block;
      margin-bottom: 0;
      font-weight: normal;
      text-align: center;
      vertical-align: middle;
      touch-action: manipulation;
      cursor: pointer;
      background-image: none;
      border: 1px solid transparent;
      white-space: nowrap;
      padding: 6px 12px;
      font-size: 14px;
      line-height: 1.42857143;
      border-radius: 2px;
      user-select: none;
      color: #fff;
      background-color: #7266ba;
      border-color: #6254b2;

      &:hover {

        background-color: #7266ba;
      }
    }
  }

  .powered-by {

    display: none !important;
  }
}
