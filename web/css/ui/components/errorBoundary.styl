.rzp-error-boundary
  width: 100%
  height: 100%

  pre.inline
    display: inline-block
    margin: 1em

  div.js-error-container
    display: table
    width: 100%
    height: 100%

    div.js-error-content
      display: table-cell
      vertical-align: middle
      width: 100%
      background-color: #FFFFFF
      text-align: center
      padding: 56px 24px

      div.js-error-illustration
        display: inline-block
        width: 274px
        height: 240px
        background-image: url('assets/error_illustration.svg')
        margin-bottom: 24px

      div.js-error-text
        p
          margin-bottom: 12px
          font-size: 15px
          line-height: 20px

          &:first-child
            font-size: 24px
            line-height: 32px

          &:last-child
            margin-bottom: 0

          &.small
            font-size: 16px

  a.error-report-link
    cursor: pointer

div.sentry-error-embed-wrapper
  z-index: 10000

  .sentry-error-embed
    padding: 24px
    border-radius: 2px

  *
    font-family: "Lato", "Helvetica Neue", Helvetica, Arial, sans-serif
    color: #58666e

    .btn[type=submit]
      display: inline-block
      margin-bottom: 0
      font-weight: normal
      text-align: center
      vertical-align: middle
      touch-action: manipulation
      cursor: pointer
      background-image: none
      border: 1px solid $primary-color
      white-space: nowrap
      padding: 6px 12px
      font-size: 14px
      line-height: 1.42857143
      border-radius: 2px
      user-select: none
      color: #fff
      background-color: $primary-color

      &:hover
        background-color: $primary-color

  .powered-by
    display: none !important
