header
  padding: 12px 20px
  line-height: 38px
  font-size: 20px
  .field
    margin: 0 6px
  .btn
    margin: -2px 16px

/* Buttons */
.link
  display: inline-block
  color: #0078E7
  border-bottom: 1px dashed #3498db
  cursor: pointer
  line-height: 16px
  margin: 0 5px
  &.danger
    border-color: #f39c12
    color: #d35400

.btn-default
  background-color: #fff
  border: 1px solid #dee5e7
  color: #000

  &:hover
    background-color: #f6f6f6

  &:active
    background-color: #f0f0f0

//-------------

/* Labels */
.status-label
  padding: 2px 12px
  font-size: 75%
  font-weight: 700
  border-radius 16px
  color: #fff;
  text-align: center;
  white-space: nowrap;


.label-muted {
  background-color: #999;
}

.label-semi-muted {
  color: #58666E;
  background-color: #D8E1E3;
}

.label-danger {
  background-color: #f05150;
}

.label-pending {
  background-color: #E8B248;
}

.label-success
  background-color: #27c24c;

.label-info
  background-color: #23b7e5;

//-------------
// icons

.i-no
  color: $danger

.i-yes
  color: $success

.code
  white-space: pre
  font-family: monospace
  background: #f6f6f6
  border: 1px solid #eee
  font-size: 13px
  margin: 20px
  border-radius: 3px
  padding: 20px