header
  padding: 12px 20px
  line-height: 38px
  font-size: 20px
  .field
    margin: 0 6px
  .btn
    margin: -2px 16px

.delete
  color: $danger
  font-size: 18px
  cursor: pointer
  float: right
  opacity: .8
  transition: $tra
  &:hover
    opacity: 1

.columns
  display: flex
  align-items: flex-start

.column
  flex: 1 0 0

.box-container
  padding: 15px
  .box
    margin: 15px

/* Buttons */
.link
  display: inline-block
  color: #0078E7
  border-bottom: 1px dashed #3498db
  cursor: pointer
  line-height: 16px
  margin: 0 5px
  &.danger
    border-color: #f39c12
    color: #d35400

.btn-default
  background-color: #fff
  border: 1px solid #dee5e7
  color: #000

  &:hover
    background-color: #f6f6f6

  &:active
    background-color: #f0f0f0

//-------------

/* Labels */
.status-label
  padding: 2px 12px
  font-size: 75%
  font-weight: 700
  border-radius 16px
  color: #fff;
  text-align: center;
  white-space: nowrap;


.label-muted {
  background-color: #999;
}

.label-semi-muted {
  color: $color-semi-muted;
  background-color: #D8E1E3;
}

.label-danger {
  background-color: #f05150;
}

.label-pending {
  background-color: #E8B248;
}

.label-success
  background-color: #27c24c;

.label-info
  background-color: #23b7e5;

//-------------
//  Text style

.text-danger {
  background-color: #f05150;
}

.text-pending {
  background-color: #E8B248;
}

.text-success
  background-color: #27c24c;

//-------------
// icons

.i-no
  color: $danger

.i-yes
  color: $success

.code
  white-space: pre
  font-family: monospace
  background: #f6f6f6
  border: 1px solid #eee
  font-size: 13px
  margin: 20px
  border-radius: 3px
  padding: 20px

header + alert-warn
  margin-top: -2px

alert-warn
  font-size: 14px
  display: block
  padding: 10px 20px
  background-color: #fcf8e3;
  border: 1px solid #eee
  color: #8a6d3b;

.info-block
  color: $color-semi-muted
  font-size: 12px

  .i-info-circle
    margin-right: 4px

.clickable
  cursor: pointer
  &:hover
    background: $bg-highlight

.highlight
  background: $bg-highlight

.rotate
  transform: rotate(-180deg);


// Custom select TypeAhead component
.custom-select
  position: relative;

  input
    width: 100%;

  .custom-icon, .typeAheadSkin
    position: absolute;
    pointer-events: none;

  .custom-icon
    top: 11px;
    left: 8px;
    font-size: 20px;
    z-index: 1;
    color: #e0e0e0;

  .typeAheadSkin
    z-index: 2;
    background-color: #fff;
    top: 10px;
    width: 87%;
    margin-left: 30px;
    font-size: 12px;

  .PowerSelect__TriggerInput
    padding-left: 32px

.PowerSelect__Option
  padding: 0 5px;
  font-size: 14px;
  border: 1px solid #eaeff0;
  background-color: #fff;
  line-height: 28px;
  cursor: pointer

  &--highlighted
    background-color: #f1f1f1;
