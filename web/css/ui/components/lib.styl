/* Buttons */
button
  border-radius: 2px
  outline: 0!important
  box-shadow: none
  cursor: pointer

.btn-default
  background-color: #fff
  border: 1px solid #dee5e7
  color: #000

  &:hover
    background-color: #f6f6f6

  &:active
    background-color: #f0f0f0

//-------------

/* Labels */
.status-label
  padding: 2px 12px
  font-size: 75%
  font-weight: 700
  border-radius 16px
  color: #fff;
  text-align: center;
  white-space: nowrap;


.label-muted {
  background-color: #999;
}

.label-semi-muted {
  color: #58666E;
  background-color: #D8E1E3;
}

.label-danger {
  background-color: #f05150;
}

.label-pending {
  background-color: #E8B248;
}

.label-success
  background-color: #27c24c;

.label-info
  background-color: #23b7e5;

//-------------
