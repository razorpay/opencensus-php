.PowerSelect
  cursor: pointer
  border: 1px solid #ccc
  border-radius: 4px
  background-color: #fff
  box-shadow: inset 0 1px 2px rgba(10,10,10,0.1)

  &__Tether
    max-height: 300px
    overflow: scroll

  &--open
    border-bottom-right-radius: 0
    border-bottom-left-radius: 0

  &__Trigger
    position: relative
    min-height: 34px
    overflow: hidden
    white-space: nowrap
    text-overflow: ellipsis

    &Input
      box-shadow: none
      border: none
      height: 28px

  &__Option
    padding: 0 5px
    font-size: 14px
    border: 1px solid #eaeff0
    background-color: #fff
    line-height: 28px
    cursor: pointer

    &--highlighted
      background-color: #f1f1f1

  &__Clear, &__TriggerInputContainer, &__TriggerLabel, &__TriggerStatus
    display: table-cell
    width: 100%
    vertical-align: middle
    height: 32px


  &__TriggerInput
    box-shadow: none !important
    text-overflow: ellipsis

  &__TriggerLabel
    padding: 6px 22px 6px 8px;


.PowerSelect:not(.PowerSelectMultiple)
  .PowerSelect__Clear
    padding: 4px
    color: #888

  .PowerSelect__Clear:before
    content: "\D7"

  .PowerSelect__TriggerStatus
    padding-top: 2px
    padding-right: 8px
    padding-left: 4px

  &.PowerSelect--open .PowerSelect__TriggerStatus:before
    transform: rotate(-180deg)

  .PowerSelect__TriggerStatus:before
    content: ""
    display: block
    border-top: 4px solid #ccc
    border-left: 4px solid transparent
    border-right: 4px solid transparent

.no-cross .PowerSelect__Clear {
  display: none;
}
