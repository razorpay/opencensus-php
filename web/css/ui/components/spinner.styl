.spinner
  display: inline-block
  width: 30px
  height: 30px
  position: relative
  font-size: 0
  border: 0
  box-shadow: none
  background: none

  &.center
    left: 50%
    top: 50%
    position: absolute
    transform: translate(-50%, -50%)

  &.small
    width: 16px
    height: 16px

  &:after, &:before
    content: ''
    width: 100%
    height: 100%
    border-radius: 50%
    background-color: #999
    opacity: 0.6
    position: absolute
    top: 0
    left: 0
    animation: sk-bounce 1.0s infinite ease-in-out

  &:after
    animation-delay: -0.5s



@keyframes sk-bounce
  0%, 100%
    transform: scale(0.0)
   50%
    transform: scale(1.0)

@keyframes spin
  to
    transform:rotate(360deg)

.spin, .spin-btn
  height: 24px
  width: 24px
  border-radius: 50%
  display: inline-block
  animation: spin .8s infinite linear
  transition: 0.3s
  opacity:0
  border:2px solid $prime
  border-top-color:transparent

.spin-btn
  vertical-align: middle
  margin-top: -3px
  width: 13px
  height: 13px
  border-width: 1px

.btn-pending
  .spin-btn
    opacity: 1