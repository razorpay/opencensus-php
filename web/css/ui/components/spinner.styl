.spinner {
  display: inline-block
  width: 30px
  height: 30px
  position: relative
  font-size: 0
  border: 0
  box-shadow: none
  background: none
  &:after, &:before {
    content: ''
    width: 100%
    height: 100%
    border-radius: 50%
    background-color: #999
    opacity: 0.6
    position: absolute
    top: 0
    left: 0
    animation: sk-bounce 1.0s infinite ease-in-out    
  }
  &:after {
    animation-delay: -0.5s
  }
}

@keyframes sk-bounce {
  0%, 100% {
    transform: scale(0.0)
  } 50% {
    transform: scale(1.0)
  }
}
