.tabs-container
  margin: 10px 0

  .tabs-nav
    list-style: none
    border-bottom: 1px solid $faded-color
    background-color: #f3f3f3

    li
      display: inline-block
      padding: 10px 14px
      cursor: pointer
      border-right: 1px solid #e6e6e6
      border-bottom: 2px solid #f3f3f3
      background-color: #f3f3f3

      &:hover
        background-color: #eee
        border-bottom: 2px solid #eee

      &.selected
        border-bottom: 2px solid $prime
        background-color: #fff


  .tabs-content
    padding: 12px
    min-height: 200px // To avoid screenshot movement when content is loading, where only loader is being shown

  .tabs-control
    padding: 10px
    overflow: auto
    border-top: 1px solid $faded-color;

    .pills
      cursor: pointer

    .prev
      float: left

    .next
      float: right

