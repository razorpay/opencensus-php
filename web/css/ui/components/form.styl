input, select, textarea, button, .btn
  display: inline-block
  height: 38px
  line-height: 20px
  border-radius: 3px
  padding: 7px 12px
  font-size: 14px
  font-family: inherit
  border: 1px solid #dbdbdb
  background: #fff
  vertical-align: middle
  transition: .2s
  &:hover, &:focus
    border-color: #b5b5b5

textarea
  min-height: 100px

input, textarea, select
  min-width: 70px
  box-shadow: inset 0 1px 2px rgba(10, 10, 10, 0.1)

input[type=checkbox]
  height: auto
  width: auto
  box-shadow: none

.small
  width: 80px

label
  line-height: 18px
  white-space: nowrap
  display: block
  margin-left: 1px
  margin-bottom: 4px

button, .btn
  line-height: 38px
  white-space: nowrap
  border: 0
  cursor: pointer
  box-shadow: 0 3px 13px rgba(0,0,0,0.09), 0 1px 5px 0 rgba(0,0,0,0.14)
  user-select: none
  background: $prime
  color: #fff
  padding: 0 16px
  margin: 10px
  &.danger
    background: #e74c3c

.disabled
  opacity: 0.5
  cursor: not-allowed !important

.field
  display: inline-block
  margin: 10px

.checkbox
  background: none
  box-shadow: none
  padding: 0

.knob
  width: 34px
  height: 38px
  position: relative
  margin: 0
  display: inline-block
  vertical-align: middle
  &:before
    content: ''
    display: block
    border-radius: 10px
    height: 20px
    width: 100%
    background: #9E9E9E
  &:after
    left: 0
    top: 9px
    position: absolute
    box-shadow: 0 1px 3px 0 rgba(0,0,0,.2), 0 1px 1px 0 rgba(0,0,0,.18)
    content: ''
    background: #fff
    border-radius: 50%
    width: 19px
    height: @width
    transition: .2s
  &.checked
    &:before
      background: linear-gradient(to bottom, #4CD964, #4BD863)
    &:after
      transform: translateX(15px)


form
  &.pending
    button:not(.checkbox), .btn
      opacity: .6
      pointer-events: none

  &.full-span
    width: 75%
    margin: 0 auto

    .field
      width: 100%
      margin-top: 16px

      label, select, input, > div
        display: inline-block
        vertical-align: middle

      label
        width: 35%
        white-space: pre-wrap

      select, input, >i
        width: 55%
        margin-left: 10px

      .info-block
        width: 55%
        float: right
        margin-right: 8%


// Used for labels
.required:after
  content: '*'
  color: red

.DayPickerInput-OverlayWrapper
  z-index: 1
