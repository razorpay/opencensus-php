input, select, textarea, button
  display: inline-block
  height: 38px
  line-height: 20px
  border-radius: 3px
  padding: 9px 12px
  font-size: 14px
  border: 1px solid #dbdbdb
  background: #fff
  vertical-align: middle
  transition: .2s
  &:hover, &:focus
    border-color: #b5b5b5

input, textarea
  box-shadow: inset 0 1px 2px rgba(10, 10, 10, 0.1)

input
  &[type=checkbox],&[type=radio]
    box-shadow: none
    margin: 0

label
  display: inline-block
  vertical-align: middle
  margin: 0 6px

button
  border: 0
  cursor: pointer
  box-shadow: 0 3px 13px rgba(0,0,0,0.09), 0 1px 5px 0 rgba(0,0,0,0.14)
  user-select: none
  background: #528ff0
  color: #fff
  padding: 0 16px
  margin: 10px

.field
  margin: 10px
  display: inline-block