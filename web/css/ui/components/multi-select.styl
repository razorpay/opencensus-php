.PowerSelectMultiple
  .PowerSelect__Trigger
    white-space: normal

  &__OptionsContainer
    padding-top: 2px
    padding-bottom: 2px
    display: table-cell
    width: 100%
    vertical-align: middle
    height: 32px

  &__SelectedOptions
    list-style: none
    padding-left: 0
    display: block
    margin: 0

    >li
      display: block
      float: left
      margin-top: 2px

  &__SelectedOption
    line-height: 24px
    margin-left: 4px
    background-color: #fffed0;
    border: 1px solid #c6cfff;
    border-radius: 16px;

    &__Label, &__Close
      padding: 0 6px
      display: block
      float: left
    &__Close
      border-left: 1px solid #c6cfff
      cursor: pointer

  .PowerSelect__TriggerInput
    min-width: 135px

  &_TriggerInputContainer
    input
      font-size: 12px
