.PowerSelect
  cursor: pointer
  border: 1px solid #ccc
  border-radius: 4px
  background-color: #fff
  box-shadow: inset 0 1px 2px rgba(10,10,10,0.1)

  &__Tether
    max-height: 300px
    overflow: scroll

  &--open
    border-bottom-right-radius: 0
    border-bottom-left-radius: 0
    border-bottom: 0

  &__Trigger
    position: relative
    height: 34px
    overflow: hidden
    white-space: nowrap
    text-overflow: ellipsis

    &Input
      box-shadow: none
      border: none
      height: auto
      height: 28px


.PowerSelectMultiple
  .PowerSelect__Trigger
    white-space: normal

  &__OptionsContainer
    padding-top: 2px
    padding-bottom: 2px

  &__SelectedOptions
    list-style: none
    padding-left: 0
    display: block
    margin: 0

    >li
      display: block
      float: left
      margin-top: 2px

  &__SelectedOption
    line-height: 24px
    margin-left: 4px
    background-color: red;
    border: 1px solid #c6cfff;
    border-radius: 16px;

    &__Label, &__Close
      padding: 0 6px
      display: block
      float: left
    &__Close
      border-left: 1px solid #c6cfff
      cursor: pointer



.PowerSelect__Clear,
.PowerSelect__TriggerInputContainer,
.PowerSelect__TriggerLabel,
.PowerSelect__TriggerStatus,
.PowerSelectMultiple__OptionsContainer
  display: table-cell
  width: 100%
  vertical-align: middle
  height: 32px


.PowerSelectMultiple_TriggerInputContainer
  input
    font-size: 12px
