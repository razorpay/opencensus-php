.list-container
  header
    padding: 20px
    font-size: 20px
  .filters
    padding: 10px 5px
    display: flex
    flex-wrap: wrap
    align-content: flex-start
    background: #fafbfc
    border-top: 1px solid #eee
    border-bottom: @border-top
    button
      margin-left: auto
  .more-filters-following ~ .field
    label
      display: block
      margin: 2px 0
      text-transform: capitalize

.table-empty
  text-align: center
  &:after
    content: 'No items to display.'

.table-info
  padding: 10px 20px
  font-size: 20px
  line-height: 36px
  border-bottom: 2px solid #eee

.table-pending
  text-align: center
  &:after
    content: 'Loading...'

.table-striped
  .tr:nth-child(2n)
    background: #f6f9fa
    > div
      border-top: 1px solid #eee
      border-bottom: @border-top

.table
  display: table
  width: 100%

.tr
  display: table-row
  width: 100%
  &.clickable
    cursor: pointer
    &:hover
      background: #FFFFE0

.th
  font-weight: bold
  padding: 16px 12px

.td, .th
  display: table-cell
  padding: 12px