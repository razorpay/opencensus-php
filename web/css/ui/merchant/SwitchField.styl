.checkbox-knob {
  background: none
  box-shadow: none
  padding: 0
  border: none

  position: relative
  margin: 0
  display: inline-block
  vertical-align: middle

  width: 28px
  height: 14px

  &:disabled, &[disabled] {
    opacity: 0.4
    cursor: not-allowed
  }

  &:before {
    content: ''
    display: block
    border-radius: 2px
    height: 100%
    width: 100%
    background-color: #F2F5F6
    box-shadow: inset 0 1px 3px 0 rgba(0,0,0,0.24)
  }
  &:after {
    left: 2px
    top: 2px
    position: absolute
    box-shadow: 0 1px 3px 0 rgba(0, 0, 0, .2), 0 1px 1px 0 rgba(0, 0, 0, .18)
    content: '='
    color: #D9DFE0;
    background: #fff
    border-radius: 1px
    padding: 4px 2px
    line-height: 2px
    transition: .2s, .3s opacity
  }

  &--round::before {
    border-radius: 8px
  }

  &--round::after {
    content: ''
    border-radius: 50%
    padding: 0
    height: 12px
    width: 12px
    top: 1px
    left: 2px
  }

  &--default.checked, &--round.checked {
    &:before {
      background: linear-gradient(to bottom, #4CD964, #4BD863)
    }
  }

  &--prime.checked {
    &:before {
      background: #528FF0;
    }
  }

  &.checked {
    &:after {
      transform: translateX(12px)
    }
  }

  &--pending, &--pending.checked {
    cursor: not-allowed

    &:before {
      background: initial
      background-color: #4CD964
      animation: move-right 0.5s linear infinite
      background-image: repeating-linear-gradient(
              -45deg,
              rgba(255,255,255,0.8),
              rgba(255,255,255,0.8) 8px,
              rgba(255,255,255,0.3) 8px,
              rgba(255,255,255,0.3) 17px /* determines size */
      )
      background-size: 24px 24px
    }

    &::after {
      opacity: 0.4
    }

    &.checkbox-knob--prime {
      &::before {
        background-color: #528FF0
      }
    }
  }
}

@keyframes move-right {
  0% {
    background-position: 0 0
  }
  100% {
    background-position: 24px 0
  }
}
