.settlements-header
  width 100%
  padding 20px 20px 0

  .TestModeBanner
    box-shadow 0 1px 4px #0000001a

  .content-wrapper
    background-color $white-color
    border 1px solid #e2e8ea
    border-radius 2px
    display flex
    flex-direction column
    border-top 0
    box-shadow 0 1px 4px #0000001a

    .content
      max-width 100%
      overflow scroll
      display flex
      margin 12px

      .left-content
        display flex
        flex 0.6
        align-items center
        padding 10px 12px

        .balance
          font-weight bold
          color #162F56
          display inline

        .info
          color #57666E
          font-size 12px

        .box-left-pad10-inline
          padding-left 24px
          margin-left 24px

        .info-icon
          color #57666E
          margin-left 5px
          vertical-align middle

      .right-content
        flex 0.4
        display flex
        align-items center
        justify-content flex-end

        .clock-icon, .link-icon
          margin 0 5px

        .border-left
          border-left 1px solid #cfdadd

        .btn-link
          text-decoration none

