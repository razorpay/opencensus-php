.container-scheduled-modal {

  .modal-header-success {
    padding-right: 10px;
  }

  .overflow-box {
    margin: 10px -48px 20px -48px;
    border: 1px solid rgba(173, 188, 201, 0.17);
    padding: 24px;
    box-shadow: 0px 2px 6px rgba(62, 71, 84, 0.13);
    border-radius: 2px;
    background-color: #fff;

    .schedule-desc-container {
      display: inline-block;
      width: 64%;
      float: left;
    }

    .schedule-img-container {
      position: relative;
      img {
        position: absolute;
        width: 282.06px;
        height: 198px;
        top: -68px;
        opacity: 0.6;
        clip: rect(13px, 175px, 200px, 0);
        right: -132px;
      }
    }

    .schedule-desc-list-container{
      display: flex;
      align-items: baseline;
    }

    ul.schedule-desc {
      padding-inline-start: 20px;

      li {
        padding: 5px 0;
      }
    }

    button.enable-schedule-btn {
      width: 100%;
    }

    div.schedule-header {
      font-weight: bolder;
      padding-bottom: 10px;
    }

    .Input-label {
      font-size: 16px;
      color: #515978;
      margin-bottom: 12px;
    }

    .Input-el {
      font-size: 20px;
      color: #0D2366;
    }
  }

  .border {
    border-left: 1px solid #000000;
    opacity: 0.21;
  }

  .modal-title {
    color: #0D2366;
  }

  .modal-body{
    padding-top:8px;
  }

  div {
    color: #515978;
  }

  .btn-link {
    font-weight: bold;
  }

  .footer-container {
    justify-content: space-around;
    display: flex;
  }

  .submit-btn {
    width: 100%;
  }

  .post-schedule-header {
    font-size: 14px;
    font-weight: bold;
    padding-bottom: 6px;
    display: flex;
    align-items: center;
  }

  .post-schedule-description {
    padding-bottom: 16px;
  }

  .fee-container {
    margin: 12px 0 50px;
  }

}

.onmdemand-modal {
  color: #58666E;

  .breakup {
    border-bottom: 1px solid rgba(173,188,201,0.17);
    margin-bottom: 5px;
    background-color: white;

    border:1px solid rgba(173, 188, 201, 0.17) {
      button {
        background-color: transparent;
        border: none;
      }
    }

    .rzp-whole {
      color: #515978;
    }
  }

  .overflow-box {
    .InputGroup {
      .input-tooltip {
        position: absolute;
        top: 50%;
        right: 10px;
      }
    }
  }

  .input-tooltip-custom:before, .input-tooltip-custom:after {
    display: block;
  }

  p {
    display: inline;
  }

  .after-deduction, .limit-warning {
    font-size: 12px;
    padding-right: 4px;
  }

  .float-right {
    display: inline;
    float: right;
  }

  .drop-button {
    float: right;
    background-color: transparent;
    color: #528FF0;
    font-weight: bold;
    padding: 0;
    margin-right: 0px;

    .i {
      font-size: 20px;
      position: relative;
      top: 3px;
    }

    &:not(:disabled) {
      &:hover {
        background-color: transparent;
        color: #2371ec;
      }
    }
  }

  .modal-title {
    color: #0D2366;
  }

  .currency {
    height: 15px;
    font-size: 15px;
  }

  .currency-big {
    height: 15px;
    font-size: 20px;
  }

  .currency-big-1 {
    .rzp-whole{
      color: #0D2366;
      font-weight: bold;
      font-size:24px;
    }
    .rzp-paise{
      font-weight: bold;
      font-size: 18px;
    }
    .rzp-currency{
      font-size: 18px;
    }
  }

  .modal-header-success {
    padding-right: 10px;
  }

  .success-breakup {
    margin-top: -24px;
  }

  .fixed {
    font-size: 13px;
  }

  .dropdown-active, .dropdown {
    color: #7B8199;
    font-size: 13px;
    line-height: 20px;
    background-color: white;
    padding: 10px 12px;
  }

  .p-b-5 {
    padding-bottom: 5px;
  }

  .dropdown-border{
    border-top: 1px solid rgba(173, 188, 201, 0.17);
    border-bottom: 1px solid rgba(173, 188, 201, 0.17);
  }

  .dropdown-active .amount-to-settle {
    color: #515978;
  }

  .dropdown-1 {
    border-bottom: 1px solid rgba(173, 188, 201, 0.17);
    margin-top: 20px;
    padding-bottom: 16px;
  }

  .dropdown-closed {
    display: none;
  }

  .border {
    margin-top: 20px;
    border-left: 3px solid #528FF0;
    padding-left: 8px;
    margin-bottom: 20px;
  }

  .btn-link {
    font-weight: bold;
  }

  .grey-border {
    border-left: 2px solid #ADBCC9;
    margin-bottom: 16px;
    padding-left: 6px;

    .rzp-amount {
      position: absolute;
    }
  }

  .percent {
    font-size: 15px;
    font-weight: bold;
    color: #515978;
  }

  .loader {
    border: 1.2px solid #f3f3f3;
    border-top: 1.2px solid #3498db;
    border-radius: 50%;
    width: 17px;
    height: 17px;
    animation: spin 1s linear infinite;
  }

  .overflow-box {
    margin: 18px -45px 20px -45px;
    border: 1px solid rgba(173, 188, 201, 0.17);
    padding-top: 0px;
    padding-left: 24px;
    padding-right: 24px;
    padding-bottom: 24px;
    padding:0px 24px 24px
    box-shadow: 0px 2px 6px rgba(62, 71, 84, 0.13);
    border-radius: 2px;
    background-color: white;

    .Input-label {
      font-size: 16px;
      color: #515978;
      margin-bottom: 6px;
    }

    .Input-el {
      font-size: 20px;
      color: #0D2366;
    }
  }

  .i-info-circle {
    color: #9fb1c7;
  }

  .close-btn, .submit-btn {
    width: 100%;
  }

  .settlement-doc-btn, .fa-circle.interpunct {
    display: none;
  }

  .help-block {
    color: #515978;
    margin: 16px 0px;
  }

  .loader {
    margin-bottom: 16px;
  }

  .error-message {
    border-left: 2px solid #f05050;
    margin: 8px 0px 16px;
    padding: 0px 8px;
    color: #f05050;

    .limit-warning {
      color: #7B8199;
    }
  }

  .is-mature .is-invalid .Input-error, .is-mature.is-invalid .Input-error {
    display: none;
  }

  .modal-body {
    padding-top: 8px;
  }
}

