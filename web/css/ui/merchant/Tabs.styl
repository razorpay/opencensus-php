.tabs-container
  .tabs-nav
    list-style: none
    padding: 0
    margin-bottom: 0
    position: relative

    li
      display: inline-block
      padding: 10px 14px
      cursor: pointer
      text-align: center

      i
        margin-right: 6px;


  .tabs-control
    padding: 10px
    overflow: auto
    border-top: 1px solid #edf1f2

    .pill
      cursor: pointer

    .prev
      float: left

    .next
      float: right


  &.some-class
    .tabs-nav
      background-color: #fff
      box-shadow: 0 4px 7px rgba(0,0,0,.08);

      li
        line-height: 35px
        border-bottom: 2px solid #fff
        width: 33.33%

        &.selected
          border-bottom: 2px solid $primary-color
          color: #5e70d2

