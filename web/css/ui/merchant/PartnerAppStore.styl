/*
  stylelint-disable -- Disabling Stylelint as the small changes I had made for Rize Marketplace FTX did not have any stylelint issues,
  and we did not have the bandwidth to resolve the 200+ lint errors in the older parts of this file.
  Please remove this comment and resolve the stylelint errors when modifying this file in the future.
*/

$titleColor = #162F56 /* Shade 900 */
$paragraphColor = rgba(22, 47, 86, 0.74); /* Shade 970 */

.appstore-shared-styles
  padding: 20px 23px;
  color: $paragraphColor;

  p:not([data-blade-component])
    color: $paragraphColor;

  h1, h2, h3, h4, h5, h6
    &:not([data-blade-component])
      color: $titleColor;
      font-weight: 600;

  section.appstore-card
    background-color: #fff;

  .text-white
    color: #fff;

  .text-teal
    color: #75D7B7;

.PartnerAppStore
  section.appstore-card
    position: relative;

    /* Top header that includes heading, and banner image */
    .back-to-dashboard-button-container
      padding: 0px 0px 10px;
      text-align: left;

      a
        color: #fff;

    .appstore-header
      background-image: url('assets/app-store/top-bg-shape.svg');
      background-size: cover;
      background-repeat: no-repeat;
      background-position: bottom;
      height: 400px;
      position: relative;
      padding: 30px 92px;
      z-index: 1;

      .appstore-info
        width: 483px;

        h1.appstore-heading
          display: inline-block;
          font-size: 40px;
          color: #fff;
          line-height: 48px;

        h1.appstore-heading::after
          content: '';
          display: block;
          width: 50px;
          height: 4px;
          background: #75D7B7;
          margin-top: 16px;

        h1.appstore-heading + p
          width: 437px;
          font-size: 20px;
          line-height: 32px;
          padding: 20px 0px;
          color: rgba(255, 255, 255, 0.8);

      img.razorpay-partner-image
        width: 420px;
        position: absolute;
        right: 90px;
        top: 31px;

      img.top-shape-green
        position: absolute;
        right: 0px;
        top: 0px;
        height: 700px;

    .dots-container
      position: absolute;
      height: 5px;
      z-index: 0;
      width: 100%;

      [class^="dots-"]
        position: absolute;
        z-index: 0;

      .dots-1
        top: -60px;
        left: 30px;

      .dots-2
        top: 20px;
        right: 350px;

      .dots-3
        top: 230px;
        right: 0px;

      .dots-4
        top: 700px;
        left: 10px;

    .new-app-banner
      margin 50px 76px 0px
      position relative
      z-index 2
      height 107px
      background linear-gradient(90.75deg, #61E1AE -50.51%, #FFFFFF 95.18%)
      border-radius 5px
      display flex
      align-items center
      position relative
      .new-app-icon
        margin: 0px 42px
      .new-app-message
        color: #162F56
        font-size: 20px
        & > p
          & > br
            display none
      .arrow-head-container
        position absolute
        right 0px
        .arrow-head-top
          position absolute
          right 20px
          top -50px
        .arrow-head-bottom
          position absolute
          right 20px
          top 0px
    /* Product Tiles Section */
    .partner-products-container
      padding: 50px 76px;
      position: relative;
      z-index: 2;

      .product-col
        padding: 12px 16px;
        display: inline-block;
        width: 33%;
        min-height: 190px;
        position relative

        .new-offer-ribbon
          padding: 5px 15px;
          background-color: #53DB8A;
          font-style: normal;
          font-weight: 600;
          z-index: 2;
          position: absolute;
          right: 6px;
          font-size: 12px;
          line-height: 17px;
          color: #fff;
          width: fit-content;
          top: 40px;
          margin-bottom: 15px;
          margin-top: -7px;
          &::before
            content: '';
            position: absolute;
            height: 0;
            border-top: 0 solid transparent;
            border-left: 10px solid #53DB8A;
            border-bottom: 8px solid transparent;
            right: 0;
            bottom: -8px;

        a.product-wrapper
          display: inline-block;
          height: 100%;
          min-height: 190px;
          width: 100%;
          box-shadow: 2px 4px 9px 1px rgba(0,0,0,0.05), 0 1px 1px rgba(0,0,0,0.04);
          border-radius: 6px;
          overflow: hidden;
          position: relative;
          vertical-align: top;
          background-color: #fff;

        a.product-wrapper:hover
          box-shadow: 0px 2px 15px rgba(11, 112, 231, 0.2);

        .image-x-title-flex
          position: relative;
          display: flex;
          background-color: #fff;
          padding: 17px 24px;
          transition: background-color .2s ease;

          .image-col
            display: inline-block;

            .product-image-background
              height: 50px;
              width: 50px;
              background-color: #fff;
              border: 0.625px solid #EDF0F5;
              border-radius: 4px;
              padding: 6px;
              display: table-cell;
              vertical-align: middle;

              & > img
                max-width:100%;
                max-height:100%;

          .title-category-col
            flex: 1
            padding: 0px 17px;

            & > h2.product-title
              font-size: 16px;
              line-height: 24px;

            & > .product-category
              font-size: 13px;
              margin-top: 7px;
              color: rgba(22, 47, 86, 0.38); /* shade 950 */

          .left-strip
            position: absolute;
            left: 0px;
            background-color: #E4E8FA;
            height: 51px;
            width: 5px;
            border-radius: 0px 2px 2px 0px;
            transition: background-color .2s ease;

        .product-description
          font-size: 14px;
          padding: 11px 24px;

        .more-details-container
          opacity: 1; /* To avoid layout shift */
          transition: opacity .2s ease;
          text-align: center;
          position: absolute;
          bottom: 0px;
          padding: 25px 20px;
          right: 0px;
          font-size: 24px;

          a
            display: inline-block;
            height: 34px;
            width: 34px;
            background-color: transparent;
            border-radius: 100%;
            color: #E4E7FA;
            transition: all .3s ease;
            transition-property: color, background-color;

          .hover-vector
            position: absolute;
            right: 0px;
            bottom: 0px;
            opacity: 0;
            transition: opacity .3s ease;

        .product-wrapper:hover
          .image-x-title-flex
            background: #1F6ED8;

            .left-strip
              background-color: #1F5BB4;

          h2.product-title
            color: #fff;

          .product-category
            color: #fff;

          .more-details-container
            a
              background: #1F6ED8;
              color: #fff;
              transition: all .2s ease;

            .hover-vector
              opacity: 1;
              transition: opacity .2s ease;

  section.become-partner
    position: relative;
    background-image: url('assets/app-store/footer-bg-shape.svg');
    background-size: cover;
    background-position: top right;

    .become-partner-container
      display: flex;
      padding: 200px 60px 100px;

      .become-partner-content
        flex: 1;
        padding: 20px 40px 20px 30px;

        h2
          font-size: 20px;
          margin: 0px 0px;
        p
          padding: 12px 0px;
          font-size: 16px;
          color: rgba(22, 47, 86, 0.54);

        .partner-links
          padding: 5px 0px;

    .footer-pc-illustration
      position: absolute;
      right: 90px;
      top: -110px;

.PartnerAppStore.rize-marketplace-enabled
  section.appstore-card
    .appstore-header
      background-image: url("assets/app-store/top-banner.svg");
      background-position: top;
      height: auto;

      .appstore-info
        width: 700px;

      img.top-banner
        position: absolute;
        top: 0;
        left: 0;
        right: 0;

/* AppStore Mobile */
@media (max-width: 768px)
  .layout--fp
    padding-bottom: 0px;

  .PartnerAppStore
    padding: 0px 0px;

    section.appstore-card
      .appstore-header
        padding: 40px 24px;
        background-image: url('assets/app-store/top-bg-shape-mob.svg');
        background-size: cover;
        background-position: bottom left;
        height: 700px;

        img.top-shape-green.top-shape-green-mobile
          top: 350px;
          width: 300px;
          height: unset;

        .appstore-info
          width: 100%;
          padding-top: 25px;

          h1.appstore-heading
            font-size: 24px;
            line-height: 31px;

          h1.appstore-heading + p
            font-size: 16px;
            line-height: 24px;
            width: 100%;

        img.razorpay-partner-image
          display: block;
          top: 350px;
          right: 0px;
          width: 300px;

      .partner-products-container
        padding: 28px 0px 50px;

        .product-col
          width: 100%;
          padding: 12px 24px;

          .more-details-container
            opacity: 1;
          .new-offer-ribbon
            right: 14px
      .new-app-banner
        margin 28px 0px 0px
        background none
        .new-app-icon
          display none
        .new-app-message
          margin-left 37px
          font-size 18px
          & > p
            & > br
              display block
        .arrow-head-container
          right 20px
          .arrow-head-top
            position absolute
            right 0px
            top -30px
          .arrow-head-mid
            position absolute
            right 0px
            top 0px
          .arrow-head-bottom
            position absolute
            right 0px
            top 30px

    hr.section-divider
      display: none;

    section.become-partner
      background-color: #fff;

      .footer-pc-illustration
        display: none;

      .become-partner-container
        display: block;
        padding: 90px 0px 30px;

        .become-partner-content
          background-color: transparent;
          margin: 24px 0px;
          box-shadow: unset;

          h2
            font-size: 24px;

  .PartnerAppStore.rize-marketplace-enabled
    section.appstore-card
      .appstore-header
        background-position: top left;

        .appstore-info
          width: 100%;
          padding-top: 0;

      .partner-products-container
        padding: 32px 0 50px;

/* AppStore Mobile Styles END */


/* Partner Details Page START */
.PartnerPage
  section.appstore-card
    header
      padding: 28px 78px;

      a
        color: #fff;

    .partnerpage-colored-top
      background-image: url(assets/app-store/banner-dots.svg);
      background-repeat: no-repeat;
      background-position: top right;

    div.top-heading
      padding: 24px 180px 20px;
      position: relative;

      & > div.inline-block
        display: inline-block;

      .product-logo-container
        position: relative;
        top: 5px;
        margin-right: 25px;

        .product-image-background
          height: 120px;
          width: 120px;
          background-color: #fff;
          border: 3px solid rgba(224, 228, 249, 0.87);
          border-radius: 4px;
          padding: 19px;
          display: table-cell;
          vertical-align: middle;
          position: relative;
          bottom: -55px;
          text-align: center;
          z-index: 2;

          img
            max-width: 100%;
            max-height: 100%;
            width: 100%;

      .heading-container
        h1
          font-size: 32px;
          line-height: 36px;
          margin: 0px;
          margin-bottom: 4px;
          color: #fff;
          font-weight: 600;

        p.category
          font-size: 16px;
          line-height: 24px;
          color: #fff;

      .get-started-button-container
        position: absolute;
        padding: 0px;
        bottom: 20px;
        right: 180px;

        .only-owners-message
          color: #fff;
          display: inline-block;
          width: 140px;
          padding: 10px;
          position: relative;
          bottom: -10px;

        .get-started-button
          background-color: #0003;
          color: #fff;
          min-width: 149px;

    div.content
      padding: 0px 0 100px;
      font-size: 16px;

      .pad-y-1
        padding-top: 20px;
        padding-bottom: 20px;

      .text-center
        text-align: center;

      li
        padding: 6px 0px;

      img
        max-width: 100%;
        display: block;
        margin: 10px 0px;

      p
        padding: 8px 0px;

      h2
        margin: 15px 0px 18px;
        font-size: 23px;
        padding-left: 10px;

      h3, h4
        margin: 15px 0px 10px;

      code
        tab-size: 4;
        vertical-align: middle;
        margin: 0 3px;
        color: #34495e;
        font-size: 13px;
        padding: 2px 4px;
        border-radius: 3px;
        font-family: Consolas,Menlo,Monaco,Andale Mono,monospace;
        white-space: pre-wrap;
        word-wrap: break-word;
        background-color: #f1f1f1;
        margin-top: 12px !important;

      .description
        padding: 60px 180px 0;
        background: #FAFAFA;
        position: relative;

        &::after
          content: " ";
          position: absolute;
          background-image: url(assets/app-store/partner-page-shape-new.svg);
          background-repeat: no-repeat;
          background-size: 100% auto;
          width: 100%;
          height: 86px;
          left: 0;
          bottom: -86px;

      .how-to-use-razorpay
        padding: 0 180px;
        margin-top: 100px;

        .content-image-holder
          display: inline-block;
          height: 285px;
          width: 466px;
          position: relative;
          border-radius: 4px;

          img.content-image
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            margin: auto;
            max-height: 270px;
            max-width: 450px;
            cursor: zoom-in

        h2.how-to-use-heading
          margin: 0px;

          & + p
            color: #162F56;
            margin: 0px;
            padding: 2px 0px;
            padding-left: 10px;
        
        .how-to-use-video
          margin-top 50px
          p
            color: #162F56;
            margin-bottom 20px
          iframe
            max-width 100%
        .queries-section
          margin-top 50px
          font-size 14px
        ol
          counter-reset: section;
          list-style-type: none;
          padding-top: 30px;

          & > li
            position: relative;
            padding: 20px 0px;
            padding-left: 20px;

            .list-flex
              display: flex;
              align-items: center;

              & > *:first-child
                flex: 1;
                padding: 0px 20px 0px 0px

              .img-col
                display: flex;
                flex-direction: column 

                & > *:not(:first-child)
                  margin-top: 10px;

          & > li div.list-counter
            position: relative

            &::before
              counter-increment: section;
              content: counters(section, ".") " ";
              background-color: inherit;
              color: #fff;
              padding: 5px;
              border-radius: 100%;
              position: absolute;
              top: 0;
              margin: auto;
              height: 28px;
              width: 28px;
              font-size: 13px;
              text-align: center;
              left: -40px;

          & > li.number-label-top::before
            top: 20px;
            margin: unset;

        table, th, td
          border: 1px solid black;

        th, td
          padding: 5px 10px;

        table
          border-collapse: collapse;

.app-store-setup-image-modal
  .content-zoomed-image
    width: 100%;

/* PartnerPage Mobile Styles START */
@media (max-width: 768px)
  .PartnerPage
    .partnerpage-colored-top
      background-size: 150px auto;

    section.appstore-card
      header
        padding: 20px;

      div.content
        padding: 0px 16px 60px;

        .description
          padding: 60px 0 80px;
          background: none;

          &::after
            background: none;

        .how-to-use-razorpay
          padding: 0;
          margin: 0;

          ol
            padding-left: 10px;

            & > li::before
              top: -5px;
              margin: unset;

            & > li
              position: relative;
              padding: 30px 0px;
              padding-left: 0px;

              .list-flex
                display: block;

            & > li div.list-counter
              &::before
                top: -30px;
                left: -20px;

          .content-image-holder
            display: inline-block;
            height: 180px;
            width: 100%;

            img.content-image
              position: absolute;
              top: 0;
              left: 0;
              right: 0;
              bottom: 0;
              margin: auto;
              max-height: 150px;
              max-width: calc(100% - 13px);


        ul
          padding-left: 20px;

      div.top-heading
        padding: 24px 16px 0px;

        .product-logo-container
          margin-right: 20px;

          .product-image-background
            bottom: unset;
            height: 60px;
            width: 60px;
            border-width: 1px;
            padding: 5px;

        .heading-container
          h1
            font-size: 20px;

          p.category
            font-size: 14px;


        .get-started-button
          position: relative;
          right: unset;

        div.get-started-button-container
          display: block;
          padding: 20px 0px;
          float: unset;
          position: relative;
          right: unset;
          bottom: unset;


          .get-started-button
            display: block;
            width: 100%;

          .only-owners-message
            width: 100%;
            bottom: unset;
            text-align: center;

