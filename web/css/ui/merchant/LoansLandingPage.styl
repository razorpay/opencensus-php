.loan-application-home {
  position: absolute
  top: 32px
  bottom: 32px
  right: 52px
  background: #fff
  z-index: 3
  padding: 28px 0px 20px;
  width: 540px
  height: fit-content
  min-height: 87vh
  margin-left: auto
  display: flex
  flex-direction: column
  border-top: 2px solid rgba(11, 112, 231, 0.87);
  box-shadow: 0px 4px 8px rgba(22, 47, 86, 0.16)
  margin-right: 30px
  border-radius: 4px
  &:after {
    position: absolute
    content: ""
    bottom: -30px
    height: 30px
    width: 1px
  }

  .status-overview{
    flex: 1

    .loan-application-overview-header {
      display: flex;
      padding: 0 32px 12px;
      justify-content: space-between;

      &.onboarding-header{
        display: inherit;
        padding: 0;
        .loan-meta-wrapper {
          margin: 0 32px;
          // border-bottom: 1px solid rgba(22,47,86,0.1);
          .text-strong{
            font-weight: 800;
          }
        }
        .personal-pan-summary{
          background: rgba(22, 47, 86, 0.02);
          padding: 12px 20px 18px;
          font-size: 13px;
          .left-section{
            padding-right: 20px;
            border-right: 1px solid rgba(22, 47, 86, 0.1)
            margin-right: 18px;
            .pan-info{
              display: flex;
              align-items: center;
            }
          }
          .text-secondary{
            color: rgba(22, 47, 86, 0.76);
          }
          .text-strong{
            font-weight: 600;
          }
        }
      }
      .loan-meta-wrapper{
        h4{
          margin: 0 0 6px;
          color: rgba(22, 47, 86, 0.87);
          font-weight: 600;
          font-size: 18px;
          line-height: 22px;
        }
        
        p{
          color: rgba(22, 47, 86, 0.54);  
          i{
            margin-right: 6px;
            font-size: 100%;
          }
        }
      }
      .section {
        display: flex;
        flex-direction: column;
        .title.PlaceholderLoader{
          height: 18px;
          width: 220px;
          margin-bottom: 8px !important;
        }
        .description.PlaceholderLoader{
          height: 14px;
          width: 120px;
        }
      }

      .loan-application-progress-wrapper{
        margin-top: 4px;
        .progress-text-wrapper .PlaceholderLoader{
          height: 18px;
          width: 60px;
          margin-top: 2px !important;
        }
      }
    }
  }
  .footer{
    display: flex
    margin-top: 8px
    align-items: center;
    .btn-toolbar{
      flex: 1
    }
  }
}

.loan-application-home-top-border {
  border-top: 2px solid rgba(238, 102, 25, 0.87) !important;
}

.add-applicant-pan-modal, .Modal-container--add-applicant-pan-modal{
  .modal-body{
    padding-top: 0;
    .toggle-description .Input-error{
      margin-top: 4px;
      font-size: 13px;
    }
  }
}

.Modal-container--add-applicant-pan-modal{
  width: 328px;
}
