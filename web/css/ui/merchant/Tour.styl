$tour-text-color=#f5f5f5;
$tour-popover-bg=#2e3345;
$tour-primary-color=$primary-color;

.Tour {
  z-index: 9999 !important;
}

.Tour--initialized {
  transition: transform 300ms ease-in-out;
}

.Tour__Overlay {
  position: fixed;
  top: 0;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 9999;
}

.Tour__TargetLens {
  position: absolute;
  box-shadow: 0 0 0 9999px rgba(0,0,0,.5), 0 0 15px rgba(0,0,0,.5);
  transition: transform 300ms ease-in-out;

  .rzp-popover.rzp-tooltip {

    display: table;

    &.align-right .rzp-tooltip-inner:after {

      border-right-color: $tour-popover-bg;
    }

    &.align-left .rzp-tooltip-inner:after {

      border-left-color: $tour-popover-bg;
    }

    &.align-top .rzp-tooltip-inner:after {

      border-top-color: $tour-popover-bg;
    }

    &.align-bottom .rzp-tooltip-inner:after {

      border-bottom-color: $tour-popover-bg;
    }

    .rzp-tooltip-inner {

      background-color: $tour-popover-bg;
      color: $tour-text-color;

      div.rzp-tour-step-controls {

        display: table;
        width: 100%;
        margin-top: 24px;

        > div {

          display: table-cell;
          white-space: nowrap;

          &.steps-switcher {

            width: 100%;
            padding: 0px 4px;
            text-align: center;

            .step-switch {

              display: inline-block;
              background-color: $tour-text-color;
              width: 8px;
              height: 8px;
              border-radius: 50%;
              margin-left: 2px;

              &:first-child {

                margin-left: 0;
              }

              &.active {

                background-color: $tour-primary-color;
              }
            }
          }

          &.pagination-link {

            color: $primary-color;
            cursor: pointer;
          }
        }
      }
    }
  }
}

.TourStep {
  padding: 12px;
  background-color: #2E3345;
  color: #fff;
  max-width: 275px;
  border-radius: 4px;
  transition: opacity 300ms ease-in-out;

  .btn-link {
    padding: 0;
    color: rgba(255,255,255,0.7);
  }
}

.TourStep__Container .arrow,
.TourStep__Container .arrow:after {
  position: absolute;
  display: block;
  width: 0;
  height: 0;
  border-color: transparent;
  border-style: solid;
}

.TourStep__Container .arrow {
  border-width: 11px;
}

.TourStep__Container .arrow:after {
  border-width: 10px;
  content: "";
}

.tether-element-attached-left .arrow {
  top: 50%;
  left: -11px !important;
  margin-top: -11px;
  border-left-width: 0;
  border-right-color: #999;
  border-right-color: $tour-popover-bg;
}

.tether-element-attached-left .arrow:after {
  content: " ";
  left: 1px;
  bottom: -10px;
  border-left-width: 0;
  border-right-color: $tour-popover-bg;
}

.tether-element-attached-top .arrow {
  left: 50%;
  top: -11px !important;
  margin-left: -11px;
  border-top-width: 0;
  border-bottom-color: #999;
  border-bottom-color: $tour-popover-bg;

  &:after {
    content: " ";
    top: 1px;
    margin-left: -10px;
    border-top-width: 0;
    border-bottom-color: $tour-popover-bg;
  }
}
