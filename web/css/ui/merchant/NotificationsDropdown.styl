.Dropdown--Notifications-toggle
  .highlight
    font-weight: 600

  .bubble
    display: inline-block
    width: 18px
    height: 18px
    vertical-align: middle
    border-radius: 50%
    background: $textDangerColor
    margin-left: 2px
    color: #fff
    text-align: center
    font-size: 12px
    line-height: 18px

  .new-bubble
    position: absolute
    top: 7px;
    right: 7px
    width: 16px
    height: 16px
    border-radius: 50%
    background: $textDangerColor
    font-size: 12px;
    text-align: center
    color: white
    line-height: normal

  .i-bell
    position: relative
    font-size: 20px
    vertical-align: middle

.Dropdown--Notifications-menu
  min-width: 460px
  padding: 0
  line-height: 1.8
  overflow: hidden

  &.js-overflow::before
    content: ''
    display: table
    position: absolute
    width: 100%
    height: 15vh
    min-height: 56px
    bottom: 0
    left: 0
    background: linear-gradient(to top, #fff, rgba(255,255,255,0.1) 100%)
    z-index: 2
    opacity: 0
    filter: blur(2px)
    transition: 0.4s
    pointer-events: none

  &.can-scroll::before
    opacity: 1

  .Dropdown--Notifications-content
    position: relative
    min-height: 200px
    max-height: 55vh
    overflow: scroll

  .media
    margin-top: 0

    + .media
      border-top: 1px solid #eee

    .media-body
      padding: 12px 20px
      border-bottom: 1px solid #eee

  .media-action:last-of-type
     z-index: 3

.NotificationCard
  position: relative
  display: table
  width: 100%
  padding: 20px 20px

  &.inactive
    opacity: 0.8

  &.active
    background-color: #f3f7ff

  .NotificationCard-icon, .NotificationCard-body
    display: table-cell
    vertical-align: top

  .NotificationCard-icon
    padding-right: 8px
    width: 56px

    .ico
      position: relative
      display: block
      width: 32px

      img
        vertical-align: top

      &.i
        height: 32px
        border-radius: 50%
        background: $primary-color
        color: #fff
        font-size: 16px
        line-height: 32px
        text-align: center

  .heading
    .title
      width: 80%
      white-space: nowrap
      overflow: hidden
      text-overflow: ellipsis

    .timestamp
      font-size: 12px
      position: absolute
      top: 20px
      right: 20px
      opacity: 0.7

  .description
    line-height: 20px
    margin-top: 4px

  .action-buttons
      margin-top: 20px
      display: flex

  a.btn
    font-size: 13px
    padding: 6px 20px

    &.btn-link
      color: $primary-color

    &:not(:last-of-type)
      margin-right: 12px

    i
      display: inline-block
      margin-left: 2px

    &.btn-link
      padding: 8px 4px

    &.btn-primary--invert
      background-color: #fff
      color: #3b80ee
      border-color: #3b80ee

    &.btn-primary
      i
        color: #fff


#notifications-dropdown .red-bubble
  position: absolute
  top: 0
  right: -2px
  width: 8px
  height: 8px
  border-radius: 50%
  border: 1px solid #fff
  background: $textDangerColor

.Notifications-content-empty
  width: 100%
  transform: translateY(50%)
  text-align: center

  .title
    margin-top: 20px
    font-size: 16px
    font-weight: 600

@media(max-width: 768px)
  .Dropdown--Notifications-toggle .red-bubble
    border-color: #2e3345

  .dropdown__trigger.Dropdown--Notifications-toggle
    padding: 15px 15px !important

  .Dropdown--Notifications-menu
    position: fixed
    top: 56px

    .Dropdown--Notifications-content
      max-height: calc(100vh - 56px - 50px)