.disable-reason-automated-withdraw-modal
  padding: 24px;
  .disable-reason-automated-withdraw-modal--heading
    font-weight: 800;
    font-size: 16px;
    color: rgba(22, 47, 86, 0.87);
    margin-bottom: 16px;
  .disable-reason-automated-withdraw-modal--description
    font-size: 15px;
    color: rgba(13, 35, 102, 0.87);
    margin-bottom: 8px;
  .close-choices
    padding-bottom: 3px;
    input[type='radio']
      margin-right: 6px;
    label
      color: #515978;
      font-weight: normal;
      font-size: 14px;
  .disable-reason-automated-withdraw-modal--confirm-btn
    display: flex;
    justify-content: flex-end;

.automated-withdraw-tooltip {
  .automated-withdraw-tooltip--enabled {
    display: flex;
    justify-content: space-between;
    margin-bottom: 9px;
    font-weight: 600;
  }
  .automated-withdraw-tooltip--enabled--heading {
    font-weight: 600;
  }
  .automated-withdraw-tooltip--enabled-content {
    font-weight: 600;
    font-size: 12px;
    text-align: center;
    letter-spacing: 0.4px;
    text-transform: uppercase;
    color: #0FCAA9;
    opacity: 0.7;
    align-items: center;
    .enabled-dot {
      background: #0FCAA9;
      width: 5px;
      height: 5px;
      border-radius: 50%;
      display: inline-block;
      margin-right: 5px;
    }
  }

  .automated-withdraw-tooltip--enabled-summary {
    font-size: 12px;
    color: rgba(255,255,255,0.78);
    line-height: 15px;
  }

  .automated-withdraw-tooltip--details {
    margin: 10px 0px;
    padding: 8px 0px;
    border: 1px solid rgba(173, 188, 201, 0.12);
    border-left: none;
    border-right: none;
  }

  .automated-withdraw-tooltip--details-row {
    display: flex;
    justify-content: space-between;
    padding: 4px 0px;
    color: rgba(255, 255, 255, 0.87);
    font-size: 12px;
  }

  .automated-withdraw-tooltip--disable-withdrawal {
    text-align: center;
    color: rgba(199, 91, 91, 0.87);
    font-weight: 600;
    font-size: 12px;
    cursor: pointer;
    letter-spacing: 0.3px;
  }

  .automated-withdraw-tooltip--max-amount {
    .rzp-whole, .rzp-paise, .rzp-currency {
      font-weight: 600;
      opacity: 1;
    }
  }

  .automated-withdraw-tooltip--details-row-month {
    color: rgba(255, 255, 255, 0.87);
    font-weight: 600;
    font-size: 12px;
  }
}

.automated-tag {
  background: rgba(4, 138, 115, 0.1);
  border: 1px solid rgba(4, 138, 115, 0.87);
  border-radius: 2px;
  font-weight: 600;
  font-size: 10px;
  line-height: 14px;
  text-align: center;
  letter-spacing: 0.4px;
  text-transform: uppercase;
  color: #048A73;
  opacity: 0.7;
  padding: 4px 12px;
  height: 22px;
  display: flex;
  align-items: center;
}

.pulsating-ring::after {
  display: flex;
  height: 22px;
  width: 92px;
  animation: pulsate 1.5s ease-out;
  animation-iteration-count: infinite;
  opacity: 0.0;
  content: "";
  z-index: -1;
  margin: auto;
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  border: 1px solid rgba(4, 138, 115, 0.87);
}

@keyframes pulsate {
  0% {
    transform: scale(1, 1);
    opacity: 0.7;
  }
  100% {
    transform: scale(1.2, 1.8);
    opacity: 0.0;
  }
}

.rounded-rectange {
  background: #118FF2;
  border-radius: 50px;
  width: 2px;
  height: 35px;
  margin-left: 8px;
}
.automated-withdrawal {
  font-size: 13px;
  position: absolute;
  bottom: 0px;
  right: 0px;
  @media (max-width: 1400px) and (min-width: 1300px) {
    left: 445px;
  }
  @media (max-width: 1299px) and (min-width: 1200px) {
    left: 390px;
  }
  .enable-now-btn {
    font-weight: 600;
    padding: 0px;
    align-self: flex-end;
    margin: 0px;
  }
}

.automated-withdrawal-wrapper {
  display: flex;
  flex-direction: column;
}
