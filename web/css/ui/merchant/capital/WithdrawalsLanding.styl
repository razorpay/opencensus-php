.FlashWithdrawals--Container
  tabbed-container
    padding-top: 14px;
    .rzp-amount
      .rzp-currency, .rzp-whole, rzp-paise
        font-weight: 600;
  tabbed-container content .content-wrapper
    padding: 0;
    .filters-wrapper
      display: flex;
      align-items: center;
      .list-filter-container
        flex: 1;
        padding: 24px;
        margin-bottom: 0;
      .repay-cta-container
        align-items: center;
        padding-right: 10px;
        font-size: 13px;
        .help-content--currency
          font-size: 14px;
        .PlaceholderLoader
          height: 24px;
          width: 132px;
          &:last-child
            height: 36px;
            width: 104px;
            margin-right: 12px;
    .table-responsive
      padding: 0 24px 24px;
      .table tbody tr td.row-action .btn-group .btn
        height: 24px;
        line-height: 7px;
      .no-results-container
        display: flex;
        justify-content: center;
        align-items: center;
        text-align: start;
        .content
          width: 300px;
  .withdrawals__top-summary
    height: 260px;
    position: relative;
    border-radius: 3px;
    background: #fff;
    box-shadow: 0 0 0 1px rgba(63,63,68,0.05), 0 1px 3px 0 rgba(63,63,68,0.15);
    color: rgba(22, 47, 86, 0.87);
    background-position: right;
    display: flex;
    padding-left: 132px;
    overflow-x: hidden;
    &:before
      content: '';
      background-image: url(assets/capital/onboarding_illustration.svg);
      background-repeat: no-repeat;
      position: absolute;
      z-index: 1;
      left: 0;
      top:0;
      bottom: 0;
      width: 210px;
      margin-left: -54px;
      background-position: -54px;
    .withdrawals__action-container
      padding: 40px 52px 24px 0;
      width: 100%;
      position: relative;
      z-index: 2;
      .Input-addons
        top: 1px;
        bottom: 1px;
        line-height: 42px;
      input
        height: 42px;
      .InputGroup.InputGroup--inline
        height: 82px;
      .Input--vTop .Input-label
        margin-bottom: 6px;
      .title
        font-weight: 900;
        font-size: 24px;
      .repayable-amount-hint
        position: absolute;
        bottom: 0;
        margin-top: 18px;
        width: 100%;
        .repayable-helper-text
          font-size: 13px;
      .withdraw-fade-section-enter {
        opacity: 0;
        transform: translateX(60px);
      }
      .withdraw-fade-section-enter-active {
        opacity: 1;
        transform: translateX(0);
      }
      .withdraw-fade-section-exit {
        opacity: 1;
        transform: translateX(0);
      }
      .withdraw-fade-section-exit-active {
        opacity: 0;
        transform: translateX(-60px);
      }
      .withdraw-fade-section-enter-active,
      .withdraw-fade-section-exit-active {
        transition: opacity 600ms, transform 600ms;
      }
      .tc-form-container
        margin-top: 50px;
        margin-bottom: 46px;

        position: absolute;
        width: 100%;
        top: 0;

        .tc-form-field
          align-items: center;
          height: 44px;
          border: 1px solid rgba(22, 47, 86, 0.08);
          border-radius: 2px;
          margin-right: 24px;
          flex: 1;
          input
            height: 0;
          .amount-wrapper
            background: #f8f8f8;
            border: none;
            padding: 10px 16px;
            border-radius: 2px;
            margin-right: 18px;
            border-top-left-radius: 0;
            border-bottom-left-radius: 0;
            height: 100%;
            .help-content--currency
              font-size: 18px;
              .rzp-amount
              .rzp-currency, .rzp-whole, rzp-paise
                font-weight: 600;
          .tc-confirm-cta
            height: 100%;
            border-radius: 1px;

      .withdrawal-cta-container
        height: 82px;
        align-items: flex-end;
        display: flex;
        margin: 10px 12px 0;
        .btn
          height: 42px;
      .title-container
        display: flex;
        margin-bottom: 10px;
        align-items: center;
        img
          margin-right: 6px;
        .i
          font-size: 20px;
          margin-right: 6px;
          margin-top: 2px;
      .disbursal-details
        margin-bottom: 24px;
      .withdrawal-info
        align-items: center;
      .close-cta
        position: absolute;
        top: 12px;
        right: 12px;
        .Button
          color: #58666da6;
    .withdrawals__credit-meta
      padding: 32px;
      border-left: 2px solid #0b70f714;
      width: 420px;
      height: 100%;
      .title__wrapper
        display: flex;
        .low-balance-badge
          border: 1px solid rgba(240, 81, 80, 0.52);
          opacity: 0.5;
          background: #FFFFFF;
          width: 94px;
          height: 22px;
          color: #A9100F;
          font-size: 10px;
          padding: 3px 10px;
        img
          height: 12px;
          margin-top: 6px;
          margin-left: 4px;
        .title
          margin: 0 12px;
          font-size: 18px;
          flex: 1;
          font-weight: 600;

    .withdrawals__credit-meta__list
      margin-top: 8px;
      .withdrawals__credit-meta__list-item
        display: flex;
        img
          margin-top: 18px;
          height: 18px;
          width: 22px;
        .description__wrapper
          margin-left: 12px;
          display: flex;
          padding: 10px 0;
          width: 100%;
          &.no-top-padding
            padding-top: 0;
          .description
            flex: 1;
          .help-content--currency
            font-size: 16px;
            .rzp-amount
            .rzp-currency, .rzp-whole, rzp-paise
              font-weight: 600;
          &.bordered-bottom
            border-bottom: 1px solid rgba(22, 47, 86, 0.1);
          .PlaceholderLoader
            width: 52px;
            height: 20px;
            &:last-child
              margin-left: 5px;
              width: 20px;
          .credit-balance-indicator
            font-size: 22px;
            height: 14px;
            padding: 3px 3px 0;
            &.small
              font-size: 18px;
              height: 14px;
              padding: 4px 3px 0;
            &.pull-right
              margin-right: -30px;

    .repayment_details_wrapper
      width: 0px;
      margin-right: 40px;
      margin-left: -60px;
      &.show
        //transition: all 200ms ease-in-out;
        width: 390px;
        opacity: 0.5;
        .withdrawals__credit-meta
          width: 390px;
      &.hide
        //width: 0;
        transform: translate(-20%, 0);
        transition: all 200ms ease-in-out;
      //&.display-enter
      //  opacity: 0;
      //  transform: translateX(-100%);
      &.display-enter-active
        opacity: 0.5;
        margin-left: 0;
        transition: all 200ms ease-in-out;
      &.display-enter-done
        opacity: 1;
        width: 390px;
        transition: all 200ms ease-in-out;
        margin-left: 0;
        .withdrawals__credit-meta
          width: 390px;

      .withdrawals__credit-meta
        border-left: none;
        border-right :2px solid rgba(11,112,247,0.078);
        //.block-note
        //  text-align: right;
        //  padding-left: 0;
        //  padding-right: 10px;
        //  border-left: none;

    .credit_details_wrapper
      transition: all 200ms ease-in-out;
      .withdrawals__credit-meta
        padding: 32px 32px 14px 32px;
      &.show
        width: 420px;
      &.hide
        width: 0;
      &.display-enter
        opacity: 0.5;
        width: 100px;
      &.display-enter-active
        opacity: 0.7;
        width: 420px;
      &.display-enter-done
        opacity: 1;
        width: 420px;
        transition: all 200ms ease-in-out;

.block-note
  padding-left: 10px;
  position: relative;
  &::before, &::after
    position: absolute;
    top: 0;
    height: 100%;
    width: 3px;
    border-radius: 20px;
    background: #0b70e7;
  &::before
    content: " ";
    left: 0;
  &:after
    right: 0;
  &.thick
    &::before
      width: 4px;
      left: -2px;
  &.warning
    &::before, &::after
      background: #E79315;
  &.purple
    &::before, &::after
      background: #8684E3;
  &.success
    &::before, &::after
      background: #24A832;
  &.right-border
    padding-left: 0;
    padding-right: 10px;
    &::before
      content: none;
    &::after
      content: " ";


.withdrawals-tc-modal
  .content-wrapper
    margin: 12px 28px 24px;
    overflow: scroll;
    .tc-content
      line-height: 24px;
      font-size: 13px;
