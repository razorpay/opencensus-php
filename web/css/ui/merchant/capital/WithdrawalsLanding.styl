.FlashWithdrawals--Container
  tabbed-container
    padding-top: 14px;
    .rzp-amount
      .rzp-currency, .rzp-whole, rzp-paise
        font-weight: 600;
  tabbed-container content .content-wrapper
    padding: 0;
    .filters-wrapper
      display: flex;
      align-items: center;
      .list-filter-container
        flex: 1;
        padding: 24px;
        margin-bottom: 0;
      .repay-cta-container
        align-items: center;
        padding-right: 10px;
        font-size: 13px;
        .help-content--currency
          font-size: 14px;
        .PlaceholderLoader
          height: 24px;
          width: 132px;
          &:last-child
            height: 36px;
            width: 104px;
            margin-right: 12px;
    .table-responsive
      padding: 0 24px 24px;
      .table tbody tr td.row-action .btn-group .btn
        height: 24px;
        line-height: 7px;
      .no-results-container
        display: flex;
        justify-content: center;
        align-items: center;
        text-align: start;
        .content
          width: 300px;
  .withdrawals__top-summary
    height: 260px;
    position: relative;
    border-radius: 3px;
    background: #fff;
    box-shadow: 0 0 0 1px rgba(63,63,68,0.05), 0 1px 3px 0 rgba(63,63,68,0.15);
    color: rgba(22, 47, 86, 0.87);
    background-position: right;
    display: flex;
    padding-left: 152px;
    overflow-x: hidden;
    &:before
      content: '';
      background-image: url(assets/capital/onboarding_illustration.svg);
      background-repeat: no-repeat;
      position: absolute;
      z-index: 1;
      left: 0;
      top:0;
      bottom: 0;
      width: 210px;
      margin-left: -54px;
      background-position: -54px;
    .withdrawals__action-container
      padding: 40px 12px 24px 0px;
      width: 100%;
      position: relative;
      z-index: 2;
      .InputGroup.InputGroup--inline
        height: 82px;
      .Input--vTop .Input-label
        margin-bottom: 6px;
      .title
        font-weight: 900;
        font-size: 24px;
      .repayable-amount-hint
        margin-top: 18px;
        .repayable-helper-text
          font-size: 13px;
      .withdrawal-cta-container
        height: 84px;
        align-items: flex-end;
        display: flex;
        margin: 2px 12px 0;
      .title-container
        display: flex;
        margin-bottom: 10px;
        align-items: center;
        img
          margin-right: 6px;
        .i
          font-size: 20px;
          margin-right: 6px;
          margin-top: 2px;
      .disbursal-details
        margin-bottom: 24px;
      .withdrawal-info
        align-items: center;
      .close-cta
        position: absolute;
        top: 12px;
        right: 12px;
        .Button
          color: #58666da6;
    .withdrawals__credit-meta
      padding: 32px;
      border-left: 2px solid #0b70f714;
      width: 420px;
      height: 100%;
      .title__wrapper
        display: flex;
        .low-balance-badge
          border: 1px solid rgba(240, 81, 80, 0.52);
          opacity: 0.5;
          background: #FFFFFF;
          width: 94px;
          height: 22px;
          color: #A9100F;
          font-size: 10px;
          padding: 3px 10px;
        img
          height: 12px;
          margin-top: 6px;
          margin-left: 4px;
        .title
          margin: 0 12px;
          font-size: 18px;
          flex: 1;
          font-weight: 600;

    .withdrawals__credit-meta__list
      margin-top: 8px;
      .withdrawals__credit-meta__list-item
        display: flex;
        img
          margin-top: 18px;
          height: 18px;
          width: 22px;
        .description__wrapper
          margin-left: 12px;
          display: flex;
          padding: 10px 0;
          width: 100%;
          &.no-top-padding
            padding-top: 0;
          .description
            flex: 1;
          .help-content--currency
            font-size: 16px;
            .rzp-amount
            .rzp-currency, .rzp-whole, rzp-paise
              font-weight: 600;
          &.bordered-bottom
            border-bottom: 1px solid rgba(22, 47, 86, 0.1);
          .PlaceholderLoader
            width: 52px;
            height: 20px;
            &:last-child
              margin-left: 5px;
              width: 20px;
          .credit-balance-indicator
            font-size: 22px;
            height: 14px;
            padding: 3px 3px 0;
            &.small
              font-size: 18px;
              height: 14px;
              padding: 4px 3px 0;
            &.pull-right
              margin-right: -30px;

    .repayment_details_wrapper
      width: 0px;
      margin-right: 40px;
      margin-left: -60px;
      &.show
        //transition: all 200ms ease-in-out;
        width: 420px;
        opacity: 0.5;
        .withdrawals__credit-meta
          width: 420px;
      &.hide
        //width: 0;
        transform: translate(-20%, 0);
        transition: all 200ms ease-in-out;
      //&.display-enter
      //  opacity: 0;
      //  transform: translateX(-100%);
      &.display-enter-active
        opacity: 0.5;
        margin-left: 0;
        transition: all 200ms ease-in-out;
      &.display-enter-done
        opacity: 1;
        width: 420px;
        transition: all 200ms ease-in-out;
        margin-left: 0;
        .withdrawals__credit-meta
          width: 420px;

      .withdrawals__credit-meta
        border-left: none;
        border-right :2px solid rgba(11,112,247,0.078);
        .block-note
          text-align: right;
          padding-left: 0;
          padding-right: 10px;
          border-left: none;
          border-right: 2px solid #0b70e7;

    .credit_details_wrapper
      transition: all 200ms ease-in-out;
      .withdrawals__credit-meta
        padding: 32px 32px 14px 32px;
      &.show
        width: 420px;
      &.hide
        width: 0;
      &.display-enter
        opacity: 0.5;
        width: 100px;
      &.display-enter-active
        opacity: 0.7;
        width: 420px;
      &.display-enter-done
        opacity: 1;
        width: 420px;
        transition: all 200ms ease-in-out;

.block-note
  padding-left: 10px;
  border-width: 0;
  border-left-width: 3px;
  border-style: solid;
  border-color: #0B70E7;
  &.thick
    border-left-width: 4px;
    margin-left: -2px;
  &.warning
    border-color: #E79315;
  &.purple
    border-color: #8684E3;
  &.success
    border-color: #24A832;
  &.right-border
    padding-left: 0;
    padding-right: 10px;
    border-width: 0;
    border-right-width: 3px;

