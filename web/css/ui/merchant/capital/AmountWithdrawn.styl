.cash-advance-body
  .card
    background: #fff;
    box-shadow: 0 0 0 1px rgba(63,63,68,0.05), 0 1px 3px 0 rgba(63,63,68,0.15);

  .withdrawals__top-summary
    min-height: 200px;
    position: relative;
    border-radius: 3px;
    color: rgba(22, 47, 86, 0.87);
    background-position: right;
    display: flex;
    justify-content: flex-start;
    transform: translateX(-30%);
    transition: all 500ms ease-in-out;

    &.move-right {
      transform: translateX(0%);
    }

    .withdrawals__top-summary-wrapper
      min-width: 100%;
      position: relative;
      display: flex !important;
      justify-content: space-between;
      flex: 1;

      .withdrawals__action-container
        padding: 29px 32px 20px 32px;
        width: 65%;
        position: relative;
        z-index: 2;

        .Input
          .error-message
            margin-top: 10px;

        .Input-addons
          top: 1px;
          bottom: 1px;
          line-height: 42px;

        input
          height: 42px;

        .InputGroup.InputGroup--inline
          height: 82px;

        .Input--vTop .Input-label
          margin-bottom: 12px;

        .title
          font-weight: 900;
          font-size: 24px;

        .repayable-amount-hint
          position: absolute;
          bottom: 0;
          margin-top: 18px;
          width: 100%;

          .repayable-helper-text
            font-size: 13px;

        .tc-form-container
          margin-top: 50px;
          margin-bottom: 46px;

          position: absolute;
          width: 100%;
          top: 0;

          .tc-form-field
            align-items: center;
            height: 44px;
            border: 1px solid rgba(22, 47, 86, 0.08);
            border-radius: 2px;
            margin-right: 24px;
            flex: 1;

            input
              height: 0;

            .amount-wrapper
              background: #f8f8f8;
              border: none;
              padding: 10px 16px;
              border-radius: 2px;
              margin-right: 18px;
              border-top-left-radius: 0;
              border-bottom-left-radius: 0;
              height: 100%;

              .help-content--currency
                font-size: 18px;
                .rzp-amount
                .rzp-currency, .rzp-whole, rzp-paise
                  font-weight: 600;

            .tc-confirm-cta
              height: 100%;
              border-radius: 1px;

        .withdrawal-cta-container
          height: 74px;
          align-items: flex-end;
          display: flex;
          margin: 0px 20px;

          .btn
            height: 42px;

            &.withdraw-now-btn
              width: 150px;

        .title-container
          display: flex;
          margin-bottom: 10px;
          align-items: center;

          img
            margin-right: 6px;

          .i
            font-size: 20px;
            margin-right: 6px;
            margin-top: 2px;

        .disbursal-details
          margin-bottom: 24px;

        .withdrawal-info
          align-items: center;
          padding-top: 17px;
          border-top: 1px solid rgba(22, 47, 86, 0.1);

          .withdrawal__amount,
          .withdrawal__repayable
            span
              font-weight: 600;

          .withdrawal__amount,
          .withdrawal__date,
          .withdrawal__repayable
            p
              font-weight: 600;
              color: rgba(22, 47, 86, 0.54);

          .withdrawal__date,
          .withdrawal__repayable
            margin-left: 30px;

          .withdrawal__ctas
            margin-left: 40px;

          .Button
            font-weight: bold;

            &:nth-of-type(2)
              margin-left: 15px;

        .close-cta
          position: absolute;
          top: 12px;
          right: 12px;

          .Button
            color: #58666da6;

    .withdrawals__credit-meta
      padding: 29px 22px 20px 22px;
      width: 100%;
      height: 100%;

      .title__wrapper
        display: flex;

        .low-balance-badge
          border: 1px solid rgba(240, 81, 80, 0.52);
          opacity: 0.5;
          background: #FFFFFF;
          width: 94px;
          height: 22px;
          color: #A9100F;
          font-size: 10px;
          padding: 3px 10px;

        img
          height: 12px;
          margin-top: 6px;
          margin-left: 4px;

        .title
          margin: 0;
          font-size: 16px;
          flex: 1;
          font-weight: 600;

      .amount__wrapper
        margin: 10px 0px;

        .rzp-amount
          .rzp-currency,
          .rzp-whole,
          .rzp-paise
            font-weight: 900;

          .rzp-currency,
          .rzp-paise
            font-size: 16px;

          .rzp-whole
            font-size: 24px;

    .withdrawals__credit-meta__list
      display: flex;

      .withdrawals__credit-meta__list-item
        display: flex;

        &:nth-of-type(1)
          margin-right: 12px

        &:nth-of-type(2)
          padding-left: 12px
          border-left: 1px solid rgba(22, 47, 86, 0.24);

        img
          margin-top: 18px;
          height: 18px;
          width: 22px;

        .description__wrapper
          display: flex;
          align-items: flex-end;
          width: 100%;

          &.no-top-padding
            padding-top: 0;

          .description
            flex: 1;
            margin-right: 7px;

          .help-content--currency
            // font-size: 16px;

            .rzp-amount
            .rzp-currency, .rzp-whole, rzp-paise
              font-weight: 600;

          .PlaceholderLoader
            width: 52px;
            height: 20px;
            &:last-child
              margin-left: 5px;
              width: 20px;
          .credit-balance-indicator
            font-size: 22px;
            height: 14px;
            padding: 3px 3px 0;
            &.small
              font-size: 18px;
              height: 14px;
              padding: 4px 3px 0;
            &.pull-right
              margin-right: -30px;

    .credit_details_wrapper
      transition: all 200ms ease-in-out;
      width: 34%;

      .withdrawals__credit-meta
        display: flex;
        flex-direction: column;

        .withdrawals__footer
          margin-bottom: 0;
          margin-top: auto;

          button
            font-weight: 600;
            margin-right: 5px;

            &:nth-of-type(2)
              padding-left: 9px;
              border-left: 1px solid rgba(22, 47, 86, 0.1);

    .withdrawals__footer
      padding-top: 12px;
      border-top: 1px solid rgba(22, 47, 86, 0.08);
      font-size: 13px;
      margin-bottom: auto;
      margin-top: 26px;

    .left-border
      &:before
        content: '';
        float: left;
        border-left: 4px solid #0B70E7;
        opacity: 1;
        margin: 0px 16px -4px -22px;
        height: 36px;
        border-radius: 2px;

    .repayment_details_wrapper
      width: 29%;
      margin-right: 1%;
      flex-shrink: 0;
      opacity: 0;

      &.fade-in {
        -webkit-animation: fadeIn 500ms linear 200ms;
        -webkit-animation-fill-mode: forwards;
        animation: fadeIn 500ms linear 200ms;
        animation-fill-mode: forwards;
      }

      &.fade-out {
        -webkit-animation: fadeOut 200ms linear;
        -webkit-animation-fill-mode: forwards;
        animation: fadeOut 200ms linear;
        animation-fill-mode: forwards;
      }

      .withdrawals__credit-meta {
        display: flex;
        flex-direction: column;
        flex-grow: 0;
        flex-shrink: 0;
      }

      .withdrawals__credit-meta
        border-left: none;
        border-right :2px solid rgba(11,112,247,0.078);


@-webkit-keyframes fadeIn {
  0% { opacity: 0; }
  100% { opacity: 1; }
}

@keyframes fadeIn {
  0% { opacity: 0; }
  100% { opacity: 1; }
}

@-webkit-keyframes fadeOut {
  0% { opacity: 1; }
  100% { opacity: 0; }
}

@keyframes fadeOut {
  0% { opacity: 1; }
  100% { opacity: 0; }
}
