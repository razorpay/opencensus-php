.cash-advance-body
  .info-icon
    width: 16px
    height: 16px
    margin: 2px
  .redirect-icon
    width: 14px
    height: 14px
    margin: 0 0 0 6px
  .repay-amount-wrapper
    margin: 12px 0 0 48px
    height: 40px
    line-height: 40px
  .repay-info-container
    flex-direction: column
    cursor: pointer
    height: 40px
    margin: 0 0 0 16px
    white-space: nowrap
    .top-part
      align-items: center
      .repayment-label
        font-size: 14px
        line-height: 20px
        color: #8895A8
      .info-icon
        color: #8895A8
        margin-left: 5px
        cursor: pointer
    .bottom-part
      font-weight: 600
      font-size: 14px
      line-height: 20px
      color: #324664
      opacity: 0.87
  .amount-icon
    width: 32px
    height: 32px
  .card-limit-text
    font-weight: 400
    font-size: 12px
    line-height: 20px
    color: #5D6D86
    margin: 0 0 0 6px
    .updated-card-balance-text
      margin: 0 0 0 4px
  .overview-card-icon
    width: 16px
    height: 12px
    margin: 5px 0 0 0
  @-webkit-keyframes fadeIn
    0% 
      opacity: 0
    100%  
      opacity: 1
  @keyframes fadeIn
    0%
      opacity: 0
    100%
      opacity: 1
  @-webkit-keyframes fadeOut
    0% 
      opacity: 1
    100% 
      opacity: 0
  @keyframes fadeOut
    0% 
      opacity: 1
    100% 
      opacity: 0
  @keyframes first-withdraw-offer-slideIn
    0%
      opacity: 0
      transform: translateY(-100%)
    50%
      opacity: 0
      transform: translateY(-100%)
    100%
      transform: none
      opacity: 1
  @keyframes pulse_pseudo
    0%
      opacity: 1
      transform: translate(-50%,-50%) scale(1)
    100%
      opacity: 0;
      transform: translate(-50%,-50%) scale(2.25)
  @keyframes pulse_shadow
    0% 
      box-shadow: 0 #2189e840
    100%
      box-shadow: 0 0 6px 20px #2189e800
  .card
    background: #fff;
    box-shadow: 0 0 0 1px rgba(63,63,68,0.05), 0 1px 3px 0 rgba(63,63,68,0.15);

  .withdrawals__top-summary
    min-height: 200px;
    position: relative;
    border-radius: 3px;
    color: rgba(22, 47, 86, 0.87);
    background-position: right;
    display: flex;
    justify-content: flex-start;
    transform: translateX(-30%);
    transition: all 500ms ease-in-out;
    z-index: 5;

    &.move-right {
      transform: translateX(0%);
    }

    .withdrawals__top-summary-wrapper
      min-width: 100%;
      position: relative;
      display: flex !important;
      justify-content: space-between;
      flex: 1;

      .withdrawals__action-container
        padding: 30px 32px;
        width: 65%;
        position: relative;
        z-index: 2;
        border-radius: 4px

        .onhold-reason-container
          flex-direction: column;
          justify-content: space-between

        .text-small
          font-size: 13px;

        .Input
          .error-message
            margin-top: 10px;

        .Input-addons
          top: 1px;
          bottom: 1px;
          line-height: 42px;

        input
          height: 42px;

        .InputGroup.InputGroup--inline
          height: 82px;

        .Input--vTop .Input-label
          margin-bottom: 12px;
          font-weight: 600;
          font-size: 16px;
          line-height: 22px;
          color: #324664;

        .title
          font-weight: 800;
          font-size: 24px;

        .end-align
          align-items: flex-end;

        .withdrawals__onhold-icon
          color: #F06B0A;
          font-size: 18px;
          height:18px;
          &.bottom-section-icon
            color: #2A8CFF;
            font-size: 15px;
            height: 15px;
            margin-right: 12px;


        .withdrawals__onhold-title
          font-weight: 800;
          font-size: 20px;
          line-height: 24px;
          margin-left: 10px;

        .withdrawals__onhold-summary
          font-size: 14px;
          line-height: 20px;
          margin-top: 9px;
          font-weight: 400;
          font-weight: normal;
          color: rgba(22, 47, 86, 0.76);
          &__disabled-loc-loading
            margin-top: 20px;
            .w-full
              width: 100%;
            .w-6
              width: 66%;
            .w-3
              width: 36%;
            .mt-7
             margin-top: 28px;

        .outstanding__wrapper
          flex-direction: row;
          padding-top: 16px;
          align-items: flex-start;
          border-top: 1px solid rgba(22,47,86,0.08);
          margin-top: 40px;

        .outstanding-paybutton
          padding:12px 32px;
          margin-left: 40px;
          font-weight: 600;

        .outstanding-title
          font-weight: 600;
          font-size: 13px;
          line-height: 20px;
          color: rgba(22, 47, 86, 0.54);

        .outstanding-amount {
          font-weight: 600;
          font-size: 16px;
          line-height: 20px;
          color: rgba(22, 47, 86, 0.87);
          margin-top: 2px;

             .rzp-amount, .rzp-whole, .rzp-paise{
              font-weight: 600;
             }
        }

        .repayment-succesfull-title
          font-weight: 800;
          line-height: 24px;
          margin-left: 9px;
          color:rgba(22, 47, 86, 0.87);

        .repayment-succesfull-summary
          color:rgba(22, 47, 86, 0.76);
          border-bottom: 1px solid rgba(22,47,86,0.08);
          padding-bottom: 40px;
          margin-top: 9px;

        .repayment-succesfull-breakdown-wrapper  {
          flex-direction: row;
          padding-top: 16px;
          align-items: flex-start;
            & > div {
              display: flex;
              flex-direction: column;
              align-items: center;
            }
            & > div:nth-of-type(1) {
             margin-right: 24px
             align-items: baseline;
            }
            & > div:nth-of-type(2) {
             margin-right: 20px
            }
            & > div:nth-of-type(3) {
             margin-right: 40px
            }
            & > div:nth-of-type(4) {
              align-items: baseline;
            }
        }


        .repayment-succesfull-breakdown-title
          font-size: 13px;
          line-height: 20px;
          font-weight: 600;
          color:  rgba(22, 47, 86, 0.54);

        .repayment-succesfull-breakdown-amount-wrapper {
          margin-top: 2px;
          width: 100%;
         }

        .repayment-succesfull-breakdown-amount {
          font-weight: 600;
          font-size: 16px;
          line-height: 30px;
          color: rgba(22, 47, 86, 0.87);
            .rzp-amount, .rzp-whole, .rzp-paise{
              font-weight: 600;
            }
         }


        .repayable-amount-hint
          position: absolute;
          bottom: 0;
          margin-top: 18px;
          width: 100%;

          .repayable-helper-text
            font-size: 14px;

        .tc-form-container
          margin-top: 50px;
          margin-bottom: 46px;

          position: absolute;
          width: 100%;
          top: 0;

          .tc-form-field
            align-items: center;
            height: 44px;
            border: 1px solid rgba(22, 47, 86, 0.08);
            border-radius: 2px;
            margin-right: 24px;
            flex: 1;

            input
              height: 0;

            .amount-wrapper
              background: #f8f8f8;
              border: none;
              padding: 10px 16px;
              border-radius: 2px;
              margin-right: 18px;
              border-top-left-radius: 0;
              border-bottom-left-radius: 0;
              height: 100%;

              .help-content--currency
                font-size: 18px;
                .rzp-amount
                .rzp-currency, .rzp-whole, rzp-paise
                  font-weight: 600;

            .tc-confirm-cta
              height: 100%;
              border-radius: 1px;

        .withdrawal-cta-container
          height: 74px;
          align-items: flex-end;
          display: flex;
          margin: 0 20px 0 16px;

          .btn
            height: 42px;

            &.animation-wrapper
              animation: pulse_shadow 1.5s ease-in-out infinite

            &.withdraw-now-btn
              width: 150px;

        .title-container
          display: flex;
          margin-bottom: 10px;
          align-items: center;

          img
            margin-right: 6px;

          .i
            font-size: 20px;
            margin-right: 6px;
            margin-top: 2px;

        .disbursal-details
          margin-bottom: 24px;

        .withdrawal-info
          align-items: center;
          padding-top: 17px;

          .withdrawal__amount,
          .withdrawal__repayable
          .withdrawal__limit,
          .withdrawal__repayment-preference,
          .withdrawal__change-preferenece
            span
              font-weight: 600;

          .withdrawal__amount,
          .withdrawal__date,
          .withdrawal__repayable
          .withdrawal__limit,
          .withdrawal__repayment-preference,
          .withdrawal__change-preferenece
            p
              font-weight: 600;
              color: #162f568a

          .withdrawal__date,
          .withdrawal__repayable
          .withdrawal__limit,
          .withdrawal__repayment-preference
            margin-left: 24px;

          .fungible_date
            margin-left: 0

          .withdrawal__ctas
            margin-left: 40px;

          .Button
            font-weight: 600;

            &:nth-of-type(2)
              margin-left: 15px;

          .view-details-link
            display: inline-flex
            margin: 0 0 0 12px

        .top-border
          border-top: 1px solid #162f561a

        .vertical-splitter
          width: 1px
          height: 44px
          margin-left: 24px
          background: linear-gradient(180deg, #eaeaea00 0%, #162f5629 20.83%, #162f5629 80.73%, #eaeaea00 100%)

        .tooltip-wrapper

          .card-balance-popover.rzp-popover.rzp-tooltip
            position: absolute
            top: 40px !important
            left: 321px !important

          .card-balance-text
            font-weight: 400
            font-size: 14px
            line-height: 20px
            color: #C4CBD7

        .close-cta
          position: absolute;
          top: 12px;
          right: 12px;

          .Button
            color: #58666da6;

        .withdrawals-disabled
          .withdrawals-disabled-title-wrapper
            padding-bottom: 40px;
            border-bottom: 1px solid rgba(22,47,86,0.08);
            .flex
              display: flex;
              flex-direction: row;
              align-items: flex-end;
            .withdrawals-disabled-icon
              color: #F06B0A;
              font-size: 18px;
              height:18px;
            .withdrawals-disabled-title
              font-weight: 800;
              font-size: 20px;
              line-height: 24px;
              margin-left: 10px;
          .withdrawals-disabled-summary
            font-size: 14px;
            width: fit-content;
            line-height: 20px;
            margin-top: 8px;
            font-weight: 400;

          .cta_wrapper
            flex-direction: row;
            padding-top: 16px;
            align-items: center;
            button
              padding:12px 24px;
              font-weight: 600;
              font-size: 14px;
              line-height: 16px;

    .withdrawals__credit-meta
      padding: 29px 22px 20px 22px;
      width: 100%;
      height: 100%;

      .title__wrapper
        display: flex;

        .low-balance-badge
          border: 1px solid rgba(240, 81, 80, 0.52);
          opacity: 0.5;
          background: #FFFFFF;
          width: 94px;
          height: 22px;
          color: #A9100F;
          font-size: 10px;
          padding: 3px 10px;

        img
          height: 12px;
          margin-top: 6px;
          margin-left: 4px;

        .title
          margin: 0;
          font-size: 14px;
          flex: 1;
          font-weight: 600;

      .amount__wrapper
        margin: 10px 0px;

        .rzp-amount
          .rzp-currency,
          .rzp-whole,
          .rzp-paise
            font-weight: 800;

          .rzp-currency,
          .rzp-paise
            font-size: 16px;

          .rzp-whole
            font-size: 24px;


    .withdrawals__credit-meta__header
      display flex;
      align-items: center;
      justify-content: space-between;

    .withdrawals__status__wrapper
      background:  rgba(205, 130, 20, 0.1);
      border: 1px solid rgba(205, 130, 20, 5.4);
      border-radius: 2px;
      padding: 4px 12px;

      .withdrawals__status
        font-size: 10px;
        font-style: normal;
        font-weight: 600;
        text-transform: uppercase;
        line-height: 14px;
        letter-spacing: 0.4px;
        color: #CD8214;

    .withdrawals__status__wrapper-parent
      .title
        font-weight: 800;
        font-size: 20px;
        line-height: 24px;
        color: rgba(22, 47, 86, 0.87);
      & + .summary
        font-weight: normal;
        font-size: 14px;
        line-height: 20px;
        color: #4E617F;
        margin-top: 12px;
      .withdrawals__status__wrapper
        width: 74px;
        height: 20px;
        background: rgba(205, 130, 20, 0.1);
        border-radius: 15px;
        display: flex;
        justify-content: center;
        align-items: center;
        margin-left: 12px;
        .withdrawals__status
          font-size: 10px;
          line-height: 14px;
          font-weight: 600;
          text-transform: uppercase;
          color: #CD8214;
          letter-spacing: normal;

    .withdrawals__credit-meta__list
      display: flex;

      .withdrawals__credit-meta__list-item
        display: flex;

        &:nth-of-type(1)
          margin-right: 12px

        &:nth-of-type(2)
          padding-left: 12px
          border-left: 1px solid rgba(22, 47, 86, 0.24);

        img
          margin-top: 18px;
          height: 18px;
          width: 22px;

        .description__wrapper
          display: flex;
          align-items: flex-end;
          width: 100%;

          &.no-top-padding
            padding-top: 0;

          .description
            flex: 1;
            margin-right: 7px;

          .help-content--currency
            // font-size: 16px;

            .rzp-amount
            .rzp-currency, .rzp-whole, rzp-paise
              font-weight: 600;

          .PlaceholderLoader
            width: 52px;
            height: 20px;
            &:last-child
              margin-left: 5px;
              width: 20px;
          .credit-balance-indicator
            font-size: 22px;
            height: 14px;
            padding: 3px 3px 0;
            &.small
              font-size: 18px;
              height: 14px;
              padding: 4px 3px 0;
            &.pull-right
              margin-right: -30px;

    .credit_details_wrapper
      transition: all 200ms ease-in-out;
      width: 34%;
      border-radius: 4px

      .withdrawals__credit-meta
        display: flex;
        flex-direction: column;

        .withdrawals__footer
          margin-bottom: 0;
          margin-top: auto;

          button
            font-weight: 600;
            margin-right: 5px;

            &:nth-of-type(2)
              padding-left: 9px;
              border-left: 1px solid rgba(22, 47, 86, 0.1);

    .withdrawals__footer
      padding-top: 12px;
      border-top: 1px solid rgba(22, 47, 86, 0.08);
      font-size: 13px;
      margin-bottom: 0;
      margin-top: auto;

    .left-border
      &:before
        content: '';
        float: left;
        border-left: 4px solid #0B70E7;
        opacity: 1;
        margin: 0px 16px -4px -22px;
        height: 36px;
        border-radius: 2px;

    .repayment_details_wrapper
      width: 29%;
      margin-right: 1%;
      flex-shrink: 0;
      opacity: 0;

      &.fade-in {
        -webkit-animation: fadeIn 500ms linear 200ms;
        -webkit-animation-fill-mode: forwards;
        animation: fadeIn 500ms linear 200ms;
        animation-fill-mode: forwards;
      }

      &.fade-out {
        -webkit-animation: fadeOut 200ms linear;
        -webkit-animation-fill-mode: forwards;
        animation: fadeOut 200ms linear;
        animation-fill-mode: forwards;
      }

      .withdrawals__credit-meta
        display: flex;
        flex-direction: column;
        flex-grow: 0;
        flex-shrink: 0;
        border-left: none;
        border-right :2px solid rgba(11,112,247,0.078);

.cash-advance-first-withdrawal-background
  position: absolute
  background: #fff
  box-shadow: 2px 2px 6px rgba(22, 47, 86, 0.08)
  top: 0
  left: 0
  bottom: 0
  right: 0

.cash-advance-first-withdrawal
  position: absolute
  top: 100%
  right: -1px
  left: 0
  padding: 13px 12px 13px 30px
  border: 1px solid rgba(68, 155, 171, 0.12);
  background: #DCF4FB
  border-radius: 0 0 6px 6px
  animation: 1s first-withdraw-offer-slideIn
  > i
    color: #1C9CB2
    margin-right: 6px
  span
    color: #1C9CB2
    font-weight: 600
    position: relative
    cursor: pointer
    &:hover > p
      display: block
  p
    cursor: normal
    display: none
    background: #2C3243
    font-weight: normal
    color: #fff
    padding: 16px
    border-radius: 3px
    position: absolute
    width: 260px
    left: 50%
    margin-left: -40px
    top: 100%
    margin-top: 12px
    font-size: 13px
    &:before
      content: ''
      position: absolute
      border: 6px solid transparent
      border-bottom-color: #2C3243
      bottom: 100%
      left: 40px
    &:after
      content: ''
      position: absolute
      top: -13px
      left: 0
      right: 0
      height: 13px
    strong
      font-size: 14px

.show-first-withdrawal-offer
  .repayment_details_wrapper .withdrawals__credit-meta
    height: calc(100% + 48px)
  +.overview-footer, +tabbed-container
    margin-top: 70px

.withdrawals__footer-first-withdrawal-info
  background: #F0F9FB
  padding: 10px 14px
  border-radius: 2px
  margin: 10px 0 -20px

.success-heading-container-settings
  display: flex
  align-items: center  
  gap: 24px
  justify-content: space-between

  .withdrawal__ctas
    margin-bottom: 24px;
    display: flex;
    gap: 12px;
    margin-right: 32px;

    .Button--secondary
      border: 1px solid #528ff0;

.change-preference-link
  font-weight: 600
  font-size: 14px
  line-height: 20px
  color: #2A86F3
  margin-left: 10px
  align-self: flex-end