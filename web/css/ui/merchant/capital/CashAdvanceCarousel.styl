.overview-carousel-container
  height: 222px;
  width: 100%;
  max-width: 600px;
  .slides-container {
    position: relative;
    display: flex;
    min-height: 220px;
    width: 100%;
    height: 100%;
    overflow: hidden;
    .slide-container {
      width: 100%;
      height: 100%;
      transition-property: all;
      transition-duration: 500ms;
      transition-timing-function: ease-in-out;
      position: absolute;
      z-index: 3;
      opacity: 0;
      &.active{
        z-index: 4;
        opacity: 1;
      }
      .slide {
        max-width: 100%;
        color: white;
        text-align: left;
        padding: 28px 24px;
        border-radius: 4px;
        height: 100%;
        display: flex;
        flex-direction: column;
        .footer {
          z-index: 2;
          align-items: center;
          display: flex;
          margin-top: auto;
          .left {
            flex: 1;
            display: flex;
            button {
              z-index: 2;
              background: rgba(255, 255, 255, 0.9);
              border-radius: 2px;
              border: none;
              max-height: 36px;
              min-height: 36px;
              width: 128px;
              font-size: 15px;
              line-height: 24px;
              color: white;
              cursor: pointer;
              font-weight: 600;
            }
          }
          .right {
            display: flex;
            .right-section-wrapper {
              display: flex;
              background: rgba(0, 0, 0, 0.1);
              .data-pair-container {
                border-radius: 2px;
                padding: 8px 16px;
                .data-pair {
                  display: flex;
                  .text {
                    font-style: normal;
                    font-weight: normal;
                    line-height: 20px;
                    padding: 0;
                  }
                  .label {
                    font-size: 12px;
                    color: rgba(255, 255, 255, 0.75);
                    margin-right: 18px;
                  }
                  .value {
                    font-size: 13px;
                    color: rgba(255, 255, 255, 1);
                  }
                }
              }
            }
            .icon-set,
            .right-section-wrapper > .icon-set {
              position: relative;
              margin-top: -8px;
              margin-right: -2px;
            }
            .icon-set  .layer2,
            .right-section-wrapper > .icon-set > .layer2 {
              position: absolute;
              top: 26px;
              height: 38px;
              width: 64px;
              display: flex;
              align-items: center;
              justify-content: center;
            }
          }
        }
        button {
          &.nav {
            background: rgba(255, 255, 255, 0.6) !important;
            max-width: 36px;
            min-width: 36px;
            padding: 0 !important;
            opacity: 0.9;
            margin-left: 12px;
          }
        }
        .header {
          display: flex;
          background: transparent;
          border: none;
          padding: 0;
          .left {
            flex: 1;
            .title, .subtitle{
              margin: 0 0 12px 0;
            }
            .title {
              font-style: normal;
              font-weight: 600;
              font-size: 14px;
              line-height: 20px;
              color: #ffffff;
            }
            .subtitle {
              font-style: normal;
              font-weight: 800;
              font-size: 24px;
              line-height: 19px;
              color: rgb(255, 255, 255);
              .help-content--currency {
                .rzp-amount {
                  position: relative;
                  .rzp-currency, .rzp-whole, .rzp-paise {
                    font-weight: 800;
                  }
                  .rzp-paise{
                    position: absolute;
                    bottom: 3px;
                  }
                }
              }
            }
          }
          .right {
            padding: 8px;
          }
        }
        .body {
          font-size: 13px;
          line-height: 18px;
          margin-bottom: 18px;
          color: rgba(255, 255, 255, 0.76);
        }
        .background-pattern-image {
          position: absolute;
          opacity: 0.09;
          left: -40px;
          top: -38px;
          transform: rotate(-5deg);
          object-fit: none;
          background-repeat: space;
          z-index: 0;
        }
      }
    }
  }
  .nav {
    .i {
      font-size: 30px;
      line-height: 36px;
    }
    &.inactive {
      opacity: 0.4 !important;
    }
  }
  .dot-navigation-container {
    display: flex;
    .nav-dot {
      border: none;
      height: 9px;
      width: 9px;
      padding: 0;
      margin-right: 6px;
      background: #ffffff;
      cursor: pointer;
      &.disabled {
        cursor: default;
      }
      &.inactive {
        opacity: 0.2;
      }
      &.active {
        opacity: 0.9;
      }
    }
  }
