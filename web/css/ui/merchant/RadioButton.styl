@import 'rzp/vars.styl'

.RadioButton{
  margin: 16px 0;

  label {
    padding-left: 0;
    font-weight: normal;
    display: block;
  }

  input {
    display: none;

    &:checked + div {
      .RadioButton__button {
        &:before {
          opacity: 1;
          transform: rotate(42deg) translate(8px, -3px) scale(1);
        }
      }
    }
  }

  &__button {
    width: 20px;
    height: @width;
    background: #f5f5f5;
    border: 1px solid #E0E0E0;
    border-radius: 50%;
    float: left;
    cursor: pointer;

    &:before {
      content: '';
      position: absolute;
      width: 10px;
      height: 10px;
      margin-left: -4px;
      margin-top: 1px;
      border-radius: 50%;
      background-color: $primary-color;
      opacity: 0;
      transition: 0.2s;
      transform: rotate(42deg) translate(8px, -3px) scale(0.4);
    }
  }

  &__label {
    padding-left: 32px;
    line-height: 24px;
    cursor: pointer;
  }
}
