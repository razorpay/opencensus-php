.rzp-accounts-list {

  position: relative;

  .PowerSelect__TriggerInput {
    padding-left: 32px;
  }
}

.rzp-option-component {

  padding: 5px;
}

.rzp-account-item {

  margin-right: 5px;
  max-width: 500px;


  .account-name {

    text-overflow: ellipsis;
    overflow: hidden;
    max-width: 30%;
    white-space: nowrap;
    display: inline-block;
    vertical-align: top;

    &.tag-invisible {

      max-width: 50%;
    }
  }

  .account-id {

    vertical-align: top;
  }


  .custom-tag {
    font-size: 12px;
    line-height: 1;
    & > span.text {
      vertical-align: top;
    }

    &:before {

      display: none;
    }

    @media (max-width: 992px) {

      &:before {

        display: inline;
      }

      &> span.text {

        display: none;
      }
    }
  }
}

.rzp-account-item-preview {
  .id-email{
    color: #939AA6;
    font-size: 12px;
  }

  .account-id {
    vertical-align: middle;
  }
}
