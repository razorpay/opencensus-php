.Modal {
  margin: 65px auto;
  padding: 0;
  border: 0;
  box-shadow: 0 0 8px 0 rgba(0, 0, 0, 0.3);
  background-color: #fafafa;
  border-radius: 2px;

  .modal-header {
    padding: 24px 24px 0;
    border-bottom: 0;

    .modal-title {
      font-size: 18px;
      font-weight: bold;
      line-height: 1em;
    }

    .close {
      margin: 0;
    }
  }

  .modal-body {
    padding: 16px 24px 24px;
  }

  .Modal__actions {
    padding-top: 8px;
  }
}

.Modal--regular {
  max-width: 625px;

  @media (max-width: 625px) {
    margin-left: 10px;
    margin-right: 10px;
  }
}

.Modal--medium {
  max-width: 375px;

  @media (max-width: 625px) {
    margin-left: 10px;
    margin-right: 10px;
  }
}

.Modal--med-large {
  max-width: 473px;

  @media (max-width: 625px) {
    margin-left: 10px;
    margin-right: 10px;
  }
}

.Modal--small {
  max-width: 328px;

  @media (max-width: 328px) {
    margin-left: 10px;
    margin-right: 10px;
  }
}

.Modal--large {
  max-width: 756px;

  @media (max-width: 756px) {
    margin-left: 10px;
    margin-right: 10px;
  }
}

.Modal--xlarge {
  max-width: 850px;

  @media (max-width: 756px) {
    max-width: 756px;
    margin-left: 10px;
    margin-right: 10px;
  }
}

.RazorpayXNitroAnnouncement--Modal {
  max-width: fit-content
}

.PL_Catalyst_Banner--Modal {
  max-width: 1020px;
  position: relative;
  overflow: hidden;

  .nomob {
    @media (max-width: 768px) {
      display: none;
    }
  }

  .mob {
    display: none

    @media (max-width: 768px) {
      display: unset
    }
  }

  @media (max-width: 768px) {
    max-width: 624px;
  }
}

.Modal--full-screen {
  width: 100%;
  height: 100%;
  margin: 0;
  top: 0;
  bottom: 0;
}

.Modal--confirm {
  .Modal__actions {
    > .btn {
      width: 48%;
    }

    > .btn + .btn {
      margin-left: 4%;
    }
  }
}

.confirm-note {
  background-color: #FCF8E3;
  color: #515978;
  border-left: 4px solid #FFBB00;
  font-size: 13px;
  padding: 5%;
  margin-top: 5%;
  margin-bottom: 5%;

  >p:first-child {
    font-weight: bold;
  }
}

.confirm-note-info {
  background-color: #F8FAFB;
  border-left: 4px solid #528FF0;
  font-size: 12px;
  padding: 0 5%;
  color: #515978;
  margin-top: 5%;
  margin-bottom: 5%;
  font-size: 13px;

  >p:first-child {
    font-weight: bold;
  }
}
