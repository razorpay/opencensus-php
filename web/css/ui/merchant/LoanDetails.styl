  max-width: 328px;
  .modal-title
    display: flex;
    img
      margin-top: -2px;
      margin-right: 8px;

.capital-landing-spinner-container
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%)
