$ticketSystemCdn = 'https://cdn.razorpay.com/static/assets/ticket-system';


.support
  position: absolute
  z-index: 9999 // smooch hit area has 9998
  .notify-icon
    display: inline-block;
    position: absolute;
    background: #f05050;
    width: 20px;
    height: 20px;
    right: -10px;
    top: -10px;
    border-radius: 50%;
    text-align: center;
    color: #fff;
.support-launcher
  position: fixed;
  bottom: 20px;
  right: 20px;
  width: 60px;
  height: 60px;
  border-radius: 50%;
  cursor: pointer;
  background-color: $sidebar-bg-color
  transform-origin: center;
  -webkit-backface-visibility: hidden;
  backface-visibility: hidden;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  box-shadow: 0 5px 4px 0 rgba(0,0,0,.26);
  .open-icon, .close-icon
    font-size: 1.5em;
    color: #fff
    display: flex;
    align-items: center;
    justify-content: center;
    position: absolute;
    top: 4px;
    bottom: 0;
    width: 100%;
    transition: transform 0.16s linear, opacity 0.08s linear, -webkit-transform 0.16s linear;
  .open-icon
    opacity: 1
    transform: rotate(0deg) scale(1);
  .close-icon
    opacity: 0
    transform: rotate(-30deg);
  &.active
    .notify-icon
      display: none
    .open-icon
      opacity: 0;
      transform: rotate(30deg) scale(0);
    .close-icon
      opacity: 1;
      transform: rotate(0deg);
.onboarding-screen
  bottom: 60px;
  right : 30px;
.support-body
  position fixed
  background: #fff
  bottom: 100px;
  right: 40px;
  border-radius: 4px
  box-shadow: 0 5px 20px rgba(0,0,0,.16);
  overflow: hidden;
  transition: all 150ms ease-in;
  opacity: 0;
  max-width: 450px;
  height: 0;
  &.active
    opacity: 1
    height: auto
  header
    font-size: 16px
    font-weight: 600
    padding: 16px
    background-color: $sidebar-bg-color
    color: #fff
    .mob-close
      display: none
  .support-feedback
    overflow: hidden
    button
      display: inline-block
      width: 50%
      padding: 12px
  .support-list
    list-style: none
    padding: 0
    margin: 0
    .support-item
      display: block
      height: 80px
      padding-left: 80px
      padding-top: 20px
      cursor: pointer
      background-size: 40px;
      background-repeat: no-repeat;
      background-position: 20px;
      &:hover:not(.disabled)
        background-color: #f6fcfd
      &.disabled
        pointer-events: none
        background-color: #f6f6f6
        cursor: auto
        .help-block
          color:rgba(240, 81, 80, 0.7)
      .help-content
        color: #A3B0B7
        cursor: auto
      &:not(:last-child)
        border-bottom: 1px solid rgba(158, 157, 157, 0.4)
      &.dashboard_guide
        background-image: url(assets/support_widget/bulb.svg)
      &.ticket
        background-image: url($ticketSystemCdn/icon-paper.png)
      &.callback
        background-image: url($ticketSystemCdn/icon-call.svg)
        .badge
          background: #1AAE94;
          position: relative;
          left: 4px;
          border-radius: 2px;
          top: -1px;
      &.callback.disabled
        filter: grayscale(100%)
      &.chat:not(.disabled)
        background-image: url($ticketSystemCdn/icon-chat.png)
      &.history:not(.disabled)
        background-image: url($ticketSystemCdn/icon-history.svg)
      &.call:not(.disabled)
        background-image: url($ticketSystemCdn/icon-support-call.svg)
      &.chat.disabled
        background-image: url(assets/support_widget/chat_disabled.svg)
      &.call.disabled
        background-image: url(assets/support_widget/call_disabled.svg)
  .notify-icon
    position: relative;
    right: 0;
    top: 0;
    width: 28px;
    border-radius: 15px;
    font-size: 12px;
    line-height: 20px

// hide hotjar feedback button
div[class$="feedback_minimized_label"]
  display: none

@media(max-width: 424px)
  .support-body
    width: 100%
    height: 0
    top: 0
    left: 0
    border: 1px solid rgba(179, 179, 179, 0.3)
    &.active
      height: 100%
    .mob-close
      font-size: 24px;
      font-weight: bold;
      display: inline-block !important

@media(max-height: 424px)
  .support-body .support-list .support-item
    padding-top: 10px
    height: 60px

.write-to-us
  padding: 20px
  .i-close
    position: absolute;
    top: 8px;
    cursor: pointer;
    right: 5px;
  .write-to-us-heading-container
    margin:-20px -20px 20px -20px
    height: 100px;
    display: flex
    align-items:center
    justify-content:center
    background: url('assets/instant_activations/pending_background.png') top left no-repeat;
    &.write-to-us-heading
      color: #fff
      margin:20px 20px
  .write-to-us-content
    margin: 0px 0px 20px 0px
  .write-to-us-button-container
    display: flex
    justify-content: space-between
    flex-wrap: wrap;

    .btn
      height: 32px;
      width: 46%;
      padding: 0px;
      margin: 2%;
      font-size: 13px;

    &.thanks-button, &.continue-button
      border:none
      border-radius: 2px
    &.thanks-button
      color: #fff
      background-color: #528ff0
      &:hover:not(.disabled)
        background-color:#3b80ee
      margin: 0px 0px 20px 10px;
      width: 50%;
      padding-left: 37px;
    &.continue-button
      background-image: none;
      background-color:rgb(250,250,250)
      margin:0px 0px 20px 0px;

#ymDivBar
  display: none !important;

#chatDetails
  div.close-chat
    display: none !important;

#ymFrameHolder
  right: 50px !important;
  left: auto !important;


.minimize-bot
  align-items: center;
  background-color: #707c92;
  border-radius: 1rem;
  cursor: pointer;
  display: flex;
  font-size: 1rem;
  justify-content: center;
  opacity: 0.7;
  position: absolute;
  right: -1px;
  top: -29px;
  transition: opacity 0.2s;
  height: 1.75rem;
  width: 2.5rem;
  padding: 11px 17px;
  padding-bottom: 15px;


.bot-close-icon
  &:before
    content: '\00d7';
    font-size: 18px;
    color: #fff;

#ym-notification
  display: none;
