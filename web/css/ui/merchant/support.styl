$ticketSystemCdn = 'https://cdn.razorpay.com/static/assets/ticket-system';

.support
    position: fixed
    bottom:  -374px
    right: 25px
    width: 340px
    z-index: 9999 // smooch hit area has 9998
    transition: all .5s cubic-bezier(0.820, 0.085, 0.395, 0.895)
    opacity: 1
    box-shadow: 0 1px 2px rgba(0,0,0,.1)
    &.open
      bottom: 0
    &.hidden
      opacity: 0
  .support-notify
    background-color: #F76A69;
    padding: 0 8px;
    border-radius: 8px;
    font-size: 12px;
    color: #fff
  .support-header
    padding: 10px
    border-radius: 5px 5px 0 0;
    .support-toggle
      font-size: 16px
      margin-top: 4px
  .support-body 
    background: #fff
    padding-bottom: 16px
    h4
      font-size: 16px
      font-weight: 600
      margin-bottom: 16px
      margin-top: 4px
    .support-feedback
      button 
        display: inline-block
        width: 50%
        padding: 4px 16px
        height: 40px
    .rzp-banner
      margin: 0
      font-size: 13px
      border: none
    .support-list
      list-style: none
      border: 1px solid rgba(158, 157, 157, 0.4)
      padding: 0
      .support-item
        display: block
        height: 70px
        padding-left: 60px
        padding-top: 14px
        cursor: pointer
        background-size: 40px;
        background-repeat: no-repeat;
        background-position: 10px;
        &:hover:not(.disabled)
          font-weight: bold
          background-color: #f6fcfd
        &.disabled
          background-color: #efefef
        .help-content
          color: #A3B0B7
        &:not(:last-child)
          border-bottom: 1px solid rgba(158, 157, 157, 0.4)
        &.ticket
          background-image: url($ticketSystemCdn/icon-paper.png)
        &.chat
          background-image: url($ticketSystemCdn/icon-chat.png)
        &.call
          background-image: url($ticketSystemCdn/icon-support-call.svg)

  


