.Announcement_Banner

  background: #ffffff
  height: 50px
  position: relative
  border-radius: 2px
  box-shadow: 0 1px 4px 0 rgba(0,0,0,0.1)
  display: table;
  width: 100%;

  .title, .content, .close-btn {

    display: table-cell;
    vertical-align: middle;
  }

  .title, .close-btn {

    width: 0;
  }

  .close-btn {

    cursor: pointer;
    color: currentColor;
    font-size: 28px;
    padding-right: 15px;
  }

  .big-dot-separator {

    display: inline-block;
    width: 9px;
    height: 9px;
    margin: 0 8px;
    background-color: currentColor;
    border-radius: 50%;
  }

  .title
    position: relative;
    height: 100%;
    font-size: 50px
    font-weight: bold
    color: white
    border-radius: 2px 0 0 2px;
    padding-right: 50px;

    .title-content {

      position: relative;
      font-size: 15px;
      line-height: 18px;
      height: 100%;
      z-index: 1;
      padding-left: 15px;
      color: #fff;
      white-space: nowrap;
      display: table;

      .title-content-wrapper {

        display: table-cell;
        height: 100%;
        vertical-align: middle;
      }
    }

    &:before, &:after {

      position: absolute;
      display: block;
      content: "";
    }

    &:before {

      bottom: 0;
      width: 60px;
      height: 100%;
      opacity: 0.5;
      right: 25px;
      background-color: currentColor;
      transform: skew(30deg);
    }

    &:after {

      top: 0;
      width: 60px;
      height: 100%;
      right: 16px;
      background-color: currentColor;
      z-index: 0;
      transform: skewX(-35deg);
    }

  .corner
    display: none;
    float: left

  .content
    padding: 15px 15px 15px 8px
    width: 100%

  .btn-link 
    font-weight: bold
    text-decoration: none

    .i-chevron-right
      top: 2px
      left: 0
      position: relative

  @media (max-width: 1020px) {

    position: relative;

    .title, .content, .close-btn {

      display: block;
    }

    .title {

       width: 100%;
       padding-right: 0;
       height: auto;

       &:before, &:after {

         display: none;
       }

       .title-content {

         display: block;
         padding: 12px 37px 12px 12px;

         .title-content-wrapper {

           display: block;
         }
       }
     }

     .content {

       padding: 15px;
     }

     .close-btn {

       position: absolute;
       top: 0;
       right: 12px;
       z-index: 1;
       color: #fff;
     }
  }

.Modal .modal-body.rzp-early-stl-modal
  color: #58666E
  padding: 0

  .modal-header
    padding: 15px 0
  
  .modal-title
    font-size: 24px
    font-weight: bold
    line-height: 32px

  .help-block
    color: #58666E

  .modal-subtitle
    display: inline-block
    margin: 25px 0 10px 0
    font-size: 18px
    font-weight: bold
    line-height: 22px

  .content-left, .content-right
    display: inline-block
    width: 50%
    height: 100%
    vertical-align: top
    padding: 35px

    button.close
      margin: -30px -30px 0 0

  .content-left
    border-radius: 2px 0 0 2px
    background-color: #fff
    border-right: 1px solid #E0E0E0

    .form-action, button.close
      display: none
  
  .content-right
    background-color: #FAFAFA
    position: relative
    padding-left: 33px

    .modal-title
      font-size: 18px

    form
      margin-top: 24px;

    .radio-label
      .title
        font-size: 16px
        font-weight: bold
        line-height: 19px
      .description
        color: #7B8199

    .options-back-btn
      display: none

  .form-action
    position: absolute
    bottom: 0
    left: 0
    width: 100%
    text-align: right 
    border-top: 1px solid #E0E0E0
    background-color: #F6F6F6
    padding: 20px

    .Button:first-child
      margin-right: 20px

    .Button.Button--primary:last-child
      margin: 0

  .features-list 
    color: #58666E
    margin-top: 20px
    .feature-item
      margin: 20px 0
    .feature-icon
      width: 45px
      display: inline-block
      vertical-align: top
      padding: 5px
      img 
        width: 40px
    .feature-title
      font-weight: bold
    .feature-text
      color: #7B8199
    .feature-content
      display: inline-block
      width: 85%
      padding-left: 20px

.success-modal
  text-align: center
  background-color: #FFFFFF
  
  .success-banner-cnt
    height: 400px
    width: 100%
    position: relative

    .banner-header
      width: 100%
      position: absolute
      left: 0
      top: 0

    .banner
      width: 34%
      margin: 10% 33% 20px 33%
      display: inline-block

    .modal-title
      margin: 20px 0
      display: inline-block

    .help-block
      width: 57%
      margin: 0 auto
    
    .banner-footer
      width: 100%
      position: absolute
      left: 0
      bottom: 0

@media only screen and (max-width: 764px)
  .Modal .modal-body.rzp-early-stl-modal
    .content-left, .content-right
      width: 100%
      
    .content-left
      min-height: 600px

      .form-action, button.close, .options-back-btn
        display: block

    .content-right
      .options-back-btn
        display: inline-block
      
    .features-list 
      .feature-content
        width: 80%

  .success-modal
    .success-banner-cnt
      .help-block
        width: 75%
      .banner
        width: 50%
        margin: 60px 25% 20px 25%

.Announcement_Banner.with-tour
  margin-top: 20px

.Announcement_Banner--hide
  display: none

.Announcement_Banner.margin-bottom
  margin-bottom: 20px
