.Announcement_Banner
  padding: 12px
  text-align: center
  margin-bottom: 12px
  line-height: 20px
  color: #fff
  background-color: #5d89e5
  background: linear-gradient(223.96deg, #3059c0 0%, #5d89e5 100%)
  position: relative
  transition: 0.25s cubic-bezier(0.12, 1.03, 1, 1)

  &--hide
    height: 0
    margin: 0
    padding: 0

  .link
    text-decoration: underline
    color: inherit

  .close-btn
    font-size: 20px
    position: absolute
    top: 50%
    transform: translateY(-50%)
    right: 12px

