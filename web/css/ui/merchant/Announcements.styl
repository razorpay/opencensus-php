.Announcement_Banner
  margin: 65px 20px 0px 20px
  background: #ffffff
  height: 50px
  position: relative
  border-radius: 2px
  box-shadow: 0 1px 4px 0 rgba(0,0,0,0.1)

  .title
    float: left
    height: 50px
    font-weight: bold
    background: linear-gradient(270deg, #2682FF 0%, #415BD3 100%)
    color: white
    padding: 15px 0 15px 15px
    border-radius: 2px 0 0 2px

  .corner
    float: left
    width: 0
    height: 0
    border-style: solid
    border-width: 50px 50px 0 0
    border-color: #2682FF transparent transparent transparent

  .content
    float: left
    padding: 15px 15px 15px 0
    width: 72%
  
  .close-btn
    color: #58666D
    font-size: 26px
    position: absolute
    top: 4px
    right: 12px
    padding: 4px 8px

  .btn-link 
    font-weight: bold
    text-decoration: none

    .i-chevron-right
      top: 2px
      left: 0
      position: relative

.Modal--small .rzp-early-stl-modal
  color: #58666E

  .modal-header
    padding: 15px 0

  .help-block
    color: #58666E

  .submit-btn, .close-btn
    width: 100%

.Announcement_Banner.with-tour
  margin-top: 20px

@media only screen and (max-width: 1190px) and (min-width: 1021px)
  .Announcement_Banner
    height: 68px

    .title
      height 68px
      padding: 24px 0 15px 15px
    
    .content
      width: 65%

    .corner
      border-width: 68px 68px 0 0

    .close-btn
      top: 12px

@media only screen and (max-width: 1020px)
  .Announcement_Banner
    height: auto  

    .title
      float: none
      height 48px
      padding: 12px
      border-radius: 2px 2px 0 0
    
    .corner
      display: none
    
    .content
      float: none
      width: 100%
      padding: 12px
    
    .close-btn
      color: #ffffff
      top: 2px

.Announcement_Banner--hide
  display: none