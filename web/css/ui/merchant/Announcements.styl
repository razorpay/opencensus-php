.Announcement_Banner

  background: #ffffff
  height: 50px
  position: relative
  border-radius: 2px
  box-shadow: 0 1px 4px 0 rgba(0,0,0,0.1)
  display: table;
  width: 100%;

  .title, .content, .close-btn {

    display: table-cell;
    vertical-align: middle;
  }

  .title, .close-btn {

    width: 0;
  }

  .close-btn {

    cursor: pointer;
    color: currentColor;
    font-size: 28px;
    padding-right: 15px;
  }

  .title
    position: relative;
    height: 100%;
    font-size: 50px
    font-weight: bold
    color: white
    border-radius: 2px 0 0 2px;
    padding-right: 50px;

    .title-content {

      position: relative;
      font-size: 15px;
      line-height: 18px;
      height: 100%;
      z-index: 1;
      padding-left: 15px;
      color: #fff;
      white-space: nowrap;
      display: table;

      .title-content-wrapper {

        display: table-cell;
        height: 100%;
        vertical-align: middle;
      }
    }

    &:before, &:after {

      position: absolute;
      display: block;
      content: "";
    }

    &:before {

      bottom: 0;
      width: 60px;
      height: 100%;
      opacity: 0.5;
      right: 25px;
      background-color: currentColor;
      transform: skew(30deg);
    }

    &:after {

      top: 0;
      width: 60px;
      height: 100%;
      right: 16px;
      background-color: currentColor;
      z-index: 0;
      transform: skewX(-30deg);
    }

  .corner
    display: none;
    float: left

  .content
    padding: 15px 15px 15px 8px
    width: 100%

    .dot--primary
      color: $primary-color
      margin: 0 4px
    
    .big-circle-seprator
      display: inline-block
      width: 9px
      height: 9px
      margin: 0px 24px
      background-color: currentColor
      border-radius: 50%

  .btn-link
    font-weight: bold
    text-decoration: none

    .i-chevron-right
      top: 2px
      left: 0
      position: relative

  @media (max-width: 1020px) {

    position: relative;

    .title, .content, .close-btn {

      display: block;
    }

    .title {

       width: 100%;
       padding-right: 0;
       height: auto;

       &:before, &:after {

         display: none;
       }

       .title-content {

         display: block;
         padding: 12px 37px 12px 12px;

         .title-content-wrapper {

           display: block;
         }
       }
     }

     .content {

       padding: 15px;
     }

     .close-btn {

       position: absolute;
       top: 0;
       right: 12px;
       z-index: 1;
       color: #fff;
     }
  }

.announcement-banner
  &#announcement-banner-SEP21-ULTRALOC-BANNER, &#announcement-banner-nitro-settlements-banner
    .content, .content .schedule-enable-container
      display: flex
      flex-wrap: wrap
      align-items: center
      height: 100%

      span.display-inline
        margin: 0 10px 0 0

      a.Button--secondary
        margin: 2px 0

.Modal .modal-body.rzp-early-stl-modal
  color: #58666E
  padding: 0

  .modal-header
    padding: 15px 0

  .modal-title
    font-size: 24px
    font-weight: bold
    line-height: 32px

  .help-block
    color: #58666E

  .modal-subtitle
    display: inline-block
    margin: 25px 0 10px 0
    font-size: 18px
    font-weight: bold
    line-height: 22px

  .content-left, .content-right
    display: inline-block
    width: 50%
    height: 100%
    vertical-align: top
    padding: 35px

    button.close
      margin: -30px -30px 0 0

  .content-left
    border-radius: 2px 0 0 2px
    background-color: #fff
    border-right: 1px solid #E0E0E0

    .form-action, button.close
      display: none

  .content-right
    background-color: #FAFAFA
    position: relative
    padding-left: 33px

    .modal-title
      font-size: 18px

    form
      margin-top: 24px;

    .radio-label
      .title
        font-size: 16px
        font-weight: bold
        line-height: 19px
      .description
        color: #7B8199

    .options-back-btn
      display: none

  .form-action
    position: absolute
    bottom: 0
    left: 0
    width: 100%
    text-align: right
    border-top: 1px solid #E0E0E0
    background-color: #F6F6F6
    padding: 20px

    .Button:first-child
      margin-right: 20px

    .Button.Button--primary:last-child
      margin: 0

  .features-list
    color: #58666E
    margin-top: 20px
    .feature-item
      margin: 20px 0
    .feature-icon
      width: 45px
      display: inline-block
      vertical-align: top
      padding: 5px
      img
        width: 40px
    .feature-title
      font-weight: bold
    .feature-text
      color: #7B8199
    .feature-content
      display: inline-block
      width: 85%
      padding-left: 20px

.success-modal
  text-align: center
  background-color: #FFFFFF

  .success-banner-cnt
    height: 400px
    width: 100%
    position: relative

    .banner-header
      width: 100%
      position: absolute
      left: 0
      top: 0

    .banner
      width: 34%
      margin: 10% 33% 20px 33%
      display: inline-block

    .modal-title
      margin: 20px 0
      display: inline-block

    .help-block
      width: 57%
      margin: 0 auto

    .banner-footer
      width: 100%
      position: absolute
      left: 0
      bottom: 0

@media only screen and (max-width: 764px)
  .Modal .modal-body.rzp-early-stl-modal
    .content-left, .content-right
      width: 100%

    .content-left
      min-height: 600px

      .form-action, button.close, .options-back-btn
        display: block

    .content-right
      .options-back-btn
        display: inline-block

    .features-list
      .feature-content
        width: 80%

  .success-modal
    .success-banner-cnt
      .help-block
        width: 75%
      .banner
        width: 50%
        margin: 60px 25% 20px 25%

  .Announcement_Banner
    .pull-right
      float: unset !important

.Announcement_Banner.with-tour
  margin-top: 20px

.Announcement_Banner--hide
  display: none

.Announcement_Banner.margin-bottom
  margin-bottom: 20px

.debit-refund-notif
  .title
    font-size: 24px
    font-weight: 700
    color: #515978
    margin-bottom: 17px
    line-height: inherit

  .debit-refund-panel-body
    padding-left: 35px
    padding-bottom: 17px

  h4.changing
    margin: 15px 0px
    font-size: 15px
    color: #515978
    font-weight: 700

  ul
    font-family: Lato
    font-style: normal
    font-weight: normal
    font-size: 14px
    line-height: 20px
    padding-left: 20px
    color: #4A4A4A
    padding-left: 0
    margin-left: 10px

    li
      margin-bottom: 12px

  table
    border-collapse: collapse

    td
      padding: 7px 10px
      border: 1px solid rgba(173, 188, 201, 0.18)

  .table
    border-bottom: 0

  .banner
    position: absolute
    right: 19px
    top: 14px

  img
    width: 300px

  .btn
    margin-top: 25px
    margin-bottom: 20px
    width: 160px

  .svg-bg
    background: url("assets/debit-refund-bg.png") no-repeat
    height: 305px
    width: 336px
    position: absolute
    top: -14px
    left: -17px
    z-index: -9


.announcement-banner-container.announcement-banner-container--fullpage
  padding: 0

.announcement-banner--fullpage
  text-align: center

.Announcement_Banner
  .content
    padding: 8px 15px 8px 8px

  .skew-pattern
    &::before, &::after
      content: ''

  .skew-pattern-left
    transform: skew(30deg)

  .skew-pattern-right
    transform: skew(330deg)


  .skew-pattern, .skew-pattern::before, .skew-pattern::after
    position: absolute
    display: block
    background-color: currentColor

  .skew-pattern
    bottom: 0
    width: 30px
    height: 100%
    opacity: 0.7
    pointer-events: none
    z-index: 0

    &::before
      bottom: 0
      width: 130px
      height: 100%
      opacity: 0.17

    &::after
      bottom: 0
      width: 230px
      height: 100%
      opacity: 0.17

  .skew-pattern-left
    left: -20px

  .skew-pattern-right
    right: -20px

    &::before, &::after
      right: 0
