.Announcement_Banner
  padding: 12px 36px 12px 12px
  text-align: center
  margin-bottom: 12px
  line-height: 20px
  color: #fff
  background-color: #5d89e5
  background: linear-gradient(223.96deg, #3059c0 0%, #5d89e5 100%)
  position: relative
  transition: 0.25s cubic-bezier(0.12, 1.03, 1, 1)

  &--hide
    height: 0
    margin: 0
    padding: 0

  .link
    text-decoration: underline
    color: inherit

  .close-btn
    font-size: 20px
    position: absolute
    top: 8px
    right: 12px
    padding: 4px 8px

.Announcement_Banner--hide
  display: none

.Announcement_Banner_2
  margin: 65px 20px 0px 20px
  background: #ffffff
  height: 50px
  position: relative
  border-radius: 2px
  box-shadow: 0 1px 4px 0 rgba(0,0,0,0.1)

  .title
    float: left
    height: 50px
    // background: #4975D5
    background: linear-gradient(270deg, #2682FF 0%, #415BD3 100%);
    color: white
    padding: 15px 0 15px 15px
    border-radius: 2px 0 0 2px;

  .corner
    float: left
    width: 0;
    height: 0;
    border-style: solid;
    border-width: 50px 50px 0 0;
    border-color: #2682FF transparent transparent transparent;

  .content
    float: left
    padding: 15px 15px 15px 0
    width: 65%
  
  .close-btn
    color: #58666D
    font-size: 26px
    position: absolute
    top: 4px
    right: 12px
    padding: 4px 8px

  .btn-link 
    margin: 0 5px
    font-weight: bold
    text-decoration: none

    .i-chevron-right
      top: 2px;
      left: 0;
      position: relative;

.Modal--small .rzp-early-stl-modal
  color: #58666E

  .modal-header
    padding: 15px 0

  .help-block
    color: #58666E

  .submit-btn, .close-btn
    width: 100%

.Announcement_Banner_2.with-tour
  margin-top: 20px

@media only screen and (max-width: 1190px)
  .Announcement_Banner_2
    height: 68px

    .title
      height 68px
      padding: 24px 0 15px 15px

    .corner
      border-width: 68px 68px 0 0

    .close-btn
      top: 12px

.Announcement_Banner_2.inMobile
  height 148px

  .title
    float: none
    height 48px
    padding: 15px
    border-radius: 2px 2px 0 0

  .content
    width: 100%
    padding: 15px
  
  .close-btn
    color: #ffffff;
    top: 2px
