.loan-onboarding-content-body{
  padding: 16px 32px 0;
  &.los-content-body{
    padding: 0px 32px 0;
  }
  .Form{
    .Input {
      margin: 8px 0 8px;
      .Input-addons{
        background: white;
      }
    }
    .Input-el--before {
      padding-left: 40px;
    }
    .Input--small {
      .Input-content {
        margin-right: 16px;
        .Input-elWrapper {
          width: 230px;
          font-size: inherit;
        }
      }
    }

    .Input.Input--large .Input-elWrapper{
      width: 476px;
    }
  }
}

.non-fldg-loan-onboarding-body{

  .title{
    padding: 0 0 12px 0;
    text-align: left;
    border-bottom: 1px solid rgba(22, 47, 86, 0.1);
    color: rgba(22,47,86,0.87);
    font-weight: 900;
    font-size: 20px;
    line-height: 24px;
    margin: 0 32px;
  }


  .inner{
    padding:32px;
    .description{
      margin-top: 12px;
      font-weight: normal;
      font-size: 13px;
      line-height: 19px;
      color: rgba(22, 47, 86, 0.87);
    }
    .text{
      font-size: 14px;
      line-height: 20px;
      color: rgba(22, 47, 86, 0.87);
    }   
    .tips-container{
      margin-top: 12px;
      .wrapper{
        margin-top: 10px;
      }
      .flex{
        display: flex;
        flex-direction: row;
        align-items:center; 
      }
      i{
        font-size:14px;
        color:#239651;
      } 
      .tip{
        margin: 0 0 0 10px
      }
    }
    .action-point{
      margin-top:32px;
      padding-top: 20px
      border-top:1px solid rgba(22, 47, 86, 0.12);
      color: rgba(22, 47, 86, 0.74);
    }
   a {
    text-decoration: none;
    color: white;
    background-color: none;
    .cta{
      color: white;
      margin-top: 24px;
      font-weight: bold;
      padding: 8px 29px 8px 24px;
      }
      img{
        margin:-2.5px 0 0 8px;
      }
    }   
   }
}

.loan-application-disabled-body{
    padding:12px 32px 0;
    .loan-application-disabled-wrapper{
        border: 1px solid rgba(238, 102, 25, 0.16);
        padding: 24px 20px;
        border-radius: 6px;
          .flex{
            display: flex;
            flex-direction: row;
            align-items:center;  
          }
          .title-wrapper{ 
            i { 
              margin: 4px 6px 0 0;
              font-size: 18px;
              color: #EE6619;
            }
          }
          .title{
            font-weight: bold;
            font-size: 16px;
            line-height: 22px; 
            color: rgba(22, 47, 86, 0.87);
          }
          .description{
            margin-top: 12px;
            font-weight: normal;
            font-size: 13px;
            line-height: 19px;
            color: rgba(22, 47, 86, 0.87);
          }
          .tips-container{
            margin-top: 12px;
            .wrapper{
              margin-top: 6px;
            }
            .flex{
              display: flex;
              flex-direction: row;
              align-items:center; 
            }
            i{
              font-size:12px;
            } 
            .tip{
              color: rgba(22, 47, 86, 0.74);
              margin: 0 0 0 8px
            }
          }
          .subtitle{
            font-weight: bold;
            font-size: 12px;
            line-height: 18px; 
            text-transform: uppercase;
            color: rgba(22, 47, 86, 0.87); 
            margin-top: 28px
          }
          .action-point{
            margin-top: 12px
          }
          .cta{
            margin-top: 24px;
            font-weight: bold;
            font-size: 14px;
            line-height: 20px;
            padding: 8px 29px 8px 24px;

            i{
              margin-left: 8px
            }
          }
    }
}
