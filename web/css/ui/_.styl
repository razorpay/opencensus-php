@import 'components/*'

*
  box-sizing: border-box

:focus
  outline: none

html
  height: 100%
  font-size: 14px
  color: #414141
  background: #F0F3F4
  line-height: 22px
  font-family: -apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Oxygen,Ubuntu,Cantarell,'Open Sans','Helvetica Neue',sans-serif;

body
  height: 100%
  margin: 0
  > #react-root
    height: 100%

a
  color: inherit
  text-decoration: none

#app-container
  height: 100%
  $side-width = 200px
  > aside
    background: #3A3F51
    position: fixed
    left: 0
    width: $side-width
    height: 100%
    top: 0
    color: #ccc
    line-height: 40px
    padding: 20px 0
    label
      font-size: 12px
      padding: 0 20px
      display: block
      opacity: .8
    a
      display: block
      padding: 0 20px
      &:hover, &.active
        background: rgba(0,0,0,.1)
  > header
    position: fixed
    top: 0
    left: $side-width
    right: 0
    top: 0
    height: 48px
    line-height: @height
    box-shadow: 0 2px 2px rgba(0, 0, 0, 0.05), 0 1px 0 rgba(0, 0, 0, 0.05)
    background: #fff
  > main
    background: #F0F3F4
    min-height: 100%
    margin-left: $side-width
    padding: 50px 0 1px
    position: relative

.box
  background: #fff
  margin: 30px
  box-shadow: 1px 2px 8px rgba(0,0,0,.11)

.clearfix
  overflow: auto;
