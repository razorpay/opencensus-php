@import 'components/*'

*
  box-sizing: border-box

:focus
  outline: none

pre
  margin: 0
  font-size: 12px

img
  vertical-align: middle
  max-width: 100%
  max-height: 100%

html
  min-width: 800px
  height: 100%
  font-size: 13px
  color: #414141
  background: #F0F3F4
  line-height: 22px
  font-family: -apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Oxygen,Ubuntu,Cantarell,'Open Sans','Helvetica Neue',sans-serif;

body
  height: 100%
  margin: 0
  > #react-root
    height: 100%
  &.noscroll
    overflow: hidden

i
  display: inline-block
  font-style: normal
  vertical-align: top

a
  color: inherit
  text-decoration: none

.main-nav
  display: block
  padding: 0 20px
  &:hover, &.active
    background: rgba(0,0,0,.1)
    color: #fff
    i
      opacity: 1
  i
    color: #5bffd4
    margin-right: 12px;
    position: relative;
    opacity: .5;
    font-size: 16px

#app-container
  height: 100%
  $side-width = 200px
  > aside
    &::-webkit-scrollbar
      display: none
    overflow: auto
    background: #3A3F51
    position: fixed
    left: 0
    width: $side-width
    height: 100%
    top: 0
    color: #ccc
    line-height: 40px
    padding: 20px 0
    > div
      & + div
        border-top: 2px solid rgba(0,0,0,.2)
      &:last-child
        i
          color: #ff9a5b
      &:nth-last-child(2)
        i
          color: #fffd5b
    label
      font-size: 12px
      padding: 0 20px
      display: block
      opacity: .8
  > header
    position: fixed
    top: 0
    left: $side-width
    right: 0
    top: 0
    height: 48px
    line-height: @height
    padding: 0 20px
    font-size: 14px
    box-shadow: 0 2px 2px rgba(0, 0, 0, 0.05), 0 1px 0 rgba(0, 0, 0, 0.05)
    background: #fff
  > main
    background: #F0F3F4
    min-height: 100%
    margin-left: $side-width
    padding: 50px 0 1px
    position: relative

.container
  position: relative

  header
    border-bottom: 1px solid $faded-color;

.box
  position: relative
  background: #fff
  margin: 30px
  box-shadow: 1px 2px 8px rgba(0,0,0,.11)
  > header:not(:only-child)
    border-bottom: 2px solid #eee

.limited
  margin-left: auto
  margin-right: auto
  max-width: 600px

.box-icon
  float: right
  margin: 24px 20px 0 0
  font-size: 16px

.capitalize
  text-transform: capitalize

.clearfix
  overflow: auto;

.text-right
  text-align: right

.split
  width: 50%
  vertical-align: top
  padding: 10px 20px 10px 20px
  display: inline-block

code
  background: #f6f9fa
  border: 1px solid #eee
  color: #444
  font-size: 80%
  padding: 2px 6px
  border-radius: 3px
  margin: 0 4px

ul
  margin: 0
  padding: 0
