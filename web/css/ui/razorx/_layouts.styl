.page-center
  position: absolute
  left: 50%
  top: 50%
  transform: translate(-50%, -50%)
  text-align: center

.empty-entity
  color: #dad9d9
  i
    font-size: 40px
    margin-bottom: 16px

  .description
    font-size: 20px
    font-weight: 600

    div
      font-size: 16px
      font-weight: 400


.parent-container
  height: 100%

  .container-group
    height 100%
    padding-top: 62px
    margin-top: -62px
    display: flex

    .list-container
      flex: 1

    .entity-container
      width: 400px
      background: #f1f1f1
      border-left: 1px solid #e9e9e9
      padding: 28px 20px
      overflow-y: auto

      .title
        font-size: 20px
        font-weight: 500
        margin-bottom: 8px

      .description
        line-height: 20px

      .sub-description
        margin-top: 8px
        font-size: 12px
        opacity: 0.4
        font-style: italic

      .title + .description
        opacity: 0.6

      .label
        margin-bottom: 4px
        font-weight: 700

      .square-pills
        font-size: 14px
        display: inline-block
        margin-bottom: 4px
        max-width: 100%
        word-wrap: break-word
        white-space: normal
        text-align: left

      .link
        font-size: 12px

