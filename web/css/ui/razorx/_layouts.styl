.page-center
  position: absolute
  left: 50%
  top: 50%
  transform: translate(-50%, -50%)
  text-align: center

.empty-entity
  color: #dad9d9
  i
    font-size: 40px
    margin-bottom: 16px

  .description
    font-size: 20px
    font-weight: 600

    div
      font-size: 16px
      font-weight: 400


.parent-container
  height: 100%

  .container-group
    height 100%
    padding-top: 62px
    margin-top: -62px
    display: flex

    .list-container
      flex: 1

    .entity-container
      width: 400px
      background: #f1f1f1
      border-left: 1px solid rgba(0,0,0,0.03)
      padding: 20px

      > div
        overflow-y: auto
        height: 100%

      .separator
        border-top: 1px solid rgba(0,0,0,0.03)
        margin: 22px auto

      .title
        font-size: 20px
        font-weight: 500
        margin-bottom: 8px

        &::after
          content: ''
          display: block
          width: 24px
          height: 5px
          margin: 12px 0
          background: #f3dd61

      .description
        line-height: 20px

      .sub-description
        margin-top: 8px
        font-size: 12px
        font-style: italic
        color: #c7c7c7

      .title + .description
        color: #878787

      .label
        margin-bottom: 4px
        font-weight: 700

      .square-pills
        font-size: 14px
        display: inline-block
        margin-bottom: 4px
        max-width: 100%
        word-wrap: break-word
        white-space: normal
        text-align: left

      .link
        margin: 0
        font-size: 12px

