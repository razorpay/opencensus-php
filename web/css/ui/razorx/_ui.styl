$color-primary = #58d4ff
$color-primary-hover = #58d4ff

.RazorX-container.RazorX-container
  -webkit-font-smoothing: antialiased
  -moz-osx-font-smoothing: grayscale

  .btn
    border-radius: 2px
    font-weight: 600

    &--primary
      background: $color-primary

      &:hover
        background: $color-primary-hover

  .Modal-mask
    background-color: rgba(17,30,60,0.8);

    .Modal-container
      border-radius: 2px

  .knob
    background: none
    box-shadow: none
    padding: 0
    border: none
    position: relative
    margin: 0
    display: inline-block
    vertical-align: middle
    width: 28px
    height: 14px

    &::before
      content: ''
      display: block
      border-radius: 2px
      height: 100%
      width: 100%
      background-color: #f2f5f6
      box-shadow: inset 0 1px 3px 0 rgba(0,0,0,0.24)

    &::after
      content: '='
      left: 2px
      top: 2px
      position: absolute
      height: auto
      width: auto
      box-shadow: 0 1px 3px 0 rgba(0,0,0,0.2), 0 1px 1px 0 rgba(0,0,0,0.18)
      color: #d9dfe0
      background: #fff
      border-radius: 1px
      padding: 4px 2px
      line-height: 2px
      font-size: 12px
      transition: 0.2s

    &.checked::before
      background: $color-primary

    &.checked::after
      transform: translateX(12px)


  .table-striped .td
    min-width: auto

  .list-container
    .box
      margin: 0 24px
      box-shadow: none
      background: transparent

      .thead
        color: rgba(0,0,0,0.2)
        .th
          font-size: 12px
          font-weight: 600
          text-transform: uppercase

          &:first-of-type
            font-weight: 700
            color: rgba(0,0,0,0.6)

      .tr:nth-child(2n+1):not(.thead)
        background: #fafafa

    .table-container
      width: 100%

      .th
        vertical-align: bottom

  .spinner
    &::after, &::before
      background-color: #dad9d9

  .pill
    color: #e3e3e6
    border: 1px solid currentColor
    background: transparent

    &.label-success
      color: #8bd75f

    &.label-danger
      color: #e04c4c

  .square-pills
    background: #e4e9ea

    &.label-success
      color: #8bd75f

    &.label-danger
      color: #e04c4c
