.parent-container.experiments-container
  .list-container
    .table
      .tr .td
        &:nth-child(1)
          width: 236px

        &:nth-child(3)
          width: 86px

        &:nth-child(4), &:nth-child(5)
          width: 128px

  .entity-container
    width: 400px

    .segment
      margin-bottom: 22px

      > div:first-of-type
        background: #f1f1f1
        position: -webkit-sticky /* Safari */
        position: sticky
        top: 0
