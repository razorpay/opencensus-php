.RazorX-container.RazorX-container
  -webkit-font-smoothing: antialiased
  -moz-osx-font-smoothing: grayscale

  /* Btn */
  .btn
    border-radius: 2px
    font-weight: 600

    &--primary
      background: $color-primary

      &:hover
        background: $color-primary-hover

  /* Modal */
  .Modal-mask
    background-color: rgba(17,30,60,0.8)

    .Modal-container
      border-radius: 2px
      background: transparent
      box-shadow: none
      overflow: hidden

      .Modal-close
        color: rgba(255, 255, 255, 0.4)
        top: 10px
        padding: 9px 12px 11px
        right: -12px

      .Modal-content
        header
          color: rgba(255,255,255,0.9)
          padding: 12px 48px 12px 12px
          border-bottom: 0

          &::after
            content: ''
            display: block
            position: absolute
            top: 18px
            left: 0
            height: 24px
            width: 5px
            background: #f3dd61

        .Modal-body
          background: #fff
          min-width: 400px

  /* Knob */
  .knob
    background: none
    box-shadow: none
    padding: 0
    border: none
    position: relative
    margin: 0
    display: inline-block
    vertical-align: middle
    width: 28px
    height: 14px

    &::before
      content: ''
      display: block
      border-radius: 2px
      height: 100%
      width: 100%
      background-color: #f2f5f6
      box-shadow: inset 0 1px 3px 0 rgba(0,0,0,0.24)

    &::after
      content: '='
      left: 2px
      top: 2px
      position: absolute
      height: auto
      width: auto
      box-shadow: 0 1px 3px 0 rgba(0,0,0,0.2), 0 1px 1px 0 rgba(0,0,0,0.18)
      color: #d9dfe0
      background: #fff
      border-radius: 1px
      padding: 4px 2px
      line-height: 2px
      font-size: 12px
      transition: 0.2s

    &.checked::before
      background: $color-primary

    &.checked::after
      transform: translateX(12px)


  /* Table */
  .table-striped .td
    min-width: auto

  .list-container
    .box
      margin: 0 24px
      box-shadow: none
      background: transparent

      .thead
        color: rgba(0,0,0,0.2)
        .th
          font-size: 12px
          font-weight: 600
          text-transform: uppercase

          &:first-of-type
            font-weight: 700
            color: rgba(0,0,0,0.6)

      .tr:nth-child(2n+1):not(.thead)
        background: #fafafa

    .table-container
      width: 100%

      .th
        vertical-align: bottom

  /* Spinner */
  .spinner
    &::after, &::before
      background-color: #dad9d9

  /* Pills */
  .pill
    color: #fff
    background-color: #e3e3e6

    &.label-success
      background-color: #84e64c

    &.label-danger
      background-color: #e05555

  /* Square Pills */
  .square-pills
    background: #e4e9ea

    &.label-success
      color: #84e64c

    &.label-danger
      color: #e05555
