.RazorX-container.RazorX-container
  .page-center
    position: absolute
    left: 50%
    top: 50%
    transform: translate(-50%, -50%)
    text-align: center

  .empty-entity
    color: #dad9d9
    i
      font-size: 40px
      margin-bottom: 16px

    .description
      font-size: 20px
      font-weight: 600

      div
        font-size: 16px
        font-weight: 400


  .parent-container
    height: 100%
    background: $background-anti
    box-shadow: -4px 0 72px rgba(0,0,0,0.4)

    .container-group
      height 100%
      padding-top: 62px
      margin-top: -62px
      display: flex

      .list-container
        flex: 1
        overflow-y: auto

      .entity-container
        width: 400px
        background: $background-anti-overlay
        border-left: 1px solid rgba(0,0,0,0.02)
        padding: 24px 0

        > div
          overflow-y: auto
          height: 100%
          padding: 0  24px

        .pad-highlight
          padding: 8px
          background: rgba(0,0,0,0.01)
          border: 1px solid rgba(0,0,0,0.02)
          border-radius: 2px
          margin-left: -8px
          margin-right: -8px
          width: unset
          position: relative

        .separator
          border-top: 1px solid rgba(0,0,0,0.02)
          margin: 22px auto

        .title
          font-size: 20px
          font-weight: 500
          margin-bottom: 8px

          &::after
            content: ''
            display: block
            width: 24px
            height: 5px
            margin: 12px 0
            background: #f3dd61

        .description
          line-height: 20px

        .sub-description
          margin-top: 0
          margin-bottom: 8px
          font-size: 12px
          color: #c7c7c7

        .description .sub-description
          margin-top: 8px
          margin-bottom: 0
          font-style: italic

        .title + .description
          color: #878787

        .label
          margin-bottom: 4px
          font-weight: 700

        .square-pills
          font-size: 14px
          display: inline-block
          margin-bottom: 4px
          max-width: 100%
          word-wrap: break-word
          white-space: normal
          text-align: left

        .link
          margin: 0
          font-size: 12px

  .btn.json-btn.json-btn
    font-size: 8px
    height: unset
    letter-spacing: 0.4px
    line-height: 20px
    padding: 0 4px
    margin: 0 0 0 -7px
    border-bottom-right-radius: 0
    border-bottom-left-radius: 0
    transform: rotate(90deg)
    background: #fff
    color: $color-primary

  @keyframes move-left
    100%
      opacity: 1
      transform: translateX(0)
