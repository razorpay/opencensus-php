.RazorX-container.RazorX-container
  /* Btn */
  .btn
    border-radius: 2px
    font-weight: 600

    &--primary
      background: $color-primary

      &:hover
        background: $color-primary-hover

  /* Knob */
  .knob
    background: none
    box-shadow: none
    padding: 0
    border: none
    position: relative
    margin: 0
    display: inline-block
    vertical-align: middle
    width: 28px
    height: 14px

    &::before
      content: ''
      display: block
      border-radius: 2px
      height: 100%
      width: 100%
      background-color: #f2f5f6
      box-shadow: inset 0 1px 3px 0 rgba(0,0,0,0.24)

    &::after
      content: '='
      left: 2px
      top: 2px
      position: absolute
      height: auto
      width: auto
      box-shadow: 0 1px 3px 0 rgba(0,0,0,0.2), 0 1px 1px 0 rgba(0,0,0,0.18)
      color: #d9dfe0
      background: #fff
      border-radius: 1px
      padding: 4px 2px
      line-height: 2px
      font-size: 12px
      transition: 0.2s

    &.checked::before
      background: $color-primary

    &.checked::after
      transform: translateX(12px)

  form
    .btn .spin-btn
      display: none

    &.pending
      .btn
        pointer-events: none
        opacity: 0.7
        cursor: not-allowed

        .spin-btn
          display: inline-block
          opacity: 1
          border: 2px solid #fff
          border-top-color: transparent
