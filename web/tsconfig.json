{
  "compilerOptions": {
    "allowJs": true,
    "outDir": "./dist/",
    "sourceMap": true,
    "noImplicitAny": false,
    "module": "commonjs",
    "target": "ES6",
    "jsx": "react",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "typeRoots": ["./typings", "node_modules/@types"],
    "strict": true,
    "resolveJsonModule": true,
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "baseUrl": "js",
    "paths": {
      "test-utils": ["common/services/test/test-utils"]
    },
    "plugins": [
      {
        "name": "typescript-styled-plugin"
      }
    ],
    "lib": ["DOM", "es2020"]
  },
  "include": [
    "typings/**/*",
    "js/newAuth/signin/types.d.ts",
    "js/newAuth/**/*",
    "js/merchant",
    "js/common"
  ],
  "exclude": ["node_modules"],
  "types": ["resize-observer-browser"]
}
