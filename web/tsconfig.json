{
  "compilerOptions": {
    "outDir": "./dist/",
    "sourceMap": true,
    "noImplicitAny": false,
    "module": "commonjs",
    "target": "ES6",
    "jsx": "react",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "typeRoots": ["./typings", "node_modules/@types"],
    "strict": true,
    "resolveJsonModule": true,
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "baseUrl": "js",
    "paths": {
      "test-utils": ["common/services/test/test-utils"]
    },
    "plugins": [
      {
        "name": "typescript-styled-plugin"
      }
    ]
  },
  "include": [
    "typings/**/*",
    "js/merchant/views/TermsAndCondition",
    "js/merchant/views/referral",
    "js/merchant/views/onboarding",
    "js/merchant/views/Settlements",
    "js/merchant/hooks",
    "js/common/hooks",
    "js/common/context",
    "js/common/services",
    "js/common/components",
    "js/common/new-ui",
    "js/common/ui/DashboardBanner",
    "js/common/ui/NotificationsDropdown/Neostone",
    "js/common/ui/GrowthCustomizeModal"
  ],
  "exclude": ["node_modules", "js/common/utils"]
}
