{
  "compilerOptions": {
    "allowJs": true,
    "outDir": "./dist/",
    "sourceMap": true,
    "noImplicitAny": false,
    "module": "commonjs",
    "target": "ES6",
    "jsx": "react",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "typeRoots": ["./typings", "node_modules/@types"],
    "strict": true,
    "preserveSymlinks": true,
    "resolveJsonModule": true,
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "composite": true,
    "baseUrl": "js",
    "paths": {
      "test-utils": ["common/services/test/test-utils"],
      "@dashboard/shared-ui": ["../../libs/shared-ui/src/index.ts"],
      "@dashboard/shared-utils": ["../../libs/shared-utils/src/index.ts"],
      "shell/commonStore": ["./merchant/commonStore/index.ts"],
      "shell/I18Context": ["./common/i18/I18ServiceProvider.tsx"],
      "shell/SpiltzServiceContext": ["./common/splitz/context/SplitzContextProvider.tsx"]
    },
    "plugins": [
      {
        "name": "typescript-styled-plugin"
      }
    ],
    "lib": ["DOM", "es2020"]
  },
  "include": [
    "typings/**/*",
    "js/newAuth/signin/types.d.ts",
    "js/newAuth/**/*",
    "js/merchant",
    "js/merchant/**/*.json",
    "js/common",
    "js/merchant_common/"
  ],
  "exclude": ["node_modules"],
  "types": ["resize-observer-browser", "jest", "jest-dom"]
}
