`
var cdnUrl = _.htmlWebpackPlugin.options.vars.cdnUrl;
var filename = _.htmlWebpackPlugin.options.vars.filename;
`

@include('partials/header')

<script src="`=cdnUrl`/`=filename(_, 'vendor')`" defer></script>
<link rel='stylesheet' href="`=cdnUrl`/fonts/icons.css" type='text/css' />
<link rel='stylesheet' href="`=cdnUrl`/admin.css" type='text/css' />
</head>
<body>
  <div id="react-root" class="react-root"></div>
  <script src="`=cdnUrl`/admin/`=filename(_, 'admin')`" defer></script>
</body>
</html>

@include('partials/footer')
