@font-face {
  font-family: "{{ fontName }}";
  src: {{{ src }}}; /* nosemgrep : javascript.express.security.audit.xss.mustache.explicit-unescape.template-explicit-unescape */
}

i:not(.fa):before,
.icon:after
 {
  font-family: {{fontName}} !important;
  font-style: normal;
  font-weight: normal !important;
}

{{# each codepoints }}
i.i-{{ @key }}:before,.icon.i-{{ @key }}:after{content:"\\{{ this }}"}
{{/ each }}
