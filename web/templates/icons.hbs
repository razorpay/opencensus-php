@font-face {
  font-family: "{{ fontName }}";
  src: {{{ src }}};
}

i:not(.fa):before,
.icon:after
 {
  font-family: {{fontName}} !important;
  font-style: normal;
  font-weight: normal !important;
}

{{# each codepoints }}
i.i-{{ @key }}:before,.icon.i-{{ @key }}:after{content:"\\{{ this }}"}
{{/ each }}
