$slider-width = 500px

.close-secondary {
  display: none;
}

.ModalSlider__Overlay.ReactModal__Overlay {
  width: $slider-width;
  position: fixed;
  top: 51px;
  right: 0;
  margin-left: - $slider-width;
  bottom: 0;
  box-shadow: 0 0 10px 0 rgba(0,0,0,0.1);
  transform: translateX(90%);
  transition: .3s, .24s opacity;
  z-index: 2;
  padding-bottom: 45px;

  @media (max-width: 650px) {
    max-width: 92%;
    width: 100%;
  }

  &.ReactModal__Overlay--after-open {
    transform: none;
  }

  &.expanded {
    @media (min-width: 1280px) {
      transform: translateX(-100%);
      .content-wrapper {
        &:first-child {
          .panel, .panel-heading {
            background-color: #FAFAFA;
          }
        }
      }
    }
  }
  .close-secondary {
    left: 100%;
    display: block;
    .icon-arrow-back {
      display: none;
    }
  }

  @media (max-width: 1279px) {
    .close-secondary {
      left: 0;
      margin: 3px 0 0 6px;
      .icon-arrow-back {
        display: block;
      }
      .icon-close {
        display: none;
      }
    }
    .content-wrapper:not(:first-child) .panel-heading {
      //padding-left: 50px;
    }
  }

  &.ReactModal__Overlay--before-close {
    opacity: 0;
    transform: translateX(100%);
  }
}

.ModalSlider__Content {
  min-height: 100%;
  transform: none;

  button.close {
    padding: 10px;
    position: absolute;
    top: 16px;
    margin-left: -53px;
    left: 100%;
    z-index: 2;
  }

  .content-wrapper {
    overflow: auto;
    max-width: none
    margin: 0
    min-height: 0;
    padding: 0
    position: absolute
    top: 0
    bottom: 0
    background: #fff
    width: 100%
    @media (max-width: 1279px) {
      &+.content-wrapper {
        animation: slideLeft 600ms cubic-bezier(0.25, 0.1, 0.25, 1) forwards;
        transition: transform 600ms cubic-bezier(0.25, 0.1, 0.25, 1);

        // Add it to slide away the slider
        &.toggle-slider {
          transform: translateX(100%);
        }

        @keyframes slideLeft {
          from {left: 100%}
          to {left: 0}
        }
      }
    }
    @media (min-width: 1280px) {
      &+.content-wrapper {
        left: 100%;
      }
    }
  }

  .SliderPanel__Body {
    > .panel-body {
      padding-bottom: 80px;
    }
  }
}

.SliderPanel__Body {
  .empty-table-message {
    padding: 30px 50px;
  }
}

.ReactModal__Content--after-open {
  .SliderPanel .panel-heading > .btn-toolbar {
    padding-right: 35px;
  }
}
