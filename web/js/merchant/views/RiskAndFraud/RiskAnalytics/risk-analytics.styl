$tooltip-border-color = #E0E8F4

//custom tooltip styles
#chartjs-tooltip.risk-chartjs-tooltip
  margin-left 0
  width auto

.risk-chartjs-tooltip
  .tooltip-caret
    display block
    position absolute
    margin auto
    width 0
    height 0
    border-color transparent
    border-style solid
    border-width 6px

    &.top.center, &.top.left, &.top.right
      border-bottom-color $tooltip-border-color
      top -13px

    &.bottom.center, &.bottom.left, &.bottom.right
      border-top-color $tooltip-border-color
      bottom -13px

    &.center.left
      border-right-color $tooltip-border-color
      bottom -13px

    &.center.right
      border-left-color $tooltip-border-color
      bottom -13px

  .title-wrap
    margin-bottom 7px
    font-weight bold

  .tooltip-body-wrap
    .line
      display block
      width 100%
      height 1px
      background-color #E1E5EB
      margin-top 7px
      margin-bottom 6px

    .tooltip-body-before
      display flex
      align-items center
      margin-bottom -4px

      .time
        font-weight bold
        margin-right 8px

      .severity
        padding 4px
        border-radius 2px

      .severity.low
        background-color #E5F1FF
        color #2A86F3

      .severity.medium
        background-color #F8F2E6
        color #BD7A03

      .severity.high
        background-color #FBEEEE
        color #D12D2D

    .tooltip-body
      display flex
      align-items center

      .label-box
        width 10px
        height 10px
        display block
        margin-right 5px
        border-width 2px
        border-radius 100%