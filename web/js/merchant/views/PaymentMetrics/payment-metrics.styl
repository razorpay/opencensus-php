$tooltip-border-color = #E0E8F4

// payment metrics dashboard tooltip styles
#chartjs-tooltip.sr-chartjs-tooltip
  margin-left: 0
  width: auto

.sr-chartjs-tooltip
  .tooltip-caret
    display: block
    position: absolute
    margin: auto
    width: 0
    height: 0
    border-color: transparent
    border-style: solid
    border-width: 6px

    &.top.center,
    &.top.left,
    &.top.right
      border-bottom-color: $tooltip-border-color
      top: -13px

    &.bottom.center,
    &.bottom.left,
    &.bottom.right
      border-top-color: $tooltip-border-color
      bottom: -13px

    &.center.left
      border-right-color: $tooltip-border-color
      bottom: -13px

    &.center.right
      border-left-color: $tooltip-border-color
      bottom: -13px

  .title-wrap
    margin-bottom: 7px
    font-weight: 600

  .tooltip-body-wrap
    .line
      display: block
      width: 100%
      height: 1px
      background-color: #E1E5EB
      margin-top: 7px
      margin-bottom: 6px

    .tooltip-body-before
      display: flex
      align-items: center
      margin-bottom: -4px

      .time
        font-weight: 600
        margin-right: 8px

    .tooltip-body
      display: flex
      align-items: center

      .label-box
        width: 10px
        height: 10px
        display: block
        margin-right: 5px
        border-width: 2px
        border-radius: 100%

  .btn-wrapper
    text-align: center
    padding-top: 10px

    .tooltip-btn
      background: #B6B6B6
      border: none
      color: #FFF
      font-weight: 600
      padding: 6px 10px
      cursor: pointer
      border-radius: 25px
      text-align: center
      pointer-events: auto
