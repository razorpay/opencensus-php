.fux-commission-cards {
    color: $fux-text-color;
    background: linear-gradient(249.98deg, #FFFFFF 57.5%, #F6F6F6 116.05%);
    border-radius: 4px;
    position: relative;

    &.home-view {
        margin: 22px;
    }

    &.lg {
        @media (max-width: 1300px) {
            display: none;
        }
    }

    .card-title {
        font-weight: bold;
        font-size: 20px;
        margin: 16px 30px 0;
        padding-top: 16px;
    }

    .card-wrapper {
        display: flex;
        justify-content: space-between;

        @media (max-width: 767px) {
            flex-direction: column;
        }

        .card-body {
            display: flex;
            flex: 1;
            background: #F9FAFF;
            box-shadow: 0px -4px 13.4769px #0b70e71a;
            border-radius: 4px;
            margin: 40px;
            margin-top: 20px;
            padding-bottom: 12px;
            overflow: hidden;

            &:first-child {
                margin-right: 20px;

                @media (max-width: 500px) {
                    margin: 8px;
                    margin-bottom: 20px;
                }
            }

            &:last-child {
                margin-left: 20px;

                @media (max-width: 500px) {
                    margin: 8px;
                }
            }

            ul {
                width: 100%;
                list-style: none;
                margin: 32px 16px;

                li {
                    &:before {
                        content: ' ';
                        background: url('https://cdn.razorpay.com/static/assets/partner-dashboard/fux-cards/commission-guide/earning-list.svg') no-repeat; 
                        display: inline-block;
                        width: 24px;
                        height: 24px;
                        margin-left: -36px;
                        font-size: 18px;
                        margin-top: 12px;
                    }

                    &:last-child {
                        &:before {
                            background: none;
                        }
                    }
                }
            }

            .text-content {
                width: 100%;
                z-index: 1;

                @media (max-width: 1300px) {
                    z-index: 1;
                }

                .title-text {
                    font-weight: 700;
                    font-size: 22px;
                    margin: 30px;
                    margin-bottom: 0;

                    @media (max-width: 1300px) {
                        font-size: 18px;
                    }
                }

                .sub-text {
                    font-size: 15px;
                    line-height: 16px;
                    text-align: start;
                    margin: 30px;
                    margin-top: 4px;
                    margin-bottom: 25px;
                    width: 75%;

                    @media (max-width: 1300px) {
                        font-size: 13px;
                    }
                }

                .list-title {
                    font-size: 15px;
                    line-height: 18px;
                    font-weight: 700;
                    margin-bottom: 4px;
                    margin-top: -30px;
                }

                .list-subtext {
                    font-size: 13px;
                    line-height: 16px;
                    color: #162f56bd;
                    width: 60%;

                    @media (max-width: 1300px) {
                        width: 70%;
                    }
                }
            }

            .card-image {
                width: 200px;
                height: 100%;
                position: relative;

                @media (max-width: 1300px) {
                    width: auto;
                    height: auto;
                    position: relative;
                }

                img {
                    position: absolute;
                    opacity: 0.8;

                    @media (max-width: 1300px) {
                        z-index: 0;
                        opacity: 0.2;
                    }
                }

                &.bonus-image {
                    img {
                        right: -110px;
                        bottom: -50px;

                        @media (max-width: 1300px) {
                            right: -75px;
                            bottom: -40px;
                            width: 270px;
                        }
                    }
                }

                &.rewards-image {
                    img {
                        top: -55px;
                        right: -245px;

                        @media (max-width: 1300px) {
                            width: 270px;
                            right: -135px;
                            top: auto;
                            bottom: 15px;
                        }
                    }
                }
            }
        }
    }
}