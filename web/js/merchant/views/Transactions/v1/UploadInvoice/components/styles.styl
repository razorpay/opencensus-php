.invoice-file-uploader
  opacity: 0
  visibility: hidden
  position: absolute
  left: -200%
  top: -200%
  z-index: -100
  width: 0
  height: 0
  overflow: hidden

button.invoice-payment-doc-view-btn
  display: inline-block
  border: 1px solid #D0D0D0
  background: #FFF
  border-radius: 4px
  color: #8A8A8A
  font-size: 12px
  padding: 1px 8px

  .Button-icon
    color: #008659

.invoice-info-banner
  display: flex
  color: #31708F
  background-color: #008CB117
  border-radius: 4px
  padding: 1rem
  margin-bottom: 1.4rem

  .i
    margin-top: 0.3rem
    font-size: 1.8rem

  .content
    margin-left: 1rem
