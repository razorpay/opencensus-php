.magic-checkout-demo-container
  position: relative
  background: url("assets/magic-checkout/shiprocket-demo-bg.svg") no-repeat
  background-size: cover

  .magic-checkout-demo-content
    padding: 50px 12px 16px

    .magic-checkout-demo-video
      min-height: 430px

    .demo-video-subtext
      color: #9FA3AF
      margin-top: 12px

      .shiprocket-demo-info-icon
        background: #878c9c
        border-radius: 50%;
        height: 12px;
        width: 12px;
        margin-right: 4px;

  img
    position: absolute
    top: 0
    left: calc(100% - 20px)
    top: 25px
    z-index: 1
    width: 40px

.link-account-instruction
  margin-top: 30px

  .shipping-services-info-highlights
    border-left: 4px solid #eeeff4
    position: relative

  .link-account-subheading
    margin-top: 8px

  .info-component-divider
    border-top: 1px solid #BABDC1
    flex: 1
    margin: 24px 0

  .info-component-divider-text
    margin: 0 10px

.link-account-content
  padding: 0 48px

  .link-account-header
    font-size: 16px

  .link-account-desc
    padding-top: 10px

  .link-account-info
    flex-wrap: wrap
    height: 400px

    .link-account-list
      padding-left: 12px
      margin-left: 6px

    .link-account-list-item
      margin: 8px 0 4px

    .pointer-container
      position: absolute
      left: -10px

      .pointer-circle
        width: 18px
        height: 18px
        font-size: 10px
        background: #1583F1
        border-radius: 50%
        color: #FFFFFF

    .shipping-services-cta-container
      position: absolute
      bottom: 20px
      right: 48px

      .primary-cta
        margin-left: 40px
        padding: 10px 28px
        background: #1583F1
        color: #FFFFFF
        border-radius: 2px
      
      .shiprocket-connect-cta-disabled
        background: #8AC1FA
        cursor: not-allowed

.shipping-header
  margin-bottom: 10px
  color: #162f56de

.shiprocket-connect-info
  padding: 12px
  background: #F8F9FF
  margin-top: 30px

  .shiprocket-connect-info-icon
    border-radius: 50%
    background: #B8C0E6
    height: 15px
    width: 40px
    margin-right: 8px
    margin-top: 4px

img.benefits-shiprocket-list-icon
  align-self: flex-start
  margin-right: 10px
  margin-top: 2px

.benefit-shiprocket-container
  width: 40%
  margin-left: 18%
  padding-right: 4px;


li.link-account-list-item:first-child, .filter-item .shiprocket-api-input, .filter-item .slabs-container
  margin-top: 0

.filter-item .serviceability-setting-input
  display: inline-block
  margin: 0
  padding-top: 0
  margin-left: 16px

.filter-item .slabs-flat-charge-input
  width: 300px
  margin-left: 0
  margin-top: 8px

.slab-parent
  margin-left: 0
  padding: 4px 8px

.slabs-label
  margin-left: 8px  