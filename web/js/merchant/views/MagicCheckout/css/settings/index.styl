.platform-settings-container 
  padding: 24px
  width: 100%

  .platform-settings 
    
    .platform-heading-container
      border-bottom: 1px solid #5159781a
      background: #fafcff

      .platform-heading
        color: #344A6C

      .platform-subtext
        color: #516482

      .platform
        padding: 2px 4px
        background: #162f560d

      .platform-details
        margin-right: 24px
      
      .platform-label
        display: flex
        align-items: center
        min-width: 17%
        margin-right: 24px
        .i-info-outline
          margin-top: 4px;
          margin-left: 10px;
          font-size: 18px;
          .rzp-popover-content > .rzp-popover-body
            font-style: normal

      .platform-edit
        color: #2B83EA

      .platform-edit-icon
        margin-right: 8px

  .platform-cta-container 
    justify-content: end

    .platform-cta 
      margin: 16px 0
      background: #0B70E7
      padding: 10px

.bg-settings
  background: #fafcff

.platform-settings-container
  .settings-cta
    float: right
    margin: 16px 0

  .woocommerce-shipping-container
    .settings-cta
      margin: 36px 0
