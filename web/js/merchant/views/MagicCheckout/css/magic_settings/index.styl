.Input.select-platform-dropdown
  width: 320px
  margin: 0 0 8px

.selection-container
  padding: 48px 28px 8px
  width: fit-content
  border-right: 1px solid #0000001a

  label 
    margin-bottom: 12px

.edit-settings-cta-container
  padding: 14px 28px
  background: #FAFAFA

.Form.Form--magic-settings 
  .Input-label
    text-align: left

  .slabs-container
    margin-left: 16px

  .c-fee-configuration
    .Input-content
      margin-left: 0

  .serviceability-setting-label
    text-align: right
  
  .Magic-Settings--Input.Input--disabled
    opacity: 1
    .Input-el
      background: #F7F8F8

  .Magic-Settings--Input.Input
    display: flex
    .Input-content
      flex: 1
      margin-left: 16px
    .Input-label
      width: 30%
      text-align: right
      label
        font-weight: bold

  .Input--Shopify.Input.is-mature:not(.is-focused).is-invalid 
      .Input-addons
        background-color: transparent
  .Input--Shopify.Input
      .Input-addons--after 
        right: 8px
      .Input-addons
        width: auto
        background-color: transparent
  .Input--Shopify.Input.is-focused
      .Input-addons
        background-color: transparent

.magic-settings-container
  min-height: 600px

.switch-platform-modal--heading
  color: #262D3A;
  font-size: 16px;
  line-height: 20px;
  font-weight: bold;

.border-bottom-light 
  border-bottom: 1px solid rgba(0, 0, 0, 0.1)

.platform-settings-card
  max-width: 420px
  margin: 48px 28px
  border: 2px solid #E0E8F4

.platform-settings-card--header
  background: #F8FBFF
  border-bottom: 1px solid rgba(0, 0, 0, 0.2)
  padding: 24px 18px

  .inline-flex
    display: inline-flex
    align-items: center
    gap: 8px

  .platform-heading 
    color: #58666E
    font-size: 14px
    font-weight: 800
    line-height: 18px

.platform-settings-card--body
  .setting-label
    color: #5A6870
    font-size: 14px
    font-weight: 500
    line-height: 16px

  .setting-value
    color: #000000
    font-size: 14px
    font-weight: 600
    line-height: 20px

.border-bottom-light 
  border-bottom: 1px solid #0000001a
