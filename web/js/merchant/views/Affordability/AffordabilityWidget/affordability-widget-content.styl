.platforms-page
  padding: 64px

  @media (max-width 1024px)
    padding: 24px 24px 75px

  .pp-header
    display: flex
    align-items: center
    justify-content: space-between
    flex-wrap: wrap

    .pp-header-title
      margin: 0
      color: #0D2366
      font-size: 32px
      line-height: 1.5
      font-weight: 600

      @media (max-width 1024px)
        font-size: 24px
        width: 100%
        line-height: 1

  .platforms
    display: flex
    justify-content: space-between
    position: absolute
    top: 40%
    left: 64px
    right: 64px
    transform: translate(0, -50%)

    @media (max-width 1024px)
      position: relative
      transform: none
      display: block
      left: 0
      top: 0
      right: 0
      margin-top: 16px
      overflow: scroll

  .platform
    display: flex
    flex-direction: column
    width: calc(100% / 3 - 28px)
    // stylelint-disable-next-line
    box-shadow: 0 3px 6px 0 rgba(48,52,62,0.1)
    padding: 16px
    border-radius: 4px
    text-align: left
    position: relative
    z-index: 0
    overflow: hidden

    @media (max-width 1024px)
      width: 100%
      display: flex
      flex-direction: row
      margin: auto
      margin-bottom: 16px

    &::before,
    &::after
      content: ""
      position: absolute
      z-index: 2
      background: #F1F6FD
      width: 122%
      height: 150%
      left: -25%
      top: -75%
      transform: rotate(-19deg)

    &::after
      background: #F7FAFE
      right: -25%
      left: 0
      top: -30%
      transform: rotate(30deg)
      z-index: 1

  .platform:hover
    cursor: pointer
    border: 1px solid #2560BC

  .platform-icon
    width: 70px
    position: relative
    z-index: 3

    @media (max-width 1024px)
      width: 42px

  .platform-content
    margin-top: 20px
    position: relative
    z-index: 3
    display: flex
    justify-content: space-between
    align-items: baseline

    @media (max-width 1024px)
      flex: 1
      margin-top: 0
      margin-left: 8px
      align-items: center;

  .platform-title
    font-weight: 600
    font-size: 24px
    line-height: 24px
    // stylelint-disable-next-line
    color: rgba(13, 35, 102, 0.9)

    @media (max-width 1024px)
      font-size: 20px

  .platform-title-icon
    font-size: 12px
    color: #2A2A77
    position: relative

.steps {
  display: flex
  flex-direction: column

  .step {
    margin-top: 42px
    display: flex
    justify-content: flex-start
    align-items: stretch
    gap: 26px

    .step-indicator {
      position: relative
    }

    .step-indicator-icon {
      height: 28px
      width: 28px
      background: #FFF
      border: 1px solid #D9D9D9
      border-radius: 50%
      display: flex
      justify-content: center
      align-items: center
    }

    .step-indicator-icon-done {
      background-image: url("assets/onboarding/done-darkgreen.svg")
      background-repeat: repeat
      background-position: center
    }

    .btn-feedback {
      // stylelint-disable-next-line
      background: rgba(0, 156, 92, 0.09)
      // stylelint-disable-next-line
      border: 1px solid rgba(0, 156, 92, 0.32)
      border-radius: 2px
      color: #008659
      font-weight: 600
      cursor: arrow
    }

    .step-indicator-connector {
      position: absolute
      width: 130px
      height: 0
      transform: translate(15px, 0) rotate(90deg)
      transform-origin: top left
      border: 1px dashed #D9D9D9
    }

    .title {
      font-weight: 600
      font-size: 16px
      line-height: 110%
      color: #444
    }

    .description {
      font-weight: 400
      font-size: 14px
      line-height: 18px
      color: #7C8297
      margin-top: 6px
      margin-bottom: 20px
    }
  }
}

.confirm-enable-modal {
  .close-btn {
    background: #FFF
    color: #528FF0
    margin-right: 10px
  }

  .checkbox-row {
    display: flex

    p {
      .discounted-price {
        text-decoration-line: line-through
      }

      a {
        color: #528FF0
      }
    }
  }

  .modal-footer {
    display: flex
    justify-content: flex-end
    padding: 10px
    border-top: 0
  }
}

.icon-wrapper
  height: 62px
  width: 62px
  display: grid
  place-content: center

  @media (max-width 395px)
    height: 32px

.icon-img
  height: 52px
  width: 52px

  @media (max-width 395px)
    height: 26px
    width: 26px

.Product--Details
  .callout
    .caption
      font-size: 16px
      font-weight: 600
      line-height: 17.6px
      color: #444

    .feature-tiles-grid
      margin-top: 30px
      display: grid
      grid-template-columns: repeat(auto-fit, minmax(110px, 1fr))
      max-width: 475px
      gap: 28px 12px

      @media (max-width 395px)
        grid-template-columns: repeat(auto-fit, minmax(94px, 1fr))
        max-width: 475px
        gap: 28px 11px

      .feature-tile
        width: 100%
        height: 195px
        display: flex
        flex-direction: column
        align-items: center
        justify-content: start
        background: #FFF
        // stylelint-disable-next-line
        box-shadow: 0px 0px 4px rgba(0, 0, 0, 0.25)
        position: relative
        padding-top: 20px

        @media (max-width 395px)
          height: 112px
          padding-top: 10px

        .feature-metric
          font-weight: 600;
          font-size: 30px;
          line-height: 110%;
