$text-default = #5D666D
$border-grey = #E6E7E8
$text-grey = #828282
$color-grey = #515978
$tat-text-color = #162F5661

.instruments-methods-container
  border: 1px solid $border-grey
  padding: 14px 0 0

  .status-label
    padding: 5px 12px
    text-transform: uppercase
    min-width: unset

  button
    margin-right: 0

  .request-cta
    margin-left: 10px
    min-width: 120px

    button
      width: 100%

  .top-container
    padding: 0 20px
    margin-bottom: 14px

    .action-wrapper
      display: flex
      flex-direction: row
      align-items: center
      justify-content: space-between
      margin-bottom: 14px

    .left-text-wrapper
      margin-right: 0
      flex: 1

      h4
        font-size: 14px
        color: $text-default
        margin: 0 0 5px
        line-height: 17px
        font-weight: 500

      p
        font-weight: 400
        font-size: 12px
        line-height: 16px
        color: $text-grey

  .bottom-container
    padding: 8px 16px
    margin-bottom: 14px
    border-radius: 4px
    display: flex
    flex-direction: row
    background: #0B70E70D

    i
      margin-top: 3px

    .error-message
      padding-left: 5px

      .message
        font-size: 12px
        color: $text-default
        line-height: 16px
        margin-bottom: 4px

      .action
        font-weight: 400
        font-size: 12px
        line-height: 14px
        color: $text-default

  .method-list-container
    border-top: 1px solid $border-grey

    button
      margin-left: auto

    .instrument-row
      display: flex
      flex-direction: row
      align-items: center
      padding: 14px 0
      border-bottom: 1px dashed $border-grey

      &:last-child
        border-bottom: unset

      img
        width: 22px
        height: auto
        margin-right: 17px
        font-size: 10px

      .text-wraper
        margin-right: auto

        .name
          font-size: 14px
          font-weight: 500
          color: $text-default
          line-height: 17px

        .description
          font-size: 12px
          line-height: 16px
          font-weight: 400
          margin-top: 5px
          color: $text-grey

      .status-wrapper
        display: flex
        flex-direction: column
        align-items: center

        .tat-text
          font-size: 10px
          color: $tat-text-color
          border-bottom: 0.5px solid $tat-text-color
          margin-top: 5px
          font-weight: 600
