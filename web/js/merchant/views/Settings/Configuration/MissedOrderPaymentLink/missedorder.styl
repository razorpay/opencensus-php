$screen-xs-max = 767px

#missed-order-plan-title
  font-size: 18px
  font-weight: 600
  color: #4A4A4A
  line-height: 20px

#info-outline-icon-wrapper
  font-size: 80%
  color: #8A9499
  padding-left: 4px

#missed-order-amount-information
  font-size: 14px
  color: #58666E
  font-weight: 600
  line-height: 20px

#missed-order-pl-button
  border-radius: 4px

.mopl-btn-loading
  gap: 8px
  opacity: 0.5

.info-wrapper-mopl
  width: 100%
  padding: 8px 12px
  border-radius: 1px
  background: #F8FAFF
  border: 1px solid #608DE9

  .flex-space-between
    display: flex
    font-size: 14px
    font-weight: 400
    color: #4A4A4A
    margin-bottom: 8px
    justify-content: space-between

  .amount-wrapper
    font-size: 16px
    color: #4A4A4A
    font-weight: 600

  .middle-align
    display: flex
    align-items: center

  .left-space
    width: 4px
    height: 8px
    color: #8A9499
    padding-left: 4px

.manage-settings-container
  width: 360px

  .header-wrapper
    gap: 4px
    display: flex
    border-bottom: 0
    align-items: center
    padding: 24px 8px 0
    justify-content: space-between

  .heading-title
    display: flex
    align-items: baseline
    justify-content: center

  .content
    padding: 24px

    .heading
      font-weight: 600
      font-size: 14px
      line-height: 20px
      color: #58666E

    .channels-space
      gap: 24px
      margin-top: 12px

    .middle-align
      display: flex
      align-items: center
      justify-content: center

    .current-wrapper
      margin-top: 24px

    .info-wrapper-space
      margin-top: 8px

    .cancel-wrapper
      display: flex
      margin-top: 16px
      align-items: center
      justify-content: space-between

    .btn-wrapper
      margin-top: 40px

    .pro-info-wrapper
      margin-top: 12px

.mopl-insights-container
  width: 360px

  .content
    padding: 24px

    .heading
      color: #333
      font-weight: 400
      font-size: 14px
      line-height: 20px

    .sub-heading
      color: #333
      font-size: 12px
      font-weight: 400
      line-height: 20px

    .blue-text
      color: #333
      font-weight: 600
      padding-left: 4px

    .insight-highlighter
      height: 56px
      padding: 8px
      margin-top: 16px
      border-radius: 1px
      border: 1px solid #7BB2F2
      background: rgba(11 112 231 0.05)

    .amount-wrapper
      color: #333
      font-size: 16px
      padding-left: 8px
      line-height: 20px

    .subtitle
      font-size: 14px
      font-weight: 600
      color: #58666E
      line-height: 20px

    .retarget-wrapper
      margin-top: 20px
      margin-bottom: 8px

    .info-space
      gap: 16px

    .info-wrapper
      gap: 2px
      padding: 8px
      width: 50%
      display: flex
      border-radius: 1px
      background: #FAFCFF
      flex-direction: column
      border: 1px solid rgba(11 112 231 0.1)

    .conversion-wrapper
      margin-top: 16px

    .whatsapp-wrapper
      display: flex
      align-items: center

    .btn-wrapper
      margin-top: 18px

    .info-data-validation
      gap: 4px
      display: flex
      margin-top: 8px
      align-items: end
      justify-content: center

.plan-confirmation-container
  width: 328px
  border-radius: 2px

  .header-wrapper
    gap: 4px
    display: flex
    border-bottom: 0
    align-items: center
    padding: 24px 24px 0

  .icon-wrapper
    margin-right: 12px

  .content
    padding: 18px 24px

    .info-wrapper
      height: 92px
      width: 280px
      padding: 8px 12px
      border-radius: 1px
      background: #F8FAFF
      border: 1px solid #608DE9

    .flex-space-between
      display: flex
      font-size: 14px
      font-weight: 400
      color: #4A4A4A
      margin-bottom: 8px
      justify-content: space-between

    .amount-wrapper
      font-size: 16px
      color: #4A4A4A
      font-weight: 600

    .plan-conditions
      margin-top: 16px
      margin-bottom: 8px

    .terms-conditions
      color: #8A9499
      margin-bottom: 64px

    .alert-info-wrapper
      gap: 8px
      padding: 8px
      font-size: 14px
      margin-top: 12px
      color: #8A6D6B
      border-radius: 1px
      margin-bottom: 24px
      background: #FEF6DD

    .btn-wrapper
      gap: 32px
      display: flex
      align-items: center
      justify-content: flex-end

.plan-selection-container
  width: 400px
  min-height: 526px
  display flex
  border-radius: 2px
  padding-left: 24px
  flex-direction column

  .content
    font-weight: 400
    color: #58666E
    line-height: 20px
    padding-right: 24px

    ul
      padding: 4px 0 0 24px

    .plan-wrapper
      width: 352px
      display: flex
      margin-top: 16px
      margin-bottom: 16px
      border-radius: 2px
      flex-direction: row
      background: #FAFCFF
      justify-content: space-between
      border: 1px solid rgba(11 112 231 0.1)

    .amount-wrapper
      display: flex
      width: 140px
      margin-top: 8px
      font-size: 16px
      color: #4A4A4A
      font-weight: 600

    .info-text
      font-size: 12px
      margin-top: 4px
      color: #58666E
      font-weight: 400
      line-height: 20px

    .plan-info
      display: flex
      padding-top: 12px
      padding-left: 12px
      margin-bottom: 10px
      flex-direction: column
      justify-content: flex-start

    .select-plan-btn
      padding: 24px 0 44px

    .img-wrapper
      display: flex
      font-size: 12px
      margin-top: 8px
      color: #1F890E
      font-weight: 600
      line-height: 18px

    .img-frame
      width: 10px
      height: 10px
      margin-right: 4px

    .free-eligible
      padding: 8px
      display: flex
      font-size: 14px
      color: #8A6D6B
      line-height: 19px
      border-radius: 1px
      align-items: center
      background: #FEF6DD
      justify-content: center
      margin-bottom: 24px

    .info-wrapper
      margin-right: 8px

  .modal-header
    padding-left: 0
    padding-bottom: 12px

    .close
      margin-right -8px

  .pointer
    cursor: pointer

.missedorder-features-container
  width: 400px
  height: 462px
  background: #FFF
  box-shadow: 0 2px 6px rgb(62 71 84 0.13)
  border-radius: 2px

  .content
    margin: 21px 24px 24px

    .plans-wrapper
      display: flex
      padding: 12px 0
      gap: 24px

      .plan-container
        width: 168px
        height: 337px
        padding: 12px
        background: #FFF
        border-radius: 2px
        border: 1px solid #D9DEE4

      .amount-wrapper
        display: flex
        margin-top: 8px
        align-items: baseline

      .amount-value
        font-size: 16px
        color: #4A4A4A
        font-weight: 600

      .underline-blue
        width: 20px
        height: 1.5px
        margin-top: 8px
        background: #608DE9

      .sub-section
        font-size: 12px
        margin-top: 12px
        color: #58666E

      .success-tick
        color: #1F890E

      .close-tick
        color: #D12D2D

      .features-content
        margin-top: 2px

      .select-btn-wrapper
        margin-top: 24px

.missed-order-wrapper
  .form-btn-align
    flex: 0.4
    display: flex
    padding: 0 32px 0 0
    justify-content: space-between
    align-items: baseline

    @media screen and (max-width $screen-xs-max)
      padding: 0

  .charge-info
    font-size: 12px
    color: #5B666D
    font-weight: 400
    line-height: 20px
    font-style: normal
    text-align: center

  .manage-wrapper
    width: 96%
    display: flex
    justify-content: space-between

  .btn-loading
    opacity: 0.5
    gap: 4px

  .title
    width: 65%
    display: flex
    align-items: center

    @media screen and (max-width $screen-xs-max)
      align-items: start
      flex-direction: column
      gap: 10px

  .active-wrapper
    padding-left: 8px

    @media screen and (max-width $screen-xs-max)
      padding-left: 0

  .active-content
    display: flex
    min-width: 78px
    font-size: 12px
    padding-top: 5px
    padding-bottom: 5px
    border-radius: 20px
    justify-content: center
    background: rgba(31 137 14 0.1)

  .active-color
    color: #1F890E

  .inactive-color
    color: #FFF
    background: #777

  .manage-btn
    width: 90px
    height: 28px
    display: flex
    font-size: 12px
    cursor: pointer
    color: #2B83EA
    font-weight: 600
    line-height: 18px
    border-radius: 2px
    margin-right: 4px
    align-items: center
    justify-content: center
    background: rgba(11 112 231 0.05)
    border: 1px solid rgba(11 112 231 0.74)

  .icon-wrapper
    outline-color: #2B83EA
    padding-right: 4px

  .date-wrapper
    font-size: 12px
    padding-left: 12px
    font-weight: 600

  .free-bill-date
    color: #C28533

    @media screen and (max-width $screen-xs-max)
      list-style-type: none;
      padding-left: 0

  .billing-date
    color: #9BA6AC

  .get-started-btn
    margin-right: 0

  .insight-description-wrapper
    display: flex
    align-items: center
    width: 500px
    height: 44px
    padding: 8px
    margin-top: 16px
    background: #FAFCFF
    justify-content: space-between
    border: 1px solid rgba(11 112 231 0.1)

    @media screen and (max-width $screen-xs-max)
      width: 100%

  .insight-image-wrapper
    margin-right: 8px

  .insight-highlight-textarea
    display: flex
    align-items: center
    font-style: normal
    font-size: 14px
    line-height: 20px
    color: #333

.missed-order-cancel-container
  width: 360px

  .header-wrapper
    gap: 4px
    display: flex
    border-bottom: 0
    align-items: center
    padding: 24px 8px 0
    justify-content: space-between

  .heading-title
    display: flex
    align-items: center
    justify-content: center
    gap: 8px

  .content
    margin: 10px 28px 0

    .info
      font-size: 14px
      font-weight: 400
      color: #58666E

    .info-warning
      height: 56px
      display: flex
      color: #8A6D6B
      margin-top: 20px
      align-items: center

    .btn-wrapper
      gap: 24px
      display: flex
      margin-top: 28px
      margin-bottom: 24px
      align-items: center
      justify-content: end

#pro-plan-lock-wrapper
  gap: 8px
  display: flex
  padding: 8px
  align-items: center
  border-radius: 1px
  background: #FEF6DD
  justify-content: flex-start

  .pro-plan-text
    font-size: 14px
    color: #8A6D6B
    font-weight: 400
    line-height: 19px

  .img-wrapper
    width: 18px
    height: 18px
    display: flex
    align-items: center
    border-radius: 10px
    justify-content: center
    background: rgba(205 130 20 0.1)
