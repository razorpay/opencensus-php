.gap--8
    gap: 8px
.firstview-heading-container
    justify-content: space-between
    margin-bottom: 10px
    align-items: center
    .rzp-amount
        .rzp-currency,.rzp-whole,.rzp-paise
            font-weight: 800
            font-size: 100%
            opacity:1
    .firstview-heading
        font-weight: 800 
        font-size: 20px
        line-height: 24px 
    .small
        font-size: 100%
        color:#4e617fb3
.new-label
    background:linear-gradient(102.84deg, #0B70E7 -0.01%, #0b70e799 113.69%)
    border-radius: 2px
    color: #ffffff
    padding: 0 4px
.firstview-footer--note
    margin-top: 16px
    font-weight: 400
    font-size: 13px
    line-height: 18px
    color: #7B8199
.firstview-options-label--container
    margin-top: 16px
    margin-bottom: 12px
.firstview-preference--container
    align-items: center
    gap:10px
    .firstview-radio--label
        font-weight: 600
        font-size: 14px
        line-height: 20px
        .default-label
            font-weight: 600
            font-size: 10px
            line-height: 14px
            color: #2A86F3
            letter-spacing: 0.5px
            text-transform: uppercase
    .firstview-radio--sublabel
        font-weight: 400
        font-size: 12px
        line-height: 18px 