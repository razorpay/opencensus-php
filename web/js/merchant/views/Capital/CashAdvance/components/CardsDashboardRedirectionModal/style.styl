.dashboard-redirect-modal-wrapper
  width: 464px
  height: 295px
  background: #F5F8FC
  border-radius: 8px
  .modal-title
    font-size: 20px
    font-weight: 600
    line-height: 30px
    text-align: center
    color: #132644
    margin: 26px 0 0 0
  .dashboard-modal-inner-card
    width: 400px
    height: 185px
    background: #FFFFFF
    border: 1px solid #adbcc93d
    border-radius: 4px
    text-align: center
    margin: 48px 32px 32px 32px
    paddingTop: 22px
    .redirect-msg
      font-style: normal
      font-weight: 400
      font-size: 14px
      line-height: 20px
      text-align: center
      color: #324664
      margin: 24px 0 0 0
    .rzp-icon
      width: 45px
      height: 45px
      margin: 32px 0 0 0
