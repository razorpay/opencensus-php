.withdrawal-form-container
  .breakup-cta-container
    margin-left: 69px
    margin-top: 4px

  .repayment-info-container.static-tenure-repayment-info-container
    margin-left: auto
    flex: none
    width: 200px

    .repay-amount-wrapper
      margin: 4px 0 0 20px
      height: 40px
      line-height: 40px

    .calendar-icon
      margin: 38px 16px 0 20px
      width: 32px
      height: 32px

  .static-tenure
    display: flex
    flex-direction: column
    align-items: flex-start
    gap: 12px

    &__label
      margin-top: 12px
      font-weight: 600
      font-size: 16px
      line-height: 22px
      color: #324664

      .small-icon
        padding-left: 2px

    &__error
      font-weight: 400
      font-size: 13px
      line-height: 22px
      color: #D13821
      margin-top: 12px

    &__options
      display: flex

    &__option
      padding: 6px 8px
      font-weight: 500
      font-size: 14px
      line-height: 20px
      color: #4E617F
      opacity: 0.87
      cursor: pointer
      border: 1px solid #9DA7B6
      border-collapse: collapse

      &--left
        border-top-left-radius: 4px
        border-bottom-left-radius: 4px

      &--right
        border-top-right-radius: 4px
        border-bottom-right-radius: 4px

      &--active
        color: #0B70E7
        opacity: 0.87
        border-color: #0B70E7

    &__cta-container
      margin-left: 20px

    &__banner
      font-weight: 400
      font-size: 12px
      line-height: 20px
      color: #008CB1
      display: flex
      align-items: center
      padding: 2px 12px
      gap: 6px
      background: #DBF4FA
      border-radius: 50px
      margin-top: 4px
      margin-bottom: -18px
