.block-radio-container
  display: flex
  cursor: pointer
  padding: 8px 24px 8px 16px
  border-radius: 4px
  gap: 12px
  border: 1px solid #2a86f380
.block-radio-container--active
  background: #1566f117
  border: 1px solid #2a86f3
.block-radio-container--disable
  cursor: not-allowed
  opacity:0.6
.block-radio
  width: 13px
  height: 13px
  border-radius: 100%
  margin-top: 4px
  border: 1px solid #2a86f3
  background: #f8f9fb
.block-radio--checked
  border: 4px solid #2a86f3
  background: #ffffff
.block-radio--disable
  cursor: not-allowed  