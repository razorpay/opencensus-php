.cash-advance-v2-wrapper {
  padding: 60px 45px;
  background: #03042b;
  background-position: 0 -90px;
  background-size: cover;
  background-image: url('https://cdn.razorpay.com/static/assets/cash-advance/CashAdvanceBackground.svg');

  .heading {
    font-size: 40px;
    line-height: 48px;
    text-align: left;
    color: #ffffff;
    font-weight: 700;
  }

  .divider {
    height: 5px;
    width: 30px;
    background-color: #2cca74;
    margin-top: 10px;
    z-index: 2;
  }

  .sub-heading {
    font-family: $mullish-font;
    padding: 20px 0;
    font-weight: 400;
    font-size: 16px;
    color: #ffffffc2;
    max-width: 440px;
  }

  .description {
    font-weight: 400;
    font-size: 12px;
    line-height: 16px;
    color: #8f93a4;
    margin-top: 20px;
  }

  button {
    background: #3281ff;
    color: #ffffff;
    font-weight: 700;
    font-size: 18px;
    min-width: 175px;
    height: 52px;
    font-size: 18px;
    line-height: 28px;
    border-radius: 4px;
  }
}


.card-section-wrapper {
  margin-top: 130px;
  display: flex;
  
  div {
    margin-right: 16px;
  }
}
