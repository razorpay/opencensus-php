.cash-advance-v2-wrapper 
  min-height: 100vh
  padding: 60px 45px
  background: #03042b
  background-position: 0 -90px
  background-size: cover

  &.default 
    background-image: url('https://cdn.razorpay.com/static/assets/cash-advance/CashAdvanceBackground.svg')

  &.plain 
    background-image: url('https://cdn.razorpay.com/static/assets/cash-advance/CashAdvancePlainBackground.png')
    background-position: 0

  .heading 
    font-size: 40px
    line-height: 48px
    text-align: left
    color: #ffffff
    font-weight: 700

  .divider 
    height: 5px
    width: 30px
    background-color: #2cca74
    margin-top: 10px
    z-index: 2

  .sub-heading 
    font-family: $mullish-font
    padding: 20px 0
    font-weight: 400
    font-size: 16px
    color: #ffffffc2
    max-width: 440px

    &.with-border 
      border-bottom: 1px solid #4F546E

  .description 
    font-weight: 400
    font-size: 12px
    line-height: 16px
    color: #8f93a4
    margin-top: 20px

  button 
    background: #3281ff
    color: #ffffff
    font-weight: 700
    font-size: 18px
    min-width: 175px
    height: 52px
    font-size: 18px
    line-height: 28px
    border-radius: 4px
  
  .cash-advance-v2-wrapper-flex 
    min-height: 80vh
    display: flex
  
  .heading-flex 
    display: flex
    justify-content: space-between

  .left-side 
    flex: 50%
  
  .right-side 
    flex: 50%
    padding: 30px
    display: flex
    justify-content: space-between
    flex-direction: column
    background: #112058b3
    border: 1px solid #ffffff1a
    box-sizing: border-box
    box-shadow: inset 0 0 2px #223DA4
    backdrop-filter: blur(6px)
    border-radius: 4px

    .right-heading 
      font-weight: 700
      font-size: 18px
      line-height: 22px
      color: #E7E8EC
    
    .right-sub-heading 
      font-size: 14px
      line-height: 20px
      color: #E7E8EC
    
    .application-status 
      margin-top: 40px
    
    .right-footer 
      display: flex
      justify-content: space-between
      margin-top: 20px

      i 
        color: #528ff0
        font-size: 16px
        margin-right: 6px

      img 
        width: 77px
        height: 20px

  .view-content 
    color: #2A86F3
    font-weight: 700
    font-size: 14px
    cursor: pointer
    padding-left: 40px

    .i-chevron-up 
      font-size: 14px
      margin-top: 5px
      position: absolute

      &.rotate 
        transform: rotate(180deg)

.card-section-wrapper 
  margin-top: 130px
  display: flex

  div 
    margin-right: 16px

