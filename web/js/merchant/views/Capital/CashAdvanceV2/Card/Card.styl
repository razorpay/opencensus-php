.card-wrapper 
  position: relative
  min-width: 270px
  max-width: 290px
  min-height: 186px
  padding: 30px
  border-radius: 10px
  background: url('https://cdn.razorpay.com/static/assets/cash-advance/card-noise.png')
  background-repeat: round

  .title 
    margin-top: 5px
    font-weight: 600
    font-size: 16px
    line-height: 21px
    padding-bottom: 6px
    color: #ffffff

  .sub-title 
    margin-top: 4px
    font-size: 12px
    font-weight: 400
    line-height: 16px
    word-wrap: break-word
    color: #bbbdc8

  img 
    width: 36px
    height: 36px
  

