.OnBoarding--RazorpayX
    .offers-page
      padding: 80px 60px
      @media(max-width: 1250px)
        padding: 20px

      &--header
        display: flex
        flex-direction: row
        justify-content: space-between
        align-items: center
        margin-bottom: 80px
        color: #FFFFFF
        @media(max-width: 1250px)
          flex-direction: column
          align-items: flex-start
          gap: 8px

        h1
          margin: 0
          font-size: 32px
          font-weight: 900

          .text-gradient
            color: transparent
            -webkit-text-fill-color: transparent
            background: linear-gradient(90deg, #FFBD3C, #FF7015 50%)
            background-clip: text
            -webkit-background-clip: text
            font-weight: 700

        a
          font-size: 14px
          color: #FFFFFF
          text-decoration: underline

        span.bullet
          margin: 0 5px

      &--content
        .features-list
          display: grid
          grid-template-columns: repeat(auto-fit, minmax(130px, 1fr))
          gap: 50px
          @media(max-width: 638px)
            grid-template-columns: auto

          .feature
            @media(max-width: 638px)
              display: grid
              grid-template-columns: 72px 1fr
              align-items: center
              gap: 20px
            
          .feature--content
            .description
              font-size: 16px
              color: rgba(255,255,255,0.74)
              max-width: 200px
              @media(max-width: 638px)
                font-size: 14px

              .highlight
                font-weight: 700
                color: #FF7417
                
      .Button-Container
        @media(max-width: 638px)
          position: static
          display: flex
          justify-content: flex-end
          margin-top: 40px
        
        button.Back-Button
          color: #FFFFFF

  .Product--Details
    .callout
      .caption
        font-size: 14px
        font-weight: 700
        color: rgba(255, 255, 255, 0.87)

      .feature-tiles-grid
        margin-top: 28px
        display: grid
        grid-template-columns: repeat(auto-fit, minmax(110px, 1fr))
        max-width: 475px
        gap: 28px 12px
        @media(max-width: 375px)
          grid-template-columns: auto
      
        .feature-tile
          width: 100%
          height: 68px
          background-color: rgba(0,0,0,0.24)
          border-radius: 6px
          position: relative
          padding-top: 20px
          @media(max-width: 375px)
            height: 54px

          .icon-wrapper
            height: 32px
            width: 32px
            display: grid
            place-content: center
            padding-top: 2px //icons are slightly off centered
            border-radius: 50%
            background-color: #4A3C57
            position: absolute
            top: -16px
            left: 16px

          i
            font-size: 16px
            color: var(--icon-color)

          .feature-desc
            margin: 0
            padding-left: 12px
            font-size: 12px
            line-height: 18px
            color: rgba(255, 255, 255, 0.74)
            max-width: 15ch
            @media(max-width: 375px)
              max-width: none
