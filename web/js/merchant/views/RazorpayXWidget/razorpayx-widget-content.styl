.OnBoarding--RazorpayX
  .rzp-image
    width: auto
    height: auto

  .caption
    font-size: 14px
    font-weight: 600
    color: rgb(255 255 255 / 0.87)

  .feature-tiles-grid
    margin-top: 28px
    display: grid
    grid-template-columns: repeat(auto-fit, minmax(110px, 1fr))
    max-width: 475px
    gap: 28px 12px

    @media (max-width 375px)
      grid-template-columns: auto

    .feature-tile
      width: 100%
      height: 68px
      background-color: #0000003D
      border-radius: 6px
      position: relative
      padding-top: 20px

      @media (max-width 375px)
        height: 54px

      .icon-wrapper
        height: 32px
        width: 32px
        display: grid
        place-content: center
        padding-top: 2px //icons are slightly off centered
        border-radius: 50%
        background-color: #4A3C57
        position: absolute
        top: -16px
        left: 16px

      i
        font-size: 16px
        color: var(--icon-color)

      .feature-desc
        margin: 0
        padding-left: 12px
        font-size: 12px
        line-height: 18px
        color: rgb(255 255 255 / 0.74)
        max-width: unset

.x-banking-spinner
  position: absolute;
  top: 50%;
  left: 50%;
