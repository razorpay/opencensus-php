$bubble-red = #F54A2A;

.whats-new-icon
  .whats-new-icon-text
    .highlight
      font-weight: 600

    .bubble
      display: inline-block
      width: 18px
      height: 18px
      vertical-align: middle
      border-radius: 50%
      background: $bubble-red
      margin-left: 4px
      color: #FFF
      text-align: center
      font-size: 12px
      line-height: 18px

    .new-bubble
      position: absolute
      top: 7px;
      right: 7px
      width: 16px
      height: 16px
      border-radius: 50%
      background: $bubble-red
      font-size: 12px;
      text-align: center
      color: #FFF
      line-height: normal

.layout .whats-new-icon
  .whats-new-icon-text
    display: inline-block
    color: inherit
    cursor: pointer
    padding: 15px 15px 12px

    &.slider-active
      i
        color: #2B83EA

        &::after
          background: #F3F5F9

    i.i.i-horn
      font-size: 24px
      position relative
      top: 1px

      &::after
        border-radius: 50%
        height: 36px
        width: 36px
        position: absolute
        content: ""
        left: -6px
        top: -6px
        z-index -1

  &.whats-new-icon--active
    .whats-new-icon-text
      i
        color: #2B83EA

        &::after
          background: #F3F5F9

.layout.rzp .whats-new-icon .whats-new-icon-text
  @media screen and (max-width 767px) {
    color #FFF
  }
