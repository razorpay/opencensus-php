
#nitroPgPricing {
    height: 100vh;
    overflow: scroll;
    background:  linear-gradient(120.65deg, #252C4B 0%, #171B2F 100%);

    .tooltip-ui{
        position: absolute;
        z-index: 1;
        right: 15px;
        top: 43px;
    }
    .header-icons {
        position: fixed;
        width: 100%;
        display: flex;
        justify-content: space-between;
        height: 62px;
        align-items: center;
        background: linear-gradient(120.65deg, #252c4b 0%, #171b2f 100%);
        padding: 0 20px;
        padding-right: 70px;
        .nitro-tooltip {
            width: 18px;
        }
    }
    .nitro-image {
        width: 100%;
    }
    .addMarginNitro {
        margin-top: 60px;
    }
    .cta-wrapper {
        position: fixed;
        bottom: -1px;
        left: 50%;
        transform: translate(-50%, 0);
        width: 100%;
        display: flex;
        height: 65px;
        justify-content: center;
        background: linear-gradient(0.31deg, #171B2F 70.99%, rgba(23, 27, 47, 0) 99.72%);
        padding-top: 15px;

        button {    
            width: 100%;
            height: 36px;
            margin: 0 20px;
        }
    }
}