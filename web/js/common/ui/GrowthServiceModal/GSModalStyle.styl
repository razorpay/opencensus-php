// stylelint-disable color-function-notation
$screen-xs-max = 767px;
$desktop-wide = 1170px;

.gs-container
  max-height: 458px
  width: 100%
  overflow: scroll

  @media screen and (min-height 800px)
    max-height: 630px

#gs-btn-close
  position: relative
  right: 34px
  top: 25px
  padding: 0
  border: none
  background: none
  color: #FFF
  float: right
  height: 0

#gs-modal-loader
  width: auto
  height: 100%
  border: none

#gs-modal-body
  width: 100%
  height: 100%

  .background-img-mweb
    width: 100%
    overflow: hidden
    margin-bottom: 100px

  .background-img-dweb
    width: 100%
    overflow: hidden

.gs-modal-footer
  display: flex
  background: #8B3666
  min-height: 94px
  align-items: center
  justify-content: space-between
  padding-top: 3%
  padding-bottom: 3%
  border-top-color: #FFF
  border-top-style: solid

  .para-container
    width: 35%
    display: flex
    text-align: center
    margin-left: 31%
    justify-content: center

    .para
      font-size: 100%
      color: #FFFFFFBD

    .btn-container
      margin-right: 5%

      .btn
        min-height: 40px
        white-space: normal

        @media screen and (max-width 1400px)
          max-width: 100px

.gs-modal-footer-mobile
  text-align: center
  padding-top: 10px
  padding-bottom: 20px
  width: 100%
  border-top-color: #FFF
  border-top-style: solid
  position: fixed
  bottom: 0
  background: linear-gradient(0.31deg, #171B2F 70.99%, rgba(23, 27, 47, 0) 99.72%)

  .para-container
    padding-bottom: 15px

    .para
      font-size: 13px
      color: #FFFFFFBD
      margin-right: 12px
      margin-left: 12px

    .btn-container
      .btn
        margin-top: auto
        height: 40px
        margin-bottom: auto

#btn-center-cta
  position: absolute
  top: 85%
  left: 20%

  .btn
    margin-top: auto
    min-height: 40px
    margin-right: 50px
    margin-bottom: auto

.thank-you-gs-modal
  .img-container
    text-align: center
    padding-top: 40px

    img
      max-width: 340px

  .tm-footer
    padding-bottom: 25px

    @media screen and (max-width $desktop-wide)
      padding-bottom: 25px

    @media screen and (max-width $screen-xs-max)
      padding-bottom: 30px
