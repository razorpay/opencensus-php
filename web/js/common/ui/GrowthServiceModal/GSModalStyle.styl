  $screen-xs-max = 767px;
  $desktop-wide = 1170px;
.gs-container
    max-height: 458px
    width: 100%
    overflow: scroll
    @media screen and (min-height: 800px)
        max-height: 630px

#gs-btn-close
    position: relative
    right: 34px
    top: 25px
    padding: 0
    border: none
    background: none
    color: #FFFFFF
    float: right
    height: 0px

#gs-modal-loader
    width: auto;
    height: 100%;
    border: none;
    

#gs-modal-body
    width: 100%
    height: 100%
    .background-img
       width: 100%
       overflow: hidden


.gs-modal-footer
    display:flex
    background: #8B3666
    height: auto
    text-align: center
    padding-left: 20%
    padding-top: 3%
    padding-bottom: 3%
    justify-content: space-between
    border-top-color: white
    border-top-style: solid
    .para-container
        width: 70%
        .para
            font-size: 100%
            color: #ffffffbd
            margin-right: 10%
    .btn-container
        .btn
            margin-top: auto
            height: 40px
            margin-right: 50px
            margin-bottom: auto

.gs-modal-footer-mobile
    text-align: center
    padding-top: 10px
    padding-bottom: 20px
    width: 100%
    border-top-color: white
    border-top-style: solid
    position: fixed
    bottom: 0px
    background: linear-gradient(0.31deg, #171B2F 70.99%, rgba(23, 27, 47, 0) 99.72%)
    .para-container
        padding-bottom: 15px
        .para
            font-size: 13px
            color: #ffffffbd
            margin-right: 12px
            margin-left: 12px
    .btn-container
        .btn
            margin-top: auto
            height: 40px
            margin-bottom: auto

#btn-center-cta
    position: absolute
    top: 85%
    left: 20%
    .btn
        margin-top: auto
        height: 40px
        margin-right: 50px
        margin-bottom: auto

.thank-you-gs-modal
  .img-container
    text-align: center
    img
      max-width: 340px

  .tm-footer 
    padding-bottom: 25px
    @media screen and (max-width: $desktop-wide)
        padding-bottom: 25px

    @media screen and (max-width: $screen-xs-max)
        padding-bottom: 30px