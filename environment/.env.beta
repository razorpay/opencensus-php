APP_ENV=beta
APP_DEBUG=false

CACHE_DRIVER=file
SESSION_DRIVER=database
QUEUE_DRIVER=sqs

BASE_URL='https://beta-wl-dashboard.razorpay.com'

API_URL="https://beta-heimdall-api.razorpay.com/v1/"

# AWS Bucket for storing activation documents uploaded
AWS_ACTIVATION_BUCKET=activation_test
AWS_REGION=ap-south-1
# Region to be used just for buckets
AWS_BUCKET_REGION=us-east-1
CONTEXT=beta

MAIL_DRIVER=mailgun

# Should contact form submit details be sent to slack
# Set false in testing/development
# This is also used for Sorting Hat integration
# Slack Key is not used for Sorting Hat

SECURE_SESSION=true

API_MOCK=false
S3_MOCK=false
SLACK_ENABLE=false
# Creevey is the screenshot service
CREEVEY_MOCK=true
# Should mail be faked, set true in testing/development See mail.php for details
MAIL_PRETEND=false
MAILCHIMP_MOCK=true
ZAPIER_MOCK=true
OAUTH_MOCK=false
