APP_ENV=testing
APP_DEBUG=true
APP_KEY=SomeRandomString
APP_LOG=daily

CACHE_DRIVER=array
SESSION_DRIVER=array
QUEUE_DRIVER=sync

BASE_URL='http://localhost:4443'

API_URL=https://beta.razorpay.com/v1/
API_MOCK=false

QUEUE_DRIVER='sync'
AWS_QUEUE_URL=''
# AWS Bucket for storing activation documents uploaded
AWS_ACTIVATION_BUCKET=activation_test
#Your AWS Access Key ID
AWS_REGION=us-east-1
AWS_KEY_ID=''
AWS_KEY_SECRET=''

S3_MOCK=true
# Should mail be faked, set true in testing/development See mail.php for details
MAIL_PRETEND=true
MAIL_DRIVER=log

# Should contact form submit details be sent to slack
# Set false in testing/development
# This is also used for Sorting Hat integration
# Slack Key is not used for Sorting Hat
SLACK_ENABLE=false
SLACK_KEY=
NOCAPTCHA_SECRET=

CONTEXT=testing
# Creevey is the creenshot service
CREEVEY_TOKEN=
CREEVEY_MOCK=true
MAILCHIMP_LIST_ID=
MAILCHIMP_API_TOKEN=
MAILCHIMP_MOCK=true
ZAPIER_MOCK=true
CRON_PASS=RANDOM_CRON_PASS
SECURE_SESSION=false
