APP_ENV=bvt
SHIELD_STAGE=staging
APP_DEBUG=false

CACHE_DRIVER=redis
# This is just used for 1 zapier hook
# and the contact form
QUEUE_DRIVER=sync

BASE_URL=beta-dashboard.bvt.razorpay.in
CDN_DASHBOARD_URL=https://betacdn.np.razorpay.in/dashboard/bvt
CDN_BASE_URL='https://betacdn.np.razorpay.in'
API_URL="https://api-web.bvt.razorpay.in/v1/"
BANKING_SERVICE_URL="https://x-bvt.np.razorpay.in"
BANK_LMS_BANKING_SERVICE_URL ="https://partner-lms-bvt.np.razorpay.in"

# AWS Bucket for storing activation documents uploaded
AWS_ACTIVATION_BUCKET=rzp-beta-activation
MIGRATED_AWS_ACTIVATION_BUCKET=rzp-beta-activation

AWS_REGION=ap-south-1
# Region to be used just for buckets
AWS_BUCKET_REGION=us-east-1
MIGRATED_AWS_BUCKET_REGION=us-east-1

MAIL_DRIVER=mailgun

# Should contact form submit details be sent to slack
# Set false in testing/development
# This is also used for Sorting Hat integration
# Slack Key is not used for Sorting Hat

SECURE_SESSION=true

API_MOCK=false
S3_MOCK=false
SLACK_ENABLE=false
# Creevey is the screenshot service
CREEVEY_MOCK=true
# Should mail be faked, set true in testing/development See mail.php for details
MAIL_PRETEND=false
MAILCHIMP_MOCK=true
ZAPIER_MOCK=true
OAUTH_MOCK=false

AUTH_SERVICE_URL="https://auth.bvt.razorpay.in"
LJ_KEY='6z9XZ6qi4zo6lBu082ptIMAHg6XlOHJS'
