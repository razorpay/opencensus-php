BANK_LMS_BANKING_SERVICE_URL ="https://partner-lms-func.np.razorpay.in"
API_URL="https://api-web.func.razorpay.in/v1/"

# AWS Bucket for storing activation documents uploaded
AWS_ACTIVATION_BUCKET=rzp-1018-nonprod-qa-common
MIGRATED_AWS_ACTIVATION_BUCKET=rzp-1018-nonprod-qa-common
AWS_REGION=ap-south-1
# Region to be used just for buckets
AWS_BUCKET_REGION=ap-south-1
MIGRATED_AWS_BUCKET_REGION=ap-south-1

MAIL_DRIVER=mailgun

# Should contact form submit details be sent to slack
# Set false in testing/development
# This is also used for Sorting Hat integration
# Slack Key is not used for Sorting Hat

SECURE_SESSION=true

API_MOCK=false
S3_MOCK=false
SLACK_ENABLE=false
# Creevey is the screenshot service
CREEVEY_MOCK=true
# Should mail be faked, set true in testing/development See mail.php for details
MAIL_PRETEND=false
MAILCHIMP_MOCK=true
ZAPIER_MOCK=true
OAUTH_MOCK=false

