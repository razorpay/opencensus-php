APP_ENV=production
SHIELD_STAGE=production
APP_DEBUG=false

CACHE_DRIVER=redis
QUEUE_DRIVER=sqs

APP_LOG=daily

BASE_URL='https://dashboard.razorpay.com'
CDN_DASHBOARD_URL=''
CDN_BASE_URL=''

BANKING_SERVICE_URL="https://x.razorpay.com"

API_URL="http://api.razorpay.com/v1/"

# AWS Bucket for storing activation documents uploaded
AWS_ACTIVATION_BUCKET=dashboard-activation
AWS_REGION=ap-south-1
# Region to be used just for buckets
AWS_BUCKET_REGION=us-east-1

API_GUEST_AUTH_PASS=RANDOM_DASH_GUEST_PASSWORD
API_INTERNAL_AUTH_PASS=RANDOM_DASH_INTERNAL_PASSWORD

MAIL_DRIVER=mailgun
MAILGUN_DOMAIN=razorpay.com

# Should contact form submit details be sent to slack
# Set false in testing/development
# Slack Key is not used for Sorting Hat

SECURE_SESSION=true

API_MOCK=false
S3_MOCK=false
SLACK_ENABLE=true
# Creevey is the screenshot service
CREEVEY_MOCK=false
# Should mail be faked, set true in testing/development See mail.php for details
MAIL_PRETEND=false
MAILCHIMP_MOCK=false
ZAPIER_MOCK=false

AUTH_SERVICE_URL="https://auth.razorpay.com"
AUTH_SERVICE_URL_CDE="https://auth-cde.razorpay.com"
