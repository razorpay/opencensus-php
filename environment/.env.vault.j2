# {{ alohomora_managed }}

#Common
AWS_REGION            = ap-south-1

SLACK_KEY             = {{lookup('slack_key')}}
NOCAPTCHA_SECRET      = {{lookup('nocaptcha_secret')}}
CREEVEY_TOKEN         = {{lookup('creevey_token')}}

MAILGUN_API_KEY       = {{lookup('mailgun_api_secret')}}
MAIL_DOMAIN           = razorpay.com
MAIL_PORT             = 2525

AWS_QUEUE_URL         = https://sqs.ap-south-1.amazonaws.com/141592612890/{{ env }}-dashboard

APP_KEY               = {{lookup('app_key')}}

DB_MYSQL_PASSWORD     = {{lookup('user_pass')}}

API_AUTH_PASS         = {{lookup('auth_pass')}}
API_GUEST_AUTH_PASS   = {{lookup('guest_auth_pass')}}

CRON_PASS             = {{lookup('cron_password')}}

AUTH_SERVICE_PASS     = {{lookup('auth_service_password')}}

OAUTH_CLIENT_ID       = {{lookup('google_oauth_id')}}
OAUTH_CLIENT_SECRET   = {{lookup('google_oauth_secret')}}

# Required because versions of the app on k8s need to run PHP 7.1
# and PHP 7.1 does not support the mcrypt.
# Uncomment this when this has to be deployed to k8s
{% if env == 'echo' %}
#ENCRYPTION_CIPHER     = 'AES-256-CBC'
{% endif %}

{% if env == 'beta' %}

DB_MYSQL_DATABASE  = dbd-staging
DB_MYSQL_USERNAME  = dbd-staging

REDIS_DB           = 10

{% elif env == 'charlie' or env == 'delta' or env == 'echo' or env == 'func' or env == 'perf' %}

DB_MYSQL_DATABASE  = dbd-{{ env }}
DB_MYSQL_USERNAME  = dbd-{{ env }}

# beta, charlie, delta, echo - api reserves {1, 2, 3, 4}
# beta-hosted - {0}
# beta-harvester - {5}
{% if env == 'charlie' %}
REDIS_DB  = 11
{% elif env == 'delta' %}
REDIS_DB  = 12
{% elif env == 'echo' %}
REDIS_DB  = 13
{% elif env == 'stage' %}
REDIS_DB  = 14
{% elif env == 'func' %}
REDIS_DB  = 15
{% elif env == 'perf' %}
REDIS_DB  = 16
{% endif %}

{% endif %}


{% if env == 'beta' or env == 'charlie' or env == 'delta' or env == 'echo' %}

DB_MYSQL_HOST         = beta.db.razorpay.vpc
AWS_ACTIVATION_BUCKET = dashboard-activation-test
REDIS_HOST            = beta.cache.razorpay.vpc

{% if env == 'echo' %}
BASE_URL              = "https://{{ env }}-dashboard.razorpay.in"
{% else %}
BASE_URL              = "https://{{ env }}-dashboard.razorpay.com"
{% endif %}
API_URL               = "https://{{ env }}-api.razorpay.com/v1/"

{% elif env == 'func' or env == 'perf' %}
DB_MYSQL_HOST         = common.qa.db.razorpay.vpc
AWS_ACTIVATION_BUCKET = dashboard-activation-test
REDIS_HOST            = qa.cache.razorpay.vpc
BASE_URL              = "https://{{ env }}-dashboard.razorpay.in"

{% elif env == 'prod' %}

MAILCHIMP_LIST_ID     = {{lookup('mailchimp_list_id')}}
MAILCHIMP_API_TOKEN   = {{lookup('mailchimp_api_token')}}

DB_MYSQL_HOST         = prod-common.db.razorpay.vpc
DB_MYSQL_DATABASE     = dbd
DB_MYSQL_USERNAME     = dbd

AWS_ACTIVATION_BUCKET = dashboard-activation


REDIS_HOST            = prod-common.cache.razorpay.vpc
# hosted    - {1}
# harvester - {2}
REDIS_DB              = 0

BASE_URL              = "https://dashboard.razorpay.com"
API_URL               = "https://api.razorpay.com/v1/"

KEEN_READ_KEY         = {{lookup('keen_read_key')}}

{% endif %}
