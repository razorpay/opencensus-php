# {{ alohomora_managed }}
# Beta is not treated as a non-prod because of quirks
# around the naming of certain beta resources.
{% set nonprod = ['charlie', 'delta', 'echo','omega','zeta'] %}
{% set qa = ['func', 'perf','automation'] %}

#Common
AWS_REGION              = ap-south-1

SLACK_KEY               = {{lookup('slack_key')}}
NOCAPTCHA_SECRET        = {{lookup('nocaptcha_secret')}}

MAIL_DOMAIN             = razorpay.com
MAIL_PORT               = 2525

AWS_QUEUE_URL           = https://sqs.ap-south-1.amazonaws.com/141592612890/{{ env }}-dashboard

APP_KEY                 = {{lookup('app_key')}}

DB_MYSQL_PASSWORD       = {{lookup('user_pass')}}

API_AUTH_PASS           = {{lookup('auth_pass')}}
API_GUEST_AUTH_PASS     = {{lookup('guest_auth_pass')}}
API_INTERNAL_AUTH_PASS  = {{lookup('internal_auth_pass')}}

AUTH_SERVICE_PASS       = {{lookup('auth_service_password')}}

OAUTH_CLIENT_ID         = {{lookup('google_oauth_id')}}
OAUTH_CLIENT_SECRET     = {{lookup('google_oauth_secret')}}

JWT_ENCRYPTION_KEY      = {{lookup('jwt_encryption_key')}}

MAILGUN_API_KEY         = {{lookup('mailgun_api_key')}}

# Required because versions of the app on k8s need to run PHP 7.1
# and PHP 7.1 does not support the mcrypt.
# Uncomment this when this has to be deployed to k8s
# TODO: add for echo once asg is deprecated
{% if env in qa %}
ENCRYPTION_CIPHER       = 'AES-256-CBC'
{% endif %}

{% if env == 'beta' %}

DB_MYSQL_DATABASE  = dbd-staging
DB_MYSQL_USERNAME  = dbd-staging

{% elif env in nonprod+qa %}

DB_MYSQL_DATABASE  = dbd-{{ env }}
DB_MYSQL_USERNAME  = dbd-{{ env }}

{% endif %}

# beta, charlie, delta, echo - api reserves {1, 2, 3, 4}
# beta-hosted - {0}
# beta-harvester - {5}
{% if env == 'beta' %}
REDIS_DB  = 10
{% elif env == 'charlie' %}
REDIS_DB  = 11
{% elif env == 'delta' %}
REDIS_DB  = 12
{% elif env == 'echo' %}
REDIS_DB  = 13
{% elif env == 'stage' %}
REDIS_DB  = 14
{% elif env == 'func' or env == 'automation'  %}
REDIS_DB  = 15
{% elif env == 'perf' %}
REDIS_DB  = 16
{% elif env == 'zeta' %}
REDIS_DB  = 8
{% elif env == 'omega' %}
REDIS_DB  = 9
{% endif %}

{% if env == 'beta' or env in nonprod %}

DB_MYSQL_HOST         = beta-api-db.np.razorpay.vpc
AWS_ACTIVATION_BUCKET = dashboard-activation-test
REDIS_HOST            = beta.cache.np.razorpay.vpc

METRICS_DEFAULT_DRIVER = dogstatsd
METRICS_DOGSTATSD_HOST = 10.1.100.113
METRICS_DOGSTATSD_PORT = 9125

{% if env == 'echo' %}
BASE_URL              = "https://{{ env }}-dashboard.stage.razorpay.in"
API_URL               = "https://{{ env }}-api.stage.razorpay.in/v1/"
{% else %}
BASE_URL              = "https://{{ env }}-dashboard.stage.razorpay.com"
API_URL               = "https://{{ env }}-api.stage.razorpay.in/v1/"
{% endif %}


{% elif env in qa %}

DB_MYSQL_HOST         = common.qa.db.np.razorpay.vpc
AWS_ACTIVATION_BUCKET = dashboard-activation-test
REDIS_HOST            = qa.cache.np.razorpay.vpc

	{% if env == 'func' %}
	CDN_DASHBOARD_URL     = "https://betacdn.np.razorpay.in/dashboard/func{{ ENV['CDN_FOLDER'] }}"
    {% endif %}
    {% if env == 'automation' %}
    BASE_URL              = "https://dashboard.qa.razorpay.in"
    API_URL               = "https://api-web.qa.razorpay.in/v1/"
    CDN_DASHBOARD_URL     = "https://betacdn.np.razorpay.in/dashboard/qa"
    {% else %}
        {% if ENV['CDN_FOLDER'] == '3' %}
        API_URL               = "https://api-web-graphql.{{ env }}.razorpay.in/v1/"
        BASE_URL              = "https://dashboard-3.{{ env }}.razorpay.in"
        {% elif ENV['CDN_FOLDER'] == '2' %}
        API_URL               = "https://api-2.{{ env }}.razorpay.in/v1/"
        BASE_URL              = "https://dashboard-2.{{ env }}.razorpay.in"
        {% else %}
        API_URL               = "https://api-web.{{ env }}.razorpay.in/v1/"
        BASE_URL              = "https://dashboard.{{ env }}.razorpay.in"
        {% endif %}
    {% endif %}
{% elif env == 'prod' %}

MAILCHIMP_LIST_ID     = {{lookup('mailchimp_list_id')}}
MAILCHIMP_API_TOKEN   = {{lookup('mailchimp_api_token')}}

DB_MYSQL_HOST         = dashboard.prod.db.razorpay.vpc
DB_MYSQL_DATABASE     = dbd
DB_MYSQL_USERNAME     = dbd

AWS_ACTIVATION_BUCKET = dashboard-activation


REDIS_HOST            = prod-common.cache.razorpay.vpc
# hosted    - {1}
# harvester - {2}
REDIS_DB              = 0

BASE_URL              = "https://dashboard.razorpay.com"
API_URL               = "https://api.razorpay.com/v1/"

KEEN_READ_KEY         = {{lookup('keen_read_key')}}

METRICS_DEFAULT_DRIVER          = dogstatsd
METRICS_DOGSTATSD_HOST          = 10.1.0.160
METRICS_DOGSTATSD_PORT          = 9125

{% endif %}
