APP_ENV=production
SHIELD_STAGE=production
APP_DEBUG=false

CACHE_DRIVER=redis
QUEUE_DRIVER=sync

BASE_URL='https://dashboard.razorpay.com'
CDN_DASHBOARD_URL='https://cdn.razorpay.com/dashboard'
CDN_BASE_URL='https://cdn.razorpay.com'
API_URL="https://api-cron.razorpay.com/v1/"

# AWS Bucket for storing activation documents uploaded
AWS_ACTIVATION_BUCKET=dashboard-activation
# Region for queue, aws default config etc
AWS_REGION=ap-south-1
# Region to be used just for buckets
AWS_BUCKET_REGION=us-east-1

MAIL_DRIVER=mailgun
MAILGUN_DOMAIN=razorpay.com

# Should contact form submit details be sent to slack
# Set false in testing/development
# This is also used for Sorting Hat integration
# Slack Key is not used for Sorting Hat

SECURE_SESSION=true

API_MOCK=false
S3_MOCK=false
SLACK_ENABLE=true
# Creevey is the screenshot service
CREEVEY_MOCK=false
# Should mail be faked, set true in testing/development See mail.php for details
MAIL_PRETEND=false
MAILCHIMP_MOCK=false
ZAPIER_MOCK=false
OAUTH_MOCK=false

